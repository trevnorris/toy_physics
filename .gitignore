__pycache__

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.dvi
*.fdb_latexmk
*.fls
*.log
*.lof
*.lot
*.nav
*.snm
*.synctex.gz
*.synctex(busy)
*.toc
*.vrb
*.out
*.zip

# Obsidian vault volatile state
atlas/.obsidian/workspace.json
atlas/.obsidian/workspace-mobile.json
atlas/.obsidian/cache/
atlas/.obsidian/plugins/*/data.json

# Red-team rendered prompt files (regenerated on demand from prompts/ templates)
research/*/redteam/tmp_prompts/
research/*/redteam/pass2/tmp_prompts/
# Adversarial-audit Phase B per-candidate prompt renders (regenerated by phase-b-build-all; agents work from the bundles)
research/*/redteam_adversarial/tmp_prompts/*__phase_b__*.md
# Adversarial-audit Phase B per-batch genealogy-agent prompt renders (regenerated from the committed template + batch plan)
research/*/redteam_adversarial/tmp_prompts/phase_b_agent_batch_*.md

# Red-team runtime artifacts (captured per fix/verify cycle; reproducible)
research/*/redteam/exec_logs/
research/*/redteam/codex_logs/
research/*/redteam/.manifest.lock
research/*/redteam/fix_batch_*.log
research/*/redteam/fix_batch_*.marker
# Second-pass runtime artifacts (same as above, under the pass2/ subtree)
research/*/redteam/pass2/exec_logs/
research/*/redteam/pass2/codex_logs/
research/*/redteam/pass2/.manifest.lock
research/*/redteam/pass2/fix_batch_*.log
research/*/redteam/pass2/fix_batch_*.marker
research/*/redteam/MORNING_SUMMARY.md

# Adversarial-audit raw Codex session dumps (multi-MB; the redteam/ rule above
# missed the redteam_adversarial/ path). Curated consult records are committed
# explicitly with `git add -f` when they are genuine provenance.
research/*/redteam_adversarial/codex_logs/

# Verbose Codex apply-logs + raw review dumps (untracked 2026-06-12; history purge later).
# The DISTILLED decisions live in docs/ and redteam/codex_reviews/*.md (kept tracked).
research/*/redteam/resolutions/codex_apply_log_*.txt
research/*/redteam/pass2/resolutions/codex_apply_log_*.txt
research/*/redteam/codex_reviews/*.raw
research/*/redteam_adversarial/codex_reviews/*.raw

# Reduced-FEM negative-control generated output (V2-23 surrogate; regenerable, was 16M tracked)
research/pde_audit/simulation/output/

# =====================================================================
# Layer-3 Stage-1 solver: generated-data firewall (added 2026-06-12)
# The numerical branch-realization solver produces large mesh/field/
# checkpoint data. To stop the repo from exploding, ALL run output goes
# to gitignored directories; only code + small curated YAML/markdown
# summaries are committed, and only ever via an explicit `git add <path>`
# (never `git add -A`). To commit a deliberate binary fixture, force it:
# `git add -f <path>`.
# =====================================================================

# Crash artifacts (core dumps are core.<pid>; do NOT use core.* -- core.py is tracked)
core.[0-9]*
vgcore.*
*.stackdump

# Solver home: ignore all run-output / scratch / figure trees inside it
# (solver code lives under software/ — research/ is reserved for publication material)
software/stage1_solver/runs/
software/stage1_solver/data/
software/stage1_solver/figures/
software/stage1_solver/output/
software/stage1_solver/_scratch/

# Generic run-output / scratch trees anywhere under software/ (and research/ as a backstop)
software/**/runs/
software/**/_scratch/
research/**/runs/
research/**/_scratch/

# Large numerical / serialized-data formats, wherever they land
*.h5
*.hdf5
*.npy
*.npz
*.vtk
*.vtu
*.vtr
*.vti
*.pvtu
*.pvd
*.xdmf
*.bp
*.zarr/
*.pkl
*.pickle
*.pt
*.pth
*.ckpt
*.safetensors
*.mat
*.nc
*.parquet
*.feather
*.tar.gz
*.tgz
