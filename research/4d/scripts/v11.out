[1] \left(v^{\rm brane}_x{\left(t,x,y,z \right)} \frac{\partial}{\partial x} v^{\rm brane}_x{\left(t,x,y,z \right)} + v^{\rm brane}_y{\left(t,x,y,z \right)} \frac{\partial}{\partial y} v^{\rm brane}_x{\left(t,x,y,z \right)} + v^{\rm brane}_z{\left(t,x,y,z \right)} \frac{\partial}{\partial z} v^{\rm brane}_x{\left(t,x,y,z \right)} + \frac{\partial}{\partial t} v^{\rm brane}_x{\left(t,x,y,z \right)}\right) \rho_{\rm brane}{\left(t,x,y,z \right)} = F^{\rm tot}_x{\left(t,x,y,z \right)} - S_{\rho,\rm brane}{\left(t,x,y,z \right)} v^{\rm brane}_x{\left(t,x,y,z \right)} - \frac{\partial}{\partial x} R_{xx}{\left(t,x,y,z \right)} - \frac{\partial}{\partial y} R_{xy}{\left(t,x,y,z \right)} - \frac{\partial}{\partial z} R_{xz}{\left(t,x,y,z \right)}

[2] \left(v^{\rm brane}_x{\left(t,x,y,z \right)} \frac{\partial}{\partial x} v^{\rm brane}_y{\left(t,x,y,z \right)} + v^{\rm brane}_y{\left(t,x,y,z \right)} \frac{\partial}{\partial y} v^{\rm brane}_y{\left(t,x,y,z \right)} + v^{\rm brane}_z{\left(t,x,y,z \right)} \frac{\partial}{\partial z} v^{\rm brane}_y{\left(t,x,y,z \right)} + \frac{\partial}{\partial t} v^{\rm brane}_y{\left(t,x,y,z \right)}\right) \rho_{\rm brane}{\left(t,x,y,z \right)} = F^{\rm tot}_y{\left(t,x,y,z \right)} - S_{\rho,\rm brane}{\left(t,x,y,z \right)} v^{\rm brane}_y{\left(t,x,y,z \right)} - \frac{\partial}{\partial x} R_{yx}{\left(t,x,y,z \right)} - \frac{\partial}{\partial y} R_{yy}{\left(t,x,y,z \right)} - \frac{\partial}{\partial z} R_{yz}{\left(t,x,y,z \right)}

[3] \left(v^{\rm brane}_x{\left(t,x,y,z \right)} \frac{\partial}{\partial x} v^{\rm brane}_z{\left(t,x,y,z \right)} + v^{\rm brane}_y{\left(t,x,y,z \right)} \frac{\partial}{\partial y} v^{\rm brane}_z{\left(t,x,y,z \right)} + v^{\rm brane}_z{\left(t,x,y,z \right)} \frac{\partial}{\partial z} v^{\rm brane}_z{\left(t,x,y,z \right)} + \frac{\partial}{\partial t} v^{\rm brane}_z{\left(t,x,y,z \right)}\right) \rho_{\rm brane}{\left(t,x,y,z \right)} = F^{\rm tot}_z{\left(t,x,y,z \right)} - S_{\rho,\rm brane}{\left(t,x,y,z \right)} v^{\rm brane}_z{\left(t,x,y,z \right)} - \frac{\partial}{\partial x} R_{zx}{\left(t,x,y,z \right)} - \frac{\partial}{\partial y} R_{zy}{\left(t,x,y,z \right)} - \frac{\partial}{\partial z} R_{zz}{\left(t,x,y,z \right)}

