artial}{\partial z} \psi{\left(t,x,y,z,w \right)} - \frac{i q \operatorname{Az}{\left(t,x,y,z,w \right)} \psi{\left(t,x,y,z,w \right)}}{\bar{\h}}\right) \bar\psi{\left(t,x,y,z,w \right)}\right) W{\left(w \right)}}{2 m}\right)\, dw\right) \int\limits_{- W_{\rm proj}}^{W_{\rm proj}} \left(W{\left(w \right)} \bar\psi{\left(t,x,y,z,w \right)} \frac{\partial}{\partial z} \psi{\left(t,x,y,z,w \right)} + W{\left(w \right)} \psi{\left(t,x,y,z,w \right)} \frac{\partial}{\partial z} \bar\psi{\left(t,x,y,z,w \right)}\right)\, dw}{\left(\int\limits_{- W_{\rm proj}}^{W_{\rm proj}} W{\left(w \right)} \bar\psi{\left(t,x,y,z,w \right)} \psi{\left(t,x,y,z,w \right)}\, dw\right)^{2}} + \frac{\frac{i \bar{\h} \left(- \left(\frac{\partial}{\partial W_{\rm proj}} \bar\psi{\left(t,x,y,z,W_{\rm proj} \right)} + \frac{i q \operatorname{Aw}{\left(t,x,y,z,W_{\rm proj} \right)} \bar\psi{\left(t,x,y,z,W_{\rm proj} \right)}}{\bar{\h}}\right) \psi{\left(t,x,y,z,W_{\rm proj} \right)} + \left(\frac{\partial}{\partial W_{\rm proj}} \psi{\left(t,x,y,z,W_{\rm proj} \right)} - \frac{i q \operatorname{Aw}{\left(t,x,y,z,W_{\rm proj} \right)} \psi{\left(t,x,y,z,W_{\rm proj} \right)}}{\bar{\h}}\right) \bar\psi{\left(t,x,y,z,W_{\rm proj} \right)}\right) W{\left(W_{\rm proj} \right)}}{2 m} - \frac{i \bar{\h} \left(- \left(\left. \frac{\partial}{\partial w} \bar\psi{\left(t,x,y,z,w \right)} \right|_{\substack{ w=- W_{\rm proj} }} + \frac{i q \operatorname{Aw}{\left(t,x,y,z,- W_{\rm proj} \right)} \bar\psi{\left(t,x,y,z,- W_{\rm proj} \right)}}{\bar{\h}}\right) \psi{\left(t,x,y,z,- W_{\rm proj} \right)} + \left(\left. \frac{\partial}{\partial w} \psi{\left(t,x,y,z,w \right)} \right|_{\substack{ w=- W_{\rm proj} }} - \frac{i q \operatorname{Aw}{\left(t,x,y,z,- W_{\rm proj} \right)} \psi{\left(t,x,y,z,- W_{\rm proj} \right)}}{\bar{\h}}\right) \bar\psi{\left(t,x,y,z,- W_{\rm proj} \right)}\right) W{\left(- W_{\rm proj} \right)}}{2 m} + \int\limits_{- W_{\rm proj}}^{W_{\rm proj}} \left(- \frac{i \bar{\h} \left(- 