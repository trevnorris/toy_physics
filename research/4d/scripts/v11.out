[1] \frac{\int\limits_{- W_{\rm proj}}^{W_{\rm proj}} \left(- \frac{i \bar{\h} \left(- \left(\frac{\partial}{\partial x} \bar\psi{\left(t,x,y,z,w \right)} + \frac{i q \operatorname{Ax}{\left(t,x,y,z,w \right)} \bar\psi{\left(t,x,y,z,w \right)}}{\bar{\h}}\right) \psi{\left(t,x,y,z,w \right)} + \left(\frac{\partial}{\partial x} \psi{\left(t,x,y,z,w \right)} - \frac{i q \operatorname{Ax}{\left(t,x,y,z,w \right)} \psi{\left(t,x,y,z,w \right)}}{\bar{\h}}\right) \bar\psi{\left(t,x,y,z,w \right)}\right) W{\left(w \right)}}{2 m}\right)\, dw}{\int\limits_{- W_{\rm proj}}^{W_{\rm proj}} W{\left(w \right)} \bar\psi{\left(t,x,y,z,w \right)} \psi{\left(t,x,y,z,w \right)}\, dw}

