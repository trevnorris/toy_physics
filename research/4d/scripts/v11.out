[3] - \frac{i \bar{\h} \left(- \left(\frac{\partial}{\partial z} \bar\psi{\left(t,x,y,z,w \right)} + \frac{i q \operatorname{Az}{\left(t,x,y,z,w \right)} \bar\psi{\left(t,x,y,z,w \right)}}{\bar{\h}}\right) \psi{\left(t,x,y,z,w \right)} + \left(\frac{\partial}{\partial z} \psi{\left(t,x,y,z,w \right)} - \frac{i q \operatorname{Az}{\left(t,x,y,z,w \right)} \psi{\left(t,x,y,z,w \right)}}{\bar{\h}}\right) \bar\psi{\left(t,x,y,z,w \right)}\right)}{2 m}

