EM1) Emergent-EM kinematics: Φ_em=λ(h+½|v|^2),  A_em=λ v  ⇒  E=-∇Φ-∂tA,  B=∇×A
--------------------------------------------------------------------------------------------
[1] \Phi_{\rm em} = \lambda_{\rm em} \left(\frac{5 K \rho_{\rm brane}^{4}{\left(t,x,y,z \right)}}{4} + \frac{\left(v^{\rm brane}_x\right)^{2}{\left(t,x,y,z \right)}}{2} + \frac{\left(v^{\rm brane}_y\right)^{2}{\left(t,x,y,z \right)}}{2} + \frac{\left(v^{\rm brane}_z\right)^{2}{\left(t,x,y,z \right)}}{2}\right)

[2] A_{\rm em} = \left[\begin{matrix}\lambda_{\rm em} v^{\rm brane}_x{\left(t,x,y,z \right)}\\\lambda_{\rm em} v^{\rm brane}_y{\left(t,x,y,z \right)}\\\lambda_{\rm em} v^{\rm brane}_z{\left(t,x,y,z \right)}\end{matrix}\right]

[3] E_{\rm em} = \left[\begin{matrix}- \lambda_{\rm em} \left(5 K \rho_{\rm brane}^{3}{\left(t,x,y,z \right)} \frac{\partial}{\partial x} \rho_{\rm brane}{\left(t,x,y,z \right)} + v^{\rm brane}_x{\left(t,x,y,z \right)} \frac{\partial}{\partial x} v^{\rm brane}_x{\left(t,x,y,z \right)} + v^{\rm brane}_y{\left(t,x,y,z \right)} \frac{\partial}{\partial x} v^{\rm brane}_y{\left(t,x,y,z \right)} + v^{\rm brane}_z{\left(t,x,y,z \right)} \frac{\partial}{\partial x} v^{\rm brane}_z{\left(t,x,y,z \right)}\right) - \lambda_{\rm em} \frac{\partial}{\partial t} v^{\rm brane}_x{\left(t,x,y,z \right)}\\- \lambda_{\rm em} \left(5 K \rho_{\rm brane}^{3}{\left(t,x,y,z \right)} \frac{\partial}{\partial y} \rho_{\rm brane}{\left(t,x,y,z \right)} + v^{\rm brane}_x{\left(t,x,y,z \right)} \frac{\partial}{\partial y} v^{\rm brane}_x{\left(t,x,y,z \right)} + v^{\rm brane}_y{\left(t,x,y,z \right)} \frac{\partial}{\partial y} v^{\rm brane}_y{\left(t,x,y,z \right)} + v^{\rm brane}_z{\left(t,x,y,z \right)} \frac{\partial}{\partial y} v^{\rm brane}_z{\left(t,x,y,z \right)}\right) - \lambda_{\rm em} \frac{\partial}{\partial t} v^{\rm brane}_y{\left(t,x,y,z \right)}\\- \lambda_{\rm em} \left(5 K \rho_{\rm brane}^{3}{\left(t,x,y,z \right)} \frac{\partial}{\partial z} \rho_{\rm brane}{\left(t,x,y,z \right)} + v^{\rm brane}_x{\left(t,x,y,z \right)} \frac{\partial}{\partial z} v^{\rm brane}_x{\left(t,x,y,z \right)} + v^{\rm brane}_y{\left(t,x,y,z \right)} \frac{\partial}{\partial z} v^{\rm brane}_y{\left(t,x,y,z \right)} + v^{\rm brane}_z{\left(t,x,y,z \right)} \frac{\partial}{\partial z} v^{\rm brane}_z{\left(t,x,y,z \right)}\right) - \lambda_{\rm em} \frac{\partial}{\partial t} v^{\rm brane}_z{\left(t,x,y,z \right)}\end{matrix}\right]

[4] B_{\rm em} = \left[\begin{matrix}- \lambda_{\rm em} \frac{\partial}{\partial z} v^{\rm brane}_y{\left(t,x,y,z \right)} + \lambda_{\rm em} \frac{\partial}{\partial y} v^{\rm brane}_z{\left(t,x,y,z \right)}\\\lambda_{\rm em} \frac{\partial}{\partial z} v^{\rm brane}_x{\left(t,x,y,z \right)} - \lambda_{\rm em} \frac{\partial}{\partial x} v^{\rm brane}_z{\left(t,x,y,z \right)}\\- \lambda_{\rm em} \frac{\partial}{\partial y} v^{\rm brane}_x{\left(t,x,y,z \right)} + \lambda_{\rm em} \frac{\partial}{\partial x} v^{\rm brane}_y{\left(t,x,y,z \right)}\end{matrix}\right]

