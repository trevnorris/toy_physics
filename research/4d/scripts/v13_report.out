[3] \left(- \frac{\partial}{\partial y} v^{\rm brane}_x{\left(t,x,y,z \right)} + \frac{\partial}{\partial x} v^{\rm brane}_y{\left(t,x,y,z \right)}\right) \frac{\partial}{\partial x} v^{\rm brane}_x{\left(t,x,y,z \right)} + \left(- \frac{\partial}{\partial y} v^{\rm brane}_x{\left(t,x,y,z \right)} + \frac{\partial}{\partial x} v^{\rm brane}_y{\left(t,x,y,z \right)}\right) \frac{\partial}{\partial y} v^{\rm brane}_y{\left(t,x,y,z \right)} + \left(- \frac{\partial^{2}}{\partial y^{2}} v^{\rm brane}_x{\left(t,x,y,z \right)} + \frac{\partial^{2}}{\partial y\partial x} v^{\rm brane}_y{\left(t,x,y,z \right)}\right) v^{\rm brane}_y{\left(t,x,y,z \right)} - \left(\frac{\partial}{\partial z} v^{\rm brane}_x{\left(t,x,y,z \right)} - \frac{\partial}{\partial x} v^{\rm brane}_z{\left(t,x,y,z \right)}\right) \frac{\partial}{\partial y} v^{\rm brane}_z{\left(t,x,y,z \right)} + \left(\frac{\partial^{2}}{\partial x^{2}} v^{\rm brane}_y{\left(t,x,y,z \right)} - \frac{\partial^{2}}{\partial y\partial x} v^{\rm brane}_x{\left(t,x,y,z \right)}\right) v^{\rm brane}_x{\left(t,x,y,z \right)} - \left(- \frac{\partial}{\partial z} v^{\rm brane}_y{\left(t,x,y,z \right)} + \frac{\partial}{\partial y} v^{\rm brane}_z{\left(t,x,y,z \right)}\right) \frac{\partial}{\partial x} v^{\rm brane}_z{\left(t,x,y,z \right)} - \left(\frac{\partial^{2}}{\partial z\partial y} v^{\rm brane}_x{\left(t,x,y,z \right)} - \frac{\partial^{2}}{\partial y\partial x} v^{\rm brane}_z{\left(t,x,y,z \right)}\right) v^{\rm brane}_z{\left(t,x,y,z \right)} - \left(- \frac{\partial^{2}}{\partial z\partial x} v^{\rm brane}_y{\left(t,x,y,z \right)} + \frac{\partial^{2}}{\partial y\partial x} v^{\rm brane}_z{\left(t,x,y,z \right)}\right) v^{\rm brane}_z{\left(t,x,y,z \right)} - \frac{\partial^{2}}{\partial y\partial t} v^{\rm brane}_x{\left(t,x,y,z \right)} + \frac{\partial^{2}}{\partial x\partial t} v^{\rm brane}_y{\left(t,x,y,z \right)} = \frac{\left(F^{\rm tot}_x{\left(t,x,y,z \right)} - S_{\rho,\rm brane}{\left(t,x,y,z \right)} v^{\rm brane}_x{\left(t,x,y,z \right)} - \frac{\partial}{\partial x} R_{xx}{\left(t,x,y,z \right)} - \frac{\partial}{\partial y} R_{xy}{\left(t,x,y,z \right)} - \frac{\partial}{\partial z} R_{xz}{\left(t,x,y,z \right)}\right) \frac{\partial}{\partial y} \rho_{\rm brane}{\left(t,x,y,z \right)}}{\rho_{\rm brane}^{2}{\left(t,x,y,z \right)}} - \frac{\left(F^{\rm tot}_y{\left(t,x,y,z \right)} - S_{\rho,\rm brane}{\left(t,x,y,z \right)} v^{\rm brane}_y{\left(t,x,y,z \right)} - \frac{\partial}{\partial x} R_{yx}{\left(t,x,y,z \right)} - \frac{\partial}{\partial y} R_{yy}{\left(t,x,y,z \right)} - \frac{\partial}{\partial z} R_{yz}{\left(t,x,y,z \right)}\right) \frac{\partial}{\partial x} \rho_{\rm brane}{\left(t,x,y,z \right)}}{\rho_{\rm brane}^{2}{\left(t,x,y,z \right)}} - \frac{- S_{\rho,\rm brane}{\left(t,x,y,z \right)} \frac{\partial}{\partial y} v^{\rm brane}_x{\left(t,x,y,z \right)} - v^{\rm brane}_x{\left(t,x,y,z \right)} \frac{\partial}{\partial y} S_{\rho,\rm brane}{\left(t,x,y,z \right)} + \frac{\partial}{\partial y} F^{\rm tot}_x{\left(t,x,y,z \right)} - \frac{\partial^{2}}{\partial y^{2}} R_{xy}{\left(t,x,y,z \right)} - \frac{\partial^{2}}{\partial y\partial x} R_{xx}{\left(t,x,y,z \right)} - \frac{\partial^{2}}{\partial z\partial y} R_{xz}{\left(t,x,y,z \right)}}{\rho_{\rm brane}{\left(t,x,y,z \right)}} + \frac{- S_{\rho,\rm brane}{\left(t,x,y,z \right)} \frac{\partial}{\partial x} v^{\rm brane}_y{\left(t,x,y,z \right)} - v^{\rm brane}_y{\left(t,x,y,z \right)} \frac{\partial}{\partial x} S_{\rho,\rm brane}{\left(t,x,y,z \right)} + \frac{\partial}{\partial x} F^{\rm tot}_y{\left(t,x,y,z \right)} - \frac{\partial^{2}}{\partial x^{2}} R_{yx}{\left(t,x,y,z \right)} - \frac{\partial^{2}}{\partial y\partial x} R_{yy}{\left(t,x,y,z \right)} - \frac{\partial^{2}}{\partial z\partial x} R_{yz}{\left(t,x,y,z \right)}}{\rho_{\rm brane}{\left(t,x,y,z \right)}}

