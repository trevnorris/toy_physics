12-summary) Madelung dictionary (bulk) and PDEs (compact)
--------------------------------------------------------------------------------------------
[1] \psi = \sqrt{\rho}\,e^{i\theta}

[2] v_{i} = \frac{\bar{\h} \partial_{i\theta}}{m}

[3] Q = - \frac{\bar{\h}^{2} \left(\frac{2 \frac{\partial^{2}}{\partial w^{2}} \rho{\left(t,x,y,z,w \right)} - \frac{\left(\frac{\partial}{\partial w} \rho{\left(t,x,y,z,w \right)}\right)^{2}}{\rho{\left(t,x,y,z,w \right)}}}{4 \sqrt{\rho{\left(t,x,y,z,w \right)}}} + \frac{2 \frac{\partial^{2}}{\partial x^{2}} \rho{\left(t,x,y,z,w \right)} - \frac{\left(\frac{\partial}{\partial x} \rho{\left(t,x,y,z,w \right)}\right)^{2}}{\rho{\left(t,x,y,z,w \right)}}}{4 \sqrt{\rho{\left(t,x,y,z,w \right)}}} + \frac{2 \frac{\partial^{2}}{\partial y^{2}} \rho{\left(t,x,y,z,w \right)} - \frac{\left(\frac{\partial}{\partial y} \rho{\left(t,x,y,z,w \right)}\right)^{2}}{\rho{\left(t,x,y,z,w \right)}}}{4 \sqrt{\rho{\left(t,x,y,z,w \right)}}} + \frac{2 \frac{\partial^{2}}{\partial z^{2}} \rho{\left(t,x,y,z,w \right)} - \frac{\left(\frac{\partial}{\partial z} \rho{\left(t,x,y,z,w \right)}\right)^{2}}{\rho{\left(t,x,y,z,w \right)}}}{4 \sqrt{\rho{\left(t,x,y,z,w \right)}}}\right)}{2 m \sqrt{\rho{\left(t,x,y,z,w \right)}}}

[4] \frac{\bar{\h} \rho{\left(t,x,y,z,w \right)} \frac{\partial^{2}}{\partial w^{2}} \theta{\left(t,x,y,z,w \right)}}{m} + \frac{\bar{\h} \rho{\left(t,x,y,z,w \right)} \frac{\partial^{2}}{\partial x^{2}} \theta{\left(t,x,y,z,w \right)}}{m} + \frac{\bar{\h} \rho{\left(t,x,y,z,w \right)} \frac{\partial^{2}}{\partial y^{2}} \theta{\left(t,x,y,z,w \right)}}{m} + \frac{\bar{\h} \rho{\left(t,x,y,z,w \right)} \frac{\partial^{2}}{\partial z^{2}} \theta{\left(t,x,y,z,w \right)}}{m} + \frac{\bar{\h} \frac{\partial}{\partial w} \rho{\left(t,x,y,z,w \right)} \frac{\partial}{\partial w} \theta{\left(t,x,y,z,w \right)}}{m} + \frac{\bar{\h} \frac{\partial}{\partial x} \rho{\left(t,x,y,z,w \right)} \frac{\partial}{\partial x} \theta{\left(t,x,y,z,w \right)}}{m} + \frac{\bar{\h} \frac{\partial}{\partial y} \rho{\left(t,x,y,z,w \right)} \frac{\partial}{\partial y} \theta{\left(t,x,y,z,w \right)}}{m} + \frac{\bar{\h} \frac{\partial}{\partial z} \rho{\left(t,x,y,z,w \right)} \frac{\partial}{\partial z} \theta{\left(t,x,y,z,w \right)}}{m} + \frac{\partial}{\partial t} \rho{\left(t,x,y,z,w \right)} = 0

[5] \frac{5 K \rho^{4}{\left(t,x,y,z,w \right)}}{4} - \frac{\bar{\h}^{2} \left(\frac{2 \frac{\partial^{2}}{\partial w^{2}} \rho{\left(t,x,y,z,w \right)} - \frac{\left(\frac{\partial}{\partial w} \rho{\left(t,x,y,z,w \right)}\right)^{2}}{\rho{\left(t,x,y,z,w \right)}}}{4 \sqrt{\rho{\left(t,x,y,z,w \right)}}} + \frac{2 \frac{\partial^{2}}{\partial x^{2}} \rho{\left(t,x,y,z,w \right)} - \frac{\left(\frac{\partial}{\partial x} \rho{\left(t,x,y,z,w \right)}\right)^{2}}{\rho{\left(t,x,y,z,w \right)}}}{4 \sqrt{\rho{\left(t,x,y,z,w \right)}}} + \frac{2 \frac{\partial^{2}}{\partial y^{2}} \rho{\left(t,x,y,z,w \right)} - \frac{\left(\frac{\partial}{\partial y} \rho{\left(t,x,y,z,w \right)}\right)^{2}}{\rho{\left(t,x,y,z,w \right)}}}{4 \sqrt{\rho{\left(t,x,y,z,w \right)}}} + \frac{2 \frac{\partial^{2}}{\partial z^{2}} \rho{\left(t,x,y,z,w \right)} - \frac{\left(\frac{\partial}{\partial z} \rho{\left(t,x,y,z,w \right)}\right)^{2}}{\rho{\left(t,x,y,z,w \right)}}}{4 \sqrt{\rho{\left(t,x,y,z,w \right)}}}\right)}{2 m \sqrt{\rho{\left(t,x,y,z,w \right)}}} + \bar{\h} \frac{\partial}{\partial t} \theta{\left(t,x,y,z,w \right)} + \frac{m \left(\frac{\bar{\h}^{2} \left(\frac{\partial}{\partial w} \theta{\left(t,x,y,z,w \right)}\right)^{2}}{m^{2}} + \frac{\bar{\h}^{2} \left(\frac{\partial}{\partial x} \theta{\left(t,x,y,z,w \right)}\right)^{2}}{m^{2}} + \frac{\bar{\h}^{2} \left(\frac{\partial}{\partial y} \theta{\left(t,x,y,z,w \right)}\right)^{2}}{m^{2}} + \frac{\bar{\h}^{2} \left(\frac{\partial}{\partial z} \theta{\left(t,x,y,z,w \right)}\right)^{2}}{m^{2}}\right)}{2} + V_{\rm conf}{\left(x,y,z,w,a,L \right)} = 0

