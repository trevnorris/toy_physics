- \frac{i \bar{\h} \left(- \left(\frac{\partial}{\partial w} \bar\psi{\left(t,x,y,z,w \right)} + \frac{i q \operatorname{Aw}{\left(t,x,y,z,w \right)} \bar\psi{\left(t,x,y,z,w \right)}}{\bar{\h}}\right) \frac{\partial}{\partial w} \psi{\left(t,x,y,z,w \right)} + \left(\frac{\partial}{\partial w} \psi{\left(t,x,y,z,w \right)} - \frac{i q \operatorname{Aw}{\left(t,x,y,z,w \right)} \psi{\left(t,x,y,z,w \right)}}{\bar{\h}}\right) \frac{\partial}{\partial w} \bar\psi{\left(t,x,y,z,w \right)} - \left(\frac{\partial^{2}}{\partial w^{2}} \bar\psi{\left(t,x,y,z,w \right)} + \frac{i q \operatorname{Aw}{\left(t,x,y,z,w \right)} \frac{\partial}{\partial w} \bar\psi{\left(t,x,y,z,w \right)}}{\bar{\h}} + \frac{i q \bar\psi{\left(t,x,y,z,w \right)} \frac{\partial}{\partial w} \operatorname{Aw}{\left(t,x,y,z,w \right)}}{\bar{\h}}\right) \psi{\left(t,x,y,z,w \right)} + \left(\frac{\partial^{2}}{\partial w^{2}} \psi{\left(t,x,y,z,w \right)} - \frac{i q \operatorname{Aw}{\left(t,x,y,z,w \right)} \frac{\partial}{\partial w} \psi{\left(t,x,y,z,w \right)}}{\bar{\h}} - \frac{i q \psi{\left(t,x,y,z,w \right)} \frac{\partial}{\partial w} \operatorname{Aw}{\left(t,x,y,z,w \right)}}{\bar{\h}}\right) \bar\psi{\left(t,x,y,z,w \right)}\right)}{2 m} - \frac{i \bar{\h} \left(- \left(\frac{\partial}{\partial x} \bar\psi{\left(t,x,y,z,w \right)} + \frac{i q \operatorname{Ax}{\left(t,x,y,z,w \right)} \bar\psi{\left(t,x,y,z,w \right)}}{\bar{\h}}\right) \frac{\partial}{\partial x} \psi{\left(t,x,y,z,w \right)} + \left(\frac{\partial}{\partial x} \psi{\left(t,x,y,z,w \right)} - \frac{i q \operatorname{Ax}{\left(t,x,y,z,w \right)} \psi{\left(t,x,y,z,w \right)}}{\bar{\h}}\right) \frac{\partial}{\partial x} \bar\psi{\left(t,x,y,z,w \right)} - \left(\frac{\partial^{2}}{\partial x^{2}} \bar\psi{\left(t,x,y,z,w \right)} + \frac{i q \operatorname{Ax}{\left(t,x,y,z,w \right)} \frac{\partial}{\partial x} \bar\psi{\left(t,x,y,z,w \right)}}{\bar{\h}} + \frac{i q \bar\psi{\left(t,x,y,z,w \right)} \frac{\partial}{\partial x} \operatorname{Ax}{\left(t,x,y,z,w \right)}}{\bar{\h}}\right) \psi{\left(t,x,y,z,w \right)} + \left(\frac{\partial^{2}}{\partial x^{2}} \psi{\left(t,x,y,z,w \right)} - \frac{i q \operatorname{Ax}{\left(t,x,y,z,w \right)} \frac{\partial}{\partial x} \psi{\left(t,x,y,z,w \right)}}{\bar{\h}} - \frac{i q \psi{\left(t,x,y,z,w \right)} \frac{\partial}{\partial x} \operatorname{Ax}{\left(t,x,y,z,w \right)}}{\bar{\h}}\right) \bar\psi{\left(t,x,y,z,w \right)}\right)}{2 m} - \frac{i \bar{\h} \left(- \left(\frac{\partial}{\partial y} \bar\psi{\left(t,x,y,z,w \right)} + \frac{i q \operatorname{Ay}{\left(t,x,y,z,w \right)} \bar\psi{\left(t,x,y,z,w \right)}}{\bar{\h}}\right) \frac{\partial}{\partial y} \psi{\left(t,x,y,z,w \right)} + \left(\frac{\partial}{\partial y} \psi{\left(t,x,y,z,w \right)} - \frac{i q \operatorname{Ay}{\left(t,x,y,z,w \right)} \psi{\left(t,x,y,z,w \right)}}{\bar{\h}}\right) \frac{\partial}{\partial y} \bar\psi{\left(t,x,y,z,w \right)} - \left(\frac{\partial^{2}}{\partial y^{2}} \bar\psi{\left(t,x,y,z,w \right)} + \frac{i q \operatorname{Ay}{\left(t,x,y,z,w \right)} \frac{\partial}{\partial y} \bar\psi{\left(t,x,y,z,w \right)}}{\bar{\h}} + \frac{i q \bar\psi{\left(t,x,y,z,w \right)} \frac{\partial}{\partial y} \operatorname{Ay}{\left(t,x,y,z,w \right)}}{\bar{\h}}\right) \psi{\left(t,x,y,z,w \right)} + \left(\frac{\partial^{2}}{\partial y^{2}} \psi{\left(t,x,y,z,w \right)} - \frac{i q \operatorname{Ay}{\left(t,x,y,z,w \right)} \frac{\partial}{\partial y} \psi{\left(t,x,y,z,w \right)}}{\bar{\h}} - \frac{i q \psi{\left(t,x,y,z,w \right)} \frac{\partial}{\partial y} \operatorname{Ay}{\left(t,x,y,z,w \right)}}{\bar{\h}}\right) \bar\psi{\left(t,x,y,z,w \right)}\right)}{2 m} - \frac{i \bar{\h} \left(- \left(\frac{\partial}{\partial z} \bar\psi{\left(t,x,y,z,w \right)} + \frac{i q \operatorname{Az}{\left(t,x,y,z,w \right)} \bar\psi{\left(t,x,y,z,w \right)}}{\bar{\h}}\right) \frac{\partial}{\partial z} \psi{\left(t,x,y,z,w \right)} + \left(\frac{\partial}{\p