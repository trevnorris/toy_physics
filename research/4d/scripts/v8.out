8h0) Brane shorthand fields (definitions)
--------------------------------------------------------------------------------------------
[1] \rho_{\rm brane}{\left(t,x,y,z \right)} = \int\limits_{- W_{\rm proj}}^{W_{\rm proj}} W{\left(w \right)} \bar\psi{\left(t,x,y,z,w \right)} \psi{\left(t,x,y,z,w \right)}\, dw

[2] J_{x,\rm brane}{\left(t,x,y,z \right)} = \int\limits_{- W_{\rm proj}}^{W_{\rm proj}} \left(- \frac{i \bar{\h} \left(- \left(\frac{\partial}{\partial x} \bar\psi{\left(t,x,y,z,w \right)} + \frac{i q \operatorname{Ax}{\left(t,x,y,z,w \right)} \bar\psi{\left(t,x,y,z,w \right)}}{\bar{\h}}\right) \psi{\left(t,x,y,z,w \right)} + \left(\frac{\partial}{\partial x} \psi{\left(t,x,y,z,w \right)} - \frac{i q \operatorname{Ax}{\left(t,x,y,z,w \right)} \psi{\left(t,x,y,z,w \right)}}{\bar{\h}}\right) \bar\psi{\left(t,x,y,z,w \right)}\right) W{\left(w \right)}}{2 m}\right)\, dw

[3] J_{y,\rm brane}{\left(t,x,y,z \right)} = \int\limits_{- W_{\rm proj}}^{W_{\rm proj}} \left(- \frac{i \bar{\h} \left(- \left(\frac{\partial}{\partial y} \bar\psi{\left(t,x,y,z,w \right)} + \frac{i q \operatorname{Ay}{\left(t,x,y,z,w \right)} \bar\psi{\left(t,x,y,z,w \right)}}{\bar{\h}}\right) \psi{\left(t,x,y,z,w \right)} + \left(\frac{\partial}{\partial y} \psi{\left(t,x,y,z,w \right)} - \frac{i q \operatorname{Ay}{\left(t,x,y,z,w \right)} \psi{\left(t,x,y,z,w \right)}}{\bar{\h}}\right) \bar\psi{\left(t,x,y,z,w \right)}\right) W{\left(w \right)}}{2 m}\right)\, dw

[4] J_{z,\rm brane}{\left(t,x,y,z \right)} = \int\limits_{- W_{\rm proj}}^{W_{\rm proj}} \left(- \frac{i \bar{\h} \left(- \left(\frac{\partial}{\partial z} \bar\psi{\left(t,x,y,z,w \right)} + \frac{i q \operatorname{Az}{\left(t,x,y,z,w \right)} \bar\psi{\left(t,x,y,z,w \right)}}{\bar{\h}}\right) \psi{\left(t,x,y,z,w \right)} + \left(\frac{\partial}{\partial z} \psi{\left(t,x,y,z,w \right)} - \frac{i q \operatorname{Az}{\left(t,x,y,z,w \right)} \psi{\left(t,x,y,z,w \right)}}{\bar{\h}}\right) \bar\psi{\left(t,x,y,z,w \right)}\right) W{\left(w \right)}}{2 m}\right)\, dw

============================================================================================


============================================================================================
8h1) Brane momentum-flux tensor Π_{ij} definitions (kept compact)
