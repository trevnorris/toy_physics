[1] \frac{\partial}{\partial t} J_{x,\rm brane}{\left(t,x,y,z \right)} + \frac{\partial}{\partial x} \Pi_{xx}{\left(t,x,y,z \right)} + \frac{\partial}{\partial y} \Pi_{xy}{\left(t,x,y,z \right)} + \frac{\partial}{\partial z} \Pi_{xz}{\left(t,x,y,z \right)} = - \frac{\bar{\h}^{2} \left(- \left(\frac{\partial}{\partial x} \bar\psi{\left(t,x,y,z,- W_{\rm proj} \right)} + \frac{i q \operatorname{Ax}{\left(t,x,y,z,- W_{\rm proj} \right)} \bar\psi{\left(t,x,y,z,- W_{\rm proj} \right)}}{\bar{\h}}\right) \psi{\left(t,x,y,z,- W_{\rm proj} \right)} + \left(\frac{\partial}{\partial x} \psi{\left(t,x,y,z,- W_{\rm proj} \right)} - \frac{i q \operatorname{Ax}{\left(t,x,y,z,- W_{\rm proj} \right)} \psi{\left(t,x,y,z,- W_{\rm proj} \right)}}{\bar{\h}}\right) \bar\psi{\left(t,x,y,z,- W_{\rm proj} \right)}\right) \left(- \left(\left. \frac{\partial}{\partial w} \bar\psi{\left(t,x,y,z,w \right)} \right|_{\substack{ w=- W_{\rm proj} }} + \frac{i q \operatorname{Aw}{\left(t,x,y,z,- W_{\rm proj} \right)} \bar\psi{\left(t,x,y,z,- W_{\rm proj} \right)}}{\bar{\h}}\right) \psi{\left(t,x,y,z,- W_{\rm proj} \right)} + \left(\left. \frac{\partial}{\partial w} \psi{\left(t,x,y,z,w \right)} \right|_{\substack{ w=- W_{\rm proj} }} - \frac{i q \operatorname{Aw}{\left(t,x,y,z,- W_{\rm proj} \right)} \psi{\left(t,x,y,z,- W_{\rm proj} \right)}}{\bar{\h}}\right) \bar\psi{\left(t,x,y,z,- W_{\rm proj} \right)}\right) W{\left(- W_{\rm proj} \right)}}{4 m^{2} \bar\psi{\left(t,x,y,z,- W_{\rm proj} \right)} \psi{\left(t,x,y,z,- W_{\rm proj} \right)}} + \frac{\bar{\h}^{2} \left(- \left(\frac{\partial}{\partial W_{\rm proj}} \bar\psi{\left(t,x,y,z,W_{\rm proj} \right)} + \frac{i q \operatorname{Aw}{\left(t,x,y,z,W_{\rm proj} \right)} \bar\psi{\left(t,x,y,z,W_{\rm proj} \right)}}{\bar{\h}}\right) \psi{\left(t,x,y,z,W_{\rm proj} \right)} + \left(\frac{\partial}{\partial W_{\rm proj}} \psi{\left(t,x,y,z,W_{\rm proj} \right)} - \frac{i q \operatorname{Aw}{\left(t,x,y,z,W_{\rm proj} \right)} \psi{\left(t,x,y,z,W_{\rm proj} \right)}}{\bar{\h}}\right) \bar\psi{\left(t,x,y,z,W_{\rm proj} \right)}\right) \left(- \left(\frac{\partial}{\partial x} \bar\psi{\left(t,x,y,z,W_{\rm proj} \right)} + \frac{i q \operatorname{Ax}{\left(t,x,y,z,W_{\rm proj} \right)} \bar\psi{\left(t,x,y,z,W_{\rm proj} \right)}}{\bar{\h}}\right) \psi{\left(t,x,y,z,W_{\rm proj} \right)} + \left(\frac{\partial}{\partial x} \psi{\left(t,x,y,z,W_{\rm proj} \right)} - \frac{i q \operatorname{Ax}{\left(t,x,y,z,W_{\rm proj} \right)} \psi{\left(t,x,y,z,W_{\rm proj} \right)}}{\bar{\h}}\right) \bar\psi{\left(t,x,y,z,W_{\rm proj} \right)}\right) W{\left(W_{\rm proj} \right)}}{4 m^{2} \bar\psi{\left(t,x,y,z,W_{\rm proj} \right)} \psi{\left(t,x,y,z,W_{\rm proj} \right)}} - \int\limits_{- W_{\rm proj}}^{W_{\rm proj}} \frac{\left(5 K \bar\psi^{4}{\left(t,x,y,z,w \right)} \psi^{3}{\left(t,x,y,z,w \right)} \frac{\partial}{\partial x} \psi{\left(t,x,y,z,w \right)} + 5 K \bar\psi^{3}{\left(t,x,y,z,w \right)} \psi^{4}{\left(t,x,y,z,w \right)} \frac{\partial}{\partial x} \bar\psi{\left(t,x,y,z,w \right)} + \frac{\partial}{\partial x} Q{\left(t,x,y,z,w \right)} + \frac{\partial}{\partial x} V_{\rm conf}{\left(x,y,z,w,a,L \right)}\right) W{\left(w \right)} \bar\psi{\left(t,x,y,z,w \right)} \psi{\left(t,x,y,z,w \right)}}{m}\, dw + \int\limits_{- W_{\rm proj}}^{W_{\rm proj}} \frac{q \left(- \frac{i \bar{\h} \left(- \left(\frac{\partial}{\partial w} \bar\psi{\left(t,x,y,z,w \right)} + \frac{i q \operatorname{Aw}{\left(t,x,y,z,w \right)} \bar\psi{\left(t,x,y,z,w \right)}}{\bar{\h}}\right) \psi{\left(t,x,y,z,w \right)} + \left(\frac{\partial}{\partial w} \psi{\left(t,x,y,z,w \right)} - \frac{i q \operatorname{Aw}{\left(t,x,y,z,w \right)} \psi{\left(t,x,y,z,w \right)}}{\bar{\h}}\right) \bar\psi{\left(t,x,y,z,w \right)}\right) \left(\frac{\partial}{\partial x} \operatorname{Aw}{\left(t,x,y,z,w \right)} - \frac{\partial}{\partial w} \operatorname{Ax}{\left(t,x,y,z,w \right)}\right)}{2 m \bar\psi{\left(t,x,y,z,w \right)} \psi{\left(t,x,y,z,w \right)}} - \frac{i \bar{\h} \left(- \left(\frac{\partial}{\partial y} \bar\psi{\left(t,x,y,z,w \right)} + \frac{i q \operatorname{Ay}{\left(t,x,y,z,w \right)} \bar\psi{\left(t,x,y,z,w \right)}}{\bar{\h}}\right) \psi{\left(t,x,y,z,w \right)} + \left(\frac{\partial}{\partial y} \psi{\left(t,x,y,z,w \right)} - \frac{i q \operatorname{Ay}{\left(t,x,y,z,w \right)} \psi{\left(t,x,y,z,w \right)}}{\bar{\h}}\right) \bar\psi{\left(t,x,y,z,w \right)}\right) \left(- \frac{\partial}{\partial y} \operatorname{Ax}{\left(t,x,y,z,w \right)} + \frac{\partial}{\partial x} \operatorname{Ay}{\left(t,x,y,z,w \right)}\right)}{2 m \bar\psi{\left(t,x,y,z,w \right)} \psi{\left(t,x,y,z,w \right)}} - \frac{i \bar{\h} \left(- \left(\frac{\partial}{\partial z} \bar\psi{\left(t,x,y,z,w \right)} + \frac{i q \operatorname{Az}{\left(t,x,y,z,w \right)} \bar\psi{\left(t,x,y,z,w \right)}}{\bar{\h}}\right) \psi{\left(t,x,y,z,w \right)} + \left(\frac{\partial}{\partial z} \psi{\left(t,x,y,z,w \right)} - \frac{i q \operatorname{Az}{\left(t,x,y,z,w \right)} \psi{\left(t,x,y,z,w \right)}}{\bar{\h}}\right) \bar\psi{\left(t,x,y,z,w \right)}\right) \left(- \frac{\partial}{\partial z} \operatorname{Ax}{\left(t,x,y,z,w \right)} + \frac{\partial}{\partial x} \operatorname{Az}{\left(t,x,y,z,w \right)}\right)}{2 m \bar\psi{\left(t,x,y,z,w \right)} \psi{\left(t,x,y,z,w \right)}} - \frac{\partial}{\partial x} A_{0}{\left(t,x,y,z,w \right)} - \frac{\partial}{\partial t} \operatorname{Ax}{\left(t,x,y,z,w \right)}\right) W{\left(w \right)} \bar\psi{\left(t,x,y,z,w \right)} \psi{\left(t,x,y,z,w \right)}}{m}\, dw + \int\limits_{- W_{\rm proj}}^{W_{\rm proj}} \left(- \frac{\bar{\h}^{2} \left(- \left(\frac{\partial}{\partial w} \bar\psi{\left(t,x,y,z,w \right)} + \frac{i q \operatorname{Aw}{\left(t,x,y,z,w \right)} \bar\psi{\left(t,x,y,z,w \right)}}{\bar{\h}}\right) \psi{\left(t,x,y,z,w \right)} + \left(\frac{\partial}{\partial w} \psi{\left(t,x,y,z,w \right)} - \frac{i q \operatorname{Aw}{\left(t,x,y,z,w \right)} \psi{\left(t,x,y,z,w \right)}}{\bar{\h}}\right) \bar\psi{\left(t,x,y,z,w \right)}\right) \left(- \left(\frac{\partial}{\partial x} \bar\psi{\left(t,x,y,z,w \right)} + \frac{i q \operatorname{Ax}{\left(t,x,y,z,w \right)} \bar\psi{\left(t,x,y,z,w \right)}}{\bar{\h}}\right) \psi{\left(t,x,y,z,w \right)} + \left(\frac{\partial}{\partial x} \psi{\left(t,x,y,z,w \right)} - \frac{i q \operatorname{Ax}{\left(t,x,y,z,w \right)} \psi{\left(t,x,y,z,w \right)}}{\bar{\h}}\right) \bar\psi{\left(t,x,y,z,w \right)}\right) \frac{d}{d w} W{\left(w \right)}}{4 m^{2} \bar\psi{\left(t,x,y,z,w \right)} \psi{\left(t,x,y,z,w \right)}}\right)\, dw

