ght)}}{\bar{\h}} - \frac{i q \psi{\left(t,x,y,z,w \right)} \frac{\partial}{\partial x} \operatorname{Ax}{\left(t,x,y,z,w \right)}}{\bar{\h}} - \frac{i q \psi{\left(t,x,y,z,w \right)} \frac{\partial}{\partial y} \operatorname{Ay}{\left(t,x,y,z,w \right)}}{\bar{\h}} - \frac{i q \psi{\left(t,x,y,z,w \right)} \frac{\partial}{\partial z} \operatorname{Az}{\left(t,x,y,z,w \right)}}{\bar{\h}}\right)}{2 m} + \left(\frac{5 K \bar\psi^{4}{\left(t,x,y,z,w \right)} \psi^{4}{\left(t,x,y,z,w \right)}}{4} + V_{\rm conf}{\left(x,y,z,w,a,L \right)}\right) \psi{\left(t,x,y,z,w \right)}
