     1	#!/usr/bin/env python3
     2	from __future__ import annotations
     3	import sympy as sp
     4	
     5	L, a, ell, rho, Tm, hbar, cs, m, pi = sp.symbols('L a ell rho T_m hbar c_s m pi', positive=True, real=True)
     6	Js = 4*sp.pi*a**2*ell/3
     7	Hw = m*cs**2/rho
     8	Theta = Hw*Js
     9	Ks = 3*sp.pi*a**2*hbar**2/(5*m*rho*ell)
    10	gs = Tm*Js
    11	Sigma0 = sp.simplify(L*gs**2/(Ks*Theta))
    12	print('Sigma_0 =', Sigma0)
    13	That = sp.symbols('That', positive=True, real=True)
    14	Sigma0_hat = sp.simplify(Sigma0.subs(Tm, That*hbar*cs/(rho*ell*sp.sqrt(L))))
    15	print('Sigma_0 in terms of That =', Sigma0_hat)
    16	assert sp.simplify(Sigma0_hat - sp.Rational(20,9)*That**2) == 0
    17	

