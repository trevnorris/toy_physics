    10	
    11	Rq_nat = sp.N((1 - rF)**2 / (1 + rF**2), 30)
    12	Ms_nat = sp.N(Pi_star / (1 - Rq_nat * Sq_star), 30)
    13	Mq_nat = sp.N(-Rq_nat * Ms_nat, 30)
    14	
    15	g_minus = sp.N(rF - sp.sqrt(1 + rF**2)/2, 30)
    16	Rq_comp = sp.N((g_minus - rF)**2 / (1 + rF**2), 30)
    17	Ms_comp = sp.N(Pi_star / (1 - Rq_comp * Sq_star), 30)
    18	Mq_comp = sp.N(-Rq_comp * Ms_comp, 30)
    19	
    20	print('r_F1 =', rF)
    21	print('S_q(Pi_*) =', Sq_star)
    22	print('R_q^nat =', Rq_nat)
    23	print('M_s^nat,* =', Ms_nat)
    24	print('M_q^nat,* =', Mq_nat)
    25	print('g_-^F1 =', g_minus)
    26	print('R_q^comp =', Rq_comp)
    27	print('M_s^comp,* =', Ms_comp)
    28	print('M_q^comp,* =', Mq_comp)
    29	print('shell gain fractional shift =', sp.N(Ms_comp/Ms_nat - 1, 20))
    30	print('mixed gain magnitude ratio =', sp.N(abs(Mq_comp)/abs(Mq_nat), 20))
