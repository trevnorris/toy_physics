    49	assert abs(Mq_comp - sp.Float('-0.451485277739090', 20)) < tol_literal, (Mq_comp,)
    50	
    51	# Outlet consistency Pi_* = M_s + M_q * S_q(Pi_*), both branches.
    52	# (Algebraically built in by M_s = Pi_*/(1 - R_q S_q), M_q = -R_q M_s, but
