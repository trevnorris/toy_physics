     1	#!/usr/bin/env python3
     2	from __future__ import annotations
     3	import sympy as sp
     4	
     5	# r_F1 closed form from Stage 121.
     6	rF = sp.N(sp.sqrt(sp.Rational(12,1)/sp.pi**2 * (sp.Rational(37,20))**2 - 1), 30)
     7	# Pi_* and S_q(Pi_*) imported from Stage 134.
