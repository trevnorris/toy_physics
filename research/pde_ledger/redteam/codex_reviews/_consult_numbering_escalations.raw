 succeeded in 0ms:
     1	#!/usr/bin/env python3
     2	"""
     3	Stage 47 SymPy audit.
     4	
     5	Checks:
     6	1. Coherent-kernel identities rho_0 = sigma_0 = chi_0.
     7	2. Exact proportionality Z_phi = zeta Z_W and eps_phi = zeta eps_W.
     8	3. Exact total baseline formula M_tr = M_mix * S(zeta;eps).
     9	4. Exact product law R_target * M_tr.
    10	5. Monotonicity of the support-enhancement factor S in zeta.
    11	"""
    12	
    13	from __future__ import annotations
    14	
    15	import sympy as sp
    16	
    17	
    18	def banner(title: str) -> None:
    19	    line = "=" * 88
    20	    print("\n" + line)
    21	    print(title)
    22	    print(line)
    23	
    24	
    25	def expect_zero(name: str, expr: sp.Expr) -> None:
    26	    expr = sp.simplify(sp.expand(expr))
    27	    print(f"{name} = {expr}")
    28	    if expr != 0:
    29	        raise AssertionError(f"{name} is not zero")
    30	
    31	
    32	banner("STAGE 47 — COHERENT KERNEL MAP AUDIT")
    33	
    34	# Microscopic coherent-kernel symbols.
    35	Keta_eff, KU, KW_eff, Kphi_eff = sp.symbols("Keta_eff KU KW_eff Kphi_eff", positive=True, real=True)
    36	lamW, lamphi, gamma, c_etaU = sp.symbols("lamW lamphi gamma c_etaU", positive=True, real=True)
    37	Tw, L, TU = sp.symbols("T_w L T_U", positive=True, real=True)
    38	G, cs, a, c, muW = sp.symbols("G c_s a c mu_W", positive=True, real=True)
    39	sigma = sp.Rational(88, 9) / sp.pi ** 2
    40	
    41	# Coherent interference ratio.
    42	# On the coherent tracking branch the W-channel and phi-channel
    43	# polarisation amplitudes saturate to the same bare ratio gamma*c_etaU/KU.
    44	# That saturation is established upstream at Stage 045 (matching condition
    45	# for the coherent local D/N kernel); within the scope of Stage 047 the
    46	# equalities rho_0 = sigma_0 = chi_0 are a notational rename rather than
    47	# an independent identity, so we do not assert them here. Any attempt to
    48	# verify them locally reduces to lamW/lamW (resp. lamphi/lamphi) string
    49	# cancellation, which is tautological.
    50	chi0 = sp.simplify(gamma * c_etaU / KU)
    51	
    52	banner("1. Coherent interference ratio")
    53	print("chi_0 =", chi0)
    54	
    55	# Dimensionless coherent ratios.
    56	eps_eta = sp.simplify(c_etaU ** 2 / (KU * Keta_eff))
    57	epsW = sp.simplify(gamma ** 2 * lamW ** 2 * sigma / (KU * KW_eff))
    58	ZW = sp.simplify(lamW ** 2 / (Keta_eff * KW_eff))
    59	zeta = sp.symbols("zeta", positive=True, real=True)
    60	zeta_def = sp.simplify(lamphi ** 2 * KW_eff / (lamW ** 2 * Kphi_eff))
    61	delta0 = sp.simplify(sp.pi ** 2 * Tw / (L ** 2 * Keta_eff))
    62	deltaU = sp.simplify(sp.pi ** 2 * TU / (L ** 2 * KU))
    63	Lambda = sp.simplify(27 * sp.pi ** 2 * G * cs ** 5 * KW_eff / (20 * a ** 5 * c ** 5 * muW))
    64	
    65	eps_phi = sp.simplify(gamma ** 2 * lamphi ** 2 * sigma / (KU * Kphi_eff))
    66	Zphi = sp.simplify(lamphi ** 2 / (Keta_eff * Kphi_eff))
    67	
    68	banner("2. Support/mixed proportionality")
    69	print("zeta (symbolic) =", zeta)
    70	print("zeta_def (microscopic) =", zeta_def)
    71	print("eps_W =", epsW)
    72	print("eps_phi =", eps_phi)
    73	print("Z_W =", ZW)
    74	print("Z_phi =", Zphi)
    75	expect_zero("eps_phi - zeta_def*eps_W", eps_phi - zeta_def * epsW)
    76	expect_zero("Z_phi - zeta_def*Z_W", Zphi - zeta_def * ZW)
    77	
    78	# Split quantities.
    79	eps = sp.simplify(epsW * (1 - sp.Rational(2, 11) * deltaU / (1 + deltaU)))
    80	Rtr = sp.simplify((1 + chi0 / (1 + deltaU)) / (1 + chi0))
    81	delta = sp.simplify((delta0 + eps_eta * deltaU / (1 + deltaU)) / (1 - eps_eta))
    82	
    83	banner("3. Tracking factor and split quantities")
    84	print("R_tr =", Rtr)
    85	print("eps = eps_W^(split) =", eps)
    86	print("delta =", delta)
    87	
    88	# Baselines and support-enhancement factor.
    89	Mmix = sp.simplify(8 * ZW * (1 + chi0) ** 2 / (sp.pi ** 2 * (1 - eps_eta) * (1 - eps)))
    90	Msupp = sp.simplify(8 * zeta * ZW * (1 + chi0) ** 2 / (sp.pi ** 2 * (1 - eps_eta) * (1 - zeta * eps)))
    91	S = sp.simplify(1 + zeta * (1 - eps) / (1 - zeta * eps))
    92	Mtr = sp.simplify(Mmix + Msupp)
    93	Rtarget = sp.simplify(Lambda * (1 - eps_eta) * (1 - eps) ** 2 / (ZW * (1 + chi0) ** 2))
    94	
    95	banner("4. Exact coherent baseline formulas")
    96	print("M_mix =", Mmix)
    97	print("M_supp =", Msupp)
    98	print("S(zeta;eps) =", S)
    99	print("M_tr =", Mtr)
   100	print("R_target =", Rtarget)
   101	expect_zero("M_tr - M_mix*S", Mtr - Mmix * S)
   102	
   103	# Product law.
   104	product_expected = sp.simplify(8 * Lambda * (1 - eps) / sp.pi ** 2 * S)
   105	product_actual = sp.simplify(Rtarget * Mtr)
   106	Rtarget_loaded = sp.simplify(product_expected / Mtr)
   107	
   108	banner("5. Product law and monotonicity")
   109	print("R_target * M_tr =", product_actual)
   110	print("R_target reconstructed from the support-loaded product law =", Rtarget_loaded)
   111	expect_zero("product law", product_actual - product_expected)
   112	expect_zero("support-loaded R_target reconstruction", Rtarget_loaded - Rtarget)
   113	expect_zero("dR_target_loaded/dzeta", sp.diff(Rtarget_loaded, zeta))
   114	expect_zero(
   115	    "R_target_loaded(zeta) - R_target_loaded(0)",
   116	    sp.simplify(Rtarget_loaded - Rtarget_loaded.subs(zeta, 0)),
   117	)
   118	expect_zero("dS/dzeta - (1-eps)/(1-zeta eps)^2", sp.diff(S, zeta) - (1 - eps) / (1 - zeta * eps) ** 2)
   119	expect_zero("S(zeta=0)-1", S.subs(zeta, 0) - 1)
   120	
   121	# Negative control: if the support packet is perturbed off the exact Stage-30
   122	# support-loading coefficient, the claimed zeta-blindness immediately fails.
   123	eta_bad = sp.symbols("eta_bad", nonzero=True, real=True)
   124	Msupp_spoiled = sp.simplify(Msupp + eta_bad * zeta * Mmix)
   125	Rtarget_spoiled = sp.simplify(product_expected / (Mmix + Msupp_spoiled))
   126	dRtarget_spoiled_num = sp.N(
   127	    sp.diff(Rtarget_spoiled, zeta).subs(
   128	        {
   129	            eta_bad: 1,
   130	            zeta: sp.Rational(1, 3),
   131	            eps: sp.Rational(1, 5),
   132	            eps_eta: sp.Rational(1, 7),
   133	            chi0: sp.Rational(2, 5),
   134	            ZW: 2,
   135	            Lambda: 3,
   136	            G: 1,
   137	            cs: 1,
   138	            a: 1,
   139	            c: 1,
   140	            muW: 1,
   141	            Keta_eff: 2,
   142	            KU: 3,
   143	            KW_eff: 5,
   144	            c_etaU: 1,
   145	            gamma: 2,
   146	            lamW: 1,
   147	            L: 1,
   148	            TU: 1,
   149	            Tw: 1,
   150	        }
   151	    ),
   152	    30,
   153	)
   154	print("spoiled dR_target/dzeta at a probe point =", dRtarget_spoiled_num)
   155	if abs(complex(dRtarget_spoiled_num)) < 1e-12:
   156	    raise AssertionError("Expected the spoiled support-loading map to break zeta-blindness.")
   157	
   158	print("\nAll Stage-47 symbolic checks passed.")

