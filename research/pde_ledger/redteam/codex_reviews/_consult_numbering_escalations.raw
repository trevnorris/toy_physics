    53	k2 = FullSimplify[k0*y2Coeff, Assumptions -> $Assumptions];
    54	k4 = FullSimplify[k0*y4Coeff, Assumptions -> $Assumptions];
    55	gamma5 = FullSimplify[(y5Coeff/I)*k0, Assumptions -> $Assumptions];
