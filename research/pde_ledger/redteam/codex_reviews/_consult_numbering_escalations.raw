     1	\section[Stage 030]{Stage 030: Selected-Mode Normalized Response}
     2	\label{stage:030}
     3	
     4	\stagefield{Part / anchor}{Part II; primary anchor \resultanchor{MTDC-T5}.}
     5	\claimstatus{\StatusExactClosure{} inside the selected lower-mode eigenbranch.}
     6	
     7	\stagefield{Purpose}{Stage~030 translates the selected lower eigenvalue and odd coefficient into normalized-response language.  The stage defines the selected static prefactor \(P_{0,-}\), relates it to the Hellmann--Feynman derivative of the eigenvalue, and states the selected quadrupole target.}
     8	
     9	\stagefield{Inputs}{The inputs are the static selected matrix from Stage~029, the lower eigenvalue \(\lambda_-\), the selected eigenvector \(e_-\), and the overlap \(s_-=(v\cdot e_-)^2\).}
    10	
    11	\stagefield{Verification}{SymPy audit: \StageFile{scripts/moving_throat_pde_stage030_selected_mode_normalization_sympy_audit.py}; transcript: \StageFile{scripts/output/moving_throat_pde_stage030_selected_mode_normalization_sympy_audit.txt}.  Mathematica audit: \StageFile{mathematica/moving_throat_pde_stage030_selected_mode_normalization_mathematica_audit.wl}; transcript: \StageFile{mathematica/output/moving_throat_pde_stage030_selected_mode_normalization_mathematica_audit.txt}.}
    12	
    13	\subsection*{Derivation}
    14	
    15	\paragraph{1. Static selected eigenvalue.}
    16	Set
    17	\begin{equation}
    18	\label{eq:app-stage030-AB}
    19	A=K_0-\Xi_0,
    20	\qquad
    21	B=K_1-\Xi_0=A+\Delta K_{\rm ax}.
    22	\end{equation}
    23	Define
    24	\begin{equation}
    25	\delta_\kappa=\kappa_0^2-\kappa_1^2,
    26	\qquad
    27	\Pi_\kappa=\kappa_0^2\kappa_1^2,
    28	\qquad
    29	\sigma=\kappa_0^2+\kappa_1^2.
    30	\end{equation}
    31	The lower eigenvalue is
    32	\begin{equation}
    33	\label{eq:app-stage030-lambda-minus}
    34	\boxed{
    35	\lambda_-=\frac{A+B-\alpha_0\sigma-
    36	\sqrt{(\Delta K_{\rm ax}+\alpha_0\delta_\kappa)^2+4\alpha_0^2\Pi_\kappa}}{2}}.
    37	\end{equation}
    38	Let
    39	\begin{equation}
    40	R_\lambda=\sqrt{(\Delta K_{\rm ax}+\alpha_0\delta_\kappa)^2+4\alpha_0^2\Pi_\kappa}.
    41	\end{equation}
    42	The selected overlap is
    43	\begin{equation}
    44	\label{eq:app-stage030-s-minus}
    45	\boxed{
    46	s_-=(v\cdot e_-)^2
    47	=\frac12\left[
    48	\sigma+\frac{(\Delta K_{\rm ax}+\alpha_0\delta_\kappa)\delta_\kappa+4\alpha_0\Pi_\kappa}{R_\lambda}
    49	\right]}.
    50	\end{equation}
    51	Equivalently, by Hellmann--Feynman,
    52	\begin{equation}
    53	\label{eq:app-stage030-HF}
    54	\boxed{
    55	s_-=-\frac{d\lambda_-}{d\alpha_0}}.
    56	\end{equation}
    57	
    58	\paragraph{2. Normalized selected response.}
    59	Write
    60	\begin{equation}
    61	D_-(\omega)=D_{-0}+D_{-2}\omega^2+D_{-4}\omega^4-iC_{5,-}\omega^5+O(\omega^6),
    62	\qquad
    63	D_{-0}=\lambda_-.
    64	\end{equation}
    65	Then
    66	\begin{equation}
    67	Y_-(\omega)=\frac{D_{-0}}{D_-(\omega)}
    68	=1+u_{2,-}\omega^2+u_{4,-}\omega^4+i\Gamma_{5,-}\omega^5+O(\omega^6),
    69	\end{equation}
    70	with
    71	\begin{equation}
    72	\label{eq:app-stage030-selected-even}
    73	\boxed{u_{2,-}=-\frac{D_{-2}}{D_{-0}},
    74	\qquad
    75	u_{4,-}=\frac{D_{-2}^2-D_{-0}D_{-4}}{D_{-0}^2},
    76	\qquad
    77	\Gamma_{5,-}=\frac{C_{5,-}}{D_{-0}}}.
    78	\end{equation}
    79	The Stage~029 odd coefficient gives
    80	\begin{equation}
    81	\label{eq:app-stage030-Gamma-selected}
    82	\Gamma_{5,-}=\frac{a^5}{27c_s^5}\frac{\beta_0s_-}{\lambda_-}.
    83	\end{equation}
    84	Therefore define
    85	\begin{equation}
    86	\label{eq:app-stage030-P0minus}
    87	\boxed{
    88	P_{0,-}=\frac{\beta_0s_-}{\lambda_-}
    89	=-\beta_0\frac{d\ln\lambda_-}{d\alpha_0}}.
    90	\end{equation}
    91	The selected-branch target is
    92	\begin{equation}
    93	\label{eq:app-stage030-selected-target}
    94	\boxed{
    95	\widehat m_-^{\,2}P_{0,-}=N_Q^{\rm target}}.
    96	\end{equation}
    97	
    98	\stagefield{Output}{Stage~030 outputs the lower eigenvalue \eqref{eq:app-stage030-lambda-minus}, the selected overlap \eqref{eq:app-stage030-s-minus}, the Hellmann--Feynman identity \eqref{eq:app-stage030-HF}, the selected prefactor \eqref{eq:app-stage030-P0minus}, and the target \eqref{eq:app-stage030-selected-target}.}
    99	
   100	\stagefield{Checks}{\begin{verificationchecklist}
   101	\item Differentiating the eigenvalue with respect to \(\alpha_0\) gives \(d\lambda_-/d\alpha_0=-e_-^Tvv^Te_-=-s_-\).
   102	\item Normalizing \(D_-/D_{-0}\) gives the response coefficients as quotients by \(\lambda_-\).
   103	\item The outgoing coefficient contains only \(\beta_0s_-/\lambda_-\), matching the selected projection of Stage~029.
   104	\end{verificationchecklist}}
   105	
   106	\stagefield{Downstream use}{Stage~031 proves that \(P_{0,-}\) is monotone on the stable branch.  Stage~032 replaces the abstract \(\widehat m_-\) by the natural D/N source-map factor.  Stage~034 uses \(\lambda_-\) and \(s_-\) to build the softening-depth normal form.}
   107	
   108	\clearpage
   109	

