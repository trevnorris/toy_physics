    37	K4 = sp.simplify(K0 * Yser.coeff(omega, 4))
    38	Gamma5 = sp.simplify(sp.im(Yser.coeff(omega, 5)) * K0)
    39	
    40	K0_t = sp.simplify(64*G*Omega**5/(45*c**5))
    41	K2_t = sp.simplify(K0_t/(4*Omega**2))
    42	K4_t = sp.simplify(K0_t/(4*Omega**4))
    43	Gamma5_t = sp.simplify(2*G/(5*c**5))
    44	NQ_derived = sp.simplify(K0 / K0_t)
    45	
    46	print('Yhat_Q^ret series =', Yser)
    47	print('K2 =', K2)
    48	print('K4 =', K4)
    49	print('Gamma5 =', Gamma5)
    50	print('NQ =', NQ_derived)
    51	print('K2/K2_target - NQ =', sp.simplify(K2/K2_t - NQ_derived))
    52	print('K4/K4_target - NQ =', sp.simplify(K4/K4_t - NQ_derived))
    53	print('Gamma5/Gamma5_target - chiQ*NQ =', sp.simplify(Gamma5/Gamma5_t - chiQ*NQ_derived))
    54	assert sp.simplify(K2/K2_t - NQ_derived) == 0
    55	assert sp.simplify(K4/K4_t - NQ_derived) == 0
    56	assert sp.simplify(Gamma5/Gamma5_t - chiQ*NQ_derived) == 0
