     5	\claimstatus{\StatusReduced{} / \StatusExactClosure{} for the declared healing-width closure.}
     6	\stagefield{Purpose}{Stage~074 fixes the support scale of Family--1 through a healing-length lock.}
     7	\stagefield{Inputs}{The Family--1 geometry \(L/\ell=37\) and closure \(\ell=\hbar/(2mc_{s,w})\).}
     8	
     9	\stagefield{Verification}{SymPy audit: \StageFile{scripts/moving_throat_pde_stage074_family1_healing_lock_sympy_audit.py}; transcript: \StageFile{scripts/output/moving_throat_pde_stage074_family1_healing_lock_sympy_audit.txt}.  Mathematica audit: \StageFile{mathematica/moving_throat_pde_stage074_family1_healing_lock_mathematica_audit.wl}; transcript: \StageFile{mathematica/output/moving_throat_pde_stage074_family1_healing_lock_mathematica_audit.txt}.}
    10	
    11	\subsection*{Derivation}
    12	
    13	The healing lock is
    14	\begin{equation}
    15	\label{eq:app-stage074-healing}
    16	\boxed{
    17	\ell=\frac{\hbar}{2mc_{s,w}}}.
    18	\end{equation}
    19	Thus
    20	\begin{equation}
    21	\label{eq:app-stage074-chi}
    22	\boxed{
    23	\chi_s=\frac{mc_{s,w}L}{\hbar}=\frac{37}{2}}.
    24	\end{equation}
    25	Using \(\kappa=4\chi_s^2+(4/5)\Lambda_\ell^2\) gives
    26	\begin{equation}
    27	\label{eq:app-stage074-kappa}
    28	\boxed{
    29	\kappa=\frac95\Lambda_\ell^2=\frac{12321}{5},
    30	\qquad
    31	\alpha=\sqrt\kappa=\frac{111}{\sqrt5}}.
    32	\end{equation}
    33	
    34	\stagefield{Output}{Family--1 support values \(\chi_s=37/2\), \(\kappa=12321/5\), \(\eta=37\).}
    35	\stagefield{Downstream use}{Stage~075 evaluates the threshold window at these values.}
    36	

