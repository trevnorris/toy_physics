     1	#!/usr/bin/env python3
     2	"""
     3	Stage 101 SymPy audit: natural source-map reduction (mhat_0 = 1 branch).
     4	
     5	Carry-forward annotations (per [[batch-IV1-paper-alignment]] Cluster B direction
     6	(c)): paper card `\\stagefield{Checks}` items
     7	  (2) "higher odd terms begin beyond the point-particle 2.5PN coefficient"
     8	      — anchored at stage 102 (higher_odd_irrelevance); the omega^7 series
     9	      extension and tauQ-derivative gates verify the first non-(omega^2,
    10	      omega^5) term sits at omega^7, in both engines.
    11	  (3) "outgoing l=2 DtN fingerprint vs normalized z=omega a/c_s expansion"
    12	      — anchored at stage 097 (single_normalization_defect); the chi_Q = 1
    13	      identification by DtN comparison lives there. Notes line 41-51 of this
    14	      stage explicitly attributes the canonical compact branch's chi_Q = 1
    15	      to that upstream stage.
    16	This stage owns Check (1) — the factorization mhat_0^2 chi_Q N_Q = 1 keeping
    17	source, conservative, and outgoing factors separate — verified below via
    18	substantive input-equation anchors.
    19	"""
    20	from __future__ import annotations
    21	import sympy as sp
    22	
    23	mhat0, chiQ, NQ, DeltaQ = sp.symbols('mhat0 chiQ NQ DeltaQ', positive=True, real=True)
    24	
    25	# exact factorized condition
    26	sol_NQ = sp.solve(sp.Eq(mhat0**2 * chiQ * NQ, 1), NQ)[0]
    27	print('NQ from exact factorized odd normalization =', sol_NQ)
    28	print('point-particle natural branch mhat0->1 gives =', sp.simplify(sol_NQ.subs(mhat0, 1)))
    29	print('canonical compact outgoing branch chiQ=1 gives =', sp.simplify(sol_NQ.subs({mhat0:1, chiQ:1})))
    30	
    31	# Anchor the reductions to the INPUT factorization mhat0^2 * chiQ * NQ = 1.
    32	# Substituting the proposed solved NQ on the natural source-map branch must zero the residual.
    33	assert sp.simplify((mhat0**2 * chiQ * NQ - 1).subs({mhat0: 1, NQ: 1/chiQ})) == 0, \
    34	    'point-particle natural branch reduction NQ = 1/chiQ failed against input factorization'
    35	assert sp.simplify((mhat0**2 * chiQ * NQ - 1).subs({mhat0: 1, chiQ: 1, NQ: 1})) == 0, \
    36	    'canonical compact outgoing branch NQ = 1 failed against input factorization'
    37	
    38	expr_delta = sp.simplify((1/(1+DeltaQ)) - 1)
    39	series_delta = sp.expand(sp.series(expr_delta, DeltaQ, 0, 3).removeO())
    40	print('NQ - 1 in terms of DeltaQ =', expr_delta)

