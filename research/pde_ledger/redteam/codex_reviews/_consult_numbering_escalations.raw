     1	#!/usr/bin/env python3
     2	"""
     3	moving_throat_pde_stage182_microscopic_coherent_slippage_sympy_audit.py
     4	
     5	SymPy-backed audit for the microscopic coherent-kernel slippage decomposition.
     6	
     7	Checks:
     8	1. Microscopic log drifts induce the Stage 181 physical variables as stated.
     9	2. The grouped defect Xi_1 collapses to the exact four-slippage law.
    10	3. The selected-branch demand drift R_1 acquires one extra dressing slippage Sigma_eta.
    11	4. The tracking-factor drift Theta_1 factorizes through the single tracking slippage Sigma_tr.
    12	5. Xi_1 admits the exact tracking/nontracking split.
    13	6. Support microscopic drifts do not appear.
    14	"""
    15	
    16	from __future__ import annotations
    17	import sympy as sp
    18	
    19	
    20	def banner(title: str) -> None:
    21	    line = "=" * 88
    22	    print("\n" + line)
    23	    print(title)
    24	    print(line)
    25	
    26	
    27	def expect_zero(name: str, expr: sp.Expr) -> None:
    28	    expr = sp.simplify(sp.expand(expr))
    29	    print(f"{name} = {expr}")
    30	    if expr != 0:
    31	        raise AssertionError(f"{name} is not zero")
    32	
    33	
    34	banner("STAGE 182 — MICROSCOPIC COHERENT-KERNEL SLIPPAGE DECOMPOSITION")
    35	
    36	# Microscopic logarithmic drift coefficients.
    37	lam1, c1, gam1 = sp.symbols('lam1 c1 gam1', real=True)
    38	kU, keta, kW, mu1, tau1 = sp.symbols('kU keta kW mu1 tau1', real=True)
    39	# Support-lane drifts are declared but should drop out identically.
    40	lamphi1, kphi = sp.symbols('lamphi1 kphi', real=True)
    41	
    42	# Background branch variables.
    43	chi0, epsW, eps_eta, deltaU = sp.symbols('chi0 epsW eps_eta deltaU', positive=True, real=True)
    44	
    45	# Stage-30 coherent branch definitions.
    46	zetaZ = 2 * lam1 - keta - kW
    47	omegaW = kW - mu1
    48	chi1 = chi0 * (gam1 + c1 - kU)
    49	eta1 = eps_eta * (2 * c1 - kU - keta)
    50	varepsW = epsW * (2 * gam1 + 2 * lam1 - kU - kW)
    51	deltaU1 = deltaU * (tau1 - kU)
    52	eps = sp.simplify(epsW * (1 - sp.Rational(2, 11) * deltaU / (1 + deltaU)))
    53	eps1 = sp.simplify(
    54	    (1 - sp.Rational(2, 11) * deltaU / (1 + deltaU)) * varepsW
    55	    - (2 * epsW) / (11 * (1 + deltaU) ** 2) * deltaU1
    56	)
    57	
    58	# Microscopic slippages.
    59	SigmaZ = sp.symbols('Sigma_Z', real=True)
    60	SigmaChi = sp.symbols('Sigma_chi', real=True)
    61	SigmaEta = sp.symbols('Sigma_eta', real=True)
    62	SigmaEps = sp.symbols('Sigma_eps', real=True)
    63	SigmaDel = sp.symbols('Sigma_del', real=True)
    64	
    65	slip_subs = {
    66	    SigmaZ: 2 * lam1 + mu1 - keta - 2 * kW,
    67	    SigmaChi: gam1 + c1 - kU,
    68	    SigmaEta: 2 * c1 - kU - keta,
    69	    SigmaEps: 2 * gam1 + 2 * lam1 - kU - kW,
    70	    SigmaDel: tau1 - kU,
    71	}
    72	
    73	banner("Physical branch drifts from microscopic logs")
    74	expect_zero("Sigma_chi = chi_1/chi_0", SigmaChi.subs(slip_subs) - chi1 / chi0)
    75	expect_zero("Sigma_eta = eta_1/eps_eta", SigmaEta.subs(slip_subs) - eta1 / eps_eta)
    76	expect_zero("Sigma_del = delta_U,1/delta_U", SigmaDel.subs(slip_subs) - deltaU1 / deltaU)
    77	expect_zero("Sigma_eps = varepsilon_W/eps_W", SigmaEps.subs(slip_subs) - varepsW / epsW)
    78	expect_zero("Sigma_Z = zeta_Z - omega_W", SigmaZ.subs(slip_subs) - (zetaZ - omegaW))
    79	
    80	banner("Four-slippage grouped-defect law")
    81	Xi1_direct = sp.simplify(
    82	    zetaZ - omegaW + 2 * chi1 / (1 + chi0) + 2 * eps1 / (1 - eps)
    83	)
    84	Xi1_slip = sp.simplify(
    85	    SigmaZ
    86	    + 2 * chi0 / (1 + chi0) * SigmaChi
    87	    + 2 * epsW / (1 - eps) * (
    88	        (11 + 9 * deltaU) / (11 * (1 + deltaU)) * SigmaEps
    89	        - 2 * deltaU / (11 * (1 + deltaU) ** 2) * SigmaDel
    90	    )
    91	)
    92	expect_zero("Xi_1 direct - slippage form", Xi1_direct - Xi1_slip.subs(slip_subs))
    93	print("Xi_1 =")
    94	sp.pprint(Xi1_slip)
    95	
    96	banner("Selected-branch demand slippage")
    97	R1_direct = sp.simplify(-eta1 / (1 - eps_eta) - Xi1_direct)
    98	R1_slip = sp.simplify(-eps_eta / (1 - eps_eta) * SigmaEta - Xi1_slip)
    99	expect_zero("R_1 direct - slippage form", R1_direct - R1_slip.subs(slip_subs))
   100	print("R_1 =")
   101	sp.pprint(R1_slip)
   102	
   103	banner("Tracking-factor factorization")
   104	Theta1_direct = sp.simplify(
   105	    -(chi0 * (1 + chi0) * deltaU1 + deltaU * (1 + deltaU) * chi1)
   106	    / ((1 + chi0) * (1 + deltaU) * (1 + chi0 + deltaU))
   107	)
   108	SigmaTr = sp.symbols('Sigma_tr', real=True)
   109	Theta1_fact = sp.simplify(
   110	    -chi0 * deltaU / ((1 + chi0) * (1 + deltaU) * (1 + chi0 + deltaU)) * SigmaTr

