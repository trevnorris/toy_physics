 succeeded in 0ms:
     1	\section[Stage 088]{Stage 088: Loading-Ratio Extraction from the Minimal Isotropic Quadrupole Module}
     2	\label{stage:088}
     3	
     4	\stagefield{Part / anchor}{Part III; secondary anchor \resultanchor{MTDC-T7}.}
     5	\claimstatus{\StatusExactClosure{} under the natural contact-plus-pole interpretation of the minimal isotropic conservative quadrupole precursor.}
     6	\stagefield{Purpose}{Stage~088 supplies the one missing loading ratio by reading the minimal isotropic conservative quadrupole module as contact plus pole.}
     7	\stagefield{Inputs}{The minimal isotropic conservative precursor \(Y_Q^{\rm cons}=3/4+(1/4)/(1-\omega^2/\Omega_Q^2)\).}
     8	
     9	\stagefield{Verification}{SymPy audit: \StageFile{scripts/moving_throat_pde_stage088_loading_ratio_from_minimal_module_sympy_audit.py}; transcript: \StageFile{scripts/output/moving_throat_pde_stage088_loading_ratio_from_minimal_module_sympy_audit.txt}.  Mathematica audit: \StageFile{mathematica/moving_throat_pde_stage088_loading_ratio_from_minimal_module_mathematica_audit.wl}; transcript: \StageFile{mathematica/output/moving_throat_pde_stage088_loading_ratio_from_minimal_module_mathematica_audit.txt}.}
    10	
    11	\subsection*{Derivation}
    12	
    13	The minimal precursor is
    14	\begin{equation}
    15	\label{eq:app-stage088-YQ}
    16	\boxed{
    17	Y_Q^{\rm cons}(\omega)
    18	=c_0+\frac{c_1}{1-\omega^2/\Omega_Q^2},
    19	\qquad
    20	c_0=\frac34,
    21	\qquad
    22	c_1=\frac14,
    23	\qquad
    24	\Omega_Q=\frac{3c_s}{2a}}.
    25	\end{equation}
    26	The natural contact-plus-pole reading writes
    27	\begin{equation}
    28	\label{eq:app-stage088-contact-pole}
    29	Y_Q^{\rm cons}(\omega)
    30	=\frac{1}{\rho_\alpha}
    31	+\frac{\rho_\alpha-1}{\rho_\alpha}\frac{1}{1-\omega^2/\Omega_Q^2}.
    32	\end{equation}
    33	Matching coefficients gives
    34	\begin{equation}
    35	\label{eq:app-stage088-rho}
    36	\boxed{
    37	\rho_\alpha=\frac{1}{c_0}=\frac43,
    38	\qquad
    39	\zeta_{\rm req}=\frac{c_1}{c_0}=\frac13,
    40	\qquad
    41	\Pi_{\rm tr}=\frac43C_{\rm mix}}.
    42	\end{equation}
    43	This lies in the symmetric-lowest-twin regime:
    44	\begin{equation}
    45	\label{eq:app-stage088-regime}
    46	C_{\rm mix}<\Pi_{\rm tr}<2C_{\rm mix},
    47	\qquad
    48	0<\zeta_{\rm req}=\frac13<1.
    49	\end{equation}
    50	
    51	\stagefield{Output}{The minimal-module ratio \eqref{eq:app-stage088-rho}.}
    52	\stagefield{Downstream use}{Stage~089 compares \(\zeta_{\rm req}=1/3\) against the explicit Family--1 support map.}
    53	

