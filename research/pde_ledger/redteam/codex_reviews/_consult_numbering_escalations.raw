    42	u5Coeff = FullSimplify[I*chiQ*sigmaCan, Assumptions -> $Assumptions];
    43	uSquared4Coeff = FullSimplify[u2Coeff^2, Assumptions -> $Assumptions];
    44	
    45	(* Independent route: expand the pole as 1 + u + u^2 through omega^5, with
