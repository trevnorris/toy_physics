    67	eps = FullSimplify[epsW*(1 - (2/11)*deltaU/(1 + deltaU)), Assumptions -> $Assumptions];
    68	rTr = FullSimplify[(1 + chi0/(1 + deltaU))/(1 + chi0), Assumptions -> $Assumptions];
    69	delta = FullSimplify[(delta0 + epsEta*deltaU/(1 + deltaU))/(1 - epsEta), Assumptions -> $Assumptions];
    70	
    71	Print["R_tr = ", fmt[rTr]];
    72	Print["eps = ", fmt[eps]];
    73	Print["delta = ", fmt[delta]];
    74	
    75	mMix = FullSimplify[8*zW*(1 + chi0)^2/(Pi^2*(1 - epsEta)*(1 - eps)), Assumptions -> $Assumptions];
    76	
    77	(* M_supp from the paper's closed form (notes §4): the support lane
    78	   replaces (1-eps) with (1-zeta*eps) in the denominator and acquires a
    79	   prefactor zeta. We write M_supp from the dimensionless ratios directly
    80	   so the factorization M_tr = M_mix * S below is a non-trivial algebraic
    81	   identity rather than a script-built tautology. *)
    82	mSupp = FullSimplify[8*zeta*zW*(1 + chi0)^2/(Pi^2*(1 - epsEta)*(1 - zeta*eps)),
    83	                     Assumptions -> $Assumptions];
    84	
    85	(* M_tr as the sum of the two independently defined baselines. *)
    86	mTr = FullSimplify[mMix + mSupp, Assumptions -> $Assumptions];
    87	
    88	(* S(zeta;eps) from the closed-form definition (Eq. app-stage047-S). *)
    89	sEnhance = FullSimplify[1 + zeta*(1 - eps)/(1 - zeta*eps),
    90	                        Assumptions -> $Assumptions];
    91	
    92	rTarget = FullSimplify[lambdaScale*(1 - epsEta)*(1 - eps)^2/(zW*(1 + chi0)^2), Assumptions -> $Assumptions];
    93	
    94	Print["M_mix = ", fmt[mMix]];
    95	Print["M_supp = ", fmt[mSupp]];
    96	Print["S(zeta;eps) = ", fmt[sEnhance]];
    97	Print["M_tr = ", fmt[mTr]];
    98	Print["R_target = ", fmt[rTarget]];
    99	expectZero["M_tr - M_mix S", mTr - mMix*sEnhance];
   100	
   101	productExpected = FullSimplify[8*lambdaScale*(1 - eps)/Pi^2*sEnhance, Assumptions -> $Assumptions];
   102	productActual = FullSimplify[rTarget*mTr, Assumptions -> $Assumptions];
   103	loadedRTarget = FullSimplify[productExpected/mTr, Assumptions -> $Assumptions];
   104	Print["R_target M_tr = ", fmt[productActual]];
   105	Print["R_target reconstructed from the support-loaded product law = ", fmt[loadedRTarget]];
   106	expectZero["product law", productActual - productExpected];
   107	expectZero["support-loaded R_target reconstruction", loadedRTarget - rTarget];
   108	expectZero["dR_target_loaded/dzeta", D[loadedRTarget, zeta]];
   109	expectZero[
   110	  "R_target_loaded(zeta) - R_target_loaded(0)",
   111	  FullSimplify[loadedRTarget - (loadedRTarget /. zeta -> 0), Assumptions -> $Assumptions]
   112	];
   113	expectZero["dS/dzeta - (1-eps)/(1-zeta eps)^2", D[sEnhance, zeta] - (1 - eps)/(1 - zeta*eps)^2];
   114	expectZero["S(zeta=0)-1", FullSimplify[sEnhance /. zeta -> 0, Assumptions -> $Assumptions] - 1];
   115	
   116	Print[""];
   117	Print["Stage 047 Mathematica audit passed."];
   118	
   119	Exit[0];

