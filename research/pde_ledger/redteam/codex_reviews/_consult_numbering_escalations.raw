 succeeded in 0ms:
     1	#!/usr/bin/env python3
     2	"""
     3	Stage 097 SymPy audit: the actual isotropic passive/outgoing quadrupole branch
     4	collapses to a single normalization defect.
     5	
     6	Carry-forward annotations (per [[batch-IV1-paper-alignment]] Cluster A
     7	direction (a)): paper card `\\stagefield{Checks}` items
     8	  (i) "static limit eps_2=eps_4=0 returns c_pole=1/4"
     9	  (ii) "l=0 and l=2 orthogonality before applying the geometry firewall"
    10	  (iii) "minimal-module hypothesis on any support/source success statement"
    11	are upstream carry-ins from Part III + IV.1 stages:
    12	  (i)  derives from stage 091 (grouped P2 + static geometry) and stage 092
    13	       (dynamic-geometry obstruction); reduction is asserted explicitly at
    14	       stage 094 (after orthogonality) and stage 096 (verdict).
    15	  (ii) is the full content of stage 094 (15 angular integrals + Laplace
    16	       eigenvalue) in both engines.
    17	  (iii) is anchored by the Part III chain stages 088 / 089 / 090.
    18	This stage uses those upstream outputs without re-deriving them.
    19	"""
    20	from __future__ import annotations
    21	import sympy as sp
    22	
    23	G, c, c_s, a = sp.symbols('G c c_s a', positive=True, real=True)
    24	K0, Omega = sp.symbols('K0 Omega', positive=True, real=True)
    25	
    26	# Actual branch conservative module coefficients.
    27	K2 = sp.simplify(K0 / (4 * Omega**2))
    28	K4 = sp.simplify(K0 / (4 * Omega**4))
    29	Gamma5 = sp.simplify(9 * K2**sp.Rational(5, 2) / K0**sp.Rational(3, 2))
    30	Gamma5_expected = sp.simplify(9 * K0 / (32 * Omega**5))
    31	assert sp.simplify(Gamma5 - Gamma5_expected) == 0
    32	
    33	# GR target normalization.
    34	K0_target = sp.simplify(64 * G * Omega**5 / (45 * c**5))
    35	Omega_geom = sp.simplify(3 * c_s / (2 * a))
    36	K0_target_geom = sp.simplify(K0_target.subs(Omega, Omega_geom))
    37	assert sp.simplify(K0_target_geom - 54 * G * c_s**5 / (5 * a**5 * c**5)) == 0
    38	
    39	K2_target = sp.simplify(K0_target / (4 * Omega**2))
    40	K4_target = sp.simplify(K0_target / (4 * Omega**4))
    41	Gamma5_target = sp.simplify(9 * K2_target**sp.Rational(5, 2) / K0_target**sp.Rational(3, 2))
    42	assert sp.simplify(Gamma5_target - 2 * G / (5 * c**5)) == 0
    43	
    44	# Single normalization defect.
    45	NQ = sp.symbols('N_Q', positive=True, real=True)
    46	subs_actual = {K0: sp.simplify(NQ * K0_target)}
    47	R0 = sp.simplify(K0.subs(subs_actual) / K0_target - 1)
    48	R2 = sp.simplify(K2.subs(subs_actual) / K2_target - 1)
    49	R4 = sp.simplify(K4.subs(subs_actual) / K4_target - 1)
    50	R5 = sp.simplify(Gamma5.subs(subs_actual) / Gamma5_target - 1)
    51	assert sp.simplify(R0 - (NQ - 1)) == 0
    52	assert sp.simplify(R2 - (NQ - 1)) == 0
    53	assert sp.simplify(R4 - (NQ - 1)) == 0
    54	assert sp.simplify(R5 - (NQ - 1)) == 0
    55	
    56	print('K2 =', K2)
    57	print('K4 =', K4)
    58	print('Gamma5 =', Gamma5_expected)
    59	print('K0_target =', K0_target)
    60	print('K0_target (Omega=3 c_s/(2a)) =', K0_target_geom)
    61	print('Gamma5_target =', Gamma5_target)
    62	print('R0 =', sp.factor(R0))
    63	print('R2 =', sp.factor(R2))
    64	print('R4 =', sp.factor(R4))
    65	print('R5 =', sp.factor(R5))
    66	print('\nSTAGE 097 AUDIT PASSED')

