    20	import sympy as sp
    21	
    22	G, c = sp.symbols('G c', positive=True, real=True)
    23	Omega = sp.symbols('Omega', positive=True, real=True)
    24	K0, mhat0 = sp.symbols('K0 mhat0', positive=True, real=True)
