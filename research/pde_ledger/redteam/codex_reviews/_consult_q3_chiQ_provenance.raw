    38	
    39	K2_target = sp.simplify(K0_target / (4 * Omega**2))
    40	K4_target = sp.simplify(K0_target / (4 * Omega**4))
    41	Gamma5_target = sp.simplify(9 * K2_target**sp.Rational(5, 2) / K0_target**sp.Rational(3, 2))
    42	assert sp.simplify(Gamma5_target - 2 * G / (5 * c**5)) == 0
    43	
