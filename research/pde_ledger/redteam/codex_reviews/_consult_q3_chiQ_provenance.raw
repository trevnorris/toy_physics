     1	#!/usr/bin/env python3
     2	"""
     3	Stage 100 SymPy audit: outgoing-normalization factorization mhat_0^2 chi_Q N_Q = 1.
     4	
     5	Carry-forward annotations (per [[batch-IV1-paper-alignment]] Cluster B direction
     6	(c)): paper card `\\stagefield{Checks}` items
     7	  (ii) "higher odd terms begin beyond the point-particle 2.5PN coefficient"
     8	       — verified at stage 102 (higher_odd_irrelevance) via omega^7 series
     9	       extension and the tauQ-derivative gate; this stage's series truncates
    10	       at omega^5 by design.
    11	  (iii) "outgoing l=2 DtN fingerprint against the normalized z=omega a/c_s
    12	       expansion" — the chi_Q = 1 identification by DtN comparison lives at
    13	       stage 097 (single_normalization_defect); this stage carries chi_Q as
    14	       a free real symbol.
    15	This stage owns Check (i) — the `mhat_0^2 chi_Q N_Q = 1` closure — which is
    16	derived below by imposing the observable-side condition `mhat_0^2 * Gamma_5 =
    17	Gamma_5_target` on the script-derived Gamma_5(K_0, chi_Q, Omega).
    18	"""
    19	from __future__ import annotations
    20	import sympy as sp
    21	
    22	G, c = sp.symbols('G c', positive=True, real=True)
    23	Omega = sp.symbols('Omega', positive=True, real=True)
    24	K0, mhat0 = sp.symbols('K0 mhat0', positive=True, real=True)
    25	# chi_Q is a free real parameter at this stage. Its pinning to 1 by the l=2
    26	# DtN fingerprint is upstream (stage 097). Declaring it positive would falsely
    27	# constrain the factorization assertion below.
    28	chiQ = sp.symbols('chiQ', real=True)
    29	NQ = sp.symbols('N_Q', positive=True, real=True)
    30	omega = sp.symbols('omega', real=True)
    31	
    32	sigma_can = sp.Rational(9, 8) / Omega**5
    33	Y = sp.Rational(3,4) + sp.Rational(1,4) / (1 - omega**2/Omega**2 - sp.I*chiQ*sigma_can*omega**5)
    34	Yser = sp.expand(sp.series(Y, omega, 0, 6).removeO())
    35	
    36	K2 = sp.simplify(K0 * Yser.coeff(omega, 2))
    37	K4 = sp.simplify(K0 * Yser.coeff(omega, 4))
    38	Gamma5 = sp.simplify(sp.im(Yser.coeff(omega, 5)) * K0)
    39	
    40	K0_t = sp.simplify(64*G*Omega**5/(45*c**5))
    41	K2_t = sp.simplify(K0_t/(4*Omega**2))
    42	K4_t = sp.simplify(K0_t/(4*Omega**4))
    43	Gamma5_t = sp.simplify(2*G/(5*c**5))
    44	NQ_derived = sp.simplify(K0 / K0_t)
    45	
    46	print('Yhat_Q^ret series =', Yser)
    47	print('K2 =', K2)
    48	print('K4 =', K4)
    49	print('Gamma5 =', Gamma5)
    50	print('NQ =', NQ_derived)
    51	print('K2/K2_target - NQ =', sp.simplify(K2/K2_t - NQ_derived))
    52	print('K4/K4_target - NQ =', sp.simplify(K4/K4_t - NQ_derived))
    53	print('Gamma5/Gamma5_target - chiQ*NQ =', sp.simplify(Gamma5/Gamma5_t - chiQ*NQ_derived))
    54	assert sp.simplify(K2/K2_t - NQ_derived) == 0
    55	assert sp.simplify(K4/K4_t - NQ_derived) == 0
    56	assert sp.simplify(Gamma5/Gamma5_t - chiQ*NQ_derived) == 0
    57	
    58	# Substantive closure: impose the observable-side condition
    59	#   mhat_0^2 * Gamma_5 = Gamma_5_target
    60	# (the point-particle 2.5PN coefficient with source-map factor mhat_0^2 matches
    61	# the GR target). Substituting the script-derived Gamma_5 = chi_Q N_Q Gamma_5_target,
    62	# the residual factorizes as Gamma_5_target * (mhat_0^2 chi_Q N_Q - 1).
    63	# This is non-tautological because if the series derivation of Gamma_5 had a
    64	# wrong factor, the ratio below would not equal (mhat_0^2 chi_Q N_Q - 1).
    65	closure_residual = sp.simplify(mhat0**2 * Gamma5 - Gamma5_t)
    66	closure_ratio = sp.simplify(closure_residual / Gamma5_t)
    67	closure_check = sp.simplify(closure_ratio - (mhat0**2 * chiQ * NQ_derived - 1))
    68	print('closure_residual / Gamma5_target =', closure_ratio)
    69	print('closure_ratio - (mhat0^2 chi_Q N_Q - 1) =', closure_check)
    70	assert closure_check == 0
    71	
    72	# Headline ledger entry: on the closure (mhat_0^2 Gamma_5 = Gamma_5_target),
    73	# the factorization mhat_0^2 chi_Q N_Q = 1 is forced.
    74	print('\nClosure ledger: mhat_0^2 * Gamma_5 = Gamma_5_target  <=>  mhat_0^2 chi_Q N_Q = 1')
    75	print('STAGE 100 AUDIT PASSED')

