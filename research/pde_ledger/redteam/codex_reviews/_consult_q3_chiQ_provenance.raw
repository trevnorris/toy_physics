    53	assert sp.simplify(R4 - (NQ - 1)) == 0
    54	assert sp.simplify(R5 - (NQ - 1)) == 0
    55	
    56	print('K2 =', K2)
    57	print('K4 =', K4)
    58	print('Gamma5 =', Gamma5_expected)
    59	print('K0_target =', K0_target)
    60	print('K0_target (Omega=3 c_s/(2a)) =', K0_target_geom)
    61	print('Gamma5_target =', Gamma5_target)
