    48	R2 = sp.simplify(K2.subs(subs_actual) / K2_target - 1)
    49	R4 = sp.simplify(K4.subs(subs_actual) / K4_target - 1)
    50	R5 = sp.simplify(Gamma5.subs(subs_actual) / Gamma5_target - 1)
