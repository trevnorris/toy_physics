    22	  Print[name, " = ", fmt[res]];
    23	  If[TrueQ[res === 0], pass[name], fail[name, res]];
    24	];
    25	
    26	banner["STAGE 105 — EXACT FIXING OF chi_Q"];
    27	
    28	Clear[aThroat, cSound, omega, chiQ];
    29	$Assumptions =
    30	  Element[{aThroat, cSound, omega, chiQ}, Reals] &&
    31	  aThroat > 0 && cSound > 0 && chiQ > 0;
    32	
    33	(* Independent derivation path: this engine derives chi_Q = 1 via Apart-based
    34	   partial-fraction verification, SeriesCoefficient operator-form extraction,
    35	   and Reduce over the reals, rather than the .py's manual 3/4 + (1/4)/(...)
    36	   decomposition followed by Series/Normal/Coefficient/Solve. *)
    37	
    38	polescl = 3*cSound/(2*aThroat);          (* pole scale (formerly named omegaQ) *)
    39	sigmaQcan = (9/8)/polescl^5;
    40	Print["pole scale = ", fmt[polescl]];
    41	Print["sigma_Q^can = ", fmt[sigmaQcan]];
    42	expectZero["sigma_Q^can - 4 a^5/(27 c_s^5)", sigmaQcan - 4*aThroat^5/(27*cSound^5)];
    43	
    44	(* Retarded module written as a single ratio rather than as a partial-
    45	   fraction decomposition. Apart should recover the canonical
    46	   3/4 + 1/(4 denomRet) form; we assert that. *)
    47	denomRet = 1 - omega^2/polescl^2 - I*chiQ*sigmaQcan*omega^5;
    48	yQretRatio = (4 - 3*omega^2/polescl^2 - 3*I*chiQ*sigmaQcan*omega^5)/(4*denomRet);
    49	expectZero[
    50	  "Y_Q^ret partial-fraction form check (Apart of unfactored ratio)",
    51	  Together[yQretRatio - (3/4 + 1/(4*denomRet))]
    52	];
    53	
    54	(* Coefficient extraction via SeriesCoefficient (operator form), distinct from
    55	   Series/Normal/Coefficient. *)
    56	cRet2 = SeriesCoefficient[yQretRatio, {omega, 0, 2}];
    57	cRet4 = SeriesCoefficient[yQretRatio, {omega, 0, 4}];
    58	cRet5 = SeriesCoefficient[yQretRatio, {omega, 0, 5}];
    59	Print["Y_Q^ret omega^2 coeff = ", fmt[cRet2]];
    60	Print["Y_Q^ret omega^4 coeff = ", fmt[cRet4]];
    61	Print["Y_Q^ret omega^5 coeff = ", fmt[cRet5]];
    62	expectZero["omega^2 coefficient", cRet2 - aThroat^2/(9*cSound^2)];
    63	expectZero["omega^4 coefficient", cRet4 - 4*aThroat^4/(81*cSound^4)];
    64	expectZero["imag omega^5 coefficient", cRet5/I - chiQ*aThroat^5/(27*cSound^5)];
    65	
    66	(* chi_Q identification via Reduce over the reals (not Solve over chi_Q
    67	   alone). The (cRet5/I) is a linear function of chiQ, so Reduce returns
    68	   a single substitution rule. *)
    69	chiReduce = Reduce[cRet5/I == aThroat^5/(27*cSound^5), chiQ, Reals];
    70	chiVal = chiQ /. ToRules[chiReduce];
    71	Print["chi_Q from exact outgoing match (Reduce) = ", fmt[chiVal]];
    72	expectZero["chi_Q - 1", chiVal - 1];
    73	
    74	Clear[z, xiQ];
    75	$Assumptions = Element[{z, xiQ}, Reals];
    76	
    77	(* Deformed-branch coefficients via polynomial inversion of Lambda * Y = -3
    78	   (the operator identity), rather than Y := -3/Lambda. This avoids
    79	   reproducing the .py's division-based normalization. *)
    80	lamDeformed = -3 + z^2/3 + z^4/9 + I*xiQ*z^5/9;
    81	yAnsatz = b0 + b1*z + b2*z^2 + b3*z^3 + b4*z^4 + b5*z^5;
    82	prodTrunc = Normal[Series[lamDeformed*yAnsatz, {z, 0, 5}]] // Expand;
    83	prodCoeffs = CoefficientList[prodTrunc, z];
    84	While[Length[prodCoeffs] < 6, AppendTo[prodCoeffs, 0]];
    85	coeffSys = Thread[(prodCoeffs + Join[{3}, ConstantArray[0, 5]]) == 0];
    86	ySolved = First[Solve[coeffSys, {b0, b1, b2, b3, b4, b5}]];
    87	yDeformedSeries = Expand[yAnsatz /. ySolved];
    88	Print["Deformed DtN normalized branch (polynomial-inverse) = ", fmt[yDeformedSeries]];
    89	expectZero["deformed constant coefficient", (b0 /. ySolved) - 1];
    90	expectZero["deformed z^2 coefficient", (b2 /. ySolved) - 1/9];
    91	expectZero["deformed z^4 coefficient", (b4 /. ySolved) - 4/81];
    92	expectZero["deformed imag z^5 coefficient", (b5 /. ySolved)/I - xiQ/27];
    93	
    94	Print[""];
    95	Print["Stage 105 Mathematica audit passed."];
    96	
    97	Exit[0];

