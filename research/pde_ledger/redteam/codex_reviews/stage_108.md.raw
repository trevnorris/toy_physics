    80	L4g = sp.simplify(sp.expand(Lambda_gen).coeff(z, 4))
    81	L5g = sp.simplify(sp.im(sp.expand(Lambda_gen).coeff(z, 5)))
    82	m2g = sp.simplify(-L2g/L0g)
