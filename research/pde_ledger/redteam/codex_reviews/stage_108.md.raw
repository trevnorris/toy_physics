     1	#!/usr/bin/env python3
     2	from __future__ import annotations
     3	import sympy as sp
     4	
     5	
     6	def banner(title: str) -> None:
     7	    line = '=' * 88
     8	    print('\n' + line)
     9	    print(title)
    10	    print(line)
    11	
    12	
    13	def expect_zero(name: str, expr: sp.Expr) -> None:
    14	    expr = sp.simplify(sp.expand(expr))
    15	    print(f"{name} = {expr}")
    16	    if expr != 0:
    17	        raise AssertionError(f"{name} is not zero")
    18	
    19	
    20	z = sp.symbols('z', real=True)
    21	S, beta = sp.symbols('S beta', nonzero=True, real=True)
    22	Sigma0, Sigma2, Sigma4, Sigma5 = sp.symbols('Sigma0 Sigma2 Sigma4 Sigma5', real=True)
    23	I = sp.I
    24	
    25	banner('STAGE 108 — ROBUSTNESS CLASSES FOR chi_Q')
    26	
    27	Lambda_out = -3 + z**2/sp.Integer(3) + z**4/sp.Integer(9) + I*z**5/sp.Integer(9)
    28	
    29	# Class A: pure scale
    30	Y_scale = sp.series((-3*S)/(S*Lambda_out), z, 0, 6).removeO()
    31	Y_can = sp.series((-3)/Lambda_out, z, 0, 6).removeO()
    32	expect_zero('pure scale invariance', Y_scale - Y_can)
    33	
    34	# Class B: pure scale+argument
    35	Y_arg = sp.series((-3*S)/(S*Lambda_out.subs(z, beta*z)), z, 0, 6).removeO()
    36	print('Y_scale+arg(z) =', sp.expand(Y_arg))
    37	m2_arg = sp.expand(Y_arg).coeff(z, 2)
    38	m4_arg = sp.expand(Y_arg).coeff(z, 4)
    39	chi_arg = sp.simplify(sp.im(sp.expand(Y_arg).coeff(z, 5)) / sp.Rational(1, 27))
    40	print('m2_arg =', m2_arg)
    41	print('m4_arg =', m4_arg)
    42	print('chi_arg =', chi_arg)
    43	
    44	sol_beta = sp.solve([sp.Eq(m2_arg, sp.Rational(1, 9)), sp.Eq(m4_arg, sp.Rational(4, 81))], [beta], dict=True)
    45	print('solutions preserving canonical even fingerprint =', sol_beta)
    46	if {sol[beta] for sol in sol_beta} != {sp.Integer(-1), sp.Integer(1)}:
    47	    raise AssertionError('Expected the two algebraic roots beta=±1.')
    48	expect_zero('chi_arg(beta=1) - 1', chi_arg.subs(beta, 1) - 1)
    49	
    50	# Class C: additive core, beta=1
    51	Lambda_add = sp.expand(S*Lambda_out + Sigma0 + Sigma2*z**2 + Sigma4*z**4 + I*Sigma5*z**5)
    52	L0 = sp.simplify(Lambda_add.subs(z, 0))
    53	L2 = sp.simplify(sp.expand(Lambda_add).coeff(z, 2))
    54	L4 = sp.simplify(sp.expand(Lambda_add).coeff(z, 4))
    55	L5 = sp.simplify(sp.im(sp.expand(Lambda_add).coeff(z, 5)))
    56	m2 = sp.simplify(-L2/L0)
    57	m4 = sp.simplify(L2**2/L0**2 - L4/L0)
    58	sol = sp.solve([sp.Eq(m2, sp.Rational(1, 9)), sp.Eq(m4, sp.Rational(4, 81))], [Sigma2, Sigma4], dict=True)
    59	if len(sol) != 1:
    60	    raise AssertionError('Expected unique additive even-match solution.')
    61	sol = sol[0]
    62	print('Sigma2(beta=1) =', sp.simplify(sol[Sigma2]))
    63	print('Sigma4(beta=1) =', sp.simplify(sol[Sigma4]))
    64	chi_add = sp.simplify((-(L5/L0)).subs(sol) / sp.Rational(1, 27))
