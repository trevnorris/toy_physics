    55	defectCoeff = FullSimplify[Coefficient[chiSeries, eps, 1], Assumptions -> $Assumptions];
    56	Print["first-order defect coefficient = ", fmt[defectCoeff]];
    57	expectZero["overall scale cancels", D[defectCoeff, s]];
    58	
    59	(* Preservation condition: solve chiSeries == 1 directly for a5. *)
    60	a5Pres = FullSimplify[a5 /. First[Solve[chiSeries - 1 == 0, a5, Reals]], Assumptions -> $Assumptions];
    61	Print["a5 preservation condition = ", fmt[a5Pres]];
    62	expectZero["a5 preservation condition + 5 b/9 + a0/27", a5Pres + 5*b/9 + a0/27];
    63	expectZero["preservation substitution", (chiSeries - 1) /. a5 -> a5Pres];
    64	
    65	Print[""];
    66	Print["Stage 109 Mathematica audit passed."];
    67	
    68	Exit[0];

