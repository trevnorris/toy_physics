     1	#!/usr/bin/env python3
     2	"""Stage 109 SymPy audit — linearized branch-selection law.
     3	
     4	Paper card's secondary `Checks` items (Robin and standalone mixed-pole limits;
     5	even-coefficient preservation under the compensated branch) are exercised at
     6	downstream stages: stage 110 (Robin outlet model), stage 111 (mixed side-channel
     7	pole), stage 112 (hybrid Robin+mixed compensation, which verifies the
     8	compensated branch's even-coefficient preservation alongside the odd-norm
     9	match). This stage establishes the linearized framework that those downstream
    10	verifications consume.
    11	"""
    12	from __future__ import annotations
    13	import sympy as sp
    14	
    15	
    16	def banner(title: str) -> None:
    17	    line = '=' * 88
    18	    print('\n' + line)
    19	    print(title)
    20	    print(line)
    21	
    22	
    23	def expect_zero(name: str, expr: sp.Expr) -> None:
    24	    expr = sp.simplify(sp.expand(expr))
    25	    print(f"{name} = {expr}")
    26	    if expr != 0:
    27	        raise AssertionError(f"{name} is not zero")
    28	
    29	
    30	eps = sp.symbols('eps', real=True)
    31	s, b, a0, a5 = sp.symbols('s b a0 a5', real=True)
    32	
    33	banner('STAGE 109 — LINEARIZED BRANCH-SELECTION LAW')
    34	
    35	S = 1 + eps*s
    36	beta = 1 + eps*b
    37	Sigma0 = eps*a0
    38	Sigma5 = eps*a5
    39	chi = sp.simplify(3*(S*beta**5 + 9*Sigma5)/(3*S - Sigma0))
    40	chi_series = sp.series(chi, eps, 0, 2).removeO()
    41	print('chi_Q series =', sp.expand(chi_series))
    42	
    43	expected = 1 + eps*(5*b + a0/sp.Integer(3) + 9*a5)
    44	expect_zero('linearized chi law', chi_series - expected)
    45	
    46	coeff = sp.expand((chi_series - 1)/eps)
    47	print('first-order defect coefficient =', coeff)
    48	expect_zero('overall scale cancels', sp.diff(coeff, s))
    49	
    50	# Linearized preservation condition.
    51	a5_sol = sp.solve(sp.Eq(coeff, 0), a5)[0]
    52	print('a5 preservation condition =', sp.simplify(a5_sol))
    53	expected_a5_sol = -sp.Rational(5, 9)*b - sp.Rational(1, 27)*a0
    54	expect_zero('a5 preservation closed-form', sp.simplify(a5_sol - expected_a5_sol))
    55	expect_zero('preservation substitution', coeff.subs(a5, a5_sol))

