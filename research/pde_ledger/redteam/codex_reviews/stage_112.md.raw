    21	
    22	# Stage 104 canonical outgoing DtN branch carried into the hybrid solve.
    23	Lambda_out = -3 + z**2/sp.Integer(3) + z**4/sp.Integer(9) + I*z**5/sp.Integer(9)
    24	Lambda_hyb = sp.expand(sp.series(Lambda_out + rho - sigma/(1 - kappa*z**2 - I*gamma*z**5), z, 0, 6).removeO())
    25	
    26	L0 = sp.simplify(Lambda_hyb.coeff(z, 0))
    27	L2 = sp.simplify(Lambda_hyb.coeff(z, 2))
    28	L4 = sp.simplify(Lambda_hyb.coeff(z, 4))
    29	L5 = sp.simplify(Lambda_hyb.coeff(z, 5) / I)
    30	
    31	sols = sp.solve([
    32	    sp.Eq(-L2/L0, sp.Rational(1, 9)),
    33	    sp.Eq(L2**2/L0**2 - L4/L0, sp.Rational(4, 81))
    34	], [rho, kappa], dict=True)
    35	
    36	print('Lambda_hyb(z) =', Lambda_hyb)
    37	print('canonical-even solutions =', sols)
    38	assert sols == [{kappa: 0, rho: sigma}, {kappa: sp.Rational(1, 3), rho: 4*sigma}]
    39	
    40	# Branch A
    41	chi_A = sp.simplify(((-L5/L0) / sp.Rational(1, 27)).subs(sols[0]))
    42	print('chi_Q branch A =', chi_A)
    43	assert sp.simplify(chi_A - (1 - 9*sigma*gamma)) == 0
    44	
    45	# Branch B
    46	chi_B = sp.simplify(((-L5/L0) / sp.Rational(1, 27)).subs(sols[1]))
    47	print('chi_Q branch B =', chi_B)
    48	assert sp.simplify(chi_B - (1 - 9*sigma*gamma)/(1 - sigma)) == 0
    49	assert sp.simplify(chi_B.subs(gamma, sp.Rational(1, 9)) - 1) == 0
    50	
    51	scaled_identity = sp.expand((Lambda_hyb.subs(sols[1]) - (1 - sigma)*Lambda_out).subs(gamma, sp.Rational(1, 9)))
    52	print('scaled identity on branch B =', scaled_identity)
    53	assert sp.simplify(scaled_identity) == 0
    54	print('stage112: PASS')

