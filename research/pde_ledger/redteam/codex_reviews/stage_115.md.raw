    33	rC = FullSimplify[lam^2/(kS*kQ), Assumptions -> $Assumptions];
    34	rhoC = FullSimplify[gS^2/kS, Assumptions -> $Assumptions];
    35	sigmaC = FullSimplify[(kS*gQ - lam*gS)^2/(kS^2*kQ*(1 + rC)), Assumptions -> $Assumptions];
    36	
    37	balanceEq = Expand[rhoC - 4*sigmaC];
    38	Print["rho_c - 4 sigma_c = ", fmt[Factor[balanceEq]]];
    39	
    40	gQSolutions = Solve[balanceEq == 0, gQ, Reals];
    41	If[Length[gQSolutions] =!= 2, fail["expected two coupling-balance branches", gQSolutions]];
    42	Print["Exact coupling-balance solutions for g_q = ", fmt[gQ /. gQSolutions]];
    43	
    44	gQBranch = FullSimplify[gQ /. First[gQSolutions], Assumptions -> $Assumptions];
    45	sigmaStar = FullSimplify[gS^2/(4*kS), Assumptions -> $Assumptions];
    46	expectZero["sigma_c on balance surface", (sigmaC /. gQ -> gQBranch) - sigmaStar];
    47	
    48	(* Independent derivation: parent-overlap reparametrization (Part-IV appendix
    49	   eqs eq:app-part04-r-g-parent-ratios and eq:app-part04-parent-compensation-family). *)
    50	frakR = lam/Sqrt[kS*kQ];
    51	frakG = gQ*Sqrt[kS]/(gS*Sqrt[kQ]);
    52	parentFamilyResidual = 1 + frakR^2 - 4*(frakG - frakR)^2;
    53	expectZero[
    54	  "independent: parent family identical balance equation",
    55	  FullSimplify[
    56	    parentFamilyResidual - balanceEq*(kS*kQ + lam^2)/(gS^2*kQ),
    57	    Assumptions -> $Assumptions
    58	  ]
    59	];
    60	(* Solve the parent family for a fresh variable, then translate back. *)
    61	Clear[gVar];
    62	parentResidualGen = 1 + frakR^2 - 4*(gVar - frakR)^2;
    63	frakGRoots = gVar /. Solve[parentResidualGen == 0, gVar];
    64	If[Length[frakGRoots] =!= 2,
    65	  fail["expected two parent-family roots", frakGRoots]];
    66	Print["Parent-family roots for frakG = ", fmt[frakGRoots]];
    67	frakGMinus = FullSimplify[frakR - Sqrt[1 + frakR^2]/2,
    68	  Assumptions -> $Assumptions];
    69	expectZero[
    70	  "independent: frakG_- root matches Solve output",
    71	  FullSimplify[(frakGRoots[[1]]) - frakGMinus,
    72	    Assumptions -> $Assumptions] *
    73	  FullSimplify[(frakGRoots[[2]]) - frakGMinus,
    74	    Assumptions -> $Assumptions]
    75	];
    76	gQFromFrakMinus = FullSimplify[
    77	  frakGMinus*gS*Sqrt[kQ]/Sqrt[kS],
    78	  Assumptions -> $Assumptions
    79	];
    80	expectZero[
    81	  "independent: sigma_c = sigma_* via parent reparametrization",
    82	  FullSimplify[
    83	    (sigmaC /. gQ -> gQFromFrakMinus) - sigmaStar,
    84	    Assumptions -> $Assumptions
    85	  ]
    86	];
    87	
    88	kappa0Can = FullSimplify[(1 + rC)/3, Assumptions -> $Assumptions];
    89	gamma0Can = FullSimplify[(1 + rC)/9, Assumptions -> $Assumptions];
    90	
    91	deltaCore = FullSimplify[
    92	  (rhoC - sigmaC/(1 - (kappa0/(1 + rC))*z^2 - I*(gamma0/(1 + rC))*z^5)) /.
    93	    {gQ -> gQBranch, kappa0 -> kappa0Can, gamma0 -> gamma0Can},
    94	  Assumptions -> $Assumptions
    95	];
    96	targetDelta = FullSimplify[4*sigmaStar - sigmaStar/(1 - z^2/3 - I*z^5/9), Assumptions -> $Assumptions];
    97	expectZero["exact collapse to compensated branch", deltaCore - targetDelta];
    98	
    99	lambdaOut = -3 + z^2/3 + z^4/9 + I*z^5/9;
   100	lambdaEff = Expand[Normal[Series[lambdaOut + targetDelta, {z, 0, 5}]]];
   101	yEff = FullSimplify[(lambdaEff /. z -> 0)/lambdaEff, Assumptions -> $Assumptions];
   102	yTarget = 1 + z^2/9 + 4*z^4/81 + I*z^5/27;
   103	expectZero["normalized outgoing fingerprint preserved", Expand[Normal[Series[yEff, {z, 0, 5}]]] - yTarget];
   104	
   105	Print[""];
   106	Print["Derived branch data:"];
   107	Print["sigma_* = ", fmt[sigmaStar]];
   108	Print["kappa0  = ", fmt[kappa0Can]];
   109	Print["gamma0  = ", fmt[gamma0Can]];
   110	
   111	Print[""];
   112	Print["Stage 115 Mathematica audit passed."];
   113	
   114	Exit[0];

