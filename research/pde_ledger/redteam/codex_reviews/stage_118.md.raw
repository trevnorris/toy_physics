    28	t = sp.symbols("t", real=True)
    29	# Use t = tanh(y), dt = sech(y)^2 dy, to avoid special-function ambiguity.
    30	I_f = sp.simplify(sp.integrate((sp.Rational(1,4))*(1 - t**2), (t, -1, 1)))
    31	I_g = sp.simplify(sp.integrate(t**2*(1 - t**2), (t, -1, 1)))
