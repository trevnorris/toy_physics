    58	banner("IV. Explicit traction law")
    59	
    60	Zq, mu0, c_s, Tm, J_s = sp.symbols("Zq mu0 c_s Tm J_s", positive=True, real=True)
    61	Kq = Zq*sp.pi**2*c_s**2/(4*mu0*L_W**2)
    62	gq = Zq*sp.pi/(sp.sqrt(2)*mu0*L_W**sp.Rational(3,2))
