     1	#!/usr/bin/env python3
     2	"""
     3	moving_throat_pde_stage119_parent_balance_sympy_audit.py
     4	
     5	SymPy audit for the one-parameter parent compensation family.
     6	"""
     7	
     8	from __future__ import annotations
     9	import sympy as sp
    10	
    11	def banner(title: str) -> None:
    12	    line = "=" * 88
    13	    print("\n" + line)
    14	    print(title)
    15	    print(line)
    16	
    17	def expect_zero(name: str, expr) -> None:
    18	    expr = sp.simplify(sp.expand(expr))
    19	    print(f"{name} = {expr}")
    20	    if expr != 0:
    21	        raise AssertionError(f"{name} is not zero")
    22	
    23	banner("I. Dimensionless reduction of the compensation law")
    24	
    25	K_s, K_q, lam, g_s, g_q = sp.symbols("K_s K_q lam g_s g_q", positive=True, real=True)
    26	rhat, ghat = sp.symbols("rhat ghat", real=True)
    27	
    28	law = sp.expand(g_s**2*(K_s*K_q + lam**2) - 4*(K_s*g_q - lam*g_s)**2)
    29	law_red = sp.simplify(
    30	    law.subs({
    31	        lam: rhat*sp.sqrt(K_s*K_q),
    32	        g_q: ghat*g_s*sp.sqrt(K_q)/sp.sqrt(K_s)
    33	    }) / (g_s**2*K_s*K_q)
    34	)
    35	print("Reduced law =", law_red)
    36	expect_zero("dimensionless law", law_red - (1 + rhat**2 - 4*(ghat-rhat)**2))
    37	
    38	banner("II. Exact solution for the mouth-coupling ratio")
    39	
    40	ghat_sol = sp.solve(sp.Eq(1 + rhat**2, 4*(ghat-rhat)**2), ghat)
    41	print("ghat solutions =", ghat_sol)
    42	expect_zero("positive branch check", 1 + rhat**2 - 4*(ghat_sol[0]-rhat)**2)
    43	expect_zero("negative branch check", 1 + rhat**2 - 4*(ghat_sol[1]-rhat)**2)
    44	
    45	banner("III. D/N-tube length in terms of the same normalized hybridization")
    46	
    47	a = sp.symbols("a", positive=True, real=True)
    48	L_W, rc = sp.symbols("L_W rc", positive=True, real=True)
    49	kappa0 = 4*L_W**2/(sp.pi**2*a**2)
