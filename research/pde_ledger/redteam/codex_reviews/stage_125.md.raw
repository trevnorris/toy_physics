    20	    print(f"{name} = {expr}")
    21	    if expr != 0:
    22	        raise AssertionError(f"{name} is not zero")
    23	
    24	
    25	def expect_true(name: str, cond: bool) -> None:
    26	    print(f"{name} = {cond}")
    27	    if not cond:
    28	        raise AssertionError(f"{name} is false")
    29	
