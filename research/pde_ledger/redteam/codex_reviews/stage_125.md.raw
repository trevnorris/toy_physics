   189	R = sp.sqrt(4107 - 100 * sp.pi**2)
   190	gminus = sp.simplify((2 * R - 37 * sp.sqrt(3)) / (20 * sp.pi))
   191	gplus = sp.simplify((2 * R + 37 * sp.sqrt(3)) / (20 * sp.pi))
