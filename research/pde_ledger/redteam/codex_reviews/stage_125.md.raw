    31	banner("STAGE 125 — POSITIVE LOCAL MOUTH-SOURCE THEOREM")
    32	
    33	z, L = sp.symbols("z L", positive=True, real=True)
    34	x = sp.symbols("x", real=True)
    35	k = sp.pi / (2 * L)
    36	kernel = sp.cos(sp.pi * x / 2)
    37	
    38	print("D/N half-wave derivative factor:")
    39	print("cos(k z) with k = pi/(2L) =", sp.cos(k * z))
    40	
    41	kernel_min = sp.calculus.util.minimum(kernel, x, sp.Interval(0, 1))
    42	kernel_max = sp.calculus.util.maximum(kernel, x, sp.Interval(0, 1))
    43	expect_zero("kernel minimum on [0,1]", kernel_min)
    44	expect_zero("kernel maximum on [0,1] - 1", kernel_max - 1)
    45	
    46	print("\nBecause the normalized kernel lies in [0,1] on x in [0,1],")
    47	print("every positive normalized source law has its cosine moment in [0,1].")
    48	
    49	r = sp.simplify(sp.sqrt(sp.Rational(12, 1) * sp.Rational(37, 20) ** 2 / sp.pi**2 - 1))
    50	R = sp.sqrt(4107 - 100 * sp.pi**2)
    51	gminus = sp.simplify((2 * R - 37 * sp.sqrt(3)) / (20 * sp.pi))
    52	gplus = sp.simplify((2 * R + 37 * sp.sqrt(3)) / (20 * sp.pi))
    53	
    54	expect_zero("r - sqrt(4107 - 100 pi^2)/(10 pi)", r - R / (10 * sp.pi))
    55	expect_zero("lower branch balance relation", 1 + r**2 - 4 * (gminus - r) ** 2)
    56	expect_zero("upper branch balance relation", 1 + r**2 - 4 * (gplus - r) ** 2)
