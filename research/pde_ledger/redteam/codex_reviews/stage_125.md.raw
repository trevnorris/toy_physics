    10	
    11	def banner(title: str) -> None:
    12	    line = "=" * 88
    13	    print("\n" + line)
    14	    print(title)
    15	    print(line)
    16	
    17	
    18	def expect_zero(name: str, expr: sp.Expr) -> None:
