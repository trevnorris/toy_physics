    19	
    20	print("sigma_match normalization =", norm_match)
    21	print("g_match =", g_match)
    22	if sp.simplify(norm_match - 1) != 0 or sp.simplify(g_match - sp.pi/4) != 0:
    23	    raise AssertionError("Self-matched profile formulas failed.")
    24	
    25	R = sp.sqrt(4107 - 100*sp.pi**2)
    26	gminus = sp.simplify((2*R - 37*sp.sqrt(3))/(20*sp.pi))
    27	delta_g = sp.simplify(sp.pi/4 - gminus)
    28	traction_ratio = sp.simplify((sp.pi/4)/gminus)
    29	
    30	print("\ng_-^F1 =", gminus)
    31	print("delta_g_match =", delta_g)
    32	print("T_- / T_match =", traction_ratio)
    33	print("g_match numeric =", sp.N(sp.pi/4, 20))
    34	print("g_- numeric     =", sp.N(gminus, 20))
    35	print("traction ratio  =", sp.N(traction_ratio, 20))
    36	
    37	# Convex positive family
    38	xi = sp.symbols('xi', real=True)
    39	sigma_xi = (1-xi)*k*sp.cos(k*z) + xi/L
    40	norm_xi = sp.simplify(sp.integrate(sigma_xi, (z, 0, L)))
    41	g_xi = sp.simplify(sp.integrate(sigma_xi*sp.cos(k*z), (z, 0, L)))
    42	
    43	print("\nsigma_xi normalization =", norm_xi)
    44	print("g_xi =", g_xi)
    45	if sp.simplify(norm_xi - 1) != 0:
    46	    raise AssertionError("Convex family normalization failed.")
    47	
    48	# Positivity: sigma_xi(z) >= 0 on z in [0, L], xi in [0, 1].
    49	# Decomposition: sigma_xi = (1 - xi)*k*cos(k*z) + xi/L. Each term is >= 0 on
    50	# the stated domain (cos(k*z) >= 0 since k*z in [0, pi/2]; xi/L > 0 for xi >= 0).
    51	min_match = sp.calculus.util.minimum(k*sp.cos(k*z), z, sp.Interval(0, L))
    52	print("min sigma_match on [0,L] =", min_match)
    53	if sp.simplify(min_match) != 0:
    54	    raise AssertionError("sigma_match minimum on [0,L] should be 0 (at z=L).")
    55	min_xi0 = sp.calculus.util.minimum(sigma_xi.subs(xi, 0), z, sp.Interval(0, L))
    56	val_xi1 = sp.simplify(sigma_xi.subs(xi, 1))
    57	print("min sigma_xi(xi=0) on [0,L] =", min_xi0)
    58	print("sigma_xi(xi=1) =", val_xi1)
    59	if sp.simplify(min_xi0) != 0:
    60	    raise AssertionError("sigma_xi(xi=0) minimum on [0,L] should be 0.")
    61	if sp.simplify(val_xi1 - 1/L) != 0:
    62	    raise AssertionError("sigma_xi(xi=1) should equal 1/L.")
    63	sigma_corner = sp.simplify(sigma_xi.subs([(z, L), (xi, 0)]))
    64	print("sigma_xi(z=L, xi=0) =", sigma_corner)
    65	if sp.simplify(sigma_corner) != 0:
    66	    raise AssertionError("sigma_xi(z=L, xi=0) should equal 0.")
    67	
    68	xi_star = sp.simplify(sp.solve(sp.Eq(g_xi, gminus), xi)[0])
    69	print("xi_* =", xi_star)
    70	print("xi_* numeric =", sp.N(xi_star, 20))
    71	
    72	g_xi_star = sp.simplify(g_xi.subs(xi, xi_star) - gminus)
    73	print("g_xi(xi_*) - g_- =", g_xi_star)
    74	if sp.simplify(g_xi_star) != 0:
    75	    raise AssertionError("Exact convex-family compensation failed.")
    76	
    77	# Interval check
    78	print("\n2/pi numeric =", sp.N(2/sp.pi, 20))
    79	print("pi/4 numeric =", sp.N(sp.pi/4, 20))
    80	interval_check = bool(sp.N(2/sp.pi) < sp.N(gminus) < sp.N(sp.pi/4))
    81	print("Check 2/pi < g_- < pi/4 ->", interval_check)
    82	if not interval_check:
    83	    raise AssertionError("g_-^F1 does not lie strictly between 2/pi and pi/4.")

