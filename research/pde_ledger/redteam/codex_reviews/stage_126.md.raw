   105	(* Positivity: sigma_xi(z) >= 0 on z in [0, lM], xi in [0, 1]. *)
   106	(* Each summand of sigma_xi is nonnegative on the stated domain. *)
   107	minMatch = FullSimplify[Minimize[{k*Cos[k*z], 0 <= z <= lM}, z][[1]],
   108	  Assumptions -> $Assumptions];
   109	Print["min sigma_match on [0,lM] = ", fmt[minMatch]];
   110	expectZero["sigma_match positivity (min = 0)", minMatch];
   111	minXiAt0 = FullSimplify[Minimize[{sigmaXi /. xi -> 0, 0 <= z <= lM}, z][[1]],
   112	  Assumptions -> $Assumptions];
   113	Print["min sigma_xi(xi=0) on [0,lM] = ", fmt[minXiAt0]];
   114	expectZero["sigma_xi(xi=0) positivity (min = 0)", minXiAt0];
   115	valXiAt1 = FullSimplify[sigmaXi /. xi -> 1, Assumptions -> $Assumptions];
   116	Print["sigma_xi(xi=1) = ", fmt[valXiAt1]];
   117	expectZero["sigma_xi(xi=1) = 1/lM", valXiAt1 - 1/lM];
   118	cornerVal = FullSimplify[sigmaXi /. {z -> lM, xi -> 0}, Assumptions -> $Assumptions];
   119	Print["sigma_xi(z=lM, xi=0) = ", fmt[cornerVal]];
   120	expectZero["sigma_xi corner (z=lM, xi=0) = 0", cornerVal];
   121	```
   122	
   123	**Claim manifest:**
   124	- M1: `min_{z in [0,L]} sigma_match(z) = 0` (attained at `z = L`, since `cos(pi/2) = 0`).
   125	- M2: `min_{z in [0,L]} sigma_xi(z; xi=0) = 0` (reduces to M1).
   126	- M3: `sigma_xi(z; xi=1) = 1/L` (constant, strictly positive).
   127	- M4: `sigma_xi(z=L, xi=0) = 0` (corner check confirming the joint minimum candidate).
   128	
   129	Together these establish `sigma_xi >= 0` on `[0,L] x [0,1]` (the interior of `xi` is a convex combination of nonnegative pieces, so the joint minimum lies on the boundary `xi in {0,1}`).
   130	
   131	**Verification command:**
   132	After Codex applies, the verifier will run `redteam exec-sympy 126` and `redteam exec-mathematica 126` and confirm the new checks appear (`min sigma_match on [0,L]`, `min sigma_xi(xi=0) on [0,L]`, `sigma_xi(xi=1)`, `sigma_xi(z=L, xi=0)`) AND each engine exits 0.
   133	
