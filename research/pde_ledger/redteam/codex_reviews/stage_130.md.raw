    45	eZ = FullSimplify[Integrate[sigma*z, {z, 0, lM}], Assumptions -> $Assumptions];
    46	eFZ = FullSimplify[Integrate[sigma*f*z, {z, 0, lM}], Assumptions -> $Assumptions];
    47	covId = FullSimplify[D[gPi, piM] + (eFZ - gPi*eZ)/lM, Assumptions -> $Assumptions];
    48	
    49	Print["g_Pi = ", fmt[gPi]];
    50	Print["Covariance identity residual = ", fmt[covId]];
    51	expectZero["covariance identity", covId];
    52	
    53	Clear[pi0, piInf];
    54	g0 = FullSimplify[Limit[gPi /. piM -> pi0, pi0 -> 0, Direction -> "FromAbove"], Assumptions -> pi0 > 0];
    55	gInf = FullSimplify[Limit[gPi /. piM -> piInf, piInf -> Infinity], Assumptions -> piInf > 0];
    56	Print["limit Pi->0+ = ", fmt[g0]];
    57	Print["limit Pi->oo = ", fmt[gInf]];
    58	expectZero["uniform-source limit", g0 - 2/Pi];
    59	expectZero["point-source limit", gInf - 1];
    60	
    61	(* Strict monotonicity sweep: dg/dpiM > 0 for piM > 0 (notes boxed result) *)
    62	dgPi = D[gPi, piM];
    63	Module[{vals = {1/10, 1/2, 1, 15088/10000, 3, 10}, dv},
    64	  Do[
    65	    dv = N[dgPi /. piM -> v, 40];
    66	    Print["dg/dpiM at piM=", fmt[v], " = ", fmt[dv]];
    67	    If[TrueQ[dv > 0], pass["dg/dpiM > 0 at piM=" <> ToString[v]],
    68	      fail["dg/dpiM > 0 at piM=" <> ToString[v], dv]],
    69	    {v, vals}]
    70	];
    71	
    72	piStar = piM /. FindRoot[gPi == gMinus, {piM, 1.5}, WorkingPrecision -> 80, AccuracyGoal -> 30, PrecisionGoal -> 30, MaxIterations -> 100];
    73	Print["Pi_* = ", fmt[N[piStar, 30]]];
    74	Print["x_* = 1/Pi_* = ", fmt[N[1/piStar, 30]]];
    75	Print["g(Pi_*) = ", fmt[N[gPi /. piM -> piStar, 30]]];
    76	Print["g'(Pi_*) = ", fmt[N[D[gPi, piM] /. piM -> piStar, 30]]];
    77	expectApprox["Family-1 compensation point", gPi /. piM -> piStar, gMinus, 10^-20];
    78	
    79	Print[""];
    80	Print["Stage 130 Mathematica audit passed."];
    81	
    82	Exit[0];

