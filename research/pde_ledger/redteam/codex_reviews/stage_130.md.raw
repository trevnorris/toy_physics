     1	#!/usr/bin/env python3
     2	"""
     3	Stage 130 SymPy audit — exact mouth-bias map and Family-1 compensation point.
     4	"""
     5	
     6	from __future__ import annotations
     7	import sympy as sp
     8	
     9	z, L, Pi = sp.symbols("z L Pi", positive=True, real=True)
    10	g_minus = sp.Float("0.758035078944663")
    11	
    12	sigma = Pi*sp.exp(-Pi*z/L)/(L*(1-sp.exp(-Pi)))
    13	f = sp.cos(sp.pi*z/(2*L))
    14	
    15	gPi = sp.simplify(sp.integrate(sigma*f, (z, 0, L)))
    16	gPi_boxed = 2*Pi*(2*Pi*sp.exp(Pi) + sp.pi) / ((4*Pi**2 + sp.pi**2) * (sp.exp(Pi) - 1))
    17	if sp.simplify(gPi - gPi_boxed) != 0:
    18	    raise AssertionError("g_Pi does not match paper boxed closed form.")
    19	Ez = sp.simplify(sp.integrate(sigma*z, (z, 0, L)))
    20	Efz = sp.simplify(sp.integrate(sigma*f*z, (z, 0, L)))
    21	cov_id = sp.simplify(sp.diff(gPi, Pi) + (Efz - gPi*Ez)/L)
    22	
    23	print("g_Pi =", gPi)
    24	print("Covariance identity residual =", cov_id)
    25	
    26	g0 = sp.simplify(sp.limit(gPi, Pi, 0, dir='+'))
    27	ginf = sp.simplify(sp.limit(gPi, Pi, sp.oo))
    28	print("limit Pi->0+ =", g0)
    29	print("limit Pi->oo =", ginf)
    30	
    31	if cov_id != 0:
    32	    raise AssertionError("Covariance identity failed.")
    33	if sp.simplify(g0 - 2/sp.pi) != 0:
    34	    raise AssertionError("Incorrect uniform-source limit.")
    35	if sp.simplify(ginf - 1) != 0:
    36	    raise AssertionError("Incorrect point-source limit.")
    37	
    38	# Strict monotonicity sweep: dg/dPi > 0 for Pi > 0 (notes boxed result)
    39	dgPi = sp.diff(gPi, Pi)
    40	for val in (sp.Rational(1, 10), sp.Rational(1, 2), sp.Integer(1), sp.Rational(15088, 10000), sp.Integer(3), sp.Integer(10)):
    41	    deriv_val = sp.N(dgPi.subs(Pi, val), 30)
    42	    print(f"dg/dPi at Pi={val} = {deriv_val}")
    43	    if deriv_val <= 0:
    44	        raise AssertionError(f"Strict monotonicity dg/dPi > 0 failed at Pi={val}.")
    45	
    46	# Unique Family-1 compensation point
    47	Pi_star = sp.nsolve(gPi - g_minus, 1.5, tol=1e-30, maxsteps=100, prec=80)
    48	print("Pi_* =", sp.N(Pi_star, 30))
    49	print("x_* = 1/Pi_* =", sp.N(1/Pi_star, 30))
    50	print("g(Pi_*) =", sp.N(gPi.subs(Pi, Pi_star), 30))
    51	print("g'(Pi_*) =", sp.N(sp.diff(gPi, Pi).subs(Pi, Pi_star), 30))

