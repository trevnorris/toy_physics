    20	expectApprox[name_String, value_, target_, tol_] := Module[{delta},
    21	  delta = N[value - target, 40];
    22	  Print[name, " residual = ", fmt[delta]];
    23	  If[TrueQ[Abs[delta] < tol], pass[name], fail[name, delta]];
    24	];
