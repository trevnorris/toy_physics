    65	  Assumptions -> $Assumptions
    66	];
    67	expectedForm = (tM - qStar*a0Prime) - piStar*thetaSigma/lM;
    68	identityResidual = Chop[Simplify[thresholdAtStar - expectedForm], 10^-30];
    69	If[TrueQ[identityResidual === 0],
