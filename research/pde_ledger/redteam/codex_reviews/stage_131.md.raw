    43	    f"Pi_* mismatch vs notes Sec. 1: computed {Pi_star_num}, paper {Pi_star_paper}"
    44	)
    45	print("PASS: Pi_* matches notes Sec. 1 value 1.50882951349316")
    46	
    47	# Anchor (2): g'(Pi_*) matches the notes-quoted slope 0.0714453558083195 (Sec. 3).
