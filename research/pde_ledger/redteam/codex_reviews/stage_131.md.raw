     1	#!/usr/bin/env python3
     2	"""
     3	Stage 131 SymPy audit — parent micro-threshold for canonical mouth compensation.
     4	"""
     5	
     6	from __future__ import annotations
     7	import sympy as sp
     8	
     9	Pi = sp.symbols("Pi", positive=True, real=True)
    10	Theta_sigma, L = sp.symbols("Theta_sigma L", positive=True, real=True)
    11	Tm, qstar, A0p = sp.symbols("T_m q_* A0p", real=True)
    12	# F1 lower-branch value g_-^{F1}: closed form is (2*sqrt(4107 - 100*pi^2) - 37*sqrt(3)) / (20*pi).
    13	# Carried forward from the F1 family lower-branch derivation in the upstream
    14	# parent-mouth stages (see notes/stages/moving_throat_pde_stage131_parent_mouth_threshold.md Sec. 3).
    15	g_minus_exact = (2*sp.sqrt(4107 - 100*sp.pi**2) - 37*sp.sqrt(3)) / (20*sp.pi)
    16	g_minus_literal = sp.Float("0.758035078944663", 50)
    17	assert abs(sp.N(g_minus_exact, 50) - g_minus_literal) < sp.Float("1e-14", 50), (
    18	    f"g_-^{{F1}} closed form vs literal: {sp.N(g_minus_exact, 50)} != {g_minus_literal}"
    19	)
    20	g_minus = sp.N(g_minus_exact, 50)
    21	print(f"PASS: g_-^F1 closed form matches literal 0.758035078944663")
    22	
    23	gPi = sp.simplify(2*Pi*(2*Pi*sp.exp(Pi) + sp.pi)/((4*Pi**2 + sp.pi**2)*(sp.exp(Pi) - 1)))
    24	Pi_star = sp.nsolve(gPi - g_minus, 1.5, tol=1e-30, maxsteps=100, prec=80)
    25	
    26	V1 = Pi*Theta_sigma/L
    27	V1_star = sp.N(Pi_star, 30)*Theta_sigma/L
    28	print("Pi_* =", sp.N(Pi_star, 30))
    29	print("V1_* =", V1_star)
    30	
    31	gprime_star = sp.N(sp.diff(gPi, Pi).subs(Pi, Pi_star), 30)
    32	print("g'(Pi_*) =", gprime_star)
    33	
    34	threshold_residual = sp.simplify((Tm - qstar*A0p) - Pi*Theta_sigma/L)
    35	print("Parent bias mismatch formula =", threshold_residual)
    36	
    37	# --- Anchored assertions vs notes/stages/moving_throat_pde_stage131_parent_mouth_threshold.md ---
    38	
    39	# Anchor (1): Pi_* matches the notes-quoted value 1.50882951349316 (Sec. 1).
