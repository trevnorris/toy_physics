    39	gMinus = N[gMinusExact, 80];
    40	gPi = FullSimplify[2*piM*(2*piM*Exp[piM] + Pi)/((4*piM^2 + Pi^2)*(Exp[piM] - 1)), Assumptions -> $Assumptions];
    41	piStar = piM /. FindRoot[gPi == gMinus, {piM, 1.5}, WorkingPrecision -> 80, AccuracyGoal -> 30, PrecisionGoal -> 30, MaxIterations -> 100];
    42	
    43	v1 = piM*thetaSigma/lM;
    44	v1Star = N[piStar, 30]*thetaSigma/lM;
    45	gPrimeStar = N[D[gPi, piM] /. piM -> piStar, 30];
    46	thresholdResidual = FullSimplify[(tM - qStar*a0Prime) - piM*thetaSigma/lM, Assumptions -> $Assumptions];
    47	
    48	Print["Pi_* = ", fmt[N[piStar, 30]]];
    49	Print["V1_* = ", fmt[v1Star]];
    50	Print["g'(Pi_*) = ", fmt[gPrimeStar]];
    51	Print["Parent bias mismatch formula = ", fmt[thresholdResidual]];
    52	(* Anchored checks vs notes/stages/moving_throat_pde_stage131_parent_mouth_threshold.md *)
