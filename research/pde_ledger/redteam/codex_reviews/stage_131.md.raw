    28	Clear[piM, thetaSigma, lM, tM, qStar, a0Prime];
    29	$Assumptions =
    30	  Element[{piM, thetaSigma, lM, tM, qStar, a0Prime}, Reals] &&
    31	  piM > 0 && thetaSigma > 0 && lM > 0;
    32	
    33	(* F1 lower-branch value g_-^{F1}: closed form below; see notes/stages/
