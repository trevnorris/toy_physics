     1	
     2	#!/usr/bin/env python3
     3	"""
     4	moving_throat_pde_stage133_coupled_mouth_fixedpoint_sympy_audit.py
     5	
     6	SymPy audit for the explicit coupled mouth-layer fixed-point law.
     7	
     8	Checks
     9	------
    10	1. Solve the scalar D/N problem with exponential source on x in [0,1].
    11	2. Verify the exact mouth-derivative kernel S(Pi,kappa).
    12	3. Verify the static-shell limit S(Pi,0)=1.
    13	4. Record the general two-channel fixed-point law after diagonalization.
    14	"""
    15	
    16	from __future__ import annotations
    17	import sympy as sp
    18	
    19	def banner(title: str) -> None:
    20	    line = "=" * 88
    21	    print("\n" + line)
    22	    print(title)
    23	    print(line)
    24	
    25	def expect_zero(name: str, expr: sp.Expr) -> None:
    26	    expr = sp.simplify(sp.expand(expr))
    27	    print(f"{name} = {expr}")
    28	    if expr != 0:
    29	        raise AssertionError(f"{name} is not zero")
    30	
    31	banner("STAGE 133 — SCALAR D/N RESPONSE KERNEL")
    32	
    33	x, Pi, kappa, G = sp.symbols("x Pi kappa G", positive=True, real=True)
    34	Sigma = Pi * sp.exp(-Pi*x) / (1 - sp.exp(-Pi))
    35	
    36	C = G * Pi / ((1 - sp.exp(-Pi)) * (kappa**2 - Pi**2))
    37	A = sp.simplify(C * (kappa * sp.sinh(kappa) + Pi * sp.exp(-Pi)) / (kappa * sp.cosh(kappa)))
    38	
    39	u = sp.simplify(A * sp.sinh(kappa*x) - C * sp.cosh(kappa*x) + C * sp.exp(-Pi*x))
    40	
    41	res = sp.simplify(-sp.diff(u, x, 2) + kappa**2 * u - G * Sigma)
    42	bc0 = sp.simplify(u.subs(x, 0))
    43	bc1 = sp.simplify(sp.diff(u, x).subs(x, 1))
    44	
    45	S = sp.simplify(sp.diff(u, x).subs(x, 0) / G)
    46	S_target = sp.simplify(
    47	    Pi * (kappa * sp.tanh(kappa) + Pi * (sp.exp(-Pi) / sp.cosh(kappa) - 1))
    48	    / ((1 - sp.exp(-Pi)) * (kappa**2 - Pi**2))
    49	)
    50	
    51	print("u(x) =")
    52	sp.pprint(u)
    53	expect_zero("ODE residual", res)
    54	expect_zero("u(0)", bc0)
    55	expect_zero("u'(1)", bc1)
    56	expect_zero("mouth derivative kernel", S - S_target)
    57	
    58	kk = sp.symbols("kk", positive=True, real=True)
    59	S0 = sp.simplify(sp.limit(S_target.subs(kappa, kk), kk, 0))
    60	print("S(Pi,0) =", S0)
    61	if sp.simplify(S0 - 1) != 0:
    62	    raise AssertionError("Static-shell limit failed.")
    63	
    64	banner("STAGE 133 — GENERAL TWO-CHANNEL FIXED-POINT LAW")
    65	print("Pi = Mplus*S(Pi,kappa_plus) + Mminus*S(Pi,kappa_minus)")
    66	print("with")
    67	print("  S(Pi,kappa) =")
    68	sp.pprint(S_target)

