     2	#!/usr/bin/env python3
     3	"""
     4	moving_throat_pde_stage134_family1_mouth_fixedpoint_sympy_audit.py
     5	
     6	SymPy audit for the Family-1 shell + first mixed D/N tube reduction.
     7	"""
     8	
     9	from __future__ import annotations
    10	import sympy as sp
    11	
    12	def banner(title: str) -> None:
    13	    line = "=" * 88
    14	    print("\n" + line)
    15	    print(title)
    16	    print(line)
    17	
    18	Pi = sp.symbols("Pi", positive=True, real=True)
    19	M_s, M_q = sp.symbols("M_s M_q", real=True)
    20	
    21	def S(Pi, kappa):
    22	    return sp.simplify(
    23	        Pi * (kappa * sp.tanh(kappa) + Pi * (sp.exp(-Pi) / sp.cosh(kappa) - 1))
    24	        / ((1 - sp.exp(-Pi)) * (kappa**2 - Pi**2))
    25	    )
    26	
