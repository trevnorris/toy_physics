     9	
    10	from __future__ import annotations
    11	import sympy as sp
    12	
    13	def banner(title: str) -> None:
    14	    line = "=" * 88
    15	    print("\n" + line)
    16	    print(title)
    17	    print(line)
    18	
    19	Pi, Sigma_m = sp.symbols("Pi Sigma_m", positive=True, real=True)
    20	
    21	def S(Pi, kappa):
    22	    return sp.simplify(
    23	        Pi * (kappa * sp.tanh(kappa) + Pi * (sp.exp(-Pi) / sp.cosh(kappa) - 1))
    24	        / ((1 - sp.exp(-Pi)) * (kappa**2 - Pi**2))
    25	    )
    26	
    27	banner("STAGE 135 — OUTLET-CONSISTENT ONE-PARAMETER CLOSURE")
    28	S_q = sp.simplify(S(Pi, sp.pi/2))
    29	
    30	# Step 1: outlet substitution check.
    31	# Build the generic mouth-gain law M_s + M_q*S_q with independent symbols, then
    32	# substitute the outlet-consistent reduction M_s = 4*Sigma_m, M_q = -Sigma_m and
    33	# verify it reduces to Sigma_m*(4 - S_q).
    34	M_s_sym, M_q_sym = sp.symbols("M_s_sym M_q_sym", real=True)
    35	generic_law = M_s_sym + M_q_sym * S_q
    36	reduced_law = generic_law.subs({M_s_sym: 4*Sigma_m, M_q_sym: -Sigma_m})
    37	expected_law = Sigma_m * (4 - S_q)
    38	residual_sub = sp.simplify(reduced_law - expected_law)
    39	print("M_s + M_q*S_q - Sigma_m*(4 - S_q) =", residual_sub)
    40	assert residual_sub == 0, f"Outlet substitution failed: residual = {residual_sub}"
    41	
    42	Pi_eq = sp.simplify(Sigma_m * (4 - S_q))
    43	print("Pi =")
    44	sp.pprint(Pi_eq)
    45	
    46	Pi_star = sp.Float("1.50882951349316")
    47	S_star = sp.N(S_q.subs(Pi, Pi_star), 30)
    48	Sigma_var = sp.symbols("Sigma_var", positive=True, real=True)
    49	Sigma_star = sp.N(sp.solve(sp.Eq(Pi_star, Sigma_var * (4 - S_star)), Sigma_var)[0], 30)
    50	M_s_star = sp.N(4 * Sigma_star, 30)
    51	M_q_star = sp.N(-Sigma_star, 30)
    52	
    53	print("S_q(Pi_star) =", S_star)
