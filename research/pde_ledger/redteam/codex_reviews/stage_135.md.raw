    60	print("Sigma_m^* =", Sigma_star)
    61	print("M_s^* =", M_s_star)
    62	print("M_q^* =", M_q_star)
    63	
    64	# Step 3: numerical anchors against notes-stated values (paper deliverables iv-vi).
    65	Sigma_target = sp.Float("0.451485277739090", 30)
    66	M_s_target = sp.Float("1.80594111095636", 30)
    67	M_q_target = sp.Float("-0.451485277739090", 30)
    68	
    69	assert abs(Sigma_star - Sigma_target) < sp.Float("1e-12", 30), \
    70	    f"Sigma_m^* mismatch: {Sigma_star} vs {Sigma_target}"
    71	assert abs(M_s_star - M_s_target) < sp.Float("1e-11", 30), \
    72	    f"M_s^* mismatch: {M_s_star} vs {M_s_target}"
    73	assert abs(M_q_star - M_q_target) < sp.Float("1e-12", 30), \
    74	    f"M_q^* mismatch: {M_q_star} vs {M_q_target}"
    75	print("Sigma_m^*, M_s^*, M_q^* anchored to notes values within tolerance.")
    76	
