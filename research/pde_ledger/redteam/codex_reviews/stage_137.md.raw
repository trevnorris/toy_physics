\section[Stage 137]{Stage 137: Explicit Core-to-Mouth Gain Map}
\label{stage:137}

\stagefield{Part / anchor}{Part IV; primary anchor \resultanchor{MTDC-T8}.}
\claimstatus{\StatusExactClosure{} / \StatusReduced{}.}

\stagefield{Purpose}{Stage~137 is a coupled mouth fixed point and gain selection ledger step.  Its audit target is the verification output quoted below.}

\stagefield{Inputs}{This stage imports the shell/mixed core, the mouth source law, outlet consistency, core-to-mouth gain maps, and self-matched susceptibility closure.  It does not change the parent action or the grouped-lane ontology; it works inside the declared reduced branch and tests the next algebraic or realization condition.}

\stagefield{Verification}{SymPy audit: \StageFile{scripts/moving_throat_pde_stage137_core_to_mouth_gain_map_sympy_audit.py}; transcript: \StageFile{scripts/output/moving_throat_pde_stage137_core_to_mouth_gain_map_sympy_audit.txt}.  Mathematica audit: \StageFile{mathematica/moving_throat_pde_stage137_core_to_mouth_gain_map_mathematica_audit.wl}; transcript: \StageFile{mathematica/output/moving_throat_pde_stage137_core_to_mouth_gain_map_mathematica_audit.txt}.}

\stagefield{Derivation ledger}{The verification step belongs to the \emph{Coupled mouth fixed point and gain selection} block.  The computation isolates the finite-bias regular canonical mouth branch and the gain pair that replaces the naive equal-normalized limit.}

\begin{quote}
Explicit gains are \(M_s=Lg_s^2/(K_s\Theta_\sigma)\), \(M_q=-L(K_sg_q-\lambda g_s)^2/[K_s(K_sK_q+\lambda^2)\Theta_\sigma]\).
\end{quote}

\stagefield{Verification note}{The detailed equations supporting this card are collected in the corresponding block narrative above and in the source stage.}

\stagefield{Checks}{\begin{verificationchecklist}
\item Check the gain pair \((M_s,M_q)\) against outlet consistency.
\item Check the self-matched susceptibility closure before using the one-scalar branch law.
\item Check numerical fixed points are recorded as numerically located, not closed-form constants.
\end{verificationchecklist}}

\stagefield{Downstream use}{This stage feeds Stages 146--153 and the finite mouth-profile correction.  When cited downstream, the status tag above must be carried with the result; the card is a derivation ledger entry, not an unconditional actual-branch theorem.}


