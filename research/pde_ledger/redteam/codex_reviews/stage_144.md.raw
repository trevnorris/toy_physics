    20	gplus  = sp.simplify(r + sp.Rational(1,2)*sp.sqrt(1+r**2))
    21	gPi = 2*Pi*(2*Pi*sp.exp(Pi)+pi)/((4*Pi**2+pi**2)*(sp.exp(Pi)-1))
    22	Sq = Pi*(((pi/2)*sp.tanh(pi/2)) + Pi*(sp.exp(-Pi)*sp.sech(pi/2)-1))/((1-sp.exp(-Pi))*(((pi/2)**2)-Pi**2))
    23	Rq = (gPi-r)**2/(1+r**2)
    24	Sigma0 = Pi/(1-Rq*Sq)
    25	That = sp.sqrt(sp.Rational(9,20)*Sigma0)
    26	
    27	subbanner("Compensated branches")
    28	print("g_-^F1 =", sp.N(gminus, 30))
    29	print("g_+^F1 =", sp.N(gplus, 30))
    30	print("2/pi   =", sp.N(2/pi, 30))
    31	
    32	Pi_star = sp.N(sp.nsolve(sp.Eq(gPi, gminus), 1.5), 30)
    33	That_star = sp.N(That.subs(Pi, Pi_star), 30)
    34	
    35	Pi_match = sp.N(sp.nsolve(sp.Eq(gPi, pi/4), 1.9), 30)
    36	That_match = sp.N(That.subs(Pi, Pi_match), 30)
    37	
    38	print("Pi_*          =", Pi_star)
    39	print("That(Pi_*)    =", That_star)
    40	Sigma0_star = sp.N(Sigma0.subs(Pi, Pi_star), 30)
