    95	(* Numeric-sample fallback: evaluate at two concrete eps values rather than
    96	   simplifying an eps-polynomial residual (the integrate-with-numeric-pStar
    97	   path produces complex near-zero coefficients that FullSimplify cannot
    98	   reduce symbolically). *)
    99	(* The numeric pStar substitution causes Integrate to produce complex near-zero
   100	   residuals at low working-precision (~9-10 digits). Treat any value whose
   101	   numerical magnitude is below 10^-6 (i.e., consistent with precision-9 zero)
   102	   as satisfying the affine law. *)
   103	gEpsRes = gBarPhys - (gMinus + eps*(gBarV - gMinus));
   104	gEpsSample1 = N[gEpsRes /. eps -> 1/10, 40];
   105	gEpsSample2 = N[gEpsRes /. eps -> 1/2, 40];
   106	Print["g_eps affine law (integral form) at eps=1/10: ", fmt[Chop[gEpsSample1, 10^-6]]];
   107	Print["g_eps affine law (integral form) at eps=1/2:  ", fmt[Chop[gEpsSample2, 10^-6]]];
   108	If[NumericQ[gEpsSample1] && NumericQ[gEpsSample2] && Abs[gEpsSample1] < 10^-6 && Abs[gEpsSample2] < 10^-6,
   109	  pass["g_eps affine law (integral form)"],
   110	  fail["g_eps affine law (integral form)", {gEpsSample1, gEpsSample2}]
   111	];
   112	
   113	sEpsRes = sBarPhys - (sStar + eps*(sBarV - sStar));
   114	sEpsSample1 = N[sEpsRes /. eps -> 1/10, 40];
   115	sEpsSample2 = N[sEpsRes /. eps -> 1/2, 40];
   116	Print["S_eps affine law (integral form) at eps=1/10: ", fmt[Chop[sEpsSample1, 10^-6]]];
   117	Print["S_eps affine law (integral form) at eps=1/2:  ", fmt[Chop[sEpsSample2, 10^-6]]];
   118	If[NumericQ[sEpsSample1] && NumericQ[sEpsSample2] && Abs[sEpsSample1] < 10^-6 && Abs[sEpsSample2] < 10^-6,
   119	  pass["S_eps affine law (integral form)"],
   120	  fail["S_eps affine law (integral form)", {sEpsSample1, sEpsSample2}]
   121	];
   122	
   123	Print[""];
   124	Print["Stage 146 Mathematica audit passed."];
   125	
   126	Exit[0];

