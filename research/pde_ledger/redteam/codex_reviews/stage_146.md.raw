   118	    if abs(float(S_res)) > 1e-15:
   119	        raise AssertionError(f"S_eps affine law fails at {label}: {S_res}")
   120	print("PASS: g_eps affine law (integral form) at eps=1/10 and eps=1/2")
   121	print("PASS: S_eps affine law (integral form) at eps=1/10 and eps=1/2")
