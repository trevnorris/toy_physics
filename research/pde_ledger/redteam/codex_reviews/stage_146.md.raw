   108	# evaluation at two concrete eps samples, matching the Mathematica path.
   109	g_eps_residual_expr = gbar_phys - (gminus + eps*(gbar_v - gminus))
   110	S_eps_residual_expr = Sbar_phys - (Sformula.subs(Pi, Pi_star) + eps*(Sbar_v - Sformula.subs(Pi, Pi_star)))
   111	for eps_val, label in [(sp.Rational(1, 10), "eps=1/10"), (sp.Rational(1, 2), "eps=1/2")]:
   112	    g_res = sp.N(g_eps_residual_expr.subs(eps, eps_val), 30)
   113	    S_res = sp.N(S_eps_residual_expr.subs(eps, eps_val), 30)
   114	    print(f"g_eps affine law (integral form) at {label}: residual = {g_res}")
   115	    print(f"S_eps affine law (integral form) at {label}: residual = {S_res}")
