    10	def expect_zero(name, expr):
    11	    expr = sp.simplify(sp.expand(expr))
    12	    print(f"{name} = {expr}")
    13	    if expr != 0:
    14	        raise AssertionError(f"{name} is not zero")
    15	
    16	Pi = sp.symbols("Pi", positive=True, real=True)
    17	x = sp.symbols("x", real=True)
    18	kap = sp.pi/2
    19	
    20	# Exact exponential-source overlap and mixed-response functions.
    21	Sigma = Pi*sp.exp(-Pi*x)/(1-sp.exp(-Pi))
    22	Kq = sp.cosh(kap*(1-x))/sp.cosh(kap)
    23	
    24	gPi = 2*Pi*(2*Pi*sp.exp(Pi)+sp.pi)/((4*Pi**2+sp.pi**2)*(sp.exp(Pi)-1))
    25	Sformula = sp.simplify(
    26	    Pi*(kap*sp.tanh(kap) + Pi*(sp.exp(-Pi)*sp.sech(kap) - 1))
    27	    / ((1-sp.exp(-Pi))*(kap**2-Pi**2))
    28	)
    29	
    30	# Symbolic verification that the closed-form moments equal the canonical
    31	# integrals against the kernel functions. This anchors the formulas before
    32	# the numeric Pi_* root-finder runs.
    33	gPi_direct = sp.integrate(Sigma*sp.cos(sp.pi*x/2), (x, 0, 1))
    34	if gPi_direct.has(sp.Integral):
    35	    for pp in [sp.Rational(7,10), sp.Rational(11,10), sp.Rational(17,10), sp.Rational(23,10)]:
    36	        diff_g = sp.N(sp.integrate((Sigma*sp.cos(sp.pi*x/2)).subs(Pi, pp), (x,0,1)) - gPi.subs(Pi, pp), 30)
    37	        print(f"g(Pi) numeric sample Pi={pp}: diff={diff_g}")
    38	        if abs(float(diff_g)) > 1e-25:
    39	            raise AssertionError(f"g(Pi) numeric mismatch at Pi={pp}: {diff_g}")
    40	    print("PASS: g(Pi) direct-formula (numeric fallback at 4 samples)")
    41	else:
    42	    expect_zero("g(Pi) direct-formula", sp.simplify(gPi_direct - gPi))
    43	
    44	Sq_direct = sp.integrate(Sigma*Kq, (x, 0, 1))
    45	if Sq_direct.has(sp.Integral):
    46	    for pp in [sp.Rational(7,10), sp.Rational(11,10), sp.Rational(17,10), sp.Rational(23,10)]:
    47	        diff_s = sp.N(sp.integrate((Sigma*Kq).subs(Pi, pp), (x,0,1)) - Sformula.subs(Pi, pp), 30)
    48	        print(f"S_q(Pi) numeric sample Pi={pp}: diff={diff_s}")
    49	        if abs(float(diff_s)) > 1e-25:
    50	            raise AssertionError(f"S_q(Pi) numeric mismatch at Pi={pp}: {diff_s}")
    51	    print("PASS: S_q(Pi) direct-formula (numeric fallback at 4 samples)")
    52	else:
    53	    expect_zero("S_q(Pi) direct-formula", sp.simplify(Sq_direct - Sformula))
    54	
    55	banner("Stage 146 audit: exact source moments")
    56	print("g(Pi) =")
    57	sp.pprint(gPi)
    58	print("S_q(Pi) =")
    59	sp.pprint(Sformula)
    60	
    61	# Numerical kernel cross-check against direct integration.
    62	for val in [sp.Integer(1), sp.Rational(3,2), sp.Rational(5,2)]:
    63	    num_int = sp.N(sp.integrate((Sigma*Kq).subs(Pi, val), (x,0,1)), 30)
    64	    num_formula = sp.N(Sformula.subs(Pi, val), 30)
    65	    diff = sp.N(num_int - num_formula, 20)
    66	    print(f"kernel check at Pi={val}: integral={num_int}, formula={num_formula}, diff={diff}")
    67	    if abs(float(diff)) > 1e-12:
    68	        raise AssertionError("Kernel formula mismatch.")
    69	
    70	# Family-1 canonical point
    71	rF1 = sp.sqrt(12*sp.Rational(37,20)**2/sp.pi**2 - 1)
    72	gminus = sp.simplify(rF1 - sp.sqrt(1+rF1**2)/2)
    73	Pi_star = sp.N(sp.nsolve(gPi - gminus, 1.5), 30)
    74	print("Pi_* =", Pi_star)
    75	
    76	g_star = sp.N(gPi.subs(Pi, Pi_star), 30)
    77	S_star = sp.N(Sformula.subs(Pi, Pi_star), 30)
    78	gp_star = sp.N(sp.diff(gPi, Pi).subs(Pi, Pi_star), 30)
    79	Sp_star = sp.N(sp.diff(Sformula, Pi).subs(Pi, Pi_star), 30)
    80	print("g_* =", g_star)
    81	print("S_* =", S_star)
    82	print("g_*' =", gp_star)
    83	print("S_*' =", Sp_star)
    84	
    85	# Generic positive convex deformation moments
    86	gbar, Sbar, eps = sp.symbols("gbar Sbar eps", real=True)
    87	dPi = sp.simplify(-eps*(gbar-gminus)/sp.diff(gPi, Pi).subs(Pi, Pi_star))
    88	dS = sp.simplify(eps*(Sbar - Sformula.subs(Pi, Pi_star)) + sp.diff(Sformula, Pi).subs(Pi, Pi_star)*dPi)
    89	
    90	banner("First-order canonical retuning law")
    91	print("delta Pi =")
    92	sp.pprint(dPi)
    93	print("delta S =")
    94	sp.pprint(sp.simplify(dS))
    95	
    96	# Exact affine law for convex family moments — tested via integration,
    97	# not via redefining the affine form. Use a concrete positive normalized
    98	# test profile varsigma_test(x) = 6 x (1 - x) (a polynomial bump,
    99	# positive on (0,1), with integral 1 on [0,1]).
   100	varsigma_test = 6*x*(1-x)
   101	Sigma_eps = (1-eps)*Sigma.subs(Pi, Pi_star) + eps*varsigma_test
   102	gbar_phys = sp.integrate(Sigma_eps*sp.cos(sp.pi*x/2), (x, 0, 1))
   103	Sbar_phys = sp.integrate(Sigma_eps*Kq, (x, 0, 1))
   104	gbar_v    = sp.integrate(varsigma_test*sp.cos(sp.pi*x/2), (x, 0, 1))
   105	Sbar_v    = sp.integrate(varsigma_test*Kq, (x, 0, 1))
   106	# Symbolic simplify cannot reduce the residual (it contains both sqrt(3) and
