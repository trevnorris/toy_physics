     1	#!/usr/bin/env python3
     2	from __future__ import annotations
     3	import sympy as sp
     4	
     5	def banner(t):
     6	    print("\n" + "="*88)
     7	    print(t)
     8	    print("="*88)
     9	
    10	Pi = sp.symbols("Pi", positive=True, real=True)
    11	x, eps = sp.symbols("x eps", real=True)
    12	kap = sp.pi/2
    13	c = sp.cos(sp.pi*x/2)
    14	Kq = sp.cosh(kap*(1-x))/sp.cosh(kap)
    15	
    16	gPi = 2*Pi*(2*Pi*sp.exp(Pi)+sp.pi)/((4*Pi**2+sp.pi**2)*(sp.exp(Pi)-1))
    17	Sformula = sp.simplify(
    18	    Pi*(kap*sp.tanh(kap) + Pi*(sp.exp(-Pi)*sp.sech(kap) - 1))
    19	    / ((1-sp.exp(-Pi))*(kap**2-Pi**2))
    20	)
    21	
    22	rF1 = sp.sqrt(12*sp.Rational(37,20)**2/sp.pi**2 - 1)
    23	gminus = sp.simplify(rF1 - sp.sqrt(1+rF1**2)/2)
    24	Pi_star = sp.N(sp.nsolve(gPi - gminus, 1.5), 40)
    25	g_star = sp.N(gPi.subs(Pi, Pi_star), 40)
    26	S_star = sp.N(Sformula.subs(Pi, Pi_star), 40)
    27	gp_star = sp.N(sp.diff(gPi, Pi).subs(Pi, Pi_star), 40)
    28	Sp_star = sp.N(sp.diff(Sformula, Pi).subs(Pi, Pi_star), 40)
    29	
    30	Sigma_star = sp.N(Pi_star/(1-S_star/4), 40)
    31	T_star = sp.N(sp.sqrt(9*Sigma_star/20), 40)
    32	
    33	AT = sp.N(
    34	    -(sp.Rational(9,1)/(40*T_star)) * (
    35	        1/(gp_star*(1-S_star/4)) + Pi_star*Sp_star/(4*gp_star*(1-S_star/4)**2)
    36	    ),
    37	    30
    38	)
    39	BT = sp.N(
    40	    (sp.Rational(9,1)/(40*T_star)) * Pi_star/(4*(1-S_star/4)**2),
    41	    30
    42	)
    43	
    44	banner("Stage 147 audit: first-order rigidity coefficients")
    45	print("Pi_* =", Pi_star)
    46	print("Sigma_* =", Sigma_star)
    47	print("T_* =", T_star)
    48	print("A_T =", AT)
    49	print("B_T =", BT)
