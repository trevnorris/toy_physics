    68	# closed-form A_T against this differential identity assembled from scratch.
    69	dTm_dSigma = sp.Rational(9, 40) / T_star
    70	dSigma_dPi_at_star = 1/(1 - S_star/4) + Pi_star * Sp_star / (4*(1-S_star/4)**2)
    71	AT_chain = sp.N(-dTm_dSigma * dSigma_dPi_at_star / gp_star, 30)
    72	AT_30 = sp.N(AT, 30)
