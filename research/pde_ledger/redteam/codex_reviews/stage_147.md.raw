    61	print("PASS: B_T matches paper-quoted 0.134875005736706 to 1e-12")
    62	assert abs(sp.N(sp.Abs(AT)/BT) - ratio_paper) < sp.Float("1e-3", 30), \
    63	    f"|A_T|/B_T deviates from paper-quoted 31.6785: {sp.N(sp.Abs(AT)/BT)}"
    64	print("PASS: |A_T|/B_T matches paper-quoted 31.6785 to 1e-3")
    65	
    66	# --- Audit assertion: chain-rule consistency for A_T (independent derivation route) ---
