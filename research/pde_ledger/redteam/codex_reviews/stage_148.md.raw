    85	
    86	# Stage 126 positive-family compensation closed form (see notes section 3)
    87	xi_star_closed = (-37*sp.sqrt(3) - 5*sp.pi**2 + 2*sp.sqrt(4107 - 100*sp.pi**2)) / (5*(8 - sp.pi**2))
    88	xi_star = sp.N(xi_star_closed, 30)
    89	print("xi_* (Stage 126 closed form) =", xi_star)
    90	residual = sp.N((1 - lam_Pi_zero) - xi_star, 30)
    91	print("(1-lambda_(Pi,0)) - xi_* =", residual)
    92	assert abs(residual) < sp.Float("1e-15"), f"Stage 148 D4 consistency failed: residual = {residual}"
    93	
    94	print("\nStage 148 complete.")

