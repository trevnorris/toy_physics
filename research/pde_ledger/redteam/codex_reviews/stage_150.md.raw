    13	    print("\n" + line)
    14	    print(title)
    15	    print(line)
    16	
    17	def expect_zero(name: str, expr: sp.Expr) -> None:
    18	    expr = sp.together(sp.expand(expr))
    19	    expr = sp.simplify(expr)
    20	    print(f"{name} =", expr)
    21	    if expr != 0:
    22	        raise AssertionError(f"{name} is not zero")
