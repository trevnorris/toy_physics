    29	# Static shell profile (exact)
    30	Ts = (1 - sp.exp(-Pi*x)) / (Pi * (1 - sp.exp(-Pi))) - x * sp.exp(-Pi)/(1 - sp.exp(-Pi))
    31	
    32	# Mixed D/N channel profile (exact, but keep algebra lightweight)
    33	Cq = Pi / ((1 - sp.exp(-Pi)) * (k**2 - Pi**2))
    34	Aq = Cq * (k * sp.sinh(k) + Pi * sp.exp(-Pi)) / (k * sp.cosh(k))
