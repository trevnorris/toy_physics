    36	    print(f"{name} = {val}   (target {target}, diff {diff})")
    37	    if float(diff) > tol:
    38	        raise AssertionError(f"{name} mismatch")
    39	
    40	
    41	banner("FIRST-ORDER SELF-CONSISTENT SOURCE CORRECTION")
    42	
    43	mp.mp.dps = 40
    44	
    45	# Numeric anchors.  Pi_star = canonical Family-1 mouth bias (notes / stage 156).
    46	# r1, r2 = arbitrary nonzero example coefficients in the residual R(x) = r1 x + r2 x^2.
    47	# gprime, AT, BT = arbitrary nonzero example parameters; we verify the algebraic
    48	# relations delta_Pi = -delta_g/gprime and delta_T = AT*delta_g + BT*delta_S
    49	# without needing the specific Family-1 values (those live in stage 152).
    50	Pi_star = mp.mpf("1.50882951349316")
    51	r1 = mp.mpf("1.7")
    52	r2 = mp.mpf("-0.9")
    53	gprime = mp.mpf("0.0714453558083195")
    54	AT = mp.mpf("-4.27263956256927")
    55	BT = mp.mpf("0.134875005736706")
    56	k = mp.pi / 2
    57	
    58	
    59	def Sigma_star(x):
    60	    return Pi_star * mp.e ** (-Pi_star * x) / (1 - mp.e ** (-Pi_star))
    61	
    62	
    63	def c_kernel(x):
    64	    return mp.cos(k * x)
    65	
    66	
    67	def K_kernel(x):
    68	    return mp.cosh(k * (1 - x)) / mp.cosh(k)
    69	
    70	
    71	def R_residual(x):
    72	    return r1 * x + r2 * x ** 2
    73	
    74	
    75	def mean(f):
    76	    return mp.quad(lambda t: Sigma_star(t) * f(t), [0, 1])
