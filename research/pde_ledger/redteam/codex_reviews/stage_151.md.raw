    34	SigmaFull[x_] := unnorm[x]/Z;
    35	SigmaSeries = Normal[Series[SigmaFull[x], {epsilon, 0, 1}]];
    36	SigmaStar = Coefficient[SigmaSeries, epsilon, 0];
    37	deltaSigma = Coefficient[SigmaSeries, epsilon, 1];
    38	
