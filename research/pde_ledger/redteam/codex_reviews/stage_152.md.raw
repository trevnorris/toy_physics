     1	#!/usr/bin/env python3
     2	"""
     3	moving_throat_pde_stage152_family1_actual_correction_sympy_audit.py
     4	
     5	Numerical audit of the actual Family-1 mouth correction induced by the full compensated
     6	mouth potential.
     7	"""
     8	
     9	from __future__ import annotations
    10	import sympy as sp
    11	import mpmath as mp
    12	
    13	def banner(title: str) -> None:
    14	    line = "=" * 88
    15	    print("\n" + line)
    16	    print(title)
    17	    print(line)
    18	
    19	def expect_close(name: str, val: float, target: float, tol: float = 1e-10) -> None:
    20	    diff = abs(val - target)
    21	    print(f"{name} = {val}   (target {target}, diff {diff})")
    22	    if diff > tol:
    23	        raise AssertionError(f"{name} mismatch")
    24	
    25	banner("ACTUAL FAMILY-1 MOUTH CORRECTION")
    26	
    27	Pi_star = mp.mpf("1.50882951349316")
    28	Sigma_m_star = mp.mpf("0.451485277739090")
    29	g_star = mp.mpf("0.758035078944663")
    30	S_star = mp.mpf("0.658075937605429")
    31	gprime_star = mp.mpf("0.0714453558083195")
    32	AT = mp.mpf("-4.27263956256927")
    33	BT = mp.mpf("0.134875005736706")
    34	Tstar = mp.mpf("0.901484054174205")
    35	
    36	k = mp.pi/2
    37	
    38	def Sigma_star(x):
    39	    return Pi_star * mp.e**(-Pi_star * x) / (1 - mp.e**(-Pi_star))
    40	
    41	def T_s(x):
    42	    return (1 - mp.e**(-Pi_star * x)) / (Pi_star * (1 - mp.e**(-Pi_star))) - x * mp.e**(-Pi_star)/(1 - mp.e**(-Pi_star))
    43	
    44	def T_q(x):
    45	    Cq = Pi_star / ((1 - mp.e**(-Pi_star)) * (k**2 - Pi_star**2))
    46	    Aq = Cq * (k * mp.sinh(k) + Pi_star * mp.e**(-Pi_star)) / (k * mp.cosh(k))
    47	    return Aq * mp.sinh(k*x) - Cq * mp.cosh(k*x) + Cq * mp.e**(-Pi_star*x)
    48	
    49	def S_q_kernel(x):
    50	    return mp.cosh((mp.pi/2)*(1-x)) / mp.cosh(mp.pi/2)
    51	
    52	def c_kernel(x):
    53	    return mp.cos(mp.pi*x/2)
    54	
    55	# Canonical compensated residual profile
    56	def R_star(x):
    57	    return Sigma_m_star * (4*T_s(x) - T_q(x)) - Pi_star*x
    58	
    59	# Check the tangent constraints numerically.
    60	for h in [mp.mpf("1e-6"), mp.mpf("1e-5")]:
    61	    deriv = (R_star(h) - R_star(0)) / h
    62	    print(f"R'(0) forward diff at h={h} :", deriv)
    63	print("R(0) =", R_star(0))
    64	print("R(1) =", R_star(1))
    65	
    66	# Weighted averages
    67	def avg(func):
    68	    return mp.quad(lambda t: Sigma_star(t) * func(t), [0, 1])
    69	
    70	def cov(f, h):
    71	    af = avg(f)
    72	    ah = avg(h)
    73	    return mp.quad(lambda t: Sigma_star(t) * (f(t) - af) * (h(t) - ah), [0, 1])
    74	
    75	Cov_cR = cov(c_kernel, R_star)
    76	Cov_SR = cov(S_q_kernel, R_star)
    77	
    78	delta_g = -Cov_cR
    79	delta_S = -Cov_SR
    80	deltaPi = Cov_cR / gprime_star
    81	deltaT = AT * delta_g + BT * delta_S
    82	
    83	print("Cov_*(c,R_*)      =", Cov_cR)
    84	print("Cov_*(K_q,R_*)    =", Cov_SR)
    85	print("delta g_act       =", delta_g)
    86	print("delta S_act       =", delta_S)
    87	print("delta Pi_act      =", deltaPi)
    88	print("delta Tm_act      =", deltaT)
    89	print("Pi_corr           =", Pi_star + deltaPi)
    90	print("T_corr            =", Tstar + deltaT)
    91	
    92	# One-step nonlinear Picard iterate
    93	def sigma1_unnorm(x):
    94	    return mp.e**(-Pi_star * x - R_star(x))
    95	
    96	Z1 = mp.quad(lambda t: sigma1_unnorm(t), [0, 1])
    97	def sigma1(x):
    98	    return sigma1_unnorm(x) / Z1
    99	
   100	g1 = mp.quad(lambda t: sigma1(t) * c_kernel(t), [0, 1])
   101	S1 = mp.quad(lambda t: sigma1(t) * S_q_kernel(t), [0, 1])
