     2	"""
     3	moving_throat_pde_stage154_coevolving_core_mouth_sympy_audit.py
     4	
     5	SymPy-backed audit for the exact co-evolving Family-1 core–mouth map.
     6	
     7	Checks:
     8	1. Exact Family-1 core ratio law R(g).
     9	2. Exact compensation equivalence g = g_* <=> R = 1/4.
    10	3. Exact defect-transport expansion of R around the lower compensated branch.
    11	4. Linearized slope identity dPi in terms of dSigma0, dS, dR.
    12	"""
    13	
    14	from __future__ import annotations
    15	import sympy as sp
    16	
    17	def banner(title: str) -> None:
    18	    line = "=" * 88
    19	    print("\n" + line)
    20	    print(title)
    21	    print(line)
    22	
    23	def expect_zero(name: str, expr: sp.Expr) -> None:
    24	    expr = sp.simplify(sp.expand(expr))
    25	    print(f"{name} = {expr}")
    26	    if expr != 0:
    27	        raise AssertionError(f"{name} is not zero")
    28	
    29	banner("STAGE 154 — EXACT CO-EVOLVING CORE–MOUTH MAP")
    30	
    31	g, r, dg = sp.symbols("g r dg", real=True)
    32	R = (g - r)**2 / (1 + r**2)
    33	print("R(g) =", sp.simplify(R))
    34	
    35	g_star = r - sp.sqrt(1 + r**2) / 2
    36	expect_zero("R(g_star) - 1/4", R.subs(g, g_star) - sp.Rational(1, 4))
    37	
    38	R_shift = sp.expand(R.subs(g, g_star + dg))
    39	R_shift_expected = sp.expand(sp.Rational(1, 4) - dg / sp.sqrt(1 + r**2) + dg**2 / (1 + r**2))
    40	expect_zero("exact shifted R formula", R_shift - R_shift_expected)
    41	
    42	banner("Linearized slope identity")
    43	Sigma0, dSigma0, Sstar, dS = sp.symbols("Sigma0 dSigma0 Sstar dS", real=True)
    44	Rstar, dR = sp.symbols("Rstar dR", real=True)
    45	Pi = (Sigma0 + dSigma0) * (1 - (Rstar + dR) * (Sstar + dS))
    46	Pi_lin = sp.expand(sp.series(Pi, dSigma0, 0, 2).removeO())
    47	# manually drop quadratic dR*dS, dSigma*dR, dSigma*dS terms
    48	Pi_lin = sp.expand(Pi).subs({
    49	    dSigma0*dR: 0,
    50	    dSigma0*dS: 0,
    51	    dR*dS: 0,
    52	    dSigma0*dR*dS: 0,
    53	})
    54	Pi0 = Sigma0 * (1 - Rstar*Sstar)
    55	dPi = sp.expand(Pi_lin - Pi0)
    56	dPi_expected = sp.expand((1 - Rstar*Sstar)*dSigma0 - Sigma0*(Rstar*dS + Sstar*dR))
    57	expect_zero("dPi identity", dPi - dPi_expected)
    58	
    59	print("\nCarry-forward formulas:")
    60	print("  R(g) = (g-r)^2/(1+r^2)")
    61	print("  g = g_*  <=>  R = 1/4 on the lower branch")
    62	print("  delta R = -delta g/sqrt(1+r^2) + delta g^2/(1+r^2)")
    63	print("  delta Pi = (1-R_*S_*) delta Sigma0 - Sigma0_* (R_* delta S + S_* delta R)")

