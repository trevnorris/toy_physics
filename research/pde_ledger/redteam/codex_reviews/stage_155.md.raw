     1	#!/usr/bin/env python3
     2	"""
     3	moving_throat_pde_stage155_frozen_traction_fixedpoint_sympy_audit.py
     4	
     5	Numerical/SymPy audit for the full co-evolving Family-1 fixed point at frozen
     6	canonical traction Sigma0*.
     7	
     8	Checks:
     9	1. Solve the exact nonlinear fixed-point map.
    10	2. Report g_fp, S_fp, R_fp, Pi_fp.
    11	3. Verify the exact shifted-R transport law from Stage 154.
    12	"""
    13	
    14	from __future__ import annotations
    15	import math
    16	import numpy as np
    17	import sympy as sp
    18	
    19	def banner(title: str) -> None:
    20	    line = "=" * 88
    21	    print("\n" + line)
    22	    print(title)
    23	    print(line)
    24	
    25	rF1 = 1.77799353547498
    26	g_star = 0.758035078944663
    27	S_star = 0.658075937605429
    28	Pi_star = 1.50882951349316
    29	Sigma0_star = 1.80594111095636
    30	
    31	N = 2401
    32	x = np.linspace(0.0, 1.0, N)
    33	dx = x[1] - x[0]
    34	w = np.ones(N) * dx
    35	w[0] = w[-1] = dx / 2
    36	kappa = math.pi / 2
    37	c = np.cos(math.pi * x / 2)
    38	Kq = np.cosh(kappa * (1 - x)) / np.cosh(kappa)
    39	
    40	def normalize(sig: np.ndarray) -> np.ndarray:
    41	    return sig / np.sum(sig * w)
    42	
    43	def Ts(sig: np.ndarray) -> np.ndarray:
    44	    cum_sig = np.cumsum(sig * w)
    45	    cum_y = np.cumsum(x * sig * w)
    46	    return cum_y + x * (cum_sig[-1] - cum_sig)
    47	
    48	def Tq(sig: np.ndarray) -> np.ndarray:
    49	    A = np.cumsum(np.sinh(kappa * x) * sig * w)
    50	    B = np.cumsum((np.cosh(kappa * (1 - x)) * sig * w)[::-1])[::-1]
    51	    return (np.cosh(kappa * (1 - x)) * A + np.sinh(kappa * x) * B) / (kappa * np.cosh(kappa))
    52	
    53	def g(sig: np.ndarray) -> float:
    54	    return float(np.sum(c * sig * w))
    55	
    56	def S(sig: np.ndarray) -> float:
    57	    return float(np.sum(Kq * sig * w))
    58	
    59	def R(sig: np.ndarray) -> float:
    60	    gv = g(sig)
    61	    return ((gv - rF1) ** 2) / (1 + rF1**2)
    62	
    63	def Phi(sig: np.ndarray, Sigma0: float) -> np.ndarray:
    64	    return Sigma0 * (Ts(sig) - R(sig) * Tq(sig))
    65	
    66	def next_sigma(sig: np.ndarray, Sigma0: float) -> np.ndarray:
    67	    ph = Phi(sig, Sigma0)
    68	    return normalize(np.exp(-ph))
    69	
    70	def solve_fixed_point(Sigma0: float, maxit: int = 400) -> tuple[np.ndarray, int, float]:
    71	    sig = normalize(Pi_star * np.exp(-Pi_star * x))
    72	    for n in range(maxit):
    73	        sig_new = next_sigma(sig, Sigma0)
    74	        err = float(np.max(np.abs(sig_new - sig)))
    75	        sig = sig_new
    76	        if err < 1e-13:
    77	            return sig, n + 1, err
    78	    return sig, maxit, err
    79	
    80	banner("STAGE 155 — FROZEN-TRACTION CO-EVOLVING FIXED POINT")
    81	sig, niter, err = solve_fixed_point(Sigma0_star)
    82	g_fp = g(sig)
    83	S_fp = S(sig)
    84	R_fp = R(sig)
    85	Pi_fp = Sigma0_star * (1 - R_fp * S_fp)
    86	
    87	print("iterations =", niter)
    88	print("max residual =", err)
    89	print("g_fp =", g_fp)
    90	print("S_fp =", S_fp)
    91	print("R_fp =", R_fp)
    92	print("Pi_fp =", Pi_fp)
    93	
    94	assert abs(g_fp - 0.693352419668063) < 1e-12, ("g_fp mismatch", g_fp)
    95	assert abs(S_fp - 0.6216013167514007) < 1e-12, ("S_fp mismatch", S_fp)
    96	assert abs(R_fp - 0.2827139049082381) < 1e-12, ("R_fp mismatch", R_fp)
    97	assert abs(Pi_fp - 1.4885734438300713) < 1e-12, ("Pi_fp mismatch", Pi_fp)
    98	
    99	dg = sp.Float(g_fp - g_star, 30)
   100	r = sp.Float(rF1, 30)
   101	pred = sp.simplify(-dg / sp.sqrt(1 + r**2) + dg**2 / (1 + r**2))
   102	direct = sp.Float(R_fp - sp.Rational(1, 4), 30)
   103	print("delta R from direct solve =", direct)
   104	print("delta R from exact transport law =", pred)
   105	if abs(float(pred - direct)) > 1e-10:
   106	    raise AssertionError("Exact transport law failed numerically.")
   107	
   108	print("\nConclusion:")
   109	print("  At frozen canonical traction, the co-evolving fixed point remains close in Pi")
   110	print("  but drifts to R > 1/4, so exact compensation is lost.")

