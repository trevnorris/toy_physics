    80	R_can = sp.N(((g_star_num - rF1) ** 2) / (1 + rF1**2), 25)
    81	expect_close("R_can = 1/4", R_can, sp.Rational(1, 4))
    82	expect_close("Pi_can identity", Pi_can, Sigma0_can * (1 - sp.Rational(1, 4) * S_can))
    83	
    84	print("Sigma0_star =", Sigma0_star)
    85	print("T_hat_star  =", T_hat_star)
    86	print("Pi_star     =", Pi_star)
    87	print("Sigma0_can  =", Sigma0_can)
    88	print("T_hat_can   =", T_hat_can)
    89	print("S_can       =", S_can)
    90	print("Pi_can      =", Pi_can)
    91	
    92	if not (float(Sigma0_can) > float(Sigma0_star) and float(T_hat_can) > float(T_hat_star) and float(Pi_can) > float(Pi_star)):
    93	    raise AssertionError("Renormalized canonical tuple should sit strictly above the original canonical point.")
    94	
    95	banner("3. Tangent-on-family and even-preservation handoff")
    96	dg, dr = sp.symbols("delta_g delta_r", real=True)
    97	s = sp.sqrt(1 + r**2)
    98	gminus = sp.simplify(r - s / 2)
    99	gp = sp.diff(gminus, r)
   100	dR = sp.diff(R, g).subs(g, gminus) * dg + sp.diff(R, r).subs(g, gminus) * dr
   101	expect_zero("tangent motion keeps delta R = 0", dR.subs(dg, gp * dr))
   102	
   103	sigma_star = sp.symbols("sigma_star", real=True)
   104	deltaC, dkappa = sp.symbols("deltaC delta_kappa", real=True)
   105	dE2 = (deltaC - 9 * sigma_star * dkappa) / (27 * (1 - sigma_star))
   106	dE4 = (5 * deltaC - 72 * sigma_star * dkappa) / (243 * (1 - sigma_star))
   107	even_preservation = sp.solve([sp.Eq(dE2, 0), sp.Eq(dE4, 0)], [deltaC, dkappa], dict=True)
   108	print("canonical-even preservation solutions =", even_preservation)
   109	if even_preservation != [{deltaC: 0, dkappa: 0}]:
   110	    raise AssertionError("Canonical-even preservation should pin deltaC = delta kappa_W = 0.")
   111	
   112	sol_deltaC = sp.solve([sp.Eq(dE2, 0), sp.Eq(dE4, 0)], [deltaC, dkappa], dict=True)[0]
   113	deltaC_from_pair = sp.simplify(sol_deltaC[deltaC])
   114	expect_zero("delta C from canonical-even Solve", deltaC_from_pair)
   115	
   116	banner("4. Stage 158 expansion point")
   117	Sigma0, dSigma0, Sstar, dS = sp.symbols("Sigma0 delta_Sigma0 Sstar delta_S", real=True)
   118	Pi = (Sigma0 + dSigma0) * (1 - (sp.Rational(1, 4) + 0) * (Sstar + dS))
   119	Pi_lin = sp.expand(Pi).subs({dSigma0 * dS: 0})
   120	Pi0 = Sigma0 * (1 - Sstar / 4)
   121	dPi_expected = sp.expand((1 - Sstar / 4) * dSigma0 - Sigma0 * dS / 4)
   122	expect_zero("Stage 158 tangent expansion packet", (Pi_lin - Pi0) - dPi_expected)
   123	print("dPi_tan at the renormalized canonical point =", dPi_expected.subs({Sigma0: Sigma0_can, Sstar: S_can}))
   124	
   125	print("\nOpen branch note:")
   126	print("  This capstone closes the reduced co-evolving classification and basepoint data.")
   127	print("  It does not assert that the full moving-throat PDE has already realized the")
   128	print("  balance-selected branch; that remains the open microscopic question carried forward.")

