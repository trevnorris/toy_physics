\section[Stage 158]{Stage 158: Linear Defect Transport from the Renormalized Family-1 Canonical Point}
\label{stage:158}

\stagefield{Part / anchor}{Part IV; primary anchor \resultanchor{MTDC-T8}.}
\claimstatus{\StatusExactClosure{}.}

