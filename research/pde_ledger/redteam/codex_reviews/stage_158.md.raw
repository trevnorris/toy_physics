    16	  If[!MissingQ[detail], Print["  residual -> ", fmt[detail]]];
    17	  Exit[1];
    18	);
    19	
    20	expectZero[name_String, expr_] := Module[{res},
    21	  res = FullSimplify[Together[Expand[expr]], Assumptions -> $Assumptions];
    22	  Print[name, " = ", fmt[res]];
    23	  If[TrueQ[res === 0], pass[name], fail[name, res]];
    24	];
    25	
    26	banner["STAGE 158 — LINEAR DEFECT TRANSPORT AROUND THE RENORMALIZED CANONICAL POINT"];
    27	
    28	Clear[g, r, dg];
    29	$Assumptions = Element[{g, r, dg}, Reals];
    30	
    31	gStar = r - Sqrt[1 + r^2]/2;
    32	rFun = (g - r)^2/(1 + r^2);
    33	rShift = Expand[rFun /. g -> gStar + dg];
    34	rLin = Normal[Series[rShift, {dg, 0, 1}]];
    35	rExpected = Expand[1/4 - dg/Sqrt[1 + r^2]];
    36	expectZero["linear delta R law", rLin - rExpected];
    37	
    38	Clear[sigma0, dSigma0, rStar, dR];
    39	$Assumptions = Element[{sigma0, dSigma0, rStar, dR}, Reals];
    40	
    41	mQ = -(sigma0 + dSigma0)*(rStar + dR);
    42	mQLin = Expand[mQ] /. dSigma0*dR -> 0;
    43	mQ0 = -sigma0*rStar;
    44	expectZero["delta Mq law", (mQLin - mQ0) - (-rStar*dSigma0 - sigma0*dR)];
    45	
    46	Clear[sStar, dS];
    47	$Assumptions = Element[{sigma0, dSigma0, rStar, dR, sStar, dS}, Reals];
    48	
    49	piExpr = (sigma0 + dSigma0)*(1 - (rStar + dR)*(sStar + dS));
    50	piLin = Expand[piExpr] /. {dSigma0*dR -> 0, dSigma0*dS -> 0, dR*dS -> 0};
    51	pi0 = sigma0*(1 - rStar*sStar);
    52	dPiExpected = (1 - rStar*sStar)*dSigma0 - sigma0*(rStar*dS + sStar*dR);
    53	expectZero["delta Pi law", (piLin - pi0) - dPiExpected];
    54	
    55	Clear[dgSym, rSym];
    56	$Assumptions = Element[{sigma0, dSigma0, sStar, dS, dgSym, rSym}, Reals] && rSym > 0;
    57	dRFromDg = -dgSym/Sqrt[1 + rSym^2];
    58	
    59	dMqComposed = -(1/4)*dSigma0 - sigma0*dRFromDg;
    60	dMqBoxed = -(1/4)*dSigma0 + (sigma0/Sqrt[1 + rSym^2])*dgSym;
    61	expectZero["composed delta Mq law", Expand[dMqComposed - dMqBoxed]];
    62	
    63	dPiComposed = (1 - sStar/4)*dSigma0 - sigma0*((1/4)*dS + sStar*dRFromDg);
    64	dPiBoxed = (1 - sStar/4)*dSigma0 - (sigma0/4)*dS + (sigma0*sStar/Sqrt[1 + rSym^2])*dgSym;
    65	expectZero["composed delta Pi law", Expand[dPiComposed - dPiBoxed]];
    66	
    67	Clear[eps, s, b, a0, a5];
    68	$Assumptions = Element[{eps, s, b, a0, a5}, Reals];
    69	
    70	sNorm = 1 + eps*s;
    71	beta = 1 + eps*b;
    72	sigmaZero = eps*a0;
    73	sigmaFive = eps*a5;
    74	chi = FullSimplify[3*(sNorm*beta^5 + 9*sigmaFive)/(3*sNorm - sigmaZero)];
    75	chiLin = Expand[Normal[Series[chi, {eps, 0, 1}]]];
    76	chiExpected = 1 + eps*(5*b + a0/3 + 9*a5);
    77	expectZero["linear Delta_Q law", chiLin - chiExpected];
    78	
    79	banner["Numerical coefficients at the renormalized canonical point"];
    80	
    81	rF1 = SetPrecision[1.77799353547498, 30];
    82	sigma0Can = SetPrecision[4.651033550168876, 30];
    83	sCan = SetPrecision[0.6703621156734617, 30];
    84	tCan = SetPrecision[1.4467083664567624, 30];
    85	sqrt1 = Sqrt[1 + rF1^2];
    86	
    87	coefDRDG = N[-1/sqrt1, 20];
    88	coefDMQDSigma = -1/4;
    89	coefDMQDg = N[sigma0Can/sqrt1, 20];
    90	coefDPiDSigma = N[1 - sCan/4, 20];
    91	coefDPiDS = N[-sigma0Can/4, 20];
    92	coefDPiDG = N[sigma0Can*sCan/sqrt1, 20];
    93	coefDSigmaDT = N[(40/9)*tCan, 20];
    94	coefDPiDT = N[coefDPiDSigma*coefDSigmaDT, 20];
    95	
    96	Print["dR/dg        = ", fmt[coefDRDG]];
    97	Print["dMq/dSigma0  = ", fmt[coefDMQDSigma]];
    98	Print["dMq/dg       = ", fmt[coefDMQDg]];
    99	Print["dPi/dSigma0  = ", fmt[coefDPiDSigma]];
   100	Print["dPi/dS       = ", fmt[coefDPiDS]];
   101	Print["dPi/dg       = ", fmt[coefDPiDG]];
   102	Print["dSigma0/dThat= ", fmt[coefDSigmaDT]];
   103	Print["dPi/dThat    = ", fmt[coefDPiDT]];
   104	
   105	Print[""];
   106	Print["Carry-forward summary:"];
   107	Print["  delta R  = -(delta g)/sqrt(1+r_F1^2) + O(delta g^2)"];
   108	Print["  delta Mq = -(1/4) delta Sigma0 + Sigma0_can/sqrt(1+r_F1^2) delta g + O(2)"];
   109	Print["  delta Pi = (1-S_can/4) delta Sigma0 - (Sigma0_can/4) delta S + Sigma0_can*S_can/sqrt(1+r_F1^2) delta g + O(2)"];
   110	Print["  Delta_Q  = 5 b + a0/3 + 9 a5 + O(2)"];
   111	
   112	Print[""];
   113	Print["Stage 158 Mathematica audit passed."];
   114	
   115	Exit[0];

