     1	#!/usr/bin/env python3
     2	"""
     3	moving_throat_pde_stage160_bare_mixed_port_slippage_sympy_audit.py
     4	
     5	SymPy-backed audit for Stage 160.
     6	
     7	Checks:
     8	1. Exact compensated-branch identity
     9	     d gamma_W - (1/3) d kappa_W
    10	     = (d gamma_0 - (1/3) d kappa_0)/(1+r_c)
    11	   for the concrete core model.
    12	2. Collapse under the Stage 159 canonical-even gate d kappa_W = 0.
    13	3. Pure-scale harmlessness: if d gamma_0 = d kappa_0 / 3 then d gamma_W = 0.
    14	4. Final defect laws after inserting the tangential-mouth transport.
    15	"""
    16	
    17	from __future__ import annotations
    18	import sympy as sp
    19	
    20	def banner(title: str) -> None:
    21	    line = "=" * 88
    22	    print("\n" + line)
    23	    print(title)
    24	    print(line)
    25	
    26	def expect_zero(name: str, expr: sp.Expr) -> None:
    27	    expr = sp.simplify(sp.expand(expr))
    28	    print(f"{name} = {expr}")
    29	    if expr != 0:
    30	        raise AssertionError(f"{name} is not zero")
    31	
    32	banner("STAGE 160 — BARE MIXED-PORT SLIPPAGE THEOREM")
    33	
    34	eps = sp.symbols("eps", real=True)
    35	rc, drc = sp.symbols("r_c dr_c", real=True)
    36	dk0, dg0 = sp.symbols("dκ0 dγ0", real=True)
    37	
    38	k0_star = (1 + rc) / 3
    39	g0_star = (1 + rc) / 9
    40	
    41	kW = ((k0_star + eps * dk0) / (1 + rc + eps * drc)).series(eps, 0, 2).removeO()
    42	gW = ((g0_star + eps * dg0) / (1 + rc + eps * drc)).series(eps, 0, 2).removeO()
    43	
    44	dkW = sp.expand(kW.coeff(eps, 1))
    45	dgW = sp.expand(gW.coeff(eps, 1))
    46	
    47	print("dκ_W =", sp.simplify(dkW))
    48	print("dγ_W =", sp.simplify(dgW))
    49	
    50	identity = dgW - sp.Rational(1, 3) * dkW - (dg0 - sp.Rational(1, 3) * dk0) / (1 + rc)
    51	expect_zero("exact compensated-branch slippage identity", identity)
    52	
    53	# Canonical-even gate dκ_W = 0
    54	dgW_gate = sp.simplify(((dg0 - sp.Rational(1, 3) * dk0) / (1 + rc)))
    55	print("dγ_W under dκ_W = 0 =", dgW_gate)
    56	
    57	# Pure-scale harmlessness
    58	dgW_purescale = sp.simplify(dgW_gate.subs(dg0, dk0 / 3))
    59	expect_zero("pure-scale harmlessness", dgW_purescale)
    60	
    61	banner("Tangential DtN susceptibility and final defect law")
    62	
    63	UpsilonPi = sp.symbols("Upsilon_Pi", real=True)
    64	dSigma0, dS, sigma_star = sp.symbols("dSigma0 dS sigma_*", real=True)
    65	
    66	dPi_tan = sp.Float("0.832409471081635") * dSigma0 - sp.Float("1.16275838754222") * dS
    67	dgW_tan = sp.simplify(UpsilonPi * dPi_tan / (1 + rc))
    68	DeltaQ = sp.simplify(-9 * sigma_star * dgW_tan / (1 - sigma_star))
    69	NQm1 = sp.simplify(9 * sigma_star * dgW_tan / (1 - sigma_star))
    70	
    71	print("dPi_tan =", dPi_tan)
    72	print("dγ_W =", dgW_tan)
    73	print("Δ_Q =", DeltaQ)
    74	print("N_Q - 1 =", NQm1)
    75	
    76	banner("Carry-forward formulas")
    77	print("1) dγ_W - (1/3)dκ_W = (dγ_0 - (1/3)dκ_0)/(1+r_c)")
    78	print("2) with dκ_W = 0: dγ_W = (dγ_0 - (1/3)dκ_0)/(1+r_c)")
    79	print("3) if dγ_0 = dκ_0/3, then dγ_W = 0")
    80	print("4) if dγ_0 - dκ_0/3 = Upsilon_Pi dPi_tan, then")
    81	print("   Δ_Q = -9 σ_* Upsilon_Pi dPi_tan / [(1-σ_*)(1+r_c)]")
    82	print("   N_Q-1 = +9 σ_* Upsilon_Pi dPi_tan / [(1-σ_*)(1+r_c)]")

