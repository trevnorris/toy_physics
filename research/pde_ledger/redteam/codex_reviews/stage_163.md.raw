    88	# 3. Outlet-defect transport
    89	# ------------------------------------------------------------------
    90	sigma_star, dkappaW, dgammaW = sp.symbols("sigma_star dkapW dgamW", real=True)
    91	deltaC = 16 * sigma_star * delta_perp / s
    92	
    93	# Stage 159 outlet transport packet carried into the off-family normal frame.
