     9	2. Exact compensation-ratio transport through the off-family normal coordinate.
    10	3. Exact microscopic parent-variable formula for delta_perp.
    11	4. Exact outlet-defect transport formulas.
    12	5. Tangent/normal split of the mouth-bias transport.
    13	
    14	Provenance notes
    15	----------------
    16	- `gminus` is the same lower compensated branch called `g_lower` in Stage 162;
    17	  the script renames it only to keep the calculus notation compact.
    18	- The Family-1 numbers at the end are carried readbacks from the Stage 162/146
    19	  benchmark branch and are used only as numeric coefficient summaries.
    20	"""
    21	
    22	from __future__ import annotations
    23	import sympy as sp
    24	
    25	
    26	def banner(title: str) -> None:
    27	    line = "=" * 88
    28	    print("\n" + line)
    29	    print(title)
    30	    print(line)
    31	
    32	
    33	def expect_zero(name: str, expr: sp.Expr) -> None:
    34	    expr = sp.simplify(sp.expand(expr))
    35	    print(f"{name} = {expr}")
    36	    if expr != 0:
    37	        raise AssertionError(f"{name} is not zero")
    38	
    39	
    40	banner("STAGE 163 — OFF-FAMILY NORMAL COORDINATE")
    41	
    42	# ------------------------------------------------------------------
    43	# 1. Parent compensation defect and compensation-ratio transport
    44	# ------------------------------------------------------------------
    45	r, g = sp.symbols("r g", positive=True, real=True)
    46	s = sp.sqrt(1 + r**2)
    47	# Stage 162 lower compensated branch `g_lower`, renamed here to `gminus`.
    48	gminus = r - s / 2
    49	
    50	dg, dr = sp.symbols("dg dr", real=True)
    51	gp = sp.diff(gminus, r)
    52	F = 1 + r**2 - 4 * (g - r) ** 2
    53	R = (g - r) ** 2 / (1 + r**2)
    54	
    55	delta_perp = dg - gp * dr
    56	
    57	dF = sp.diff(F, g).subs(g, gminus) * dg + sp.diff(F, r).subs(g, gminus) * dr
    58	dR = sp.diff(R, g).subs(g, gminus) * dg + sp.diff(R, r).subs(g, gminus) * dr
    59	
    60	expect_zero("delta F - 4 s delta_perp", dF - 4 * s * delta_perp)
    61	expect_zero("delta R + delta_perp/s", dR + delta_perp / s)
    62	expect_zero("even-preserving tangent motion keeps delta F = 0", dF.subs(dg, gp * dr))
    63	expect_zero("even-preserving tangent motion keeps delta R = 0", dR.subs(dg, gp * dr))
    64	print("g_-'(r) =", sp.simplify(gp))
    65	
    66	# ------------------------------------------------------------------
    67	# 2. Microscopic parent-variable formula for delta_perp
    68	# ------------------------------------------------------------------
    69	Ks, Kq, lam, gs, gq = sp.symbols("K_s K_q lam g_s g_q", positive=True, real=True)
    70	dln_Ks, dln_Kq, dln_lam, dln_gs, dln_gq = sp.symbols(
    71	    "dln_Ks dln_Kq dln_lam dln_gs dln_gq", real=True
    72	)
    73	
    74	# Linearized parent ratios on the lower compensated branch.
    75	delta_r = r * (dln_lam - sp.Rational(1, 2) * dln_Ks - sp.Rational(1, 2) * dln_Kq)
    76	delta_g = gminus * (dln_gq - dln_gs + sp.Rational(1, 2) * dln_Ks - sp.Rational(1, 2) * dln_Kq)
