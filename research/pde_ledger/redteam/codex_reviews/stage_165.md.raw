    39	# 1. D/N law
    40	LW_law = sp.pi * a * sp.sqrt(1 + r**2) / (2 * sp.sqrt(3))
    41	dlog_LW = sp.simplify(a * sp.diff(sp.log(LW_law), a))
    42	print("D/N law: L_W =", LW_law)
    43	print("At fixed r_* : d ln L_W = d ln a")
    44	expect_zero("d ln L_W - d ln a at fixed r_*", dlog_LW - 1)
    45	
    46	# 2. Fixed-r and fixed-g channel conditions from Stage 164
    47	eq_r = sp.Eq(dZ + 2*dcs + 3*dcsw - drho - 2*dv - 2*da - 3*dLW, 0)
    48	eq_g = sp.Eq(dZ + 3*dcsw - drho - dT - dv - 2*da - 2*dLW, 0)
    49	sol = sp.solve([eq_r, eq_g], [dv, dT], dict=True)[0]
    50	dv_sol = sp.simplify(sol[dv])
    51	dT_sol = sp.simplify(sol[dT])
    52	
    53	print("\nExact drift laws before using d ln L_W = d ln a:")
    54	print("d ln v_w0 =", dv_sol)
    55	print("d ln T_m  =", dT_sol)
