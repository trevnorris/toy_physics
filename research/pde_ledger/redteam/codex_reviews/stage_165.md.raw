    15	from __future__ import annotations
    16	import sympy as sp
    17	
    18	def banner(title: str) -> None:
    19	    line = "=" * 88
    20	    print("\n" + line)
    21	    print(title)
    22	    print(line)
    23	
    24	def expect_zero(name: str, expr: sp.Expr) -> None:
    25	    expr = sp.simplify(sp.expand(expr))
    26	    print(f"{name} = {expr}")
    27	    if expr != 0:
    28	        raise AssertionError(f"{name} is not zero")
    29	
    30	banner("STAGE 165 — EXACT LOWER-BRANCH DRIFT LAWS")
    31	
    32	dZ, drho, dcsw, dcs, dT, dv, da, dLW = sp.symbols(
    33	    "dZ drho dcsw dcs dT dv da dLW", real=True
    34	)
    35	
    36	r = sp.symbols("r", positive=True, real=True)
    37	a, LW = sp.symbols("a LW", positive=True, real=True)
