     1	#!/usr/bin/env python3
     2	"""
     3	moving_throat_pde_stage166_bundle_inversion_four_drifts_sympy_audit.py
     4	
     5	SymPy audit for Stage 166.
     6	
     7	Checks:
     8	1. Solve the exact logarithmic inversion system
     9	      Theta_w, K_s, K_q, P_0  ->  rho_w, a, c_s, Z_q.
    10	2. Verify the forward transport identities after substitution.
    11	3. Verify the equivalent bundle form using P_0 = N_0 / D_0.
    12	4. Report the explicit Family-1 frozen-wall simplification and rho_w^(chi).
    13	"""
    14	
    15	from __future__ import annotations
    16	import sympy as sp
    17	
    18	
    19	def banner(title: str) -> None:
    20	    line = "=" * 88
    21	    print("\n" + line)
    22	    print(title)
    23	    print(line)
    24	
    25	
    26	def expect_zero(name: str, expr: sp.Expr) -> None:
    27	    expr = sp.simplify(sp.expand(expr))
    28	    print(f"{name} = {expr}")
    29	    if expr != 0:
    30	        raise AssertionError(f"{name} is not zero")
    31	
    32	
    33	banner("STAGE 166 — EXACT BUNDLE INVERSION OF THE LAST FOUR DRIFTS")
    34	
    35	dTheta, dKs, dKq, dP = sp.symbols("dTheta dKs dKq dP", real=True)
    36	drho, da, dcs, dZ = sp.symbols("drho da dcs dZ", real=True)
    37	dN0, dD0 = sp.symbols("dN0 dD0", real=True)
    38	
    39	# Exact logarithmic branch laws used in the note.
    40	eq1 = sp.Eq(dTheta, 2 * drho)
    41	eq2 = sp.Eq(dKs, 2 * da + drho)
    42	eq3 = sp.Eq(dKq, dZ + 2 * dcs - 2 * da)
    43	eq4 = sp.Eq(dP, 5 * (dcs - da))
    44	
    45	sol = sp.solve((eq1, eq2, eq3, eq4), (drho, da, dcs, dZ), dict=True)[0]
    46	
    47	print("drho =", sp.simplify(sol[drho]))
    48	print("da   =", sp.simplify(sol[da]))
    49	print("dcs  =", sp.simplify(sol[dcs]))
    50	print("dZ   =", sp.simplify(sol[dZ]))
    51	
    52	banner("General inversion forms (paper Sec. 2)")
    53	expect_zero("drho general", sol[drho] - sp.Rational(1, 2) * dTheta)
    54	expect_zero("da general", sol[da] - (sp.Rational(1, 2) * dKs - sp.Rational(1, 4) * dTheta))
    55	expect_zero("dcs general", sol[dcs] - (sp.Rational(1, 2) * dKs - sp.Rational(1, 4) * dTheta + sp.Rational(1, 5) * dP))
    56	expect_zero("dZ general", sol[dZ] - (dKq - sp.Rational(2, 5) * dP))
    57	
    58	banner("Forward verification")
    59	expect_zero("Theta law", eq1.lhs.subs(sol) - eq1.rhs.subs(sol))
    60	expect_zero("Ks law", eq2.lhs.subs(sol) - eq2.rhs.subs(sol))
    61	expect_zero("Kq law", eq3.lhs.subs(sol) - eq3.rhs.subs(sol))
    62	expect_zero("P0 law", eq4.lhs.subs(sol) - eq4.rhs.subs(sol))
    63	
    64	banner("Equivalent full-bundle form with P_0 = N_0 / D_0")
    65	sol_bundle = {
