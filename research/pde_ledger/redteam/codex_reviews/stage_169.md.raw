     1	#!/usr/bin/env python3
     2	"""
     3	moving_throat_pde_stage169_no_linear_p2_scalar_slippage_sympy_audit.py
     4	
     5	SymPy-backed audit for Stage 169.
     6	
     7	Checks:
     8	1. Exact grouped bilinear invariant formula I[x,y] = (1/5) dx^T G dy = 4 a_x a_y + (4/5) b_x b_y.
     9	2. Weak axisymmetric branch law b = 3 a and I[x,y] = (7/10) eps^2 x1 y1.
    10	3. Explicit Y20 average vanishes, so the linear term of a scalar log-observable vanishes.
    11	4. Stage 168 weighted combination transports the quadratic grouped invariants into eps_perp.
    12	"""
    13	
    14	from __future__ import annotations
    15	import sympy as sp
    16	
    17	def banner(title: str) -> None:
    18	    line = "=" * 88
    19	    print("\n" + line)
    20	    print(title)
    21	    print(line)
    22	
    23	
    24	def expect_zero(name: str, expr: sp.Expr) -> None:
    25	    expr = sp.simplify(sp.expand(expr))
    26	    print(f"{name} = {expr}")
    27	    if expr != 0:
    28	        raise AssertionError(f"{name} is not zero")
    29	
    30	banner("STAGE 169 — NO LINEAR GROUPED-P2 SCALAR SLIPPAGE")
    31	
    32	# ---------------------------------------------------------------------------
    33	# 1. Exact grouped bilinear invariant
    34	# ---------------------------------------------------------------------------
    35	xb20, xb21, xb22 = sp.symbols('x20 x21 x22', real=True)
    36	yb20, yb21, yb22 = sp.symbols('y20 y21 y22', real=True)
    37	
    38	x = sp.Matrix([xb20, xb21, xb22])
    39	y = sp.Matrix([yb20, yb21, yb22])
    40	G = sp.diag(1, 2, 2)
    41	ebar = sp.Matrix([1, 1, 1])
    42	
    43	xbar = (xb20 + 2*xb21 + 2*xb22) / 5
    44	ybar = (yb20 + 2*yb21 + 2*yb22) / 5
    45	
    46	ax = (2*xb20 - xb21 - xb22) / 10
    47	bx = (xb21 - xb22) / 2
    48	ay = (2*yb20 - yb21 - yb22) / 10
    49	by = (yb21 - yb22) / 2
    50	
    51	dx = x - xbar*ebar
    52	dy = y - ybar*ebar
    53	
    54	Ixy = sp.simplify((dx.T * G * dy)[0] / 5)
    55	Ixy_expected = sp.simplify(4*ax*ay + sp.Rational(4,5)*bx*by)
    56	
    57	banner("Grouped bilinear invariant")
    58	print("I[x,y] =", Ixy)
    59	expect_zero("I[x,y] - [4 a_x a_y + 4/5 b_x b_y]", Ixy - Ixy_expected)
    60	
    61	# ---------------------------------------------------------------------------
    62	# 2. Weak axisymmetric branch law
    63	# ---------------------------------------------------------------------------
    64	eps, x1, y1, x0, y0 = sp.symbols('eps x1 y1 x0 y0', real=True)
    65	subs_axis = {
    66	    xb20: x0 + eps*x1,
    67	    xb21: x0 + eps*x1/2,
    68	    xb22: x0 - eps*x1,
    69	    yb20: y0 + eps*y1,
    70	    yb21: y0 + eps*y1/2,
    71	    yb22: y0 - eps*y1,
    72	}
    73	
    74	ax_axis = sp.simplify(ax.subs(subs_axis))
    75	bx_axis = sp.simplify(bx.subs(subs_axis))
    76	Ixy_axis = sp.simplify(Ixy.subs(subs_axis))
    77	
    78	banner("Weak axisymmetric grouped law")
    79	print("a_x(axis) =", ax_axis)
    80	print("b_x(axis) =", bx_axis)
    81	expect_zero("b_x - 3 a_x", bx_axis - 3*ax_axis)
    82	expect_zero("I_axis - (7/10) eps^2 x1 y1", Ixy_axis - sp.Rational(7,10)*eps**2*x1*y1)
    83	
    84	# ---------------------------------------------------------------------------
    85	# 3. Explicit Y20 average and no linear scalar feed-down
    86	# ---------------------------------------------------------------------------
    87	th, ph = sp.symbols('th ph', real=True)
    88	Y20 = sp.sqrt(sp.Integer(5)/(16*sp.pi)) * (3*sp.cos(th)**2 - 1)
    89	
    90	def sphere_avg(expr: sp.Expr) -> sp.Expr:
    91	    return sp.simplify(
    92	        sp.integrate(sp.integrate(expr*sp.sin(th), (ph, 0, 2*sp.pi)), (th, 0, sp.pi)) / (4*sp.pi)
    93	    )
    94	
    95	banner("Explicit harmonic average")
    96	Y20_avg = sphere_avg(Y20)
    97	Y20_sq_avg = sphere_avg(Y20**2)
    98	print("<Y20> =", Y20_avg)
    99	print("<Y20^2> =", Y20_sq_avg)
   100	expect_zero("average Y20", Y20_avg)
   101	expect_zero("average Y20^2 - 1/(4 pi)", Y20_sq_avg - 1/(4*sp.pi))
   102	
   103	X0, e = sp.symbols('X0 e', positive=True, real=True)
   104	log_series = sp.expand(sp.log(X0*(1 + e*Y20)).series(e, 0, 3).removeO())
   105	log_avg = sp.simplify(sphere_avg(log_series))
   106	lin_coeff = sp.simplify(sp.diff(log_avg, e).subs(e, 0))
   107	
   108	print("<log(X0 (1 + e Y20))> through O(e^2) =", log_avg)
   109	expect_zero("linear coefficient in averaged log-observable", lin_coeff)
   110	
   111	# ---------------------------------------------------------------------------
   112	# 4. Stage 168 transport into eps_perp
   113	# ---------------------------------------------------------------------------
   114	XiL, Xiv, XiT, Igrp = sp.symbols('XiL Xiv XiT Igrp', real=True)
   115	g, r = sp.symbols('g r', positive=True, real=True)
   116	s = sp.sqrt(1 + r**2)
   117	
   118	# model one quadratic grouped invariant contribution Igrp
   119	# eps_L = XiL Igrp, eps_v = Xiv Igrp, eps_T = XiT Igrp
   120	
   121	eps_perp = g*XiT*Igrp + (g + sp.Rational(1,2)/s)*Xiv*Igrp + (2*g + sp.Rational(3,4)/s)*XiL*Igrp
   122	Xi_perp = g*XiT + (g + sp.Rational(1,2)/s)*Xiv + (2*g + sp.Rational(3,4)/s)*XiL
   123	
   124	banner("Stage 168 weighted transport")
   125	expect_zero("eps_perp - Xi_perp Igrp", eps_perp - Xi_perp*Igrp)
   126	
   127	r_num = sp.Float('1.77799353547498', 30)
   128	g_num = sp.Float('0.758035078944663', 30)
   129	s_num = sp.sqrt(1 + r_num**2)
   130	Xi_perp_num = sp.N(Xi_perp.subs({g: g_num, r: r_num}), 20)
   131	print("Numeric Xi_perp combination =", Xi_perp_num)
   132	
   133	coeff_T = sp.N(Xi_perp.coeff(XiT).subs({g: g_num, r: r_num}), 20)
   134	coeff_v = sp.N(Xi_perp.coeff(Xiv).subs({g: g_num, r: r_num}), 20)
   135	coeff_L = sp.N(Xi_perp.coeff(XiL).subs({g: g_num, r: r_num}), 20)
   136	for name, got, want in [
   137	    ("Xi_perp coeff on XiT", coeff_T, sp.Float('0.758035078944663', 20)),
   138	    ("Xi_perp coeff on Xiv", coeff_v, sp.Float('1.00314310113848', 20)),
   139	    ("Xi_perp coeff on XiL", coeff_L, sp.Float('1.88373219118005', 20)),
   140	]:
   141	    diff = sp.Abs(got - want)
   142	    print(f"{name} = {got} (paper {want}, |diff| = {diff})")
   143	    if diff > sp.Float('1e-12', 20):
   144	        raise AssertionError(f"{name} disagrees with paper value {want}")
   145	
   146	print("\nCarry-forward formulas:")
   147	print("  I[x,y] = (1/5) (x-xbar ebar)^T Ggrp (y-ybar ebar) = 4 a_x a_y + (4/5) b_x b_y")
   148	print("  Pure grouped P2 anisotropy has no linear scalar feed-down on an isotropic branch.")
   149	print("  Weak axisymmetric branch: b = 3 a and I[x,y] = (7/10) eps^2 x^(1) y^(1).")
   150	print("  Therefore grouped-lane anisotropy enters eps_L, eps_v, eps_T, eps_perp only quadratically.")

