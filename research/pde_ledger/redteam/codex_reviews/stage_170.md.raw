    44	D4 = -D0 / 27
    45	
    46	eps = sp.symbols('eps', real=True)
    47	
    48	u2_full = - (D2 + eps*dD2) / (D0 + eps*dD0)
    49	u4_full = ((D2 + eps*dD2)**2 - (D0 + eps*dD0) * (D4 + eps*dD4)) / (D0 + eps*dD0)**2
    50	P0_full = (N0 + eps*dN0) / (D0 + eps*dD0)
    51	
    52	du2 = sp.expand(sp.series(u2_full, eps, 0, 2).removeO()).coeff(eps, 1)
    53	du4 = sp.expand(sp.series(u4_full, eps, 0, 2).removeO()).coeff(eps, 1)
    54	dP0 = sp.expand(sp.series(P0_full.subs(N0, P0*D0), eps, 0, 2).removeO()).coeff(eps, 1)
    55	
    56	banner("Linear grouped conservative/output transport")
    57	expect_zero("delta u2 + (dD2 + dD0/9)/D0", du2 + (dD2 + dD0/9)/D0)
    58	expect_zero("delta u4 + (dD4 + 2 dD2/9 + 5 dD0/81)/D0", du4 + (dD4 + 2*dD2/9 + 5*dD0/81)/D0)
    59	expect_zero("delta P0 - (dN0 - P0 dD0)/D0", dP0 - (dN0 - P0*dD0)/D0)
    60	
    61	# ---------------------------------------------------------------------------
    62	# 2. Direct outlet map
    63	# ---------------------------------------------------------------------------
    64	dkappa, dgamma = sp.symbols('dkappa dgamma', real=True)
    65	
    66	du2_hyb = - sigma * dkappa / (3 * (1 - sigma))
    67	dP0_over_P0_hyb = - 9 * sigma * dgamma / (1 - sigma)
    68	
    69	dkappa_from_du2 = sp.solve(sp.Eq(sp.Symbol('du2sym'), du2_hyb), dkappa)[0].subs(sp.Symbol('du2sym'), du2)
    70	dgamma_from_dP0 = sp.solve(sp.Eq(sp.Symbol('dP0sym')/P0, dP0_over_P0_hyb), dgamma)[0].subs(sp.Symbol('dP0sym'), dP0)
    71	
    72	banner("Direct outlet coefficients")
    73	expect_zero(
    74	    "delta kappa_W - 3(1-sigma)(dD2 + dD0/9)/(sigma D0)",
    75	    dkappa_from_du2 - 3*(1-sigma)*(dD2 + dD0/9)/(sigma*D0)
    76	)
    77	expect_zero(
    78	    "delta gamma_W + (1-sigma)(dN0 - P0 dD0)/(9 sigma N0)",
    79	    dgamma_from_dP0.subs(P0, N0/D0) + (1-sigma)*(dN0 - (N0/D0)*dD0)/(9*sigma*N0)
    80	)
    81	
    82	# ---------------------------------------------------------------------------
    83	# 3. Even one-parameter consistency relation
    84	# ---------------------------------------------------------------------------
    85	du4_from_hyb = -8 * sigma * dkappa / (27 * (1 - sigma))
    86	du4_from_kappa = sp.simplify(du4_from_hyb.subs(dkappa, dkappa_from_du2))
    87	
    88	banner("Even one-parameter consistency")
    89	expect_zero("delta u4 - (8/9) delta u2", du4_from_kappa - sp.Rational(8,9) * du2)
    90	relation = sp.simplify(sp.solve(sp.Eq(du4, sp.Rational(8,9)*du2), dD4)[0])
    91	expect_zero("delta D4 - (2/3) delta D2 - dD0/27", relation - (sp.Rational(2,3)*dD2 + dD0/27))
    92	
    93	# ---------------------------------------------------------------------------
    94	# 4. Grouped trace/anomaly formulas
    95	# ---------------------------------------------------------------------------
    96	aD0, aD2, aD4, aN0 = sp.symbols('aD0 aD2 aD4 aN0', real=True)
    97	bD0, bD2, bD4, bN0 = sp.symbols('bD0 bD2 bD4 bN0', real=True)
    98	
    99	a_kappa = sp.simplify(3*(1-sigma)*(aD2 + aD0/9)/(sigma*D0))
   100	b_kappa = sp.simplify(3*(1-sigma)*(bD2 + bD0/9)/(sigma*D0))
   101	
   102	a_gamma = sp.simplify(-(1-sigma)*(aN0 - P0*aD0)/(9*sigma*N0))
   103	b_gamma = sp.simplify(-(1-sigma)*(bN0 - P0*bD0)/(9*sigma*N0))
   104	P0_ref = sp.simplify(N0 / D0)
   105	
   106	a_kappa_from_map = sp.simplify(sp.expand(dkappa_from_du2.subs({dD2: aD2, dD0: aD0})))
   107	b_kappa_from_map = sp.simplify(sp.expand(dkappa_from_du2.subs({dD2: bD2, dD0: bD0})))
   108	a_gamma_from_map = sp.simplify(sp.expand(dgamma_from_dP0.subs({dN0: aN0, dD0: aD0})))
   109	b_gamma_from_map = sp.simplify(sp.expand(dgamma_from_dP0.subs({dN0: bN0, dD0: bD0})))
   110	
   111	banner("Grouped trace/anomaly transport")
   112	print("a_kappa =", a_kappa)
   113	print("b_kappa =", b_kappa)
   114	print("a_gamma =", a_gamma)
   115	print("b_gamma =", b_gamma)
   116	print("a_kappa from map =", a_kappa_from_map)
   117	print("b_kappa from map =", b_kappa_from_map)
   118	print("a_gamma from map =", a_gamma_from_map)
   119	print("b_gamma from map =", b_gamma_from_map)
   120	expect_zero("trace kappa coefficient", a_kappa_from_map - a_kappa)
   121	expect_zero("anomaly kappa coefficient", b_kappa_from_map - b_kappa)
   122	expect_zero(
   123	    "trace gamma coefficient",
   124	    sp.simplify(a_gamma_from_map.subs(P0, P0_ref) - a_gamma.subs(P0, P0_ref)),
   125	)
   126	expect_zero(
   127	    "anomaly gamma coefficient",
   128	    sp.simplify(b_gamma_from_map.subs(P0, P0_ref) - b_gamma.subs(P0, P0_ref)),
   129	)
   130	
   131	# ---------------------------------------------------------------------------
   132	# 5. Weak-axisymmetric branch: signature (1, 1/2, -1) and scalar amplitudes
   133	#    (paper Sec. 5 / card Checks item 2)
   134	# ---------------------------------------------------------------------------
   135	# On the weak-axisymmetric Y_20 branch the grouped bundle defects scale as
   136	#   delta D_(A,n) = eps * lambda_A * D_n^(1),  delta N_(A,0) = eps * lambda_A * N_0^(1)
   137	# with (lambda_20, lambda_21, lambda_22) = (1, 1/2, -1). Feeding these lane-scaled
   138	# inputs through the SAME linear outlet maps verified in Sec. 2 must reproduce the
   139	# grouped signature on delta kappa_W / delta gamma_W and collapse to two scalar
   140	# amplitudes kappa1, gamma1 with the closed forms boxed in notes Sec. 5.
   141	D0_1, D2_1, N0_1 = sp.symbols('D0_1 D2_1 N0_1', real=True)
   142	eps_l = sp.symbols('eps_l', real=True)
   143	
   144	def kappa_map(dD2_, dD0_):
   145	    return 3*(1 - sigma)*(dD2_ + dD0_/9)/(sigma*D0)
   146	
   147	def gamma_map(dN0_, dD0_):
   148	    return -(1 - sigma)*(dN0_ - P0*dD0_)/(9*sigma*N0)
   149	
   150	kappa1 = 3*(1 - sigma)*(D2_1 + D0_1/9)/(sigma*D0)
   151	gamma1 = -(1 - sigma)*(N0_1 - P0*D0_1)/(9*sigma*N0)
   152	
   153	banner("Weak-axisymmetric signature (1, 1/2, -1) and scalar amplitudes")
   154	lanes = {20: sp.Integer(1), 21: sp.Rational(1, 2), 22: sp.Integer(-1)}
   155	dkW = {}
   156	dgW = {}
   157	for A, lam in lanes.items():
   158	    dkW[A] = kappa_map(eps_l*lam*D2_1, eps_l*lam*D0_1)
   159	    dgW[A] = gamma_map(eps_l*lam*N0_1, eps_l*lam*D0_1)
   160	    expect_zero(f"delta kappa_W^({A}) - eps lambda kappa1", dkW[A] - eps_l*lam*kappa1)
   161	    expect_zero(f"delta gamma_W^({A}) - eps lambda gamma1", dgW[A] - eps_l*lam*gamma1)
   162	# grouped signature ratios (lambda_20, lambda_21, lambda_22) = (1, 1/2, -1)
   163	expect_zero("kappa signature: 21 = (1/2) 20", dkW[21] - sp.Rational(1, 2)*dkW[20])
   164	expect_zero("kappa signature: 22 = -20", dkW[22] + dkW[20])
   165	expect_zero("gamma signature: 21 = (1/2) 20", dgW[21] - sp.Rational(1, 2)*dgW[20])
   166	expect_zero("gamma signature: 22 = -20", dgW[22] + dgW[20])
   167	
   168	print("\nCarry-forward formulas:")
   169	print("  delta kappa_W^(A) = 3(1-sigma_*) [delta D_(A,2) + delta D_(A,0)/9] / (sigma_* D0)")
   170	print("  delta gamma_W^(A) = -(1-sigma_*) [delta N_(A,0) - P0 delta D_(A,0)] / (9 sigma_* N0)")
   171	print("  direct even-pole consistency: delta D_(A,4) = (2/3) delta D_(A,2) + delta D_(A,0)/27")
   172	print("  so the full linear grouped-anisotropy outlet problem collapses to the pair")
   173	print("      K_A := delta D_(A,2) + delta D_(A,0)/9")
   174	print("      G_A := delta N_(A,0) - P0 delta D_(A,0)")

