    62	expect_zero("delta B2 formula", dB2_exact - dB2_formula)
    63	
    64	Bcomb_exact = sp.expand(dB2_exact + sp.Rational(1, 9) * dB0_exact)
    65	Bcomb_formula = sp.expand(
    66	    2 * c * (1 / w**4 + 1 / (9 * w**2)) * dc
    67	    - 2 * c**2 * (2 / w**5 + 1 / (9 * w**3)) * dw
    68	)
    69	expect_zero("BdG obstruction bundle", Bcomb_exact - Bcomb_formula)
    70	
    71	# ---------------------------------------------------------------------------
    72	# 3. Exact portwise Maxwell/mixed linearization.
    73	# ---------------------------------------------------------------------------
    74	
    75	U, W, R = sp.symbols('U W R', nonzero=True)
