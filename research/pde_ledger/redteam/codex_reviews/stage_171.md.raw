    39	K_exact = sp.expand((-dM - dB2 - dZ2) + sp.Rational(1, 9) * (dK - dB0 - dZ0))
    40	K_split = sp.expand((sp.Rational(1, 9) * dK - dM) - (dB2 + sp.Rational(1, 9) * dB0) - (dZ2 + sp.Rational(1, 9) * dZ0))
    41	expect_zero("K_A split", K_exact - K_split)
    42	
    43	G_exact = sp.expand(dN0 - P0 * (dK - dB0 - dZ0))
    44	G_split = sp.expand(-P0 * dK + P0 * dB0 + (dN0 + P0 * dZ0))
    45	expect_zero("G_A split", G_exact - G_split)
    46	
    47	# ---------------------------------------------------------------------------
    48	# 2. Exact BdG linearization.
    49	# ---------------------------------------------------------------------------
    50	
    51	c, w = sp.symbols('c w', nonzero=True)
    52	dc, dw = sp.symbols('dc dw')
    53	B0 = c**2 / w**2
    54	B2 = c**2 / w**4
    55	
    56	dB0_exact = sp.diff(B0, c) * dc + sp.diff(B0, w) * dw
    57	dB2_exact = sp.diff(B2, c) * dc + sp.diff(B2, w) * dw
    58	
    59	dB0_formula = 2 * c * dc / w**2 - 2 * c**2 * dw / w**3
    60	dB2_formula = 2 * c * dc / w**4 - 4 * c**2 * dw / w**5
