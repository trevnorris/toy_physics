    29	# ---------------------------------------------------------------------------
    30	# 1. Exact decomposition of K_A and G_A.
    31	# ---------------------------------------------------------------------------
    32	
    33	P0 = sp.symbols('P0', nonzero=True)
    34	dK, dM = sp.symbols('dK dM')
    35	dB0, dB2 = sp.symbols('dB0 dB2')
    36	dZ0, dZ2 = sp.symbols('dZ0 dZ2')
    37	dN0 = sp.symbols('dN0')
