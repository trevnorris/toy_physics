    11	4. Equivalence of the microscopic even-consistency relation to delta u_4 = (8/9) delta u_2.
    12	5. Direct outlet formulas in physical grouped variables.
    13	6. Exact identity Delta_Q = delta P_0 / P_0 on the even-preserving branch.
    14	"""
    15	
    16	from __future__ import annotations
    17	import sympy as sp
    18	
    19	def banner(title: str) -> None:
    20	    line = "=" * 88
    21	    print("\n" + line)
    22	    print(title)
    23	    print(line)
    24	
    25	def expect_zero(name: str, expr: sp.Expr) -> None:
    26	    expr = sp.simplify(sp.expand(expr))
    27	    print(f"{name} = {expr}")
    28	    if expr != 0:
    29	        raise AssertionError(f"{name} is not zero")
    30	
    31	banner("STAGE 172 — PHYSICAL SLOPE COLLAPSE OF THE LINEAR GROUPED OUTLET PROBLEM")
    32	
    33	# ---------------------------------------------------------------------------
    34	# First-order grouped physical variables
    35	# ---------------------------------------------------------------------------
