    37	D0, N0, u2 = sp.symbols("D0 N0 u2", real=True, nonzero=True)
    38	dD0, dD2, dD4, dN0 = sp.symbols("dD0 dD2 dD4 dN0", real=True)
    39	eps, lam = sp.symbols("eps lam", real=True)
    40	sigma = sp.symbols("sigma", real=True, nonzero=True)
    41	
    42	D2 = -u2 * D0
    43	P0 = N0 / D0
    44	
    45	DA0 = D0 + eps * lam * dD0
    46	DA2 = D2 + eps * lam * dD2
    47	NA0 = N0 + eps * lam * dN0
    48	
    49	u2A = -DA2 / DA0
    50	P0A = NA0 / DA0
    51	
    52	delta_u2 = sp.simplify((sp.series(u2A, eps, 0, 2).removeO() - u2) / (eps * lam))
    53	delta_P0 = sp.simplify((sp.series(P0A, eps, 0, 2).removeO() - P0) / (eps * lam))
