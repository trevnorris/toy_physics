    61	banner("Exact obstruction-pair rewrite")
    62	expect_zero(
    63	    "K_A + D0*delta_u2 - (1/9-u2)*dD0",
    64	    KA + D0 * delta_u2 - (sp.Rational(1, 9) - u2) * dD0,
