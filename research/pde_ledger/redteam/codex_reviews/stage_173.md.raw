    60	u21_can = sp.simplify(u21.subs(D2, -sp.Rational(1,9)*D0))
    61	u41_can = sp.simplify(u41.subs({D2: -sp.Rational(1,9)*D0, D4: -sp.Rational(1,27)*D0}))
    62	P1_ratio = sp.simplify(P1 / (N0/D0))
