    31	
    32	eps, lam = sp.symbols("eps lam", real=True)
    33	D0, D01, D2, D21, D4, D41 = sp.symbols("D0 D01 D2 D21 D4 D41", real=True, nonzero=True)
    34	N0, N01 = sp.symbols("N0 N01", real=True, nonzero=True)
    35	u2, u4, P0 = sp.symbols("u2 u4 P0", real=True)
    36	
    37	D0A = D0 + eps*lam*D01
    38	D2A = D2 + eps*lam*D21
    39	D4A = D4 + eps*lam*D41
    40	N0A = N0 + eps*lam*N01
    41	
    42	u2A = sp.expand(sp.series(-D2A/D0A, eps, 0, 2).removeO())
    43	u4A = sp.expand(sp.series((D2A**2 - D0A*D4A)/D0A**2, eps, 0, 2).removeO())
    44	P0A = sp.expand(sp.series(N0A/D0A, eps, 0, 2).removeO())
    45	
    46	u21 = sp.simplify(sp.diff(u2A, eps).subs(eps, 0)/lam)
    47	u41 = sp.simplify(sp.diff(u4A, eps).subs(eps, 0)/lam)
    48	P1 = sp.simplify(sp.diff(P0A, eps).subs(eps, 0)/lam)
