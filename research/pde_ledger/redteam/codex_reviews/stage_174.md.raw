    54	omegaZ = Z0 / D0
    55	
    56	expect_zero("weight identity", omegaK - omegaB - omegaZ - 1)
    57	expect_zero(
    58	    "delta_D weighted decomposition",
    59	    deltaD - (omegaK * deltaK - omegaB * deltaB - omegaZ * deltaZ),
    60	)
    61	
    62	Xi_load = sp.simplify(deltaN - deltaD)
    63	Xi_wall_ref = sp.simplify((deltaN - deltaK) + omegaB * (deltaB - deltaK) + omegaZ * (deltaZ - deltaK))
    64	expect_zero("Xi_load wall-referenced form", Xi_load - Xi_wall_ref)
    65	print("Xi_load =", Xi_load)
    66	
    67	# ---------------------------------------------------------------------------
    68	# 2. BdG weighted-average logarithmic slope
    69	# ---------------------------------------------------------------------------
    70	banner("BdG bundle weighted logarithmic slope")
    71	
    72	c1, c2, w1, w2 = sp.symbols("c1 c2 w1 w2", real=True, nonzero=True)
    73	dc1, dc2, dw1, dw2 = sp.symbols("dc1 dc2 dw1 dw2", real=True)
    74	
    75	B1 = c1**2 / w1**2
    76	B2 = c2**2 / w2**2
    77	B0_two = sp.simplify(B1 + B2)
    78	B01_two = sp.simplify(2 * c1 * dc1 / w1**2 - 2 * c1**2 * dw1 / w1**3 + 2 * c2 * dc2 / w2**2 - 2 * c2**2 * dw2 / w2**3)
    79	
    80	rhoB1 = sp.simplify(B1 / B0_two)
    81	rhoB2 = sp.simplify(B2 / B0_two)
    82	
    83	deltaB_weighted = sp.simplify(rhoB1 * (2 * dc1 / c1 - 2 * dw1 / w1) + rhoB2 * (2 * dc2 / c2 - 2 * dw2 / w2))
    84	expect_zero("BdG weighted-average formula", B01_two / B0_two - deltaB_weighted)
    85	
    86	# ---------------------------------------------------------------------------
    87	# 3. Conservative Maxwell/mixed static weighted slope
    88	# ---------------------------------------------------------------------------
    89	banner("Conservative Maxwell/mixed weighted logarithmic slope")
    90	
    91	Q1, Q2, Delta1, Delta2 = sp.symbols("Q1 Q2 Delta1 Delta2", real=True, nonzero=True)
    92	Q1p, Q2p, Delta1p, Delta2p = sp.symbols("Q1p Q2p Delta1p Delta2p", real=True)
    93	
    94	Z1 = Q1 / Delta1
    95	Z2 = Q2 / Delta2
    96	Z0_two = sp.simplify(Z1 + Z2)
    97	Z01_two = sp.simplify((Delta1 * Q1p - Q1 * Delta1p) / Delta1**2 + (Delta2 * Q2p - Q2 * Delta2p) / Delta2**2)
    98	
    99	rhoZ1 = sp.simplify(Z1 / Z0_two)
   100	rhoZ2 = sp.simplify(Z2 / Z0_two)
   101	
   102	deltaZ_weighted = sp.simplify(rhoZ1 * (Q1p / Q1 - Delta1p / Delta1) + rhoZ2 * (Q2p / Q2 - Delta2p / Delta2))
   103	expect_zero("Z weighted-average formula", Z01_two / Z0_two - deltaZ_weighted)
   104	
   105	# ---------------------------------------------------------------------------
   106	# 4. Outgoing-transfer weighted slope
   107	# ---------------------------------------------------------------------------
   108	banner("Outgoing-transfer weighted logarithmic slope")
   109	
   110	P1, P2 = sp.symbols("P1 P2", real=True, nonzero=True)
   111	P1p, P2p = sp.symbols("P1p P2p", real=True)
   112	
   113	N1s = P1**2 / Delta1**2
   114	N2s = P2**2 / Delta2**2
   115	N0_two = sp.simplify(N1s + N2s)
   116	N01_two = sp.simplify(2 * P1 * P1p / Delta1**2 - 2 * P1**2 * Delta1p / Delta1**3 + 2 * P2 * P2p / Delta2**2 - 2 * P2**2 * Delta2p / Delta2**3)
   117	
   118	rhoN1 = sp.simplify(N1s / N0_two)
   119	rhoN2 = sp.simplify(N2s / N0_two)
   120	
   121	deltaN_weighted = sp.simplify(rhoN1 * (2 * P1p / P1 - 2 * Delta1p / Delta1) + rhoN2 * (2 * P2p / P2 - 2 * Delta2p / Delta2))
   122	expect_zero("N weighted-average formula", N01_two / N0_two - deltaN_weighted)
   123	
   124	# ---------------------------------------------------------------------------
   125	# 5. Static self-similarity theorem
   126	# ---------------------------------------------------------------------------
   127	banner("Static self-similarity theorem")
   128	
   129	delta_star = sp.symbols("delta_star", real=True)
   130	Xi_self_similar = sp.simplify(Xi_load.subs({K1: delta_star*K, B01: delta_star*B0, Z01: delta_star*Z0, N01: delta_star*N0}))
   131	expect_zero("Xi_load under static self-similarity", Xi_self_similar)
   132	
   133	# Wall-referenced defect-field form
   134	SigmaB, SigmaZ, SigmaN = sp.symbols("SigmaB SigmaZ SigmaN", real=True)
   135	Xi_sigma = sp.simplify(Xi_load.subs({B01: (deltaK + SigmaB)*B0, Z01: (deltaK + SigmaZ)*Z0, N01: (deltaK + SigmaN)*N0}))
   136	expect_zero("Xi_load mismatch-field form", Xi_sigma - (SigmaN + omegaB * SigmaB + omegaZ * SigmaZ))
   137	print("Xi_load mismatch-field prototype =", sp.simplify(SigmaN + omegaB * SigmaB + omegaZ * SigmaZ))
   138	
   139	print("\nCarry-forward formulas:")
   140	print("  delta_D = omegaK deltaK - omegaB deltaB - omegaZ deltaZ")
   141	print("  omegaK - omegaB - omegaZ = 1")
   142	print("  Xi_load = (deltaN-deltaK) + omegaB(deltaB-deltaK) + omegaZ(deltaZ-deltaK)")
   143	print("  delta_B = weighted average of 2 dln(c_alpha/varpi_alpha)")
   144	print("  delta_Z = weighted average of dln(Q_r/Delta_r)")
   145	print("  delta_N = weighted average of 2 dln(P_r/Delta_r)")
   146	print("  static self-similarity => Xi_load = 0")

