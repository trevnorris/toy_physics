{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluidspacetime.com/schemas/stage-manifest/v2.1.json",
  "title": "StageManifest v2.1",
  "description": "Machine-readable interface for one ledger stage. Quantity ownership, named dimensions with source tuples, typed claim payloads, import-completeness metadata, lifecycle census events, provenance evidence, and optional C7 executable bindings are normative.",
  "type": "object",
  "required": [
    "schema_version",
    "stage_id",
    "title",
    "part",
    "status_token",
    "symbols",
    "claims",
    "consumes",
    "exports",
    "knobs",
    "verification",
    "extraction"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.1"
    },
    "stage_id": {
      "$ref": "#/$defs/stage_id"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "part": {
      "type": "string",
      "minLength": 1
    },
    "status_token": {
      "type": "string",
      "minLength": 1
    },
    "symbols": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/symbol"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "consumes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/consumption"
      }
    },
    "exports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/export"
      }
    },
    "knobs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/knob"
      }
    },
    "departures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/departure"
      }
    },
    "verification": {
      "$ref": "#/$defs/verification"
    },
    "extraction": {
      "$ref": "#/$defs/extraction"
    }
  },
  "$defs": {
    "stage_id": {
      "type": "string",
      "pattern": "^stage[0-9]{3}$"
    },
    "rational": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(/[1-9][0-9]*)?$",
      "description": "An exact rational exponent. Rational exponents are supported so sqrt and other rational-power dimensional rules remain exact."
    },
    "dim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "L": {
          "$ref": "#/$defs/rational"
        },
        "M": {
          "$ref": "#/$defs/rational"
        },
        "T": {
          "$ref": "#/$defs/rational"
        }
      },
      "description": "Authoritative named dimension map. An absent L, M, or T key means exponent zero."
    },
    "dim_source_order": {
      "enum": [
        "LMT",
        "LTM",
        "MLT",
        "MTL",
        "TLM",
        "TML"
      ]
    },
    "dim_source": {
      "type": "object",
      "required": [
        "script_path",
        "locus"
      ],
      "additionalProperties": false,
      "properties": {
        "script_path": {
          "type": "string",
          "minLength": 1
        },
        "locus": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dim_source_tuple": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/rational"
        },
        {
          "$ref": "#/$defs/rational"
        },
        {
          "$ref": "#/$defs/rational"
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3,
      "description": "Raw positional exponent vector exactly as printed at dim_source. The checker recovers its order from the source script; dim_source_order is an assertion, not an input to recovery."
    },
    "digest": {
      "type": "string",
      "pattern": "^(sha1:[0-9a-f]{40}|sha256:[0-9a-f]{64}|sha512:[0-9a-f]{128}|[0-9a-f]{40}|[0-9a-f]{64}|[0-9a-f]{128})$"
    },
    "evidence": {
      "type": "object",
      "required": [
        "source_path",
        "locus",
        "source_digest",
        "engine",
        "method"
      ],
      "additionalProperties": false,
      "properties": {
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "locus": {
          "type": "string",
          "minLength": 1,
          "description": "A line range, predicate name, or stable object id."
        },
        "source_digest": {
          "$ref": "#/$defs/digest"
        },
        "engine": {
          "enum": [
            "sympy",
            "mathematica",
            "prose"
          ]
        },
        "method": {
          "enum": [
            "script_asserted",
            "derived_from_relation",
            "prose_only"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "method": {
                "const": "prose_only"
              }
            },
            "required": [
              "method"
            ]
          },
          "then": {
            "properties": {
              "engine": {
                "const": "prose"
              }
            }
          }
        }
      ]
    },
    "quantity_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$"
    },
    "symbol_name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
    },
    "claim_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "local_claim_ref": {
      "type": "string",
      "pattern": "^here/[a-z][a-z0-9_]*$"
    },
    "external_claim_ref": {
      "type": "string",
      "pattern": "^stage[0-9]{3}/[a-z][a-z0-9_]*$"
    },
    "claim_ref": {
      "oneOf": [
        {
          "$ref": "#/$defs/local_claim_ref"
        },
        {
          "$ref": "#/$defs/external_claim_ref"
        }
      ]
    },
    "expr": {
      "type": "object",
      "required": [
        "sympy"
      ],
      "additionalProperties": false,
      "properties": {
        "sympy": {
          "type": "string",
          "minLength": 1,
          "description": "Canonical exact SymPy form. Implicit multiplication and float atoms are forbidden."
        },
        "latex": {
          "type": "string"
        }
      }
    },
    "signature": {
      "type": "object",
      "required": [
        "domain",
        "codomain"
      ],
      "additionalProperties": false,
      "properties": {
        "domain": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/dim"
          }
        },
        "codomain": {
          "$ref": "#/$defs/dim"
        }
      }
    },
    "alias_declaration": {
      "type": "object",
      "required": [
        "group",
        "quantity_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "group": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "quantity_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/quantity_id"
          }
        }
      },
      "description": "Required by C1 on every same-name collision between distinct quantity_ids."
    },
    "symbol": {
      "type": "object",
      "required": [
        "name",
        "parse_alias",
        "quantity_id",
        "definition_ref",
        "dim",
        "dim_source_order",
        "dim_source",
        "dim_source_tuple",
        "role",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/symbol_name"
        },
        "parse_alias": {
          "$ref": "#/$defs/symbol_name"
        },
        "quantity_id": {
          "$ref": "#/$defs/quantity_id"
        },
        "definition_ref": {
          "$ref": "#/$defs/claim_ref"
        },
        "latex": {
          "type": "string"
        },
        "dim": {
          "$ref": "#/$defs/dim"
        },
        "dim_source_order": {
          "$ref": "#/$defs/dim_source_order"
        },
        "dim_source": {
          "$ref": "#/$defs/dim_source"
        },
        "dim_source_tuple": {
          "$ref": "#/$defs/dim_source_tuple"
        },
        "assumptions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "positive",
              "nonnegative",
              "nonzero",
              "real",
              "integer"
            ]
          }
        },
        "role": {
          "enum": [
            "primitive",
            "derived",
            "convention",
            "field",
            "function",
            "operator",
            "index"
          ]
        },
        "signature": {
          "$ref": "#/$defs/signature"
        },
        "alias": {
          "$ref": "#/$defs/alias_declaration"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "relation_payload": {
      "type": "object",
      "required": [
        "lhs",
        "rhs",
        "relation"
      ],
      "additionalProperties": false,
      "properties": {
        "lhs": {
          "$ref": "#/$defs/expr"
        },
        "rhs": {
          "$ref": "#/$defs/expr"
        },
        "relation": {
          "enum": [
            "eq",
            "le",
            "lt",
            "ge",
            "gt",
            "defines"
          ]
        }
      }
    },
    "operator_identity_payload": {
      "type": "object",
      "required": [
        "operator",
        "acts_on",
        "definition",
        "signature"
      ],
      "additionalProperties": false,
      "properties": {
        "operator": {
          "type": "string",
          "minLength": 1
        },
        "acts_on": {
          "$ref": "#/$defs/symbol_name"
        },
        "definition": {
          "$ref": "#/$defs/expr"
        },
        "signature": {
          "$ref": "#/$defs/signature"
        }
      }
    },
    "spectrum_payload": {
      "type": "object",
      "required": [
        "operator",
        "kernel_symbol",
        "kernel",
        "eigenvalue",
        "gap",
        "multiplicity"
      ],
      "additionalProperties": false,
      "properties": {
        "operator": {
          "type": "string",
          "minLength": 1
        },
        "kernel_symbol": {
          "$ref": "#/$defs/symbol_name",
          "description": "Stage-local parse alias bound by the kernel expression. This makes spectrum definition_ref binding mechanical."
        },
        "kernel": {
          "$ref": "#/$defs/expr"
        },
        "eigenvalue": {
          "$ref": "#/$defs/expr"
        },
        "gap": {
          "$ref": "#/$defs/expr"
        },
        "multiplicity": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "adjudication_payload": {
      "type": "object",
      "required": [
        "domain_cardinality",
        "precedence",
        "outcome_token"
      ],
      "additionalProperties": false,
      "properties": {
        "domain_cardinality": {
          "type": "integer",
          "minimum": 0
        },
        "precedence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "outcome_token": {
          "type": "string",
          "minLength": 1
        },
        "oracle_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]+$"
        },
        "bucket_counts": {
          "type": "object",
          "minProperties": 1,
          "patternProperties": {
            "^[A-Za-z][A-Za-z0-9_.-]*$": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "description": "When present, the checker requires the values to sum to domain_cardinality."
        },
        "axes": {
          "type": "object",
          "minProperties": 1,
          "patternProperties": {
            "^[A-Za-z][A-Za-z0-9_.-]*$": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false,
          "description": "Axis cardinalities. When present, the checker requires their product to equal domain_cardinality."
        }
      }
    },
    "convention_axis_choice": {
      "type": "object",
      "required": [
        "token",
        "low_delta",
        "high_delta"
      ],
      "additionalProperties": false,
      "properties": {
        "token": {
          "type": "string",
          "minLength": 1
        },
        "low_delta": {
          "type": "integer"
        },
        "high_delta": {
          "type": "integer"
        }
      }
    },
    "convention_axis": {
      "type": "object",
      "required": [
        "axis_id",
        "choices"
      ],
      "additionalProperties": false,
      "properties": {
        "axis_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "choices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/convention_axis_choice"
          }
        }
      }
    },
    "range_endpoint": {
      "type": "object",
      "required": [
        "low",
        "high"
      ],
      "additionalProperties": false,
      "properties": {
        "low": {
          "type": "integer"
        },
        "high": {
          "type": "integer"
        }
      }
    },
    "record_range_payload": {
      "type": "object",
      "required": [
        "low",
        "high",
        "spread",
        "convention_axes",
        "components"
      ],
      "additionalProperties": false,
      "properties": {
        "low": {
          "type": "integer"
        },
        "high": {
          "type": "integer"
        },
        "spread": {
          "type": "integer",
          "minimum": 0
        },
        "convention_axes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/convention_axis"
          },
          "description": "Deterministic branches. Sum component endpoints, add each Cartesian choice's low/high deltas, then take the minimum low and maximum high; spread must be high-low."
        },
        "components": {
          "type": "object",
          "minProperties": 1,
          "patternProperties": {
            "^[a-z][a-z0-9_]*$": {
              "$ref": "#/$defs/range_endpoint"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "set_cardinality_payload": {
      "type": "object",
      "required": [
        "set_label",
        "count"
      ],
      "additionalProperties": false,
      "properties": {
        "set_label": {
          "type": "string",
          "minLength": 1
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "elements": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "token_payload": {
      "type": "object",
      "required": [
        "token",
        "meaning"
      ],
      "additionalProperties": false,
      "properties": {
        "token": {
          "type": "string",
          "minLength": 1
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "typed_payload": {
      "type": "object",
      "required": [
        "payload_kind",
        "payload"
      ],
      "additionalProperties": false,
      "properties": {
        "payload_kind": {
          "enum": [
            "relation",
            "operator_identity",
            "spectrum",
            "adjudication",
            "record_range",
            "set_cardinality",
            "token"
          ]
        },
        "payload": {}
      },
      "oneOf": [
        {
          "properties": {
            "payload_kind": {
              "const": "relation"
            },
            "payload": {
              "$ref": "#/$defs/relation_payload"
            }
          }
        },
        {
          "properties": {
            "payload_kind": {
              "const": "operator_identity"
            },
            "payload": {
              "$ref": "#/$defs/operator_identity_payload"
            }
          }
        },
        {
          "properties": {
            "payload_kind": {
              "const": "spectrum"
            },
            "payload": {
              "$ref": "#/$defs/spectrum_payload"
            }
          }
        },
        {
          "properties": {
            "payload_kind": {
              "const": "adjudication"
            },
            "payload": {
              "$ref": "#/$defs/adjudication_payload"
            }
          }
        },
        {
          "properties": {
            "payload_kind": {
              "const": "record_range"
            },
            "payload": {
              "$ref": "#/$defs/record_range_payload"
            }
          }
        },
        {
          "properties": {
            "payload_kind": {
              "const": "set_cardinality"
            },
            "payload": {
              "$ref": "#/$defs/set_cardinality_payload"
            }
          }
        },
        {
          "properties": {
            "payload_kind": {
              "const": "token"
            },
            "payload": {
              "$ref": "#/$defs/token_payload"
            }
          }
        }
      ]
    },
    "domain_spec": {
      "type": "object",
      "required": [
        "variables",
        "predicate"
      ],
      "additionalProperties": false,
      "properties": {
        "variables": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/symbol_name"
          }
        },
        "predicate": {
          "$ref": "#/$defs/expr"
        }
      }
    },
    "condition": {
      "type": "object",
      "required": [
        "op",
        "operands"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "enum": [
            "all",
            "any",
            "not",
            "xor",
            "domain"
          ]
        },
        "operands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/claim_ref"
              },
              {
                "$ref": "#/$defs/condition"
              },
              {
                "$ref": "#/$defs/domain_spec"
              }
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "const": "not"
              }
            }
          },
          "then": {
            "properties": {
              "operands": {
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "xor"
              }
            }
          },
          "then": {
            "properties": {
              "operands": {
                "minItems": 2
              }
            }
          }
        }
      ]
    },
    "genesis_record_ref": {
      "type": "object",
      "required": [
        "path",
        "commit"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        }
      }
    },
    "genesis_evidence": {
      "type": "object",
      "required": [
        "record_ref",
        "date",
        "record_span",
        "predates"
      ],
      "additionalProperties": false,
      "properties": {
        "record_ref": {
          "$ref": "#/$defs/genesis_record_ref"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "record_span": {
          "type": "string",
          "minLength": 1
        },
        "predates": {
          "$ref": "#/$defs/claim_ref"
        }
      }
    },
    "genesis": {
      "type": "object",
      "required": [
        "introduced",
        "origin"
      ],
      "additionalProperties": false,
      "properties": {
        "introduced": {
          "type": "string",
          "format": "date"
        },
        "origin": {
          "enum": [
            "independent",
            "coordinated",
            "target_matched",
            "unknown"
          ]
        },
        "coordinated_with": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/claim_ref"
          }
        },
        "evidence": {
          "$ref": "#/$defs/genesis_evidence"
        },
        "note": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "origin": {
                "const": "independent"
              }
            },
            "required": [
              "origin"
            ]
          },
          "then": {
            "required": [
              "evidence"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "origin": {
                "enum": [
                  "coordinated",
                  "target_matched"
                ]
              }
            },
            "required": [
              "origin"
            ]
          },
          "then": {
            "required": [
              "coordinated_with"
            ]
          }
        }
      ]
    },
    "claim": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "status",
        "payload_kind",
        "payload",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/claim_id"
        },
        "kind": {
          "enum": [
            "identity",
            "operator_identity",
            "inequality",
            "spectral",
            "dimensional",
            "reduction",
            "nogo",
            "adjudication",
            "range",
            "set",
            "convention"
          ]
        },
        "status": {
          "enum": [
            "POSTULATED",
            "EARNED",
            "DERIVED",
            "CONV",
            "CALIBRATED",
            "R1_REQUIRED",
            "DEFERRED",
            "RETIRED",
            "FATAL_FLAW"
          ]
        },
        "payload_kind": {
          "enum": [
            "relation",
            "operator_identity",
            "spectrum",
            "adjudication",
            "record_range",
            "set_cardinality",
            "token"
          ]
        },
        "payload": {},
        "expected_dim": {
          "$ref": "#/$defs/dim"
        },
        "holds_within": {
          "$ref": "#/$defs/condition"
        },
        "genesis": {
          "$ref": "#/$defs/genesis"
        },
        "discharged_by": {
          "$ref": "#/$defs/external_claim_ref"
        },
        "retired_by": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
