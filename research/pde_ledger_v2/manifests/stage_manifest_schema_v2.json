        "check": {
          "enum": [
            "cas_equivalence",
            "implication",
            "specialization",
            "value_equal",
            "dim_equal",
            "token_match",
            "spectrum_match",
            "range_match",
            "adjudication_match",
            "set_match",
            "opaque_quantity_match"
          ]
