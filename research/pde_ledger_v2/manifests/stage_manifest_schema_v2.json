        {
          "if": {
            "properties": {
              "check": {
                "const": "dim_equal"
              }
            },
            "required": [
              "check"
            ]
          },
          "then": {
            "required": [
              "as_consumed_dim"
            ],
            "not": {
              "required": [
                "as_consumed"
              ]
            }
          },
          "else": {
            "if": {
              "properties": {
                "check": {
                  "const": "opaque_quantity_match"
                }
              },
              "required": [
                "check"
              ]
            },
            "then": {
              "required": [
                "producer_quantity_id",
                "producer_source_digest"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "as_consumed"
                    ]
                  },
                  {
                    "required": [
                      "as_consumed_dim"
                    ]
                  }
                ]
              }
            },
            "else": {
              "required": [
                "as_consumed"
              ],
              "not": {
                "required": [
                  "as_consumed_dim"
                ]
              }
            }
          }
        },
