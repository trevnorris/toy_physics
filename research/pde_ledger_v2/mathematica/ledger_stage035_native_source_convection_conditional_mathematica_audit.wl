    zq[coefficientLaw - (alpha - 1)] &&
    zq[
      continuityGeneral -
        (alpha - 1) directionalGradient] &&
    !zq[wrongCoefficientResidual];
  expectBool[
    "SOURCE_TRANSLATION_CONTINUITY",
    continuityOK,
    <|
      "SelectedAlpha" -> selectedAlpha,
      "Residual" -> liveSource["ContinuityResidual"],
      "CoefficientLaw" -> coefficientLaw,
      "UniqueCondition" -> uniqueCondition,
      "Alpha2Control" -> wrongCoefficientResidual
    |>];
  Print[
    "      sigma_i=s_i*Gaussian(x-X_i(t)); residual=(alpha-1) V.Grad[sigma_i]"];
  Print[
    "      Reduce gives unique alpha=1; alpha=2 control is nonzero"];
  Print["PROGRESS MATHEMATICA CONTINUITY COMPLETE"];

  section["Surviving-solution free-symbol guard"];
  sourceSymbols = freeSourceMarkers[liveSource["CandidateSource"]];
  barredIntersection =
    Intersection[sourceSymbols, barredSourceMarkers];
  expectBool[
    "SOURCE_NOT_IMPORTED",
    barredIntersection === {},
    <|
      "BarredIntersection" -> barredIntersection,
      "Mapping" -> barredDisplayToCode
    |>];
  Print[
    "      BARRED_MAPPING=N_u->Nu,a_T->aT,a'_T->aTp,a_L->aL,q_A^T->q_A_T,q_L->q_L"];
  Print[
    "      native source REPLACES barred j~sV/pathA_39; no barred amplitude imported"];

  section["Continuity-derived tensor source basis"];
  basisResiduals =
    liveSource["CandidateSource"] - liveSource["NativeSource"];
  qRelationSource =
    liveSource["NativeSource"] /. qT -> lambdaT tauD;
  expectedQRelationSource =
    lambdaT tauD signedSnapshot velocityVector;
  expectBool[
    "SOURCE_BASIS",
    And @@ (zq /@ basisResiduals) &&
    liveSource["NativeFlux"] ===
      signedSnapshot velocityVector &&
    qRelationSource === expectedQRelationSource,
    <|
      "ComponentResiduals" -> basisResiduals,
      "I" -> liveSource["NativeFlux"],
      "J" -> liveSource["CandidateSource"],
      "QRelation" -> qT - lambdaT tauD
    |>];
  Print["      I_i=s_i*eta_a(x-X_i)*V_i"];
  Print[
    "      J_T,i=q_T*I_i=q_T*s_i*eta_a(x-X_i)*V_i; q_T=lambda_T*tau_d"];

  section["Operator-generated 24-cell parity census"];
  parityMutation = If[
    MemberQ[
      {"PARITY_RW", "PARITY_PW", "PARITY_ROTATION",
        "PARITY_TIME_REVERSAL"},
      activeMutation],
    activeMutation,
    ""];
  liveParity = parityBuild[parityMutation];
  liveInvariants = parityInvariants[liveParity];
  Scan[
    Function[tooth,
      expectBool[tooth, liveInvariants[tooth], liveParity["Census"]]],
    {
      "PARITY_RW", "PARITY_PW", "PARITY_ROTATION",
      "PARITY_TIME_REVERSAL"
    }];
  KeyValueMap[
    Function[{name, row},
      Print[
        "      ", name,
        ": R_w=", If[row[[1]] === 1, "+1", "-1"],
        ", P_w=", If[row[[2]] === 1, "+1", "-1"],
        ", rotation=", row[[3]],
        ", T=", If[row[[4]] === 1, "+1", "-1"]]],
    liveParity["Census"]];
  Print[
    "      P_w denotes a w-type reflection of the transverse coordinate, NOT ordinary x->-x parity"];
  Print[
    "      b_T axial and T-even are RAW census facts; departure interpretation is deferred to stage039"];
  Print["PROGRESS MATHEMATICA PARITY CENSUS COMPLETE"];

  section["Build-global target blindness and canonical term coverage"];
  blindnessExpression =
    Total[liveSource["NativeSource"]] +
    qT - lambdaT tauD + s + Total[velocityVector] +
    Total[Values[liveParity["Monomials"]]];
  If[
    activeMutation === "TARGET_BLINDNESS",
    blindnessExpression += aElectric signedSnapshot];
  forbiddenLive = Intersection[
    freeGlobalSymbols[blindnessExpression],
    forbiddenTargetSymbols];
  expectBool[
    "TARGET_BLINDNESS",
    forbiddenLive === {},
    <|"ForbiddenLive" -> forbiddenLive|>];
  Print[
    "      no electric A_E; no q/g knob; no downstream comparison/landing/sign token"];

  inventory = computedTermInventory[
    activeMutation =!= "DUAL_ENGINE_TERMS"];
  expectBool[
    "DUAL_ENGINE_TERMS",
    inventory === expectedTermInventory,
    <|"Computed" -> inventory, "Required" -> expectedTermInventory|>];
  Print["      TERM_INVENTORY=", StringRiffle[inventory, ","]];

  section["Whole-stage restored-unit firewall via formal rescaling"];
  restored = unitScalingObject[
    activeMutation === "UNITS_RESTORED"];
  expectedScaling = <|
    "SigmaScale" -> lengthScale^-3,
    "ContinuityScales" ->
      {lengthScale^-3 timeScale^-1,
        lengthScale^-3 timeScale^-1},
    "IScales" ->
      ConstantArray[lengthScale^-2 timeScale^-1, 3],
    "JScales" ->
      ConstantArray[
        massScale lengthScale^-2 timeScale^-2, 3],
    "EtaScale" -> lengthScale^-3,
    "VScales" ->
      ConstantArray[lengthScale timeScale^-1, 3],
    "UScales" -> ConstantArray[lengthScale, 3],
    "BScales" -> ConstantArray[1, 3],
    "QScale" -> massScale timeScale^-1
  |>;
  expectBool[
    "UNITS_RESTORED",
    restored === expectedScaling,
    <|"Computed" -> restored, "Required" -> expectedScaling|>];
  Print[
    "      [sigma]=[eta_a]=L^-3; [I]=L^-2 T^-1; [q_T]=M T^-1"];
  Print[
    "      [J_T]=M L^-2 T^-2; [V]=L T^-1; [u_T]=L; [b_T]=1"];

  section["Build-native verdict precedence from computed upstream objects"];
  verdictSource = sourceBuild[
    If[activeMutation === "VERDICT_REDERIVATION", 2, 1]];
  cleanParity = parityBuild[];
  liveVerdict =
    deriveVerdict[verdictSource, cleanParity, Automatic, magnitudeR1];
  magnitudeForcedVerdict =
    deriveVerdict[
      sourceBuild[], cleanParity, Automatic,
      "magnitude_forced_by_electric"];
  continuityNegative =
    deriveVerdict[sourceBuild[2], cleanParity];
  coefficientNegative =
    deriveVerdict[sourceBuild[], cleanParity, 2];
  basisNegative =
    deriveVerdict[sourceBuild[1, False, 2], cleanParity];
  barredNegative =
    deriveVerdict[sourceBuild[1, True], cleanParity];
  parityNegative =
    deriveVerdict[sourceBuild[], parityBuild["PARITY_RW"]];
  sourcePrecedence =
    deriveVerdict[sourceBuild[2], parityBuild["PARITY_RW"]];
  expectBool[
    "VERDICT_REDERIVATION",
    liveVerdict === verdictToken &&
    magnitudeForcedVerdict === verdictToken &&
    continuityNegative === r1SourceToken &&
    coefficientNegative === r1SourceToken &&
    basisNegative === r1SourceToken &&
    barredNegative === r1SourceToken &&
    parityNegative === parityBadToken &&
    sourcePrecedence === r1SourceToken,
    <|
      "Rederived" -> liveVerdict,
      "AlphaNegative" -> continuityNegative,
      "WrongUniqueCoefficient" -> coefficientNegative,
      "BasisNegative" -> basisNegative,
      "BarredNegative" -> barredNegative,
      "ParityNegative" -> parityNegative,
      "SourceOverParity" -> sourcePrecedence,
      "MagnitudeR1" -> magnitudeR1
    |>];
  Print["      SOURCE_FAILURE_TOKEN=", r1SourceToken];
  Print["      CENSUS_FAILURE_TOKEN=", parityBadToken];
  Print["      R1_MAGNITUDE_IDENTITY_TOKEN=", liveVerdict];

  section["Canonical source-to-stage predicate manifest"];
  manifestTest = If[
    activeMutation === "SOURCE_TO_STAGE_MANIFEST",
    Most[sourceManifest],
    sourceManifest];
  identifiers = manifestTest[[All, 1]];
  partitionCounts = KeySort@Counts[manifestTest[[All, 2]]];
  scopedOut = Cases[
    manifestTest, {identifier_, "SCOPED_OUT", _} :> identifier];
  manifestDigest = manifestSHA256[manifestTest];
  manifestOK =
    identifiers === sourceToothIDs &&
    Length[identifiers] === Length[DeleteDuplicates[identifiers]] === 35 &&
    partitionCounts === expectedManifestCounts &&
    scopedOut === expectedScopedOut &&
    Length[scopedOut] === 25 &&
    AllTrue[
      manifestTest[[All, 3]],
      StringStartsQ[
        #,
        Alternatives[
          "STAGE034_", "STAGE035_", "STAGE036_",
          "STAGE037_", "STAGE038_"]] &] &&
    manifestDigest === manifestDigestExpected;
  expectBool[
    "SOURCE_TO_STAGE_MANIFEST",
    manifestOK,
    <|
      "Entries" -> Length[manifestTest],
      "Partition" -> partitionCounts,
      "ScopedOut" -> scopedOut,
      "Digest" -> manifestDigest
    |>];
  Print[
    "      entries=", Length[manifestTest],
    "; partition=", partitionCounts,
    "; scoped_out=", Length[scopedOut],
    "; digest=", manifestDigest];
  Print["      SCOPED_OUT=", StringRiffle[scopedOut, ","]];

  Print[""];
  Print[
    "SOURCE_LAW=I_i=s_i*eta_a(x-X_i)*V_i; J_T,i=q_T*I_i"];
  Print["Q_T=lambda_T*tau_d; MAGNITUDE=R1(magnitude)"];
  Print[
    "PROVENANCE=q_T,tau_d,u_T,eta_a cited from stage034/stage003; not re-derived or re-counted"];
  Print[
    "SCOPE=source law + raw parity census only; action/routes/landing/departure deferred"];
  Print["VERDICT_TOKEN: ", liveVerdict];
  Print["PROGRESS MATHEMATICA STAGE035 COMPLETE"];

  If[activeMutation =!= "",
    Print["FIRST_FAILURE=MUTATION_DID_NOT_FIRE"];
    raise["MUTATION_DID_NOT_FIRE"]
  ];
  True,
  "ledgerStage035Failure",
  Function[{message, tag}, False]
];

Print[""];
Print["TOOTH_COUNT=", Length[toothOrder]];
Print["PASS tally: ", passCount, "; FAIL tally: ", failCount];
If[TrueQ[ok],
  Print[
    "OVERALL PASS: Mathematica independently reached ",
    verdictToken];
  Exit[0],
  Print[
    "OVERALL FAIL: Mathematica stage035 audit did not close"];
  Exit[1]
]
