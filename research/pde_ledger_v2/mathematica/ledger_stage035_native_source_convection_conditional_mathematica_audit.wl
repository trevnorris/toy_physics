);

zq[expression_] := TrueQ[
  FullSimplify[
    expression == 0,
    a0 > 0 && Element[
      {x, y, z, vx, vy, vz, s, qT, lambdaT, tauD, alpha}, Reals]]
];

(* ---------------------------------------------------------------------- *)
(* Explicit Gaussian route: native D + Div followed by Reduce.             *)
(* ---------------------------------------------------------------------- *)

coordinates = {x, y, z};
centerFunctions = {xCenter[t], yCenter[t], zCenter[t]};
velocityVector = {vx, vy, vz};
centerVelocityRules = {
  Derivative[1][xCenter][t] -> vx,
  Derivative[1][yCenter][t] -> vy,
  Derivative[1][zCenter][t] -> vz
};

etaMoving =
  Exp[-Total[(coordinates - centerFunctions)^2]/a0^2]/
    (Pi^(3/2) a0^3);
sigmaMoving = s etaMoving;
dtSigma = Factor[D[sigmaMoving, t] /. centerVelocityRules];
fluxDivergence = Factor[
  Div[alpha sigmaMoving velocityVector, coordinates]];
continuityGeneral = Factor[dtSigma + fluxDivergence];
directionalGradient = Factor[
  velocityVector.Grad[sigmaMoving, coordinates]];
coefficientLaw = FullSimplify[
  Cancel[continuityGeneral/directionalGradient],
  a0 > 0];
uniqueCondition = Reduce[
  coefficientLaw == 0, alpha, Reals];
uniqueAlpha = If[SameQ[uniqueCondition, alpha == 1], 1, Indeterminate];

centerSnapshotRules = {
  xCenter[t] -> xC, yCenter[t] -> yC, zCenter[t] -> zC
};
etaSnapshot = etaMoving /. centerSnapshotRules;
signedSnapshot = s etaSnapshot;

(* Wolfram identifiers cannot contain raw underscores.  Keep those two exact
   source-code names as inert, code-native marker atoms rather than silently
   renaming them; the mutation uses the ordinary native symbol Nu. *)
qATMarker = barredCodeSymbol["q_A_T"];
qLMarker = barredCodeSymbol["q_L"];
barredDisplayToCode = {
  "N_u" -> Nu,
  "a_T" -> aT,
  "a'_T" -> aTp,
  "a_L" -> aL,
  "q_A^T" -> qATMarker,
  "q_L" -> qLMarker
};
barredSourceMarkers = Last /@ barredDisplayToCode;

sourceBuild[
    fluxCoefficient_: 1, injectBarred_: False,
    sourceScale_: 1] := Module[
  {nativeFlux, nativeSource, candidate},
  nativeFlux = uniqueAlpha signedSnapshot velocityVector;
  nativeSource = qT nativeFlux;
  candidate = sourceScale nativeSource;
  If[TrueQ[injectBarred],
    candidate = ReplacePart[
      candidate, 1 -> Expand[candidate[[1]] + Nu nativeSource[[1]]]]
  ];
  <|
    "SelectedFluxCoefficient" -> fluxCoefficient,
    "ContinuityResidual" ->
      Factor[continuityGeneral /. alpha -> fluxCoefficient],
    "UniqueFluxCoefficient" -> uniqueAlpha,
    "NativeFlux" -> nativeFlux,
    "NativeSource" -> nativeSource,
    "CandidateSource" -> candidate
  |>
];

freeGlobalSymbols[expression_] := DeleteDuplicates@Cases[
  expression,
  symbol_Symbol /; Context[Unevaluated[symbol]] === "Global`" :>
    Unevaluated[symbol],
  {0, Infinity},
  Heads -> True
];

freeSourceMarkers[expression_] := Union[
  freeGlobalSymbols[expression],
  DeleteDuplicates@Cases[
    expression, marker_barredCodeSymbol :> marker, {0, Infinity}]
];

(* ---------------------------------------------------------------------- *)
(* Operator-generated parity census and explicit polar/axial classifier.   *)
(* ---------------------------------------------------------------------- *)

paritySign[expression_, rules_] :=
  FullSimplify[(expression /. rules)/expression];

vectorZeroQ[vector_] :=
  And @@ (TrueQ[FullSimplify[# == 0]] & /@ vector);

classifyVector[
    original_, properImage_, reflectionImage_,
    properMatrix_, reflectionMatrix_] := Which[
  vectorZeroQ[properImage - properMatrix.original] &&
    vectorZeroQ[reflectionImage - reflectionMatrix.original],
    "polar_vector",
  vectorZeroQ[properImage - properMatrix.original] &&
    vectorZeroQ[
      reflectionImage -
        Det[reflectionMatrix] reflectionMatrix.original],
    "axial_vector",
  True,
    "unclassified"
];

parityBuild[mutation_: ""] := Module[
  {
    generators, qMonomial, jMonomial, uMonomial, bMonomial,
    monomials, rwRules, pwRules, timeRules, rwSigns, pwSigns,
    timeSigns, properMatrix, reflectionMatrix, vVector, gVector,
    jVector, uVector, bVector, gradientReflection, rotations,
    census
  },
  generators = {
    sGenerator, vGenerator, tauGenerator, lambdaGenerator,
    etaGenerator, responseGenerator, gradientGenerator
  };
  qMonomial = lambdaGenerator tauGenerator;
  jMonomial =
    qMonomial sGenerator etaGenerator vGenerator;
  uMonomial = responseGenerator jMonomial;
  bMonomial = gradientGenerator uMonomial;
  monomials = <|
    "s" -> sGenerator,
    "V" -> vGenerator,
    "tau_d/q_T" -> qMonomial,
    "J_T" -> jMonomial,
    "u_T" -> uMonomial,
    "b_T" -> bMonomial
  |>;

  rwRules = {
    sGenerator -> -sGenerator,
    vGenerator -> vGenerator,
    tauGenerator -> tauGenerator,
    lambdaGenerator -> lambdaGenerator,
    etaGenerator -> etaGenerator,
    responseGenerator ->
      If[mutation === "PARITY_RW", -responseGenerator, responseGenerator],
    gradientGenerator -> gradientGenerator
  };
  pwRules = {
    sGenerator -> -sGenerator,
    vGenerator -> vGenerator,
    tauGenerator -> tauGenerator,
    lambdaGenerator -> lambdaGenerator,
    etaGenerator -> etaGenerator,
    responseGenerator ->
      If[mutation === "PARITY_PW", -responseGenerator, responseGenerator],
    gradientGenerator -> gradientGenerator
  };
  timeRules = {
    sGenerator -> sGenerator,
    vGenerator -> -vGenerator,
    tauGenerator ->
      If[
        mutation === "PARITY_TIME_REVERSAL",
        tauGenerator, -tauGenerator],
    lambdaGenerator -> lambdaGenerator,
    etaGenerator -> etaGenerator,
    responseGenerator -> responseGenerator,
    gradientGenerator -> gradientGenerator
  };
  rwSigns = Association@KeyValueMap[
    Function[{name, expression},
      name -> paritySign[expression, rwRules]], monomials];
  pwSigns = Association@KeyValueMap[
    Function[{name, expression},
      name -> paritySign[expression, pwRules]], monomials];
  timeSigns = Association@KeyValueMap[
    Function[{name, expression},
      name -> paritySign[expression, timeRules]], monomials];

  properMatrix = {{0, -1, 0}, {1, 0, 0}, {0, 0, 1}};
  reflectionMatrix = DiagonalMatrix[{-1, 1, 1}];
  vVector = {vp1, vp2, vp3};
  gVector = {gp1, gp2, gp3};
  jVector = jScalar vVector;
  uVector = responseScalar jVector;
  bVector = Cross[gVector, uVector];
  gradientReflection = If[
    mutation === "PARITY_ROTATION",
    Det[reflectionMatrix] reflectionMatrix.gVector,
    reflectionMatrix.gVector
  ];
  rotations = <|
    "s" -> "scalar",
    "V" -> classifyVector[
      vVector,
      properMatrix.vVector,
      reflectionMatrix.vVector,
      properMatrix, reflectionMatrix],
    "tau_d/q_T" -> "scalar",
    "J_T" -> classifyVector[
      jVector,
      jScalar properMatrix.vVector,
      jScalar reflectionMatrix.vVector,
      properMatrix, reflectionMatrix],
    "u_T" -> classifyVector[
      uVector,
      responseScalar jScalar properMatrix.vVector,
      responseScalar jScalar reflectionMatrix.vVector,
      properMatrix, reflectionMatrix],
    "b_T" -> classifyVector[
      bVector,
      Cross[
        properMatrix.gVector,
        properMatrix.uVector],
      Cross[
        gradientReflection,
        reflectionMatrix.uVector],
      properMatrix, reflectionMatrix]
  |>;

  census = Association@Map[
    Function[name,
      name -> {
        rwSigns[name], pwSigns[name], rotations[name], timeSigns[name]}],
    Keys[monomials]];
  <|
    "Census" -> census,
    "Monomials" -> monomials,
    "TauTime" -> paritySign[tauGenerator, timeRules],
    "QTime" -> timeSigns["tau_d/q_T"]
  |>
];

expectedCensus = <|
  "s" -> {-1, -1, "scalar", 1},
  "V" -> {1, 1, "polar_vector", -1},
  "tau_d/q_T" -> {1, 1, "scalar", -1},
  "J_T" -> {-1, -1, "polar_vector", 1},
  "u_T" -> {-1, -1, "polar_vector", 1},
  "b_T" -> {-1, -1, "axial_vector", 1}
|>;

parityInvariants[build_] := Module[{census, order},
  census = build["Census"];
  order = Keys[expectedCensus];
  <|
    "PARITY_RW" -> (
      (census[#][[1]] & /@ order) ===
        (expectedCensus[#][[1]] & /@ order) &&
      census["J_T"][[1]] === -1 &&
      census["u_T"][[1]] === -1),
    "PARITY_PW" -> (
      (census[#][[2]] & /@ order) ===
        (expectedCensus[#][[2]] & /@ order) &&
      census["J_T"][[2]] === -1 &&
      census["u_T"][[2]] === -1),
    "PARITY_ROTATION" -> (
      (census[#][[3]] & /@ order) ===
        (expectedCensus[#][[3]] & /@ order) &&
      census["u_T"][[3]] === "polar_vector" &&
      census["b_T"][[3]] === "axial_vector"),
    "PARITY_TIME_REVERSAL" -> (
      (census[#][[4]] & /@ order) ===
        (expectedCensus[#][[4]] & /@ order) &&
      build["TauTime"] === -1 &&
      build["QTime"] === -1 &&
      census["V"][[4]] === -1 &&
      census["J_T"][[4]] === 1 &&
      census["u_T"][[4]] === 1 &&
      census["b_T"][[4]] === 1)
  |>
];

(* ---------------------------------------------------------------------- *)
(* Formal unit rescaling of the live explicit source expressions.          *)
(* ---------------------------------------------------------------------- *)

uField = {
  c11 x + c12 y + c13 z,
  c21 x + c22 y + c23 z,
  c31 x + c32 y + c33 z
};
bField = Curl[uField, coordinates];

scaledRatio[expression_, rules_] := FullSimplify[
  (expression /. rules)/expression,
  lengthScale > 0 && timeScale > 0 && massScale > 0 && a0 > 0
];

unitScalingObject[badQ_: False] := Module[
  {rules, source, snapshotGradient, continuityTerms},
  rules = {
    x -> lengthScale x,
    y -> lengthScale y,
    z -> lengthScale z,
    xC -> lengthScale xC,
    yC -> lengthScale yC,
    zC -> lengthScale zC,
    a0 -> lengthScale a0,
    vx -> lengthScale vx/timeScale,
    vy -> lengthScale vy/timeScale,
    vz -> lengthScale vz/timeScale,
    qT ->
      massScale If[TrueQ[badQ], lengthScale, 1] qT/timeScale
  };
  source = sourceBuild[];
  snapshotGradient =
    velocityVector.Grad[signedSnapshot, coordinates];
  continuityTerms = {-snapshotGradient, alpha snapshotGradient};
  <|
    "SigmaScale" -> scaledRatio[signedSnapshot, rules],
    "ContinuityScales" -> (scaledRatio[#, rules] & /@ continuityTerms),
    "IScales" -> (scaledRatio[#, rules] & /@ source["NativeFlux"]),
    "JScales" -> (scaledRatio[#, rules] & /@ source["NativeSource"]),
    "EtaScale" -> scaledRatio[etaSnapshot, rules],
    "VScales" -> (scaledRatio[#, rules] & /@ velocityVector),
    "UScales" -> (scaledRatio[#, rules] & /@ uField),
    "BScales" -> (scaledRatio[#, rules] & /@ bField),
    "QScale" ->
      massScale If[TrueQ[badQ], lengthScale, 1]/timeScale
  |>
];

