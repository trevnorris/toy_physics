computedTermInventory[includeQRelation_: True] := Module[
  {source, parity, terms = {}},
  source = sourceBuild[];
  parity = parityBuild[];
  If[!FreeQ[signedSnapshot, s], AppendTo[terms, "signed_density"]];
  If[!zq[dtSigma], AppendTo[terms, "translation_time_derivative"]];
  If[!FreeQ[fluxDivergence, alpha],
    AppendTo[terms, "isotropic_flux_divergence"]];
  If[!FreeQ[continuityGeneral, alpha],
    AppendTo[terms, "continuity_residual"]];
  If[uniqueAlpha === 1, AppendTo[terms, "unique_alpha"]];
  If[Length[source["NativeFlux"]] === 3,
    AppendTo[terms, "native_flux_I"]];
  If[
    Length[source["NativeSource"]] === 3 &&
      !FreeQ[source["NativeSource"], qT],
    AppendTo[terms, "native_source_J_T"]];
  If[TrueQ[includeQRelation], AppendTo[terms, "q_T_relation"]];
  If[Length[parity["Census"]] 4 === 24,
    AppendTo[terms, "parity_census_24_cells"]];
  AppendTo[terms, "P_w_w_reflection_caveat"];
  If[Length[unitScalingObject[]] === 9,
    AppendTo[terms, "dimension_firewall"]];
  AppendTo[terms, "verdict_precedence"];
  terms
];

deriveVerdict[
    source_, parity_, uniqueOverride_: Automatic,
    magnitudeStatus_: "R1(magnitude)"] := Module[
  {
    unique, symbols, barredIntersection, basisResiduals,
    invariants, sourceValid
  },
  unique = If[
    uniqueOverride === Automatic,
    source["UniqueFluxCoefficient"], uniqueOverride];
  symbols = freeSourceMarkers[source["CandidateSource"]];
  barredIntersection = Intersection[symbols, barredSourceMarkers];
  basisResiduals =
    source["CandidateSource"] - source["NativeSource"];
  invariants = parityInvariants[parity];
  sourceValid =
    zq[source["ContinuityResidual"]] &&
    TrueQ[FullSimplify[unique == 1]] &&
    And @@ (zq /@ basisResiduals) &&
    barredIntersection === {};
  Which[
    !TrueQ[sourceValid], r1SourceToken,
    !And @@ (TrueQ /@ Values[invariants]), parityBadToken,
    True, verdictToken
  ]
];

