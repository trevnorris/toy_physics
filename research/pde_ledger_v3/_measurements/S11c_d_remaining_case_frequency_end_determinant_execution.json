      "adapterSource": "def native_determinant(matrix, router):\n    \"\"\"Clear row denominators before the small exact determinant.\"\"\"\n    (denominators, rows) = ([], [])\n    for i in range(matrix.rows):\n        if router.restore_row(matrix, i, rows, denominators):\n            pass\n        else:\n            entries = [router.call(0, 'cancel', matrix[i, j]) for j in range(matrix.cols)]\n            router.observe('entries', entries)\n            denominator = router.call(2, 'lcm', [router.call(1, 'denom', e) for e in entries])\n            router.observe('denominator', denominator)\n            rows.append([router.call(3, 'cancel', e * denominator) for e in entries])\n            router.observe('clearedRow', rows[-1])\n            denominators.append(denominator)\n            router.row_complete(i, rows[-1], denominators[-1])\n    polynomial_matrix = router.call(4, 'ImmutableMatrix', rows)\n    router.observe('polynomial_matrix', polynomial_matrix)\n    if router.restore_tail(polynomial_matrix, denominators):\n        return router.finish(router.saved_tail)\n    else:\n        determinant = router.call(5, 'det', polynomial_matrix, method='domain-ge')\n        router.observe('determinant', determinant)\n        rational = router.call(7, 'cancel', determinant / router.call(6, 'prod', denominators))\n        router.observe('rational', rational)\n        return router.finish((router.call(8, 'fraction', rational), polynomial_matrix, tuple(denominators)))"
