  "independent_review_source": {
    "_scratch/s11c/contact_path_referee_source/check.py": {
      "sha256": "1ab832a90b979da5a3fc09002a0eaf2a0b04cb38669318e7c9b343fd5e252265",
      "source": "from pathlib import Path\nimport json, math\nimport numpy as np\nfrom numpy.polynomial import Polynomial\nfrom scipy.integrate import quad\nfrom scipy.optimize import brentq\n\nroot=Path('_scratch/s11c')\ndef radius(w):\n    t=(w-1.2)/1.85\n    if t>=0:\n        return 1+t**3*(4-3*t)/2,6*t*t*(1-t)/1.85\n    t=(w-.5)/.7\n    r0=.5+.5*math.sin(math.atan(.25/(4*math.pi*.4)))\n    return (r0+(1-r0)*(10-15*t+6*t*t)*t**3+.49*t*t*(1-t)**3,\n            (1-r0)*30*t*t*(1-t)**2/.7+.7*t*(1-t)**2*(2-5*t))\n\ndef run(n,frac):\n    with np.load(root/f'mouth_flared_delayed_n{n}/field.npz') as f:\n        coord,psi=f['points'],f['psi']\n    with np.load(root/f'contact_supply_n{n}_01/order_{frac:.5f}.npz') as f:\n        chi=f['chi']\n    # Independent wall extraction. At each axial level in the conduit the\n    # wall is the outermost carrier node, including at the corner-free collar.\n    valid=(coord[:,1]>=.5)&(coord[:,1]<3.05)\n    wwall=sorted(set(coord[valid,1]))\n    row={z: np.flatnonzero(coord[:,1]==z)[np.argmax(coord[coord[:,1]==z,0])] for z in wwall}\n    # The reservoir meets the last element, and the rounded lip meets the first.\n    # Start at the shared w=1.2 vertex, extend in each direction from that.\n    middle=wwall.index(1.2)\n    rows=wwall[middle%2:]; wall=np.array([row[w] for w in rows])\n    pp={}; cc={}; edges=[]\n    for i in range(0,len(rows)-2,2):\n        z=np.array(rows[i:i+3]); nodes=wall[i:i+3]; key=z[0]\n        if key<.75:continue\n        assert np.max(abs(coord[nodes,0]-[radius(x)[0] for x in z]))<1e-8\n        edges.append(key)\n        pp[key]=Polynomial.fit(z,psi[nodes],2)\n        cc[key]=Polynomial.fit(z,chi[nodes],2)\n    edges=np.array(edges)\n    def p(z,fields):\n        return fields[edges[np.searchsorted(edges,z,side='right')-1]]\n    def c(z):return float(p(z,cc)(z))\n    levels=[.99,.95,.90,.85,.75,.65,.50,.45,.25,.10,.05,.01,.001,.0001]\n    marks=[brentq(lambda z:c(z)-k,.80,2.5) for k in levels]\n    def time(z0,z1):\n        vals=[z0,*edges[(z0<edges)&(edges<z1)],z1]\n        total=0\n        for l,r in zip(vals,vals[1:]):\n            f=p((l+r)/2,pp)\n            def integrand(z):\n                phase_slope=(f.deriv()(z)/f(z)).imag\n                return (1+radius(z)[1]**2)/phase_slope\n            total+=quad(integrand,l,r,epsabs=1e-11)[0]\n        return total\n    print(json.dumps(dict(n=n,frac=frac,levels=levels,w=marks,elapsed_from_first=[time(marks[0],w) for w in marks],radius=[radius(w)[0] for w in marks])), flush=True)\n\nfor mesh in (34,48):\n    for q in (0.,.5):run(mesh,q)\n"
    },
    "_scratch/s11c/contact_path_referee_source/compare.py": {
      "sha256": "c8f38e4b86db169f06483505a74b7a45cac378fc2335b943c4957b6f8c4f752f",
      "source": "import json\nfrom pathlib import Path\nr=Path('_scratch/s11c')\ndef rows(folder): return [json.loads(x) for x in (r/folder/'stdout').read_text().splitlines()]\nown=rows('contact_path_referee_run01'); other=rows('contact_tracking_01')\nerror=[0.,0.,0.]; cases=0\nfor rec in other:\n    a=next(x for x in own if (x['n'],x['frac'])==(rec['mesh'],rec['head_fraction']))\n    start=a['levels'].index(.95)\n    for b in rec['readings']:\n        k=a['levels'].index(b['order'])\n        ours=[a['w'][k],a['elapsed_from_first'][k]-a['elapsed_from_first'][start],a['radius'][k]/a['radius'][start]]\n        their=[b['depth'],b['elapsed'],b['angular_spacing_ratio']]\n        error=[max(abs(u-v),e) for u,v,e in zip(ours,their,error)]\n        cases+=1\nassert cases==24 and max(error)<1e-8\nprint(json.dumps(dict(crossings=cases, max_abs_depth_elapsed_spacing=error)))\n"
    },
    "_scratch/s11c/contact_junction_referee_source/check.py": {
      "sha256": "27aaf6acff0ae716ed8eb391234cef8dff3bd29c827e78fa133874554fa2600b",
      "source": "\"\"\"Independent midpoint semigroup check using only the archived nodal coordinates and fields.\"\"\"\nfrom pathlib import Path\nimport numpy as np\nfrom math import atan,sin,pi\nfrom scipy.optimize import brentq\nimport json\nroot=Path('_scratch/s11c')\n\ndef run(n,h):\n    with np.load(root/f'mouth_flared_delayed_n{n}/field.npz') as f:\n        r,w=f['points'].T; psi=f['psi']\n    with np.load(root/f'contact_supply_n{n}_01/order_{h:.5f}.npz') as f:\n        c=f['chi']\n    unique=np.unique(w[(w>0.75)&(w<2.45)])\n    pad=np.searchsorted(unique,1.2)%2\n    z=unique[pad:]\n    node=np.array([np.argmax(np.where(w==v,r,-1)) for v in z])\n    def coefficients(values):\n        v0,v1,v2=values[node[:-2:2]],values[node[1:-1:2]],values[node[2::2]]\n        return (v0,4*v1-3*v0-v2,2*(v0+v2-2*v1))\n    cf,ps=coefficients(c),coefficients(psi)\n    left=z[:-2:2]\n    width=z[2::2]-left\n    def evaluate(y,data,deriv=False):\n        i=np.searchsorted(left,y,side='right')-1\n        t=(y-left[i])/width[i]\n        A,B,C=data\n        return (B[i]+2*C[i]*t)/width[i] if deriv else A[i]+(B[i]+C[i]*t)*t\n    def invv(y):\n        u=np.clip((y-1.2)/1.85,0,1)\n        t=np.clip((y-.5)/.7,0,1)\n        gap=.5-.5*sin(atan(.25/(4*pi*.4)))\n        a1=np.where(y<1.2,(gap*30*t*t*(1-t)**2+.49*t*(1-t)**2*(2-5*t))/.7,\n                    6*u*u*(1-u)/1.85)\n        return (1+a1*a1)/np.imag(evaluate(y,ps,True)/evaluate(y,ps))\n    def mark(level):return brentq(lambda y:evaluate(y,cf)-level,.9,2.3)\n    for high in (.95,.99,.999):\n        for low in (.01,.001,.0001,1e-5,1e-6):\n            for span in (0.,.04):\n                start,end=mark(high),mark(low)\n                knots=np.unique(np.concatenate([[start,end],*[t[(t>start)&(t<end)] for t in [left,left+span/2,left-span/2]]]))\n                widths=np.diff(knots)\n                group=np.ceil(widths/.00002).astype(int)\n                absc=np.concatenate([np.linspace(l,l+v,ng,endpoint=False) for l,v,ng in zip(knots,widths,group)])\n                d=np.diff(np.r_[absc,end]); grid=absc+d/2;dt=d*invv(grid)\n                def channels(x):return evaluate(x-span/2,cf)/2,evaluate(x+span/2,cf)/2\n                a,b=channels(grid); k=a+b\n                a0,b0=channels(start); a1,b1=channels(end)\n                x0=(a0-b0)/(a0+b0); initial=.5*(a0*(x0-1)**2+b0*(x0+1)**2)\n                x=x0; work=0.\n                for ke,xe,duration in zip(k,(a-b)/k,dt):\n                    j=x-xe; work+=.5*ke*j*j*(-np.expm1(-2*ke*duration)); x+=j*np.expm1(-ke*duration)\n                final=.5*(a1*(x-1)**2+b1*(x+1)**2)\n                print(json.dumps({'n':n,'h':h,'high':high,'low':low,'span':span,'E_initial':initial,'W':work,\n                    'W/E0':work/initial,'E_last/E0':final/initial,'equilibrium_shift':(a1-b1)/(a1+b1)-x0}),flush=True)\nfor n in (34,48):\n    for h in (0.,.5):run(n,h)\n"
    }
