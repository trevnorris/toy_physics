      "sha256": "8abf6379ed3b07e7dcfae6b919031599afcb748c8d7d77ef628539e6b5d2fbd7",
      "source": "\nimport json, numpy as np\nfrom scipy.special import expit, logit\nfrom numpy.polynomial.legendre import leggauss\nfrom scipy.optimize import brentq\nfrom pathlib import Path\nsrc=Path(\"_scratch/s11c/drain_wave_power_n34_t192_01\")\nguard=json.loads((src/\"outcome.json\").read_text())\nassert guard[\"limitsVerified\"] and guard[\"exitCode\"]==guard[\"childOutcome\"][\"exitCode\"]==0\nomega,=[json.loads(row)[\"omega\"] for row in (src/\"stdout\").read_text().splitlines() if json.loads(row)[\"test\"]==\"scalar\"]\narea=4*np.pi/3\nu=.25/area\nwidth=.04\ntau=26.0591\nhigh,low=.85,.45\nH=lambda c:c*c*(3-2*c)\norder=lambda t:expit(logit(high)-u*t/width)\nT=width*(logit(high)-logit(low))/u\nh=u/(6*5*width)\nprint(json.dumps(dict(test=\"flat_base\",omega=omega,T=T,transit_phase=omega*T,head=h,head_per_entering_particle=h*(H(high)-H(low)),total_head_power=.25*h*(H(high)-H(low)))))\nfor n in (32,64,128):\n    v,w=leggauss(n); v=(1+v)/2; w=w/2\n    a=(T*v)[:,None]\n    lag=a*v\n    dY=H(order(a-lag))-H(order(a))\n    weights=T*w[:,None]*a*w*order(a)*np.cos(omega*lag)\n    def pw(beta):\n        return -.5*omega**2 * area*3*u * np.sum(weights*np.exp(beta*dY-lag/tau))\n    root=brentq(pw,0,50)\n    print(json.dumps(dict(test=\"time_domain_kernel\",nodes=n,per_displacement_amplitude_squared={b:pw(b) for b in (0.,1.,2.,5.425,root,10.,15.)},beta_zero=root,zero_strain_entry=True)))\n"
    },
    "conversion_wave_front_response_referee01": {
      "scope": "Scoped clear for work on the prescribed oscillatory probe and signed cycle-energy accounting on this flowing planar patch.",
      "source_path": "_scratch/s11c/conversion_wave_front_response_referee.py",
      "sha256": "8f9381bd867c9058d586e1acd5fe9be81f8e4ac954d560daa5f1e54008b7c50f",
      "source": "\"\"\"Independent zero-amplitude stationary-front damping/gain at patch probe frequency.\"\"\"\nimport json\nimport numpy as np\nfrom scipy.integrate import simpson, cumulative_simpson\nfrom scipy.linalg import solve_banded\nfrom scipy.optimize import brentq\nfrom scipy.special import expit,logit\nfrom pathlib import Path\nroot=Path('_scratch/s11c')\nsetup=json.loads((root/'contact_supply_coupon_01'/'stdout').read_text().splitlines()[0])\nomega=json.loads((root/'drain_wave_power_n34_t192_01'/'stdout').read_text().splitlines()[1])['omega']\nk,M,width,tau,u,area,A=(setup[k] for k in ['kappa','mobility','width','tau','material_speed','area','area_per_volume'])\nleft,right=setup['ordered_side'],setup['less_ordered_side']\nH=lambda c: c*c*(3-2*c)\nfor multiple in [0.,1.01]:\n    head=setup['head_reference']*multiple\n    for N in [256,1024,2048]:\n        z=np.linspace(0.,setup['length'],N+1)\n        dz=z[1]\n        c=expit(logit(left)-z/width); c[0]=left; c[-1]=right\n        upper=-k/dz**2+u/(2*M*dz); lower=-k/dz**2-u/(2*M*dz)\n        def jac(c):\n            fu=c[1:-1]\n            diagonal=2*k/dz**2+k/width**2*(1-6*fu+6*fu**2)+6*head*(1-2*fu)\n            return np.array([np.repeat(upper,N-1),diagonal,np.repeat(lower,N-1)])\n        for _ in range(8):\n            inside=c[1:-1]\n            residual=-k*np.diff(c, n=2)/dz**2+u*(c[2:]-c[:-2])/(2*M*dz)+inside*(1-inside)*(k/width**2*(1-2*inside)+6*head)\n            dc=solve_banded((1,1),jac(c),-residual)\n            c[1:-1]+=dc\n            if np.max(abs(dc))<2e-14:\n                break\n        operator=jac(c).astype(complex); operator[1]+=2j*omega/M\n        osc=np.r_[0.,solve_banded((1,1),operator,np.full(N-1,-0.25)),0.]\n        shear_coefficient=-area*omega/4*simpson(osc.imag,x=z)\n        t=z/u\n        def power(beta):\n            row=np.exp(-t/tau+beta*(H(left)-H(c))-1j*omega*t)\n            inv=1/row\n            gi=1j*omega*row*(cumulative_simpson(inv.real,x=t,initial=0.)+1j*cumulative_simpson(inv.imag,x=t,initial=0.))\n            return -area*A*omega/2*simpson(c*gi.imag,x=z)\n        threshold=brentq(power,5.425,10)\n        print(json.dumps(dict(panels=N,head_ratio=multiple,shear_over_a4=shear_coefficient,contact_over_a2={str(b):power(b) for b in [0.,1.,5.425,10.]},threshold=threshold,tag_extension_ratio=np.exp(threshold*(H(left)-H(right))-t[-1]/tau),per_entering=head*(H(left)-H(right)))),flush=True)\n"
