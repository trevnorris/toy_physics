      "contents": "\"\"\"Independent exact dual bounds via all extremal supports of the l1 ball slice.\"\"\"\nfrom fractions import Fraction\nfrom itertools import combinations\nimport json\nfrom pathlib import Path\nimport sys\n\ndef det(matrix):\n    if len(matrix)==1:\n        return matrix[0][0]\n    return sum((-1)**j * value * det([r[:j]+r[j+1:] for r in matrix[1:]])\n               for j,value in enumerate(matrix[0]))\n\ndef certificates(columns):\n    for n_equal in range(3):\n        for extra in combinations((2,3),n_equal):\n            eq=(0,1)+extra\n            for index in combinations(range(len(columns[0])),len(eq)+1):\n                matrix=[[columns[k][i] for i in index] for k in eq]\n                cofs=[(-1)**j*det([row[:j]+row[j+1:] for row in matrix]) for j in range(len(index))]\n                length=sum(map(abs,cofs))\n                if not length:\n                    continue\n                for sign in (1,-1):\n                    w=[sign*v/length for v in cofs]\n                    product=[sum(x*col[i] for x,i in zip(w,index)) for col in columns]\n                    if product[:2] != [0,0] or max(product[2:])>0:\n                        continue\n                    yield index,w\n\ndef check(row):\n    bands=row['bands']\n    columns=[[1]*len(bands),[b['mean_depth'] for b in bands],\n             [b['curvature'] for b in bands],[-b['wave_pressure_per_action'] for b in bands]]\n    bound={'carrier_surface': Fraction(0),'carrier_volume': Fraction(0)}\n    for index,w in certificates(columns):\n        for key,old in list(bound.items()):\n            v=sum(x*bands[i][key] for i,x in zip(index,w))\n            if v>old: bound[key]=v\n    print(json.dumps(dict(mesh=row['mesh'],q=float(row['q']),**{k:float(v) for k,v in bound.items()})),flush=True)\n\nfor folder in sys.argv[1:]:\n    f=Path(folder)\n    outcome=json.loads((f/'outcome.json').read_text())\n    assert outcome['exitCode']==outcome['childOutcome']['exitCode']==0 and outcome['limitsVerified']\n    rows=[json.loads(s,parse_float=Fraction) for s in (f/'stdout').read_text().splitlines()]\n    for row in rows:\n        if row['test']=='force':\n            check(row)\n",
      "sha256": "cd35875c08f73de4f4d99f5b219fb70095f38b7ef4208bcb51bc2109167b6656"
    },
    "_scratch/s11c/shape_independent01/geometry.py": {
      "contents": "\"\"\"Independent radial-coordinate normalization and analytic geometry Hessians on five-band support.\"\"\"\nfrom pathlib import Path\nimport hashlib,json,math\nimport numpy as np\nfrom scipy.integrate import quad\nroot=Path('research/pde_ledger_v3/_measurements')\narchive=json.loads((root/'mouth_free_equilibrium_inputs.json').read_text())\ntxt=archive['literal_stdout']\nassert hashlib.sha256(txt.encode()).hexdigest()==archive['stdout_sha256']\nrows=[json.loads(s) for s in txt.splitlines()]\ndef geom(z):\n t=(z-1.2)/1.85\n return 1+.5*t*t*(3-2*t), 3*t*(1-t)/1.85\ndef eff(direct, bands, v, pert):\n ans=np.zeros(6)\n for coeff,(lo,hi) in zip(direct,bands):\n  h=hi-lo\n  def integrand(t, k):\n   z=lo+h*t\n   r,p=geom(z)\n   v=coeff*16*t*t*(1-t)**2\n   v1=coeff*32*t*(1-t)*(1-2*t)/h\n   r+=pert*v;p+=pert*v1\n   l=math.hypot(1,p)\n   vals=(2*r*v*l+r*r*p*v1/l,r*r*v,z*r*r*v,2*v*v*l+4*r*v*p*v1/l+r*r*v1*v1/l**3,2*r*v*v,z*2*r*v*v)\n   return vals[k]*4*math.pi*h\n  for k in range(6): ans[k]+=quad(integrand,0,1,args=(k,),epsabs=1e-13,epsrel=4e-14)[0]\n return ans\nfor n in [26,34,48]:\n pre=next(r for r in rows if r['mesh']==n and r['test']=='preparation')\n row=next(r for r in rows if r['mesh']==n and r['test']=='affine_work' and r['method']=='volume')\n bands=pre['bands']\n vols=np.array([4*math.pi*(hi-lo)*quad(lambda t: geom(lo+(hi-lo)*t)[0]**2*16*t*t*(1-t)**2,0,1)[0] for lo,hi in bands])\n c=np.array(row['dual_weights'])/vols\n c/=max(abs(c))\n wave=np.array(pre['design'])[:,3]\n press=np.array(row['carrier_pressure'])\n g=eff(c,bands,vols,0)\n f=1e-6\n df=(eff(c,bands,vols,f)[:3]-eff(c,bands,vols,-f)[:3])/(2*f)\n print(json.dumps(dict(mesh=n, coefficients=c.tolist(),weighted_volumes=(c*vols).tolist(),geometry=['area','volume','volume_w'],first=g[:3].tolist(),second=g[3:].tolist(),fd_second=df.tolist(),pressure_work=c*vols@press,wave_work=-c*vols@wave)))\n np.testing.assert_allclose(g[:3],0,rtol=0,atol=1e-12)\n np.testing.assert_allclose(df,g[3:],rtol=1e-9,atol=3e-9)\n",
      "sha256": "2b6c1111a75e98dccbade883bc95463e93c9c192d45d2d18bcbc0856c7a4f04e"
    },
    "_scratch/s11c/shape_independent01/wave.py": {
      "contents": "\"\"\"Analytic curvature of the ground frequency using the constrained first-order mode response.\"\"\"\nimport sys\nsys.path.insert(0,'software/stage1_solver/tools')\nfrom pathlib import Path\nimport json,hashlib,math,argparse\nimport numpy as np,yaml\nfrom scipy import sparse\nfrom scipy.integrate import quad\nfrom scipy.special import expit\nfrom scipy.sparse.linalg import splu\nfrom mouth_wave_flare_work import Wave\nfrom mouth_trapped_wave_ports import ARCHIVE\nparser=argparse.ArgumentParser()\nparser.add_argument('--wave-step',type=float,required=True)\nparser.add_argument('--pad',type=float,default=5)\nparser.add_argument('--coefficients',required=True)\nargs=parser.parse_args()\ncoef=np.array(json.loads(args.coefficients))\nd=json.loads(Path('research/pde_ledger_v3/_measurements/mouth_free_equilibrium_inputs.json').read_text())\nassert hashlib.sha256(d['literal_stdout'].encode()).hexdigest()==d['stdout_sha256']\nbands=next(json.loads(l)['bands'] for l in d['literal_stdout'].splitlines() if json.loads(l)['test']=='preparation')\npars=yaml.safe_load(ARCHIVE.read_text())['parameters']\nwave=Wave(1.,1.,args.wave_step,args.pad,pars)\nomega,u,K,_,b=wave.ground(1.)\ngate=wave.gate(1.)[0]; d0=pars['delta_r']/2\nz=wave.w.ravel(); B=np.zeros_like(z); Bp=np.zeros_like(z)\nfor c,(lo,hi) in zip(coef,bands):\n def shape(w):\n  t=(w-lo)/(hi-lo)\n  return 16*t*t*(1-t)**2 if 0<t<1 else 0.\n for j,w in enumerate(z):\n  if w<=lo-args.wave_step or w>=hi+args.wave_step: continue\n  B[j]+=c*shape(w)\n  x0=max(lo,w-args.wave_step);x1=min(hi,w+args.wave_step)\n  parts=np.unique([x0,max(x0,min(x1,w)),x1])\n  Bp[j]+=c*sum(quad(lambda s: shape(s)*(1-abs(s-w)/args.wave_step)/args.wave_step,a,bb,epsabs=1e-14)[0] for a,bb in zip(parts[:-1],parts[1:]))\n# Invert on the complement of the mode without a dense extra row or outer product.\nA=(K-sparse.eye(len(u),format='csc')*omega**2).tocsc()\nk=abs(u).argmax()\nactive=np.arange(len(u))!=k\nfactor=splu(A[active][:,active].tocsc())\nfor shape,label in [(B,'sampled'),(Bp,'hat_average')]:\n K1=(-wave.contrast*gate*(1-b)*shape[None,:]/d0).ravel()\n K2=(K1.reshape(b.shape)*(1-2*b)*shape[None,:]/d0).ravel()\n e1=u@(K1*u)\n rhs=-(K1-e1)*u\n v=np.zeros_like(u);v[active]=factor.solve(rhs[active]);v-=u*(v@u)\n residual=np.linalg.norm(A@v-rhs)\n e2=u@(K2*u)+2*(u*K1)@v\n w1=e1/(2*omega);w2=e2/(2*omega)-e1**2/(4*omega**3)\n print(json.dumps(dict(implementation=label,coefficients=coef.tolist(),omega=omega,force_per_action=-w1,force_slope_per_action=-w2,response_residual=residual,mesh=args.wave_step,pad=args.pad)))\n assert residual<1e-8\n",
      "sha256": "28592343b8210da75d18e10c65a80b2c2d8a6b400f97a1f3c2b7d9510fc819fd"
    },
    "_scratch/s11c/shape_independent01/bounds.py": {
      "contents": "\"\"\"Independently bound force residuals by enumerating extreme dual band combinations.\"\"\"\nimport itertools\nimport json\nimport numpy as np\nfrom pathlib import Path\nfrom hashlib import sha256\nimport sys\nfor folder in (Path(arg) for arg in sys.argv[1:]):\n run=json.loads((folder/'outcome.json').read_text()); assert run['exitCode']==0 and run['limitsVerified']\n lines=(folder/'stdout').read_bytes()\n for r in map(json.loads, lines.splitlines()):\n  if r.get('test')!='force': continue\n  bs=r['bands']; D=np.array([[1,b['mean_depth'],b['curvature'],-b['wave_pressure_per_action']] for b in bs])\n  estimates=np.array([[b['carrier_volume'],b['carrier_surface']] for b in bs])\n  best=np.zeros(2)\n  for extra in [(),(2,),(3,),(2,3)]:\n   cols=(0,1,*extra)\n   for ix in itertools.combinations(range(len(bs)),len(cols)+1):\n    q=np.array(ix); mat=D[q][:,cols].T; scaled=mat/np.max(abs(mat),axis=1)[:,None]\n    u,sv,vh=np.linalg.svd(scaled,full_matrices=True)\n    if min(sv)<1e-12:continue\n    vec=vh[-1]/sum(abs(vh[-1]))\n    for sig in [-1,1]:\n     v=sig*vec\n     if np.max(v@D[q,2:])>1e-10:continue\n     best=np.maximum(best, v@estimates[q,:])\n  print(json.dumps(dict(stdout_sha256=sha256(lines).hexdigest(),n=r['mesh'],q=r['q'],volume_lower_bound=best[0],wall_lower_bound=best[1])))\n",
      "sha256": "8efcd5379643e41a187ede51e74ba1b4d03b7b026a90eeabc459031a338fe942"
    }
  }
