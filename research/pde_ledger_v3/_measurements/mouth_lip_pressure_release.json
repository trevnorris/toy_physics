      "script_source": "\"\"\"Independent real-wave and uncondensed carrier transforms for a three-holder release.\"\"\"\nfrom pathlib import Path\nfrom types import SimpleNamespace\nimport sys\n\nimport numpy as np\nimport yaml\nfrom scipy import sparse\nfrom scipy.integrate import quad\nfrom scipy.sparse.linalg import splu\n\nsys.path.insert(0, str(Path('software/stage1_solver/tools').resolve()))\nfrom mouth_carrier_lateral_response import prepare\nfrom mouth_free_bend_held_flow import volume_reaction, wall_reaction\nfrom mouth_free_bend_drive import Response\nfrom mouth_free_bend_release import pencil\nfrom mouth_wave_flare_work import ARCHIVE, Wave\n\n\ndef real_wave(step, pad):\n    p = yaml.safe_load(ARCHIVE.read_text())['parameters']\n    wave = Wave(1., 1., step, pad, p)\n    om, u, op, _, radial = wave.ground(1.)\n    gate = wave.gate(1.)[0]\n    common = (2*wave.contrast*gate*(1-radial)/p['delta_r']).ravel() * u / np.sqrt(3)\n    angular = np.broadcast_to(2*p['c_w']**2/wave.r**2, gate.shape).ravel()\n    d = op + sparse.diags(angular-om**2, format='csc')\n    shape = [np.ones_like(wave.w)]\n    for a,b in [(0.55,1.15),(1.2,2.)]:\n        h = np.clip((wave.w-a)/(b-a), 0, 1)\n        shape.append(h**3*(10+h*(-15+6*h)))\n    shape = np.column_stack([np.broadcast_to(h,gate.shape).ravel() for h in shape])\n    q = common[:,None]*shape\n    frozen = shape.T @ ((common*splu(d).solve(common))[:,None]*shape)\n    eye = sparse.eye(len(u),format='csc')\n    def impedance(s):\n        block = sparse.bmat([[d+s*s*eye,2*om*s*eye],[-2*om*s*eye,d+s*s*eye]],format='csc')\n        rhs = np.vstack([q,np.zeros_like(q)])\n        amp = splu(block).solve(rhs)\n        residual = np.max(abs(block@amp-rhs))\n        return p['I_wave']*(frozen-q.T@amp[:len(u)])/om,residual\n    return impedance\n\n\nmesh, step, pad = int(sys.argv[1]), float(sys.argv[2]), float(sys.argv[3])\ndom, stationary = prepare(SimpleNamespace(source=Path(f'_scratch/s11c/mouth_flared_cubic_n{mesh}')))\nwall = Response(dom,stationary,'wide')\nincident, stat_res = wall.dipole.steady(1.,0.)\nsurface = wall_reaction(dom,stationary,incident)\nvolume = volume_reaction(dom,stationary,incident,'wide')\nphysical_map = np.tri(3)\nstation_load = np.linalg.solve(physical_map.T,surface)\nprint('held', mesh, step, pad, surface.tolist(),volume.tolist(),station_load.tolist(),stat_res, flush=True)\nenergy, gyro = pencil(wall,0.)\nwave = real_wave(step,pad)\nfor s in [.35,.08]:\n    scalar,res_wave = wave(s)\n    # Integrate the force history in time from its definition, including the constant tail.\n    envelope = quad(lambda t: np.exp(-s*t)*np.sin(np.pi*t/8)**2,0,4)[0] + np.exp(-4*s)/s\n    for deep in [.02,.04]:\n        support = np.diag(wall.area.diagonal()*[0,.02,deep])\n        extra = sparse.block_diag([sparse.csc_matrix(wall.operator.shape),scalar+support],format='csc')\n        op = energy-s*gyro+extra\n        rhs = np.zeros((op.shape[0],2))\n        rhs[-3:] = envelope * np.column_stack([surface,volume])\n        sol = splu(op).solve(rhs)\n        out = physical_map @ sol[-3:]\n        print('transform', s, deep, envelope,out.T.tolist(), 'wave_res', res_wave,\n              'carrier_res', np.max(abs(op@sol-rhs)),flush=True)\n",
      "literal_stdout": "{\"test\": \"preparation\", \"source\": \"_scratch/s11c/mouth_flared_cubic_n26/field.npz\", \"sha256\": \"c73466fb6e002fdf3dfa57868206809f4e9a2309426b3fa80baa601c9c7eeee2\", \"mesh\": 26, \"far\": 9.0, \"roof\": 10.0, \"rate\": 0.24999999999797987, \"profile\": \"cubic\"}\nheld 26 0.05 4.5 [0.2500130849944806, 0.0021581639153960544, 0.0002699675211624197] [0.2500122988655639, 0.0021582604906892748, 0.00026998039540160183] [0.24785492107908455, 0.0018881963942336346, 0.0002699675211624197] 1.4142642612569034e-10\ntransform 0.35 0.02 1.4857904028073985 [[4.7593148923584705, 0.6919946932037879, 0.10653367595474761], [4.7592976928669035, 0.691992494732145, 0.10653333629116035]] wave_res 4.3989117903819874e-14 carrier_res 1.5487611193520934e-14\ntransform 0.35 0.04 1.4857904028073985 [[4.8561840755773416, 0.5645833772807203, 0.14345068670324207], [4.856166568531193, 0.5645815833333305, 0.14345022983008054]] wave_res 4.3989117903819874e-14 carrier_res 1.1934897514720433e-14\ntransform 0.08 0.02 10.677647797779736 [[100.86518034613376, 44.20135723474067, 36.857610347235244], [100.86482417990258, 44.20121200690911, 36.857489360093524]] wave_res 4.3076653355456074e-14 carrier_res 1.2961680340151105e-13\ntransform 0.08 0.04 10.677647797779736 [[99.87145309658185, 41.733247818424125, 37.30564314445123], [99.87110021050646, 41.73311073747937, 37.30552067841536]] wave_res 4.3076653355456074e-14 carrier_res 1.435999756604911e-13\n",
