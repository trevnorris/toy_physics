    "script_source": "import hashlib\nimport json\nfrom pathlib import Path\nimport subprocess\n\nroot = Path('_scratch/s11c')\nbase = Path(__file__).resolve().parent\ntool = Path('software/stage1_solver/tools')\ndef read(path): return json.loads(path.read_text())\ndef digest(path): return hashlib.sha256(path.read_bytes()).hexdigest()\n\ndef collect(folder):\n    outcome, child, limits, duration, inv = [read(folder / n) for n in\n        ('outcome.json','child-outcome.json','limit-validation.json','duration-validation.json','invocation.json')]\n    assert outcome['exitCode']==child['exitCode']==outcome['childOutcome']['exitCode']==0\n    assert child['guardReason'] is None and outcome['limitsVerified'] and limits['verified'] and duration['verified']\n    assert int(limits['actual']['memory.max'])==inv['memoryMax'] and int(limits['actual']['memory.swap.max'])==0\n    assert duration['actual']['RuntimeMaxUSec']=='infinity' and duration['actual']['Restart']=='no' and inv['seconds']==0\n    stdout=(folder/'stdout').read_text()\n    stderr=(folder/'stderr').read_text()\n    assert stderr==''\n    return {'command':inv['command'],'guard_exit':outcome['exitCode'],'child_exit':child['exitCode'],'limits_verified':True,\n            'memory_cap_bytes':inv['memoryMax'],'swap_cap_bytes':0,'runtime_limit':'infinity',\n            'literal_stdout':stdout,'stderr':stderr},[json.loads(s) for s in stdout.splitlines()]\nfiles = [tool / (name + '.py') for name in ('mouth_lip_pressure_release','mouth_free_bend_held_flow','mouth_occupied_companion',\n    'mouth_free_bend_drive','mouth_carrier_lateral_response','mouth_wave_flare_work','mouth_occupied_push_baths',\n    'mouth_flared_receiver','mouth_empty_bend_stiffness','mouth_carrier_attachment_tension')]\nfiles += [root/x/'field.npz' for x in ('mouth_flared_cubic_n26','mouth_flared_cubic_n34','occupied_push_bath18_n34_01')]\nrecord={'base':subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip(),\n        'question':'With the distant stream maintained, how does a fixed-shape held mouth carry the measured pressure into motion when all three lateral holders are withdrawn?',\n        'protocol':'Radius 1, intake 0.25. Fixed reference cubic flare, trapped wave action one. First-bend area tension 0.02, deep area tension 0.02 or 0.04. Opposing loads on all three initially held coordinates smoothly withdrawn over four time units. All motion incremental from the held preparation. The ordinary carrier and the occupied wave evolve in a finite feeding and receiving bath. No separate bare wall mass or tag force.',\n        'limitations':'First-order response about prescribed occupied shape. Area tensions and wave occupation are preparations. A constant local stream represents the leading companion drive. Displacement and its time integral do not give an instantaneous acceleration, a captured material fraction or a universal free-fall coefficient.',\n        'hashes':{str(f):digest(f) for f in files},'runs':{},\n        'independent_review':None,'formal_repository_review':'Pending'}\ncodes=read(base/'DONE.json')\nassert set(codes)=={'coarse','base','fine','reverse','wide'} and not any(codes.values())\nresult={}\nfor name in codes:\n    run, rows=collect(root / ('lip_pressure_release_'+name+'_01'))\n    held,=[r for r in rows if r['test']=='held']\n    snap={int(r['time']):r for r in rows if r['test']=='release'}\n    lap,=[r for r in rows if r['test']=='laplace']\n    assert len(snap)==8 and held['wave_action']==1 and held['first_tension']==.02 and held['deep_tensions']==[.02,.04]\n    result[name]=snap\n    record['runs'][name]=run\n    pressure=held['direct_pressure']\n    station_load=[pressure[0]-pressure[1],pressure[1]-pressure[2],pressure[2]]\n    print(name,'direct pressure assigned by station virtual work',station_load,'static discrete load',held['generalized_force_per_speed'],\n          'max work relative error',max(max(x['relative_energy_error']) for x in snap.values()),\n          'max transform relative discrepancy',max(max(x) for x in lap['discrepancy']))\n    if name in ('fine','wide'):\n        for t in (4,8,16,32,64):\n            m=snap[t]['stations_per_speed']\n            print(name,t,m,'entrance change %',100*(m[1][0]/m[0][0]-1),\n                  'flare / entrance', [c[2]/c[0] for c in m])\ndef error(a,b):\n    return max(abs(x-y)/max(abs(y),1.e-12) for p,q in zip(a,b,strict=True) for x,y in zip(p,q,strict=True))\nfor name, ref in [('reverse','coarse'),('coarse','base'),('base','fine'),('fine','wide')]:\n    e={t:error(row['stations_per_speed'],result[ref][t]['stations_per_speed']) for t,row in result[name].items()}\n    print(name,'vs',ref,'max station pointwise relative error by time',e)\n    if name=='reverse': assert max(e.values())<1e-8\noutput=Path('research/pde_ledger_v3/_measurements/mouth_lip_pressure_release.json')\noutput.write_text(json.dumps(record,indent=2)+'\\n')\n",
