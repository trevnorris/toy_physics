  "independent_review_source": {
    "_scratch/s11c/matched_registry_ref_source/check.py": {
      "sha256": "c79e80308acf0038f97b94aabcd5d54210cb2e8f998e7abefc3ea40082a641d0",
      "source": "\"\"\"Independent exact finite-difference gradients of two local site energies.\"\"\"\nimport json\nfrom fractions import Fraction as Q\n\n\ns = Q(1,4)\noffset = Q(1,8)\nsmall = Q(1,10**8)\n\n\ndef u(eta, y, a, shape):\n    if shape==\"central\":\n        gap = a*a-eta*eta-y*y\n        assert gap>0\n        return -s*gap*gap/(4*a*a)\n    assert abs(eta)<a and abs(y)<a\n    return s*((eta*eta+y*y)/2-(eta**4+y**4)/(4*a*a))\n\n\ndef slope(fn, x, h):\n    return (fn(x-2*h)-8*fn(x-h)+8*fn(x+h)-fn(x+2*h))/(12*h)\n\n\ndef forces(eta, y, a, shape):\n    return (-slope(lambda e:u(e,y,a,shape), eta, small),\n            -slope(lambda t:u(eta,t,a,shape), y, small))\n\n\nfor order in [Q(3,4), Q(1,2), Q(3,10), Q(13,50)]:\n    a = order/2\n    for arch in [\"central\",\"separable\"]:\n        for d in [Q(1,10**5),Q(1,2*10**5)]:\n            fo,fy=forces(offset,d,a,arch)\n            fo0,fy0=forces(offset,0,a,arch)\n            fc,fyc=forces(0,d,a,arch)\n            fm,fym=forces(offset,-d,a,arch)\n            assert not fc and fy0==0 and fo==fm and fy==-fym and fy<0 and fyc<0\n            if arch==\"central\":\n                assert fy/fyc == 1-offset**2/(a*a-d*d)\n                assert -(fo-fo0) == -s*offset*d*d/(a*a)\n                dval=lambda e: -forces(e,d,a,arch)[1]/d\n                assert 2*(-fo+fo0)/d**2 == slope(dval,offset,small)\n            else:\n                assert fy == fyc and fo==fo0\n            print(json.dumps(dict(law=arch,chi=float(order),step=float(d),\n                  center_force=float(fyc),offcenter_force=float(fy),ratio=float(fy/fyc),\n                  holding_delta=float(fo0-fo))))\n"
    },
    "_scratch/s11c/matched_registry_motion_referee_src/check.py": {
      "sha256": "e3dd7f2f4bc8c2b5868a4e12f44e84236b1aa63969a42c5c839d3d17c9c3466a",
      "source": "\"\"\"Independent transfer of registry in the matched upstream order trace.\"\"\"\nfrom pathlib import Path\nimport hashlib, json, math\nimport numpy as np\nfrom scipy.integrate import solve_ivp\nfrom scipy.optimize import brentq\nroot=Path('_scratch/s11c')\nfield=root/'mouth_flared_delayed_n48/field.npz'\norder=root/'contact_supply_n48_01/order_0.50000.npz'\nrecord=json.loads(Path('research/pde_ledger_v3/_measurements/mouth_conversion_contact_transfer.json').read_text())\nfor path in (field,order):\n    assert hashlib.sha256(path.read_bytes()).hexdigest()==(record['pinned_inputs_sha256']|record['generated_fields_sha256'])[str(path)]\nwith np.load(field) as f:\n    points=f['points']\n    phi=f['psi']\nwith np.load(order) as f:\n    chi=f['chi']\nlevels=np.unique(points[(points[:,1]>.9)&(points[:,1]<2),1])\nstart_at=np.searchsorted(levels,1.2)%2\nlevels=levels[start_at:]\nnodes=np.array([np.argmax(np.where(points[:,1]==w,points[:,0],-1)) for w in levels])\nedges=levels[:-2:2]\nspan=levels[2::2]-edges\ndef fits(values):\n    a,b,c=values[nodes[:-2:2]],values[nodes[1:-1:2]],values[nodes[2::2]]\n    return a,4*b-3*a-c,2*(a+c-2*b)\ndef value(w,coefs,deriv=False):\n    ix=np.searchsorted(edges,w,side='right')-1\n    t=(w-edges[ix])/span[ix]\n    a,b,c=coefs\n    return (b[ix]+2*c[ix]*t)/span[ix] if deriv else a[ix]+(b[ix]+c[ix]*t)*t\ncf,pf=fits(chi),fits(phi)\ndef clock(w):\n    assert w>1.2\n    q=(w-1.2)/1.85\n    slope=6*q*q*(1-q)/1.85\n    return (1+slope*slope)/(value(w,pf,True)/value(w,pf)).imag\ndef wallroot(c):return brentq(lambda w:value(w,cf)-c,1.2,1.8,xtol=1e-14)\nA=.125; stiffness=.25; drag=.5; shift=-.02\ndef row(q,c):return -stiffness*q*max(0.,1-(2*q/c)**2)\nstart=wallroot(.95);local0=value(start+shift,cf)\ninitial=brentq(lambda q:A-q+row(q,local0),0,A,xtol=1e-15)\nlevels=[.75,.5,.3]\ngates=np.array([wallroot(c)-shift for c in levels])\nbreaks=np.unique(np.r_[start,gates,edges,edges-shift]);breaks=breaks[(breaks>=start)&(breaks<=gates[-1])]\nstate=np.array([0.,initial,1/initial**2])\nfor w0,w1 in zip(breaks[:-1],breaks[1:]):\n    def rates(w,v):\n        w=max(np.nextafter(w0,w1),min(w,np.nextafter(w1,w0)))\n        q=v[1]; width=value(w+shift,cf)\n        assert width>=.3-1e-9 and q>0 and q<=A+1e-10\n        # Free solution in the independent variable h = 1/eta**2.\n        return clock(w)*np.array([1,(A-q+row(q,width))/drag,\n                                      2*stiffness/drag*(v[2]-4/width**2)])\n    sol=solve_ivp(rates,(w0,w1),state,rtol=3e-12,atol=2e-14,method='RK45')\n    assert sol.success\n    state=sol.y[:,-1]\n    indices=np.flatnonzero(w1==gates)\n    if len(indices):\n        c=levels[indices[0]]\n        force=[]\n        for q in [0,A,state[1],state[2]**-.5]:\n            y=1e-5\n            assert math.hypot(q,y)<c/2\n            inside=max(0.,1-4*(q*q+y*y)/(c*c))\n            force.append(-stiffness*y*inside)\n        print(json.dumps(dict(local_order=c,depth=w1,time=state[0],initial_eta=initial,\n                              supported=state[1],released=state[2]**-.5,\n                              centered_held_supported_released_forces=force,\n                              ratios=[f/force[0] for f in force])),flush=True)\n"
    }
  },
