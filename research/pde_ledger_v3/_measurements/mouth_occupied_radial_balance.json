  "local_reviews": {
    "occupied_radial_cofactor_referee_01": {
      "verdict": "Scoped verdict: the measured radial work rules out a common ground-wave action, uniform area tension and uniform backing as the complete support of this fixed profile. Physical action, lateral tension and free acceleration remain undetermined.",
      "scope": "Independent local review",
      "script": "_scratch/occupied_radial_referee_20261120.py",
      "sha256": "2c8fcc8524ddb3895cc8ff3b878ea216e554233c2fde41f5c6e27ded58f3e695",
      "source": "\"\"\"Independent geometric separation of the measured pressure from the three predictors.\"\"\"\nimport itertools\nimport json\nfrom pathlib import Path\nimport numpy as np\n\nfor n in (26, 34, 48):\n    case = Path(f\"_scratch/s11c/occupied_radial_n{n}_01\")\n    guard = json.loads((case/\"outcome.json\").read_text())\n    assert guard[\"limitsVerified\"] and guard[\"exitCode\"] == guard[\"childOutcome\"][\"exitCode\"] == 0\n    obs = [json.loads(line) for line in (case/\"stdout\").read_text().splitlines()]\n    carrier, = [row for row in obs if row[\"test\"] == \"carrier_work\"]\n    wave, = [row for row in obs if row[\"test\"] == \"wave_state\"]\n    design = np.c_[np.ones(8), carrier[\"curvature\"], wave[\"pressure_per_action\"]]\n    for method in (\"surface\", \"volume\"):\n        measurements = np.array(carrier[method])\n        winners = []\n        for ids in itertools.combinations(range(8), 4):\n            local = design[list(ids)]\n            weights = np.array([(-1)**i*np.linalg.det(np.delete(local, i, axis=0)) for i in range(4)])\n            if np.all(weights==0):\n                continue\n            weights /= np.abs(weights).sum()\n            np.testing.assert_allclose(weights @ local, 0., atol=1e-12)\n            value = weights @ measurements[list(ids)]\n            winners.append((abs(value), ids, weights*np.sign(value)))\n        lower, ids, weights = max(winners, key=lambda v:v[0])\n        active = np.array(ids)\n        # Construct fit attaining the lower bound without optimization.\n        parameters = np.linalg.lstsq(design[active], measurements[active]-np.sign(weights)*lower,rcond=None)[0]\n        residual = measurements-design@parameters\n        np.testing.assert_allclose(np.max(np.abs(residual)),lower,atol=1e-12)\n        for row in obs:\n            if row[\"test\"]==\"eight_band_bound\" and row[\"method\"]==method:\n                np.testing.assert_allclose(lower,row[\"max_error\"],atol=1e-10)\n        print(json.dumps(dict(mesh=n,method=method,bands=ids,signed_weights=weights.tolist(),\n                              lower_bound=lower,attained_max=float(np.max(np.abs(residual))),\n                              singleton_contrast=2*lower)))\n"
    },
    "occupied_radial_quadrature_referee_01": {
      "verdict": "Scoped clear for the radial-work mismatch in the prescribed cubic mouth with one scalar ground mode, uniform backing and uniform area tension.",
      "scope": "Independent local review",
      "script": "_scratch/s11c/occupied_radial_quadrature_referee.py",
      "sha256": "3bed5860a7841a69e804c7cf5629234a29a31addc3ea799ff9b1274ff5e490cb",
      "source": "\"\"\"Independent subcell real-space integration of the scalar's radial work.\"\"\"\nimport json\nfrom pathlib import Path\nimport sys\nimport numpy as np\nfrom numpy.polynomial.legendre import leggauss\nfrom scipy.ndimage import map_coordinates, spline_filter\nfrom scipy.special import expit\nimport yaml\n\nsys.path.insert(0, str(Path('software/stage1_solver/tools').resolve()))\nfrom mouth_wave_flare_work import Wave\nfrom mouth_trapped_wave_ports import ARCHIVE\n\n\ndef compute(n, dz, pad):\n    rows = [json.loads(x) for x in Path(f'_scratch/s11c/occupied_radial_n{n}_01/stdout').read_text().splitlines()]\n    carrier, = [row for row in rows if row['test']=='carrier_work']\n    reference, = [row for row in rows if row['test']=='wave_state']\n    p = yaml.safe_load(ARCHIVE.read_text())['parameters']\n    state = Wave(1., 1., dz, pad, p)\n    omega, u, _, _, _ = state.ground(1.)\n    # A reduction u=r A absorbs spherical measure and azimuthal normalization.\n    # Convert discrete L2 norm to unit continuous dr dw norm before interpolation.\n    coeff = spline_filter((u/dz).reshape(state.r.size,state.w.size))\n    br, bw = p['delta_r']/2, p['delta_parallel']/2\n    contrast = p['mu_out']**2-p['mu_in']**2\n    nodes, weights = leggauss(4)\n    cell = np.arange(-32.,32.)\n    x = (cell[:,None]+(1+nodes[None,:])/2).ravel()\n    dx = np.tile(weights/2,cell.size)\n    # Split in units of the well transition width to resolve its normal derivative.\n    logistic_work = dx*expit(x)*expit(-x)\n    zeta,wgt = leggauss(48)\n    pressure, curvature = [], []\n    for lo,hi in carrier['bands']:\n        z = (lo+hi)/2+(hi-lo)*zeta/2\n        beta = (1-zeta*zeta)**2\n        t = (z-1.2)/1.85\n        a = 1+0.5*t**2*(3-2*t)\n        ap = 3*t*(1-t)/1.85\n        app = 3*(1-2*t)/1.85**2\n        kappa = 2/(a*np.sqrt(1+ap**2))-app/(1+ap**2)**1.5\n        volume = 4*np.pi*(wgt*beta)@(a*a)\n        curvature.append((wgt*beta*a*a)@kappa/((wgt*beta)@(a*a)))\n        radii = a[:,None] + br*x\n        angle = np.broadcast_to(z[:,None],radii.shape)\n        points = np.stack(((radii-state.r[0,0])/dz, (angle-state.w[0,0])/dz))\n        local = map_coordinates(coeff,points,order=3,prefilter=False)\n        gate = expit((z-.5)/bw)*expit((3.05-z)/bw)\n        load = contrast * (local**2@logistic_work) * gate/(2*omega)\n        pressure.append((wgt*beta)@load/volume)\n    pressure = np.array(pressure)\n    curvature = np.array(curvature)\n    np.testing.assert_allclose(curvature,carrier['curvature'],atol=5e-12,rtol=0)\n    reference_pressure = np.array(reference['pressure_per_action'])\n    # Build a positive convex mixture in pressure-shape space independently,\n    # matching curvature and wave load of band 2 to a mix of bands 0, 5, 6.\n    indices = [0,5,6]\n    cols = np.array([np.ones(8),curvature,pressure])\n    mixture = np.linalg.solve(cols[:,indices],cols[:,2])\n    assert np.all(mixture>0)\n    np.testing.assert_allclose(sum(mixture),1.)\n    out = dict(mesh=n,step=dz,direct_pressure_per_action=pressure.tolist(),\n               max_deviation_vs_published_projection=np.max(abs(pressure-reference_pressure)),\n               mixture=mixture.tolist())\n    for method in ['volume','surface']:\n        pp = np.array(carrier[method])\n        contrast = pp[indices] @ mixture - pp[2]\n        out[method+'_contrast'] = contrast\n    print(json.dumps(out),flush=True)\n\n\nfor n,step,pad in [(26,.04,4.5),(34,.03,5.),(48,.02,5.)]:\n    compute(n,step,pad)\n"
    }
