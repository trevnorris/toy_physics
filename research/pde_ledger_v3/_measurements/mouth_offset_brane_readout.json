  "independent_review_source": {
    "_scratch/s11c/offset_scope_ref_src/witness.py": {
      "sha256": "466c4e1d3e7ae8d2e7faede52d7ff92106ac74c695c7d7a86ccee67dd724c5a6",
      "source": "\"\"\"Exact local information test. Contains no constitutive registry/sideways force solver.\"\"\"\nimport hashlib\nimport json\nfrom pathlib import Path\nfrom zipfile import ZipFile\n\nimport sympy as s\n\n\nx, y, a, h, c = s.symbols('x y a h c', real=True, nonzero=True)\nu = s.symbols('u', real=True)\nshape = u**2*(1-u**2)**2*(u**2-s.Rational(1, 3))\nextension = c*y**2*shape.subs(u, x/a)/2\nholding = s.diff(extension, x)\neven = s.factor((holding.subs(y,h)+holding.subs(y,-h))/2 - holding.subs(y,0))\nodd = s.factor((holding.subs(y,h)-holding.subs(y,-h))/2)\ndef emit(**fields): print(json.dumps(fields))\n\ndef persist(expr): return str(s.factor(expr))\n\ngrid = {x: s.Rational(1,8), a: s.Rational(1,4)}\nat_target = s.factor(even.subs(grid))\naxis_checks = [s.simplify(expr.subs(coord,0)) for expr in\n               (extension, holding, s.diff(extension,y)) for coord in (x,y)]\naggregate = s.integrate(shape, (u,-1,1))/2\ntraction_unchanged_bare = s.factor(s.diff(extension,y).subs(y,0))\nemit(extension='c*y^2*phi(x/a)/2 with |x|<a',\n     axis_energy_force_checks=list(map(str,axis_checks)),mean_patch_stiffness_added=str(aggregate),\n     shape_derivative_at_half=str(s.diff(shape,u).subs(u,s.Rational(1,2))),\n     center_gradient= str(traction_unchanged_bare), odd=str(odd), even_at_target=str(at_target),\n     half_step= str(s.simplify(at_target.subs(h,h/2)/at_target)),\n     sample_steps={str(step): persist(at_target.subs(h,step)) for step in (s.Rational(1,100000),s.Rational(1,200000))})\nassert not any(axis_checks) and odd == 0 and aggregate == 0 and s.simplify(at_target-c*h**2/4)==0\nsource = Path('research/pde_ledger_v3/_measurements/mouth_matched_attachment.json')\nmanifest = json.loads(source.read_text())['verified_runs']['matched_attachment01']['literal_stdout']\nfine = next(row for row in map(json.loads, manifest) if row['test']=='preparation' and row['mesh']==48)\nfields={}\nfor filename, expected in fine['field_sha256'].items():\n    path = Path(filename)\n    assert hashlib.sha256(path.read_bytes()).hexdigest()==expected\n    with ZipFile(path) as raw: fields[filename]=raw.namelist()\nemit(verified_native_field_schema=fields)\n"
    },
    "_scratch/s11c/native_order_mixed_ref_source/check.py": {
      "sha256": "af1a92ddc8f5db83142a9081c8fbb0370e185e03ebbd7b29ab139825f2b2b046",
      "source": "\"\"\"Independent rational-energy control using the curl of affine displacement in 4D.\"\"\"\nimport json\nfrom fractions import Fraction as Q\n\n\ndef density(shear_a,shear_b,chi,modulus):\n    # u=(a*w,b*w,0,0), so the curl has only the (1,4) and (2,4) components.\n    gradients=[[Q(0),Q(0),Q(0),shear_a],[Q(0),Q(0),Q(0),shear_b],[Q(0)]*4,[Q(0)]*4]\n    curls=[gradients[i][j]-gradients[j][i] for i in range(4) for j in range(i)]\n    return modulus*chi*sum(f*f for f in curls)/2\n\n\ndef stress(a,b,c,mu):\n    d=Q(1,10000000)\n    return (density(a+d,b,c,mu)-density(a-d,b,c,mu))/(2*d)\n\n\ndef chi_rate(a,b,c,mu,M):\n    d=Q(1,8000000)\n    dfdc=(density(a,b,c+d,mu)-density(a,b,c-d,mu))/(2*d)\n    # A generic nonzero common background represents advection, head and well terms.\n    return Q(23,71)-M*dfdc\n\n\ndef even_odd(vals):\n    minus,zero,plus=vals\n    return (plus+minus)/2-zero,(plus-minus)/2\n\n\ndef run():\n    for g in (Q(1,1000), Q(-1,1000), Q(0)):\n        for h in (Q(1,100000),Q(1,200000)):\n            mu,M,c,dt=map(Q,(1,5,'0.5','0.00001'))\n            initial=[]\n            rates=[]\n            for s in (-h,Q(0),h):\n                tau=stress(g,s,c,mu)\n                taux=stress(g,s,c+dt*chi_rate(g,s,c,mu,M),mu)\n                initial.append(tau)\n                rates.append((taux-tau)/dt)\n            frozen,odd0=even_odd(initial)\n            even,odd=even_odd(rates)\n            print(json.dumps(dict(preload=float(g),transverse_strain=float(h),initial_even=str(frozen),initial_odd=str(odd0),rate_even=str(even),rate_odd=str(odd),rate_even_float=float(even))),flush=True)\n            assert (frozen,odd0,even,odd)==(0,0,-M*mu**2*g*h*h/2,0)\n\n\nif __name__=='__main__':\n    run()\n"
    }
