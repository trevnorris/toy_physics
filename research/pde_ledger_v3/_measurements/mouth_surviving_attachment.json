    "_scratch/s11c/surviving_stiffness_referee_src/check.py": {
      "sha256": "d5f2f3cc641e57ea3ae87d45c5e0a1f1454a2957d7c6124b7cbd4ac3833233be",
      "source": "\"\"\"Infer two affine link slopes from two recorded common-slip reactions without stiffness columns.\"\"\"\nimport hashlib\nimport json\nfrom pathlib import Path\n\nimport numpy as np\n\n\ndef report(**data):\n    print(json.dumps(data,allow_nan=False),flush=True)\n\n\ndef sha(path):\n    return hashlib.sha256(path.read_bytes()).hexdigest()\n\n\ndef demix(positions, slips, forces):\n    # Evaluate the force at the sibling's relaxed position; only the\n    # other spring acts there. Each amplitude is identically zero when dead.\n    s1,s2=slips\n    p1,p2=positions\n    sgrad=(forces[1]-forces[0])/(s2-s1)\n    return np.array([(forces[0]+sgrad*(p2-s1))/(p1-p2),\n                     (forces[0]+sgrad*(p1-s1))/(p2-p1)])\n\n\nmanifest=json.loads(Path('research/pde_ledger_v3/_measurements/mouth_tagged_contact.json').read_text())\nfor blind,run,case in [('A','contact_tagged_work01','n48_line128'),('B','contact_tagged_constant01','selected_tag')]:\n    pin=manifest['verified_runs'][run]\n    f=Path('_scratch/s11c')/run/'stdout'\n    assert sha(f)==pin['stdout_sha256'] and pin['worker_exit']==pin['guarded_exit']==0 and pin['zero_swap']\n    trial=next(r for r in map(json.loads,f.read_text().splitlines()) if r['case']==case)\n    data=Path(trial['raw_path'])\n    assert sha(data)==trial['raw_sha256']\n    slips=trial['probe_slips']; p=trial['offsets']\n    snapshots=[*trial['probes'][:2],*trial['events']]\n    inferred=[]; order=[]\n    for snap in snapshots:\n        g=demix(p, slips, snap['probe_forces'])\n        slope=-(snap['probe_forces'][1]-snap['probe_forces'][0])/(slips[1]-slips[0])\n        np.testing.assert_allclose(sum(g),slope,rtol=1e-12,atol=1e-13)\n        if snap['live_lobes'][0]:\n            inferred.append(g[0]); order.append(snap['lobe_order'][0])\n        report(trial=blind,stage=snap['stage'],t=snap['time'],center=snap['center_order'],\n               upstream_order=snap['lobe_order'][0],intact=snap['live_lobes'],reaction_slopes=g.tolist(),\n               restoring_force_increment_at_1e_minus5=-1e-5*g[0], total=slope)\n    slope,intercept=np.polyfit(order,inferred,1)\n    with np.load(data) as loaded:\n        cols=loaded['columns'].tolist()\n        def read(key):\n            return loaded['samples'][:,cols.index(key)]\n        slopes=demix(p,slips,[read('probe_force_minus'),read('probe_force_plus')])\n        mask=read('live_upstream').astype(bool)\n        # Actual load is a different archive channel from either frozen probe.\n        pred=(slopes*(np.array(p)[:,None]-read('ordered_end_slip'))).sum(axis=0)\n        err=float(max(abs(pred-read('force_on_ordered'))))\n        assert err<3e-15\n        assert max(abs(slopes[0,~mask]))<1e-12\n        report(trial=blind,n=len(mask),slope_vs_order=slope, intercept=intercept,\n               largest_error_predicting_actual_force=err, \n               entry_to_left_break_ratio=float(inferred[-1]/inferred[0]))\n"
    },
    "_scratch/s11c/surviving_well_referee_source/check.py": {
      "sha256": "13ff642e3090d007d09d683829c4167a4e6348db62e50b0472bc6813f4e53184",
      "source": "\"\"\"Independent potential-energy check for one angular registry held fixed.\"\"\"\nfrom decimal import Decimal as D, getcontext\nfrom hashlib import sha256\nfrom pathlib import Path\nimport json\n\ngetcontext().prec = 48\nS, eta = D(\".25\"), D(\".125\")\nprior = json.loads(Path(\"research/pde_ledger_v3/_measurements/mouth_tagged_contact.json\").read_text())\nrun = prior[\"verified_runs\"][\"contact_tagged_work01\"]\nsource = Path(\"_scratch/s11c/contact_tagged_work01/stdout\")\nassert sha256(source.read_bytes()).hexdigest() == run[\"stdout_sha256\"]\nobservations = [json.loads(line) for line in source.read_text().splitlines()]\ncase = next(r for r in observations if r[\"case\"] == \"n48_line128\")\n\n\ndef energy(a, x, y):\n    inside = max(a*a - x*x - y*y, D(0))\n    return -S * inside**2/(4*a*a)\n\n\ndef transverse_force(a,x,y):\n    d = D(\"1e-14\")\n    return -(energy(a,x,y+d)-energy(a,x,y-d))/(2*d)\n\n\ndef slope(a,x,y,h):\n    return -(transverse_force(a,x,y+h)-transverse_force(a,x,y-h))/(2*h)\n\n\ndef rigorous_reading(label, chi, prestrain):\n    a=chi/2\n    fs=[]\n    for h in map(D,[\".00001\",\".000005\"]):\n        fs.append({\"displacement\":float(h), \"force_minus\":float(transverse_force(a,eta,-h)),\n                   \"force_plus\":float(transverse_force(a,eta,h)),\n                   \"slope\":float(slope(a,eta,D(0),h))})\n    extrap=(4*D(str(fs[1][\"slope\"]))-D(str(fs[0][\"slope\"])))/3\n    k=S*max(1-(eta/a)**2,D(0))\n    if a > eta:\n        assert abs(extrap-k) < D(\"1e-14\")\n    print(json.dumps({\"stage\":label,\"chi\":float(chi),\"ratio_k_over_S\":float(k/S),\n                      \"reference_readings\":fs,\"was_intact_at_archived_preload\":bool(eta*eta+prestrain**2<a*a),\n                      \"loaded_tangent\":float(slope(a,eta,prestrain,D(\".000005\")))}))\n\n\nfor label,chi,ext in [(s[\"stage\"],D(str(s[\"lobe_order\"][0])),D(str(s[\"ordered_end_slip\"]))-D(\"-.001\"))\n        for s in [case[\"probes\"][0],case[\"probes\"][1],case[\"events\"][0],case[\"events\"][-2]]]:\n    rigorous_reading(label,chi,ext)\nfor chi in map(D,[\".85\",\".75\",\".50\",\".40\",\".30\",\".251\",\".250001\",\".25\"]):\n    rigorous_reading(\"loaded_zero\",chi,D(0))\nfor chi in map(D,[\".95\",\".50\",\".30\"]):\n    h=D(\"1e-7\")\n    a=chi/2\n    count=256\n    dx=2*a/count\n    live_mid=[-a+(j+D(\".5\"))*dx for j in range(count)]\n    total=dx*sum(slope(a,x,D(0),h) for x in live_mid)\n    # Midpoint error for the quadratic sharing law is O(count^-2).\n    assert abs(total/chi-2*S/3) < D(\"0.000002\")\n    print(json.dumps({\"stage\":\"population\",\"chi\":float(chi),\"mean_live\":float(total/chi),\n                      \"area\":float(total),\"exact_mean_live\":float(2*S/3)}))\n"
    }
