  "local_review": {
    "drain_wave_l0_coercivity_referee01": {
      "verdict": "Scoped clear for the fixed-bath energy-sign argument and absence of a native scalar pump.",
      "source_path": "_scratch/s11c/drain_wave_power_referee.py",
      "sha256": "300db4173930474568af467808f40eaa0bf646a42ca54569c37c3a99f429e95a",
      "script": "\"\"\"Independent energy sign check on the fixed-bath isotropic carrier sector.\"\"\"\nimport json\nimport sys\nfrom pathlib import Path\nfrom types import SimpleNamespace\nimport numpy as np\nsys.path.insert(0, str(Path('software/stage1_solver/tools').resolve()))\nfrom mouth_carrier_lateral_response import prepare\nfrom mouth_curved_phase_stability import lowest_mode, weighted_gram\nfor n in (26, 34, 48):\n    folder=Path(f'_scratch/s11c/mouth_flared_cubic_n{n}')\n    result=json.loads((folder/'outcome.json').read_text())\n    assert result['limitsVerified'] and result['exitCode']==result['childOutcome']['exitCode']==0\n    domain, psi=prepare(SimpleNamespace(source=folder))\n    free=domain.free\n    N=domain.N[:,free]\n    samples=domain.N @ psi\n    density=np.abs(samples)**2\n    potential=(density**4-1)/4\n    mass=weighted_gram(N,domain.weight)\n    kinetic=.5*domain.stiff[free][:,free]\n    scalar=kinetic+weighted_gram(N,domain.weight*potential)\n    lowest=lowest_mode(scalar,mass,potential.min())\n    positive_rank_weight=2*density**3\n    row=dict(mesh=n,axis_free=int(np.count_nonzero(free & (domain.points[:,0]==0))),\n             size=int(free.sum()), minimum_density=float(density.min()),\n             minimum_rank_weight=float(positive_rank_weight.min()),\n             minimum_potential=float(potential.min()), **lowest)\n    print(json.dumps(row), flush=True)\n    assert lowest['eigenvalue']>0 and lowest['relative_residual']<1e-7\n    assert row['axis_free']>0 and row['minimum_rank_weight']>0\n"
    },
    "drain_wave_power_modal_referee_01": {
      "verdict": "Scoped clear for the two-cycle, weak reciprocal density-coupling test on the prescribed finite bath.",
      "source_path": "_scratch/s11c/drain_wave_power_modal_referee.py",
      "sha256": "ba11136e0215a8099205d1f3b17daacf2b73c39802c25307cdfe48a121c2d7c7",
      "script": "\"\"\"Exact-time spectral quadrature of the stationary-carrier work at zero intake.\"\"\"\nfrom pathlib import Path\nfrom types import SimpleNamespace\nimport sys,json\nsys.path.insert(0,str(Path('software/stage1_solver/tools').resolve()))\nimport numpy as np\nfrom scipy.sparse.linalg import splu\nfrom mouth_carrier_lateral_response import prepare\nfrom mouth_curved_phase_stability import weighted_gram\nfrom mouth_wave_drain_power import wave_shape\n\ndom,_=prepare(SimpleNamespace(source=Path('_scratch/s11c/mouth_flared_cubic_n26')))\nshape,omega=wave_shape(dom,.04,4.5)\nbasis=dom.N[:,dom.free]\nA=0.5*dom.stiff[dom.free][:,dom.free]\nM=weighted_gram(basis,dom.weight).tocsc()\nb=basis.T@(dom.weight*shape)\nv0=splu(M).solve(b)\nstrength=b@v0\nshift=3.\ninv=splu((A+shift*M).tocsc()).solve\nlength=140\nV=np.zeros((len(b),length),order='F'); MV=np.zeros_like(V,order='F')\nT=np.zeros((length,length))\nv=v0/np.sqrt(strength)\nfor i in range(length):\n    V[:,i]=v; MV[:,i]=M@v\n    trial=inv(MV[:,i])\n    B=V[:,:i+1]; MB=MV[:,:i+1]\n    proj=MB.T@trial\n    T[:i+1,i]=proj; T[i,:i+1]=proj\n    trial-=B@proj\n    trial-=B@(MB.T@trial)\n    v=trial/np.sqrt(trial@(M@trial))\n    if i+1 in (64,96,140):\n        size=i+1\n        alpha,directions=np.linalg.eigh(T[:size,:size])\n        a=1/alpha-shift\n        assert min(a)>0\n        freq=np.sqrt(a*(a+2))\n        weights=directions[0,:]**2*strength\n        # For each M-normalized eigenmode of K/2, energy left in the bath\n        # is a*|b_i integral e^(i nu t) v(t) dt|^2 from its canonical pair.\n        for cycle in (1,2):\n            duration=cycle*2*np.pi/omega\n            def window(nu):\n                return duration*np.exp(1j*nu*duration/2)*np.sinc(nu*duration/(2*np.pi))\n            integral=.5*window(freq)-.25*(window(freq-2*omega)+window(freq+2*omega))\n            energies=np.sum(a*weights*abs(integral)**2)*np.array([.0025,.01])**2/omega**4\n            print(json.dumps(dict(mesh=26,method='rest_modal_exact_time',krylov_size=size,cycle=cycle,energies=energies.tolist(),orthogonality=float(np.max(abs(B.T@MB-np.eye(size)))))))\n"
    },
    "drain_wave_cut_flux_referee_01": {
      "verdict": "Scoped clear for net carrier perturbation energy crossing the two internal cuts during the two prescribed wave cycles in the finite, fixed-bath mouth.",
      "source_path": "_scratch/s11c/drain_wave_cut_flux_referee.py",
      "sha256": "8703a7b36d36b637f452e48c861ef735d81d3a1df63bf25cd755d3dcf0c57022",
      "script": "\"\"\"Independent endpoint comparison of the signed local and two-section carrier ledgers.\"\"\"\nimport json\nfrom pathlib import Path\nfrom math import fsum\n\ndef rows(dir_, tag):\n    base = Path('_scratch/s11c') / dir_\n    result = json.loads((base / 'outcome.json').read_text())\n    child = json.loads((base / 'child-outcome.json').read_text())\n    assert result['exitCode'] == child['exitCode'] == 0 and result['limitsVerified']\n    return [x for x in map(json.loads, (base/'stdout').read_text().splitlines()) if x['test']==tag]\n\nfor n in (26,34):\n    cuts = rows(f'drain_wave_cuts_n{n}_01','carrier_cuts')\n    total = [r for r in rows(f'drain_wave_power_n{n}_t192_01','cycle') if r['preparation']=='intake_0.25']\n    assert len(cuts)==len(total)==2\n    for r,s in zip(cuts,total):\n        work,stored,direct=r['applied_work'],r['stored'],r['outward_cumulative_from_flux']\n        local = [stored[j]-work[j] for j in (0,2)]\n        error = [(d-b)/b for d,b in zip(direct,local)]\n        residual=fsum([*stored,*(-v for v in work)])\n        flare_balance=fsum([work[1],-stored[1], *(-v for v in local)])\n        whole_comparison=fsum(stored)-s['final_carrier_perturbation_energy'][1]\n        print(json.dumps(dict(mesh=n,cycle=r['cycle'],feed_and_receiver_work=local,relative_discrepancies=error,global_residual=residual,flare_residual=flare_balance,independent_total_difference=whole_comparison)))\n        assert all(d>0 for d in direct) and max(map(abs,error))<.002\n        assert max(map(abs,[residual,flare_balance,whole_comparison]))<1e-18\n"
    }
  },
