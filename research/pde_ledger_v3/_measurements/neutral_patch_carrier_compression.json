    "independent_script": "import json\nfrom pathlib import Path\n\nimport numpy as np\nfrom scipy.optimize import least_squares\nfrom scipy.spatial import ConvexHull\n\nevidence = Path('research/pde_ledger_v3/_measurements/neutral_patch_sites.json')\nq0 = np.asarray(json.loads(evidence.read_text())['saved_measurements']['frames1321.json']['contents']['central']['rested_xy'])\ni, j = np.triu_indices(24, 1)\nbetween = (i < 12) & (j >= 12)\na = np.where(between, 10., 7.)\nl0 = np.where(between, .94, 1.)\nD = np.where(between, .6, 1.)\nfree = sorted(set(range(24)) - {base+k for base in [0,12] for k in ConvexHull(q0[base:base+12]).vertices})\n\n\ndef energy(s, gap_moves, relaxed):\n    stretch = np.exp(-s / 3)\n    q = q0 * stretch\n    def pair(x):\n        q[free] = x.reshape(-1,2)\n        delta = q[j]-q[i]\n        radius = np.sqrt(np.sum(delta*delta, axis=1)+between*(stretch**2 if gap_moves else 1.))\n        em = np.expm1(-a*(radius-l0))\n        en = np.sum(D*(em**2-1))\n        nodal = np.zeros_like(q)\n        radial = -2*D*em*a*(1+em)\n        dxy = (radial/radius)[:,None]*delta\n        np.add.at(nodal, j, dxy)\n        np.add.at(nodal, i, -dxy)\n        return en, nodal[free].ravel()\n    x = q[free].ravel()\n    if relaxed:\n        x = least_squares(lambda v: pair(v)[1], x, gtol=1e-12, ftol=1e-13, xtol=1e-13).x\n        assert np.max(np.abs(pair(x)[1])) < 2e-9\n    return pair(x)[0]\n\n\ndef pressure(s, stack, relaxed):\n    h = 1e-4\n    ens = [energy(s+k*h,stack,relaxed) for k in (-2,-1,1,2)]\n    return np.exp(s)*np.dot([1,-8,8,-1],ens)/(12*h)\n\n\nfor stack in [False,True]:\n    for relaxed in [False,True]:\n        raw = {n:pressure(np.log(n),stack,relaxed) for n in (.98,1.,1.01,1.02,1.05)}\n        scale = ((1.01**5-1)/5)/(raw[1.01]-raw[1.])\n        e = .0005\n        p_plus,p_minus = [pressure(u,stack,relaxed) for u in (e,-e)]\n        curvature = (p_plus+p_minus-2*raw[1.])/((p_plus-p_minus)*e/2)\n        print(json.dumps(dict(stack='brane' if stack else 'w', relaxed=relaxed, calibration=scale, curvature=curvature, rest_pressure=raw[1.], errors={n:scale*(v-raw[1.])/((n**5-1)/5)-1 for n,v in raw.items() if n in (.98,1.02,1.05)})))\n"
