    "verdict": "Scoped clear for the cold registered, fixed-gap, equitriaxial pressure-change test and its sampled in-plane stability.",
    "scope": "Independent shell energies and derivatives, sampled planar stability, candidate code and held-out pressure. Ambient brane stress, unrestricted phases, total mouth force and acceleration remain open.",
    "source_sha256": "76065e445f860648bad4895d8c2ac2e4d7b9fcf35a27b9fe25000fc0a9251021",
    "source": "\"\"\"Independent shell energy, volume differentiation and bilayer Fourier Hessian.\"\"\"\nfrom collections import Counter\nfrom math import sqrt\nimport mpmath as mp\nimport numpy as np\n\nmp.mp.dps = 36\nmpf = mp.mpf\nsame = (mpf(1), mpf(7), mpf(1))\ncross = (mpf('.6'), mpf(10), mpf('.94'))\n\n\ndef vectors(cut):\n    return [(i, j, i*i+i*j+j*j)\n            for i in range(-2*cut, 2*cut+1) for j in range(-2*cut, 2*cut+1)\n            if i*i+i*j+j*j <= cut*cut]\n\n\ndef energy(cut):\n    shells = Counter(q for i,j,q in vectors(cut))\n\n    def total(pitch, sector='all'):\n        ans = mpf(0)\n        for sq, count in shells.items():\n            for family, gap, (depth, inv, length) in [('within', 0, same), ('between', 1, cross)]:\n                if (sq == 0 and gap == 0) or (sector != 'all' and sector != family):\n                    continue\n                z = mp.exp(inv*(length - mp.sqrt(pitch**2*sq+gap**2)))\n                ans += count*depth*z*(z-2)\n        return ans\n    return total\n\n\ndef print_row(name, *items):\n    print(name, *(mp.nstr(a,17) for a in items), flush=True)\n\n\ndef check_phonon(pitch, cut=10, size=36):\n    # The even and odd layer parities are independent two-component sectors.\n    ijq = np.array(vectors(cut))\n    i,j,q = ijq.T\n    xy = pitch*np.stack((i+.5*j,sqrt(3)/2*j),axis=1)\n    allk = []\n    shear = 0.\n    for gap, pars in ((0,same),(1,cross)):\n        active = (q != 0) if gap == 0 else np.full(len(i),True)\n        r = np.sqrt(q[active]*pitch**2 + gap**2)\n        depth, inv, length = map(float,pars)\n        z = np.exp(inv*(length-r))\n        radial = 2*depth*inv*(1-z)*z/r\n        stiff = 2*depth*inv**2*z*(2*z-1)\n        u = xy[active]/r[:,None]\n        hh = np.zeros((len(i),2,2))\n        hh[active] = radial[:,None,None]*np.eye(2) + (stiff-radial)[:,None,None]*u[:,:,None]*u[:,None,:]\n        allk.append(hh)\n        # A unimodular common shear x -> x + eps*y counts complete stars\n        # once in each of (two planes / two per unordered pair) and cross-plane.\n        shear += np.sum(hh[:,0,0]*xy[:,1]**2)\n    least = float('inf')\n    leastopt = float('inf')\n    for h in range(size):\n        for k in range(size):\n            cs = np.cos(2*np.pi*(h*i+k*j)/size)\n            for sign in (1,-1):\n                hess = ((1-cs)[:,None,None]*allk[0]+(1-sign*cs)[:,None,None]*allk[1]).sum(axis=0)\n                eig = np.linalg.eigvalsh(hess)\n                if h == 0 and k == 0 and sign == 1:\n                    assert np.max(abs(eig)) < 1e-10\n                    continue\n                least = min(least,eig[0])\n                if sign == -1:\n                    leastopt = min(leastopt,eig[0])\n    print('phonon_grid pitch,size,least_after_translations,least_optical,affine_shear_energy_second',\n          f'{pitch:.15g}',size,f'{least:.14g}',f'{leastopt:.14g}',f'{shear:.14g}',flush=True)\n    assert least>0 and shear>0\n\n\nfor cut in (6, 10):\n    E = energy(cut)\n    root = mp.findroot(lambda pitch: mp.diff(E,pitch), (mpf('.98'),mpf('1.00')))\n    # One actual repeat area contains two sites. The remaining brane length\n    # dilates as pitch, while the fourth length and particle number stay fixed.\n    def pressure(eta, sector='all'):\n        v = mp.exp(-eta)\n        return -mp.diff(lambda w: E(root*w**(mpf(1)/3),sector),v)\n\n    def delta(n):\n        return pressure(mp.log(n))-pressure(0)\n\n    print('reference_shells',cut,flush=True)\n    print_row('pitch,old_reference_density,energy,rest_pressure,E_aa',\n              root,root**-3,E(root),pressure(0),mp.diff(E,root,2))\n    for sector in ('all','within','between'):\n        p1,p2 = (mp.diff(lambda x:pressure(x,sector),0,order) for order in (1,2))\n        print_row(sector+' p_eta,p_etaeta,ratio,p_etaeta-5p_eta',p1,p2,p2/p1,p2-5*p1)\n    c = mpf('1.01')\n    carrier = lambda n: (n**5-1)/5\n    scale = carrier(c)/delta(c)\n    print_row('force_scale',scale)\n    for n in map(mpf,('.98','.99','1.005','1.01','1.02','1.05')):\n        raw = delta(n)\n        pred = raw*scale\n        target = carrier(n)\n        print_row('n,raw,predicted,target,relerr',n,raw,pred,target,pred/target-1)\n    if cut == 10:\n        for n in (1.,1.05,.98):\n            check_phonon(float(root)*n**(-1/3))\n",
