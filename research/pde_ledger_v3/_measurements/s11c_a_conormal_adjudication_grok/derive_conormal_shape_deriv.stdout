--- flat-background term census (natural variables) ---
  W_0*e_W*trace_grad_f_4_dw/2
  -W_0*e_W_d1*trace_grad_f_1/2
  -W_0*e_W_d2*trace_grad_f_2/2
  -W_0*e_W_d3*trace_grad_f_3/2

--- flat-background closed form ---
At η=σ_W=0: a⁰=1, n̂⁰ = (0,0,0,s) = (0,0,0,-1) for FACE_MINUS
δh = s W_0 e_W / 2 = -W_0 e_W / 2
δ(∇h) = s W_0 ∇e_W / 2
δa = 0 at flat (∇h⁰=0)
δn̂_i (i=1,2,3) = −s δ(∂_i h) = −s*(s W_0 e_W_di/2) = −W_0 e_W_di/2
δn̂_w = 0 at flat
δC_flat = Σ_{i=1..3} δn̂_i g_i + δh n̂⁰_w ∂_w g_w
         = Σ_{i=1..3} (−W_0 e_W_di/2) g_i + (−W_0 e_W/2)*(−1)*∂_w g_4
         = −(W_0/2) Σ_i e_W_di g_i + (W_0/2) e_W ∂_w g_4
predicted flat = W_0*e_W*trace_grad_f_4_dw/2 - W_0*(e_W_d1*trace_grad_f_1 + e_W_d2*trace_grad_f_2 + e_W_d3*trace_grad_f_3)/2
RESIDUAL (δC_flat − predicted) = 0

--- O(σ_W^1) slice at η=0 (exact − flat) ---
δC |_{η=0} to O(σ_W^1) minus flat piece =
  W_0*sigma_W*(e_W*trace_grad_f_1_dw*w1_profile_d1 + e_W*trace_grad_f_2_dw*w1_profile_d2 + e_W*trace_grad_f_3_dw*w1_profile_d3 + e_W_d1*trace_grad_f_4*w1_profile_d1 + e_W_d2*trace_grad_f_4*w1_profile_d2 + e_W_d3*trace_grad_f_4*w1_profile_d3)/4
  expanded: W_0*e_W*sigma_W*trace_grad_f_1_dw*w1_profile_d1/4 + W_0*e_W*sigma_W*trace_grad_f_2_dw*w1_profile_d2/4 + W_0*e_W*sigma_W*trace_grad_f_3_dw*w1_profile_d3/4 + W_0*e_W_d1*sigma_W*trace_grad_f_4*w1_profile_d1/4 + W_0*e_W_d2*sigma_W*trace_grad_f_4*w1_profile_d2/4 + W_0*e_W_d3*sigma_W*trace_grad_f_4*w1_profile_d3/4

--- σ_W=0 slice (η retained): expect identical to flat ---
δC|_{σ_W=0} =
  W_0*(e_W*trace_grad_f_4_dw - e_W_d1*trace_grad_f_1 - e_W_d2*trace_grad_f_2 - e_W_d3*trace_grad_f_3)/2
  expanded: W_0*e_W*trace_grad_f_4_dw/2 - W_0*e_W_d1*trace_grad_f_1/2 - W_0*e_W_d2*trace_grad_f_2/2 - W_0*e_W_d3*trace_grad_f_3/2

RESIDUAL (δC|σ_W=0 − flat) = 0

