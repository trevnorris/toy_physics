========================================================================
S11c-a T-a′ CONORMAL_DERIV — independent FROM-SPEC derivation
CASE: LAB_HELD | FACE_MINUS (s=-1) | DOF δW
========================================================================

--- supplied inputs (§2a, §3a) ---
s            = -1
W_bg         = W_0*(eta_bg*w1_profile + 1)
dW_bg        = (sigma_W*w1_profile_d1, sigma_W*w1_profile_d2, sigma_W*w1_profile_d3)
h            = -W_0*e_W*epsilon/2 - W_0*(eta_bg*w1_profile + 1)/2
grad_h       = (-W_0*e_W_d1*epsilon/2 - sigma_W*w1_profile_d1/2, -W_0*e_W_d2*epsilon/2 - sigma_W*w1_profile_d2/2, -W_0*e_W_d3*epsilon/2 - sigma_W*w1_profile_d3/2)
dh_DOF (δh)  = -W_0*e_W/2
d_grad_h_DOF = (-W_0*e_W_d1/2, -W_0*e_W_d2/2, -W_0*e_W_d3/2)

--- outward unit normal n̂ = s ∇₄F / |∇₄F| ---
a            = sqrt((-W_0*e_W_d1*epsilon/2 - sigma_W*w1_profile_d1/2)**2 + (-W_0*e_W_d2*epsilon/2 - sigma_W*w1_profile_d2/2)**2 + (-W_0*e_W_d3*epsilon/2 - sigma_W*w1_profile_d3/2)**2 + 1)
n̂_1         = (-W_0*e_W_d1*epsilon - sigma_W*w1_profile_d1)/sqrt((W_0*e_W_d1*epsilon + sigma_W*w1_profile_d1)**2 + (W_0*e_W_d2*epsilon + sigma_W*w1_profile_d2)**2 + (W_0*e_W_d3*epsilon + sigma_W*w1_profile_d3)**2 + 4)
n̂_2         = (-W_0*e_W_d2*epsilon - sigma_W*w1_profile_d2)/sqrt((W_0*e_W_d1*epsilon + sigma_W*w1_profile_d1)**2 + (W_0*e_W_d2*epsilon + sigma_W*w1_profile_d2)**2 + (W_0*e_W_d3*epsilon + sigma_W*w1_profile_d3)**2 + 4)
n̂_3         = (-W_0*e_W_d3*epsilon - sigma_W*w1_profile_d3)/sqrt((W_0*e_W_d1*epsilon + sigma_W*w1_profile_d1)**2 + (W_0*e_W_d2*epsilon + sigma_W*w1_profile_d2)**2 + (W_0*e_W_d3*epsilon + sigma_W*w1_profile_d3)**2 + 4)
n̂_4         = -2/sqrt((W_0*e_W_d1*epsilon + sigma_W*w1_profile_d1)**2 + (W_0*e_W_d2*epsilon + sigma_W*w1_profile_d2)**2 + (W_0*e_W_d3*epsilon + sigma_W*w1_profile_d3)**2 + 4)
n̂·ŵ check    = -2/sqrt((W_0*e_W_d1*epsilon + sigma_W*w1_profile_d1)**2 + (W_0*e_W_d2*epsilon + sigma_W*w1_profile_d2)**2 + (W_0*e_W_d3*epsilon + sigma_W*w1_profile_d3)**2 + 4) ;  s(n̂·ŵ) = 2/sqrt((W_0*e_W_d1*epsilon + sigma_W*w1_profile_d1)**2 + (W_0*e_W_d2*epsilon + sigma_W*w1_profile_d2)**2 + (W_0*e_W_d3*epsilon + sigma_W*w1_profile_d3)**2 + 4)

--- background face values (eps→0) ---
h⁰           = -W_0*(eta_bg*w1_profile + 1)/2
a⁰           = sqrt(sigma_W**2*w1_profile_d1**2 + sigma_W**2*w1_profile_d2**2 + sigma_W**2*w1_profile_d3**2 + 4)/2
n̂⁰_1        = -sigma_W*w1_profile_d1/sqrt(sigma_W**2*w1_profile_d1**2 + sigma_W**2*w1_profile_d2**2 + sigma_W**2*w1_profile_d3**2 + 4)
n̂⁰_2        = -sigma_W*w1_profile_d2/sqrt(sigma_W**2*w1_profile_d1**2 + sigma_W**2*w1_profile_d2**2 + sigma_W**2*w1_profile_d3**2 + 4)
n̂⁰_3        = -sigma_W*w1_profile_d3/sqrt(sigma_W**2*w1_profile_d1**2 + sigma_W**2*w1_profile_d2**2 + sigma_W**2*w1_profile_d3**2 + 4)
n̂⁰_4        = -2/sqrt(sigma_W**2*w1_profile_d1**2 + sigma_W**2*w1_profile_d2**2 + sigma_W**2*w1_profile_d3**2 + 4)
C⁰ = n̂⁰·g    = (-sigma_W*trace_grad_f_1*w1_profile_d1 - sigma_W*trace_grad_f_2*w1_profile_d2 - sigma_W*trace_grad_f_3*w1_profile_d3 - 2*trace_grad_f_4)/sqrt(sigma_W**2*w1_profile_d1**2 + sigma_W**2*w1_profile_d2**2 + sigma_W**2*w1_profile_d3**2 + 4)

--- first ε-order δn̂ components ---
δn̂_1        = W_0*(-e_W_d1*sigma_W**2*w1_profile_d2**2 - e_W_d1*sigma_W**2*w1_profile_d3**2 - 4*e_W_d1 + e_W_d2*sigma_W**2*w1_profile_d1*w1_profile_d2 + e_W_d3*sigma_W**2*w1_profile_d1*w1_profile_d3)/(sigma_W**2*w1_profile_d1**2 + sigma_W**2*w1_profile_d2**2 + sigma_W**2*w1_profile_d3**2 + 4)**(3/2)
δn̂_2        = W_0*(e_W_d1*sigma_W**2*w1_profile_d1*w1_profile_d2 - e_W_d2*sigma_W**2*w1_profile_d1**2 - e_W_d2*sigma_W**2*w1_profile_d3**2 - 4*e_W_d2 + e_W_d3*sigma_W**2*w1_profile_d2*w1_profile_d3)/(sigma_W**2*w1_profile_d1**2 + sigma_W**2*w1_profile_d2**2 + sigma_W**2*w1_profile_d3**2 + 4)**(3/2)
δn̂_3        = W_0*(e_W_d1*sigma_W**2*w1_profile_d1*w1_profile_d3 + e_W_d2*sigma_W**2*w1_profile_d2*w1_profile_d3 - e_W_d3*sigma_W**2*w1_profile_d1**2 - e_W_d3*sigma_W**2*w1_profile_d2**2 - 4*e_W_d3)/(sigma_W**2*w1_profile_d1**2 + sigma_W**2*w1_profile_d2**2 + sigma_W**2*w1_profile_d3**2 + 4)**(3/2)
δn̂_4        = 2*W_0*sigma_W*(e_W_d1*w1_profile_d1 + e_W_d2*w1_profile_d2 + e_W_d3*w1_profile_d3)/(sigma_W**2*w1_profile_d1**2 + sigma_W**2*w1_profile_d2**2 + sigma_W**2*w1_profile_d3**2 + 4)**(3/2)

--- OBJECT: δ(n̂·∇₄ f)|_graph  to first ε ---
δC exact-in-background (full η,σ_W in n̂⁰) =
  W_0*(e_W*sigma_W**3*trace_grad_f_1_dw*w1_profile_d1**3 + e_W*sigma_W**3*trace_grad_f_1_dw*w1_profile_d1*w1_profile_d2**2 + e_W*sigma_W**3*trace_grad_f_1_dw*w1_profile_d1*w1_profile_d3**2 + e_W*sigma_W**3*trace_grad_f_2_dw*w1_profile_d1**2*w1_profile_d2 + e_W*sigma_W**3*trace_grad_f_2_dw*w1_profile_d2**3 + e_W*sigma_W**3*trace_grad_f_2_dw*w1_profile_d2*w1_profile_d3**2 + e_W*sigma_W**3*trace_grad_f_3_dw*w1_profile_d1**2*w1_profile_d3 + e_W*sigma_W**3*trace_grad_f_3_dw*w1_profile_d2**2*w1_profile_d3 + e_W*sigma_W**3*trace_grad_f_3_dw*w1_profile_d3**3 + 2*e_W*sigma_W**2*trace_grad_f_4_dw*w1_profile_d1**2 + 2*e_W*sigma_W**2*trace_grad_f_4_dw*w1_profile_d2**2 + 2*e_W*sigma_W**2*trace_grad_f_4_dw*w1_profile_d3**2 + 4*e_W*sigma_W*trace_grad_f_1_dw*w1_profile_d1 + 4*e_W*sigma_W*trace_grad_f_2_dw*w1_profile_d2 + 4*e_W*sigma_W*trace_grad_f_3_dw*w1_profile_d3 + 8*e_W*trace_grad_f_4_dw - 2*e_W_d1*sigma_W**2*trace_grad_f_1*w1_profile_d2**2 - 2*e_W_d1*sigma_W**2*trace_grad_f_1*w1_profile_d3**2 + 2*e_W_d1*sigma_W**2*trace_grad_f_2*w1_profile_d1*w1_profile_d2 + 2*e_W_d1*sigma_W**2*trace_grad_f_3*w1_profile_d1*w1_profile_d3 + 4*e_W_d1*sigma_W*trace_grad_f_4*w1_profile_d1 - 8*e_W_d1*trace_grad_f_1 + 2*e_W_d2*sigma_W**2*trace_grad_f_1*w1_profile_d1*w1_profile_d2 - 2*e_W_d2*sigma_W**2*trace_grad_f_2*w1_profile_d1**2 - 2*e_W_d2*sigma_W**2*trace_grad_f_2*w1_profile_d3**2 + 2*e_W_d2*sigma_W**2*trace_grad_f_3*w1_profile_d2*w1_profile_d3 + 4*e_W_d2*sigma_W*trace_grad_f_4*w1_profile_d2 - 8*e_W_d2*trace_grad_f_2 + 2*e_W_d3*sigma_W**2*trace_grad_f_1*w1_profile_d1*w1_profile_d3 + 2*e_W_d3*sigma_W**2*trace_grad_f_2*w1_profile_d2*w1_profile_d3 - 2*e_W_d3*sigma_W**2*trace_grad_f_3*w1_profile_d1**2 - 2*e_W_d3*sigma_W**2*trace_grad_f_3*w1_profile_d2**2 + 4*e_W_d3*sigma_W*trace_grad_f_4*w1_profile_d3 - 8*e_W_d3*trace_grad_f_3)/(2*(sigma_W**2*w1_profile_d1**2 + sigma_W**2*w1_profile_d2**2 + sigma_W**2*w1_profile_d3**2 + 4)**(3/2))
  expanded: W_0*e_W*sigma_W**3*trace_grad_f_1_dw*w1_profile_d1**3/(2*sigma_W**2*w1_profile_d1**2*sqrt(sigma_W**2*w1_profile_d1**2 + sigma_W**2*w1_profile_d2**2 + sigma_W**2*w1_profile_d3**2 + 4) + 2*sigma_W**2*w1_profile_d2**2*sqrt(sigma_W**2*w1_profile_d1**2 + sigma_W**2*w1_profile_d2**2 + sigma_W**2*w1_profile_d3**2 + 4) + 2*sigma_W**2*w1_profile_d3**2*sqrt(sigma_W**2*w1_profile_d1**2 + sigma_W**2*w1_profile_d2**2 + sigma_W**2*w1_profile_d3**2 + 4) + 8*sqrt(sigma_W**2*w1_profile_d1**2 + sigma_W**2*w1_profile_d2**2 + sigma_W**2*w1_profile_d3**2 + 4)) + W_0*e_W*sigma_W**3*trace_grad_f_1_dw*w1_profile_d1*w1_profile_d2**2/(2*sigma_W**2*w1_profile_d1**2*sqrt(sigma_W**2*w1_profile_d1**2 + sigma_W**2*w1_profile_d2**2 + sigma_W**2*w1_profile_d3**2 + 4) + 2*sigma_W**2*w1_profile_d2**2*sqrt(sigma_W**2*w1_profile_d1**2 + sigma_W**2*w1_profile_d2**2 + sigma_W**2*w1_profile_d3**2 + 4) + 2*sigma_W**2*w1_profile_d3**2*sqrt(sigma_W**2*w1_profile_d1**2 + sigma_W**2*w1_profile_d2**2 + sigma_W**2*w1_profile_d3**2 + 4) + 8*sqrt(sigma_W**2*w1_profile_d1**2 + sigma_W**2*w1_profile_d2**2 + sigma_W**2*w1_profile_d3**2 + 4)) + W_0*e_W*sigma_W**3*trace_grad_f_1_dw*w1_profile_d1*w1_profile_d3**2/(2*sigma_W**2*w1_profile_d1**2*sqrt(sigma_W**2*w1_profile_d1**2 + sigma_W**2*w1_profile_d2**2 + sigma_W**2*w1_profile_d3**2 + 4) + 2*sigma_W**2*w1_profile_d2**2*sqrt(sigma_W**2*w1_profile_d1**2 + sigma_W**2*w1_profile_d2**2 + sigma_W**2*w1_profile_d3**2 + 4) + 2*sigma_W**2*w1_profile_d3**2*sqrt(sigma_W**2*w1_profile_d1**2 + sigma_W**2*w1_profile_d2**2 + sigma_W**2*w1_profile_d3**2 + 4) + 8*sqrt(sigma_W**2*w1_profile_d1**2 + sigma_W**2*w1_profile_d2**2 + sigma_W**2*w1_profile_d3**2 + 4)) + W_0*e_W*sigma_W**3*trace_grad_f_2_dw*w1_profile_d1**2*w1_profile_d2/(2*sigma_W**2*w1_profile_d1**2*sqrt(sigma_W**2*w1_profile_d1**2 + sigma_W**2*w1_profile_d2**2 + sigma_W**2*w1_profile_d3**2 + 4) + 2*sigma_W**2*w1_profile_d2**2*sqrt(sigma_W**2*w1_profile_d1**2 + sigma_W**2*w1_profile_d2**2 + sigma_W**2*w1_profile_d3**2 + 4) + 2*sigma_W**2*w1_profile_d3**2*sqrt(sigma_W**2*w1_profile_d1**2 + sigma_W**2*w1_profile_d2**2 + sigma_W**2*w1_profile_d3**2 + 4) + 8*sqrt(sigma_W**2*w1_profile_d1**2 + sigma_W**2*w1_profile_d2**2 + sigma_W**2*w1_profile_d3**2 + 4)) + W_0*e_W*sigma_W**3*trace_grad_f_2_dw*w1_profile_d2**3/(2*sigma_W**2*w1_profile_d1**2*sqrt(sigma_W**2*w1_profile_d1**2 + sigma_W**2*w1_profile_d2**2 + sigma_W**2*w1_profile_d3**2 + 4) + 2*sigma_W**2*w1_profile_d2**2*sqrt(sigma_W**2*w1_profile_d1**2 + sigma_W**2*w1_profile_d2**2 + sigma_W**2*w1_profile_d3**2 + 4) + 2*sigma_W**2*w1_profile_d3**2*sqrt(sigma_W**2*w1_profile_d1**2 + sigma_W**2*w1_profile_d2**2 + sigma_W**2*w1_profile_d3**2 + 4) + 8*sqrt(sigma_W**2*w1_profile_d1**2 + sigma_W**2*w1_profile_d2**2 + sigma_W**2*w1_profile_d3**2 + 4)) + W_0*e_W*sigma_W**3*trace_grad_f_2_dw*w1_profile_d2*w1_profile_d3**2/(2*sigma_W**2*w1_profile_d1**2*sqrt(sigma_W**2*w1_profile_d1**2 + sigma_W**2*w1_profile_d2**2 + sigma_W**2*w1_profile_d3**2 + 4) + 2*sigma_W**2*w1_profile_d2**2*sqrt(sigma_W**2*w1_profile_d1**2 + sigma_W**2*w1_profile_d2**2 + sigma_W**2*w1_profile_d3**2 + 4) + 2*sigma_W**2*w1_profile_d3**2*sqrt(sigma_W**2*w1_profile_d1**2 + sigma_W**2*w1_profile_d2**2 + sigma_W**2*w1_profile_d3**2 + 4) + 8*sqrt(sigma_W**2*w1_profile_d1**2 + sigma_W**2*w1_profile_d2**2 + sigma_W**2*w1_profile_d3**2 + 4)) + W_0*e_W*sigma_W**3*trace_grad_f_3_dw*w1_profile_d1**2*w1_profile_d3/(2*sigma_W**2*w1_profile_d1**2*sqrt(sigma_W**2*w1_profile_d1**2 + sigma_W**2*w1_profile_d2**2 + sigma_W**2*w1_profile_d3**2 + 4) + 2*sigma_W**2*w1_profile_d2**2*sqrt(sigma_W**2*w1_profile_d1**2 + sigma_W**2*w1_profile_d2**2 + sigma_W**2*w1_profile_d3**2 + 4) + 2*sigma_W**2*w1_profile_d3**2*sqrt(sigma_W**2*w1_profile_d1**2 + sigma_W**2*w1_profile_d2**2 + sigma_W**2*w1_profile_d3**2 + 4) + 8*sqrt(sigma_W**2*w1_profile_d1**2 + sigma_W**2*w1_profile_d2**2 + sigma_W**2*w1_profile_d3**2 + 4)) + W_0*e_W*sigma_W**3*trace_grad_f_3_dw*w1_profile_d2**2*w1_profile_d3/(2*sigma_W**2*