  FACE pressure finalized = epsilon_shape*(W_0*d_w_delta_p_plus*eta_bg*w1_profile/2 + delta_p_plus)
  FACE velocity finalized = Matrix([[epsilon_shape*(W_0*d_w_delta_v_bulk_plus_1*eta_bg*w1_profile/2 + delta_v_bulk_plus_1)], [epsilon_shape*(W_0*d_w_delta_v_bulk_plus_2*eta_bg*w1_profile/2 + delta_v_bulk_plus_2)], [epsilon_shape*(W_0*d_w_delta_v_bulk_plus_3*eta_bg*w1_profile/2 + delta_v_bulk_plus_3)], [epsilon_shape*(W_0*d_w_delta_v_bulk_plus_4*eta_bg*w1_profile/2 + delta_v_bulk_plus_4)]])
  FACE density finalized  = epsilon_shape*(W_0*d_w_delta_rho_4D_face_plus*eta_bg*w1_profile/2 + delta_rho_4D_face_plus)
