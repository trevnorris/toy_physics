rhs = -Lambda_A*V*Z/rho_m + Lambda_A*mu_s + Lambda_V*V
lhs_coeff * J_solved - rhs = 0
delta_p solved = Z*rho_m*(Lambda_A*mu_s + Lambda_V*V + V*rho_m)/(Lambda_A*Z + rho_m**2)
t / n  (i.e. -(dp + Lambda_X A)) = (Lambda_X*(Lambda_V*V*Z + V*Z*rho_m - mu_s*rho_m**2) - Z*rho_m*(Lambda_A*mu_s + Lambda_V*V + V*rho_m))/(Lambda_A*Z + rho_m**2)
