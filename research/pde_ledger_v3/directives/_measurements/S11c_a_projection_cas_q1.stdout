dh_minus(x1, x2, x3, t)*Subs(Derivative(O(g1, g2), g2), (g1, g2), (w - h_plus0(x1, x2, x3, t), -w + h_minus0(x1, x2, x3, t))) - dh_plus(x1, x2, x3, t)*Subs(Derivative(O(g1, g2), g1), (g1, g2), (w - h_plus0(x1, x2, x3, t), -w + h_minus0(x1, x2, x3, t)))

