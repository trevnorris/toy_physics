dh_minus(x1, x2, x3, t)*Derivative(delta_j_1(x1, x2, x3, w, t), x1)*Subs(Derivative(O(g1, g2), g2), (g1, g2), (w - h_plus0(x1, x2, x3, t), -w + h_minus0(x1, x2, x3, t))) - dh_minus(x1, x2, x3, t)*Derivative(delta_j_1_face(x1, x2, x3, t), x1)*Subs(Derivative(O(g1, g2), g2), (g1, g2), (w - h_plus0(x1, x2, x3, t), -w + h_minus0(x1, x2, x3, t))) + dh_minus(x1, x2, x3, t)*Derivative(delta_j_2(x1, x2, x3, w, t), x2)*Subs(Derivative(O(g1, g2), g2), (g1, g2), (w - h_plus0(x1, x2, x3, t), -w + h_minus0(x1, x2, x3, t))) - dh_minus(x1, x2, x3, t)*Derivative(delta_j_2_face(x1, x2, x3, t), x2)*Subs(Derivative(O(g1, g2), g2), (g1, g2), (w - h_plus0(x1, x2, x3, t), -w + h_minus0(x1, x2, x3, t))) + dh_minus(x1, x2, x3, t)*Derivative(delta_j_3(x1, x2, x3, w, t), x3)*Subs(Derivative(O(g1, g2), g2), (g1, g2), (w - h_plus0(x1, x2, x3, t), -w + h_minus0(x1, x2, x3, t))) - dh_minus(x1, x2, x3, t)*Derivative(delta_j_3_face(x1, x2, x3, t), x3)*Subs(Derivative(O(g1, g2), g2), (g1, g2), (w - h_plus0(x1, x2, x3, t), -w + h_minus0(x1, x2, x3, t))) + dh_minus(x1, x2, x3, t)*Derivative(delta_j_w(x1, x2, x3, w, t), w)*Subs(Derivative(O(g1, g2), g2), (g1, g2), (w - h_plus0(x1, x2, x3, t), -w + h_minus0(x1, x2, x3, t))) - dh_plus(x1, x2, x3, t)*Derivative(delta_j_1(x1, x2, x3, w, t), x1)*Subs(Derivative(O(g1, g2), g1), (g1, g2), (w - h_plus0(x1, x2, x3, t), -w + h_minus0(x1, x2, x3, t))) + dh_plus(x1, x2, x3, t)*Derivative(delta_j_1_face(x1, x2, x3, t), x1)*Subs(Derivative(O(g1, g2), g1), (g1, g2), (w - h_plus0(x1, x2, x3, t), -w + h_minus0(x1, x2, x3, t))) - dh_plus(x1, x2, x3, t)*Derivative(delta_j_2(x1, x2, x3, w, t), x2)*Subs(Derivative(O(g1, g2), g1), (g1, g2), (w - h_plus0(x1, x2, x3, t), -w + h_minus0(x1, x2, x3, t))) + dh_plus(x1, x2, x3, t)*Derivative(delta_j_2_face(x1, x2, x3, t), x2)*Subs(Derivative(O(g1, g2), g1), (g1, g2), (w - h_plus0(x1, x2, x3, t), -w + h_minus0(x1, x2, x3, t))) - dh_plus(x1, x2, x3, t)*Derivative(delta_j_3(x1, x2, x3, w, t), x3)*Subs(Derivative(O(g1, g2), g1), (g1,