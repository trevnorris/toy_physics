delta_j_w(x1, x2, x3, w, t)*dh_minus(x1, x2, x3, t)*Subs(Derivative(O(g1, g2), (g2, 2)), (g1, g2), (w - h_plus0(x1, x2, x3, t), -w + h_minus0(x1, x2, x3, t))) - delta_j_w(x1, x2, x3, w, t)*dh_minus(x1, x2, x3, t)*Subs(Derivative(O(w - h_plus0(x1, x2, x3, t), g2), (g2, 2)), g2, -w + h_minus0(x1, x2, x3, t)) + delta_j_w(x1, x2, x3, w, t)*dh_plus(x1, x2, x3, t)*Subs(Derivative(O(g1, g2), (g1, 2)), (g1, g2), (w - h_plus0(x1, x2, x3, t), -w + h_minus0(x1, x2, x3, t))) - delta_j_w(x1, x2, x3, w, t)*dh_plus(x1, x2, x3, t)*Subs(Derivative(O(g1, -w + h_minus0(x1, x2, x3, t)), (g1, 2)), g1, w - h_plus0(x1, x2, x3, t)) - delta_j_w_face(x1, x2, x3, t)*dh_minus(x1, x2, x3, t)*Subs(Derivative(O(g1, g2), (g2, 2)), (g1, g2), (w - h_plus0(x1, x2, x3, t), -w + h_minus0(x1, x2, x3, t))) + delta_j_w_face(x1, x2, x3, t)*dh_minus(x1, x2, x3, t)*Subs(Derivative(O(w - h_plus0(x1, x2, x3, t), g2), (g2, 2)), g2, -w + h_minus0(x1, x2, x3, t)) - delta_j_w_face(x1, x2, x3, t)*dh_plus(x1, x2, x3, t)*Subs(Derivative(O(g1, g2), (g1, 2)), (g1, g2), (w - h_plus0(x1, x2, x3, t), -w + h_minus0(x1, x2, x3, t))) + delta_j_w_face(x1, x2, x3, t)*dh_plus(x1, x2, x3, t)*Subs(Derivative(O(g1, -w + h_minus0(x1, x2, x3, t)), (g1, 2)), g1, w - h_plus0(x1, x2, x3, t))
second_ibp_local.doit() = 0
second_ibp_identity_holds (after doit): True

=== Q1 STAGE 4: probe — replace bulk current by face values ===
diff |_{delta_j -> delta_j_face} = 0
vanishes_when_no_w_dependence: True

=== Q1 STAGE 5: concrete nonzero probe (decaying O, linear-in-w current) ===
concrete_diff_integrand = 2*A*W0**2*c*w*exp(-W0**2/2)*exp(-2*w**2) - 8*A*W0*c*w**2*exp(-W0**2/2)*exp(-2*w**2) + A*W0*c*exp(-W0**2/2)*exp(-2*w**2) + 8*A*c*w**3*exp(-W0**2/2)*exp(-2*w**2) - 2*A*c*w*exp(-W0**2/2)*exp(-2*w**2) - 2*B*W0**2*c*w*exp(-W0**2/2)*exp(-2*w**2) + B*W0*c*exp(-W0**2/2)*exp(-2*w**2) + 8*B*c*w**3*exp(-W0**2/2)*exp(-2*w**2) - 2*B*c*w*exp(-W0**2/2)*exp(-2*w**2)
Integral(concrete_diff) = sqrt(2)*sqrt(pi)*W0*c*(-A + B)*exp(-W0**2/2)/2
concrete_diff_Integral_is_zero: False

