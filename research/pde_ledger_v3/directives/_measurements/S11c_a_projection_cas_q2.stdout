=== Q2 STAGE 4: in-plane derivative of the η¹ shape integrand ===
eta^1 coefficient of dOmega/deps|_eps0 =
W0*delta_W(x1, x2, x3, t)*w1(x1, x2, x3)*Subs(Derivative(O(_xi_1, _xi_2), (_xi_1, 2)), (_xi_1, _xi_2), (-W0/2 + w, -W0/2 - w))/4 + W0*delta_W(x1, x2, x3, t)*w1(x1, x2, x3)*Subs(Derivative(O(_xi_1, _xi_2), (_xi_2, 2)), (_xi_1, _xi_2), (-W0/2 + w, -W0/2 - w))/4 + W0*delta_W(x1, x2, x3, t)*w1(x1, x2, x3)*Subs(Derivative(O(_xi_1, _xi_2), _xi_1, _xi_2), (_xi_1, _xi_2), (-W0/2 + w, -W0/2 - w))/2 + W0*w1(x1, x2, x3)*zeta_c(x1, x2, x3, t)*Subs(Derivative(O(_xi_1, _xi_2), (_xi_1, 2)), (_xi_1, _xi_2), (-W0/2 + w, -W0/2 - w))/2 - W0*w1(x1, x2, x3)*zeta_c(x1, x2, x3, t)*Subs(Derivative(O(_xi_1, _xi_2), (_xi_2, 2)), (_xi_1, _xi_2), (-W0/2 + w, -W0/2 - w))/2

d/dx1 of that coefficient (after doit) =
W0*delta_W(x1, x2, x3, t)*Derivative(w1(x1, x2, x3), x1)*Subs(Derivative(O(_xi_1, -W0/2 - w), (_xi_1, 2)), _xi_1, -W0/2 + w)/4 + W0*delta_W(x1, x2, x3, t)*Derivative(w1(x1, x2, x3), x1)*Subs(Derivative(O(-W0/2 + w, _xi_2), (_xi_2, 2)), _xi_2, -W0/2 - w)/4 + W0*delta_W(x1, x2, x3, t)*Derivative(w1(x1, x2, x3), x1)*Subs(Derivative(O(_xi_1, _xi_2), _xi_1, _xi_2), (_xi_2, _xi_1), (-W0/2 - w, -W0/2 + w))/2 + W0*w1(x1, x2, x3)*Derivative(delta_W(x1, x2, x3, t), x1)*Subs(Derivative(O(_xi_1, -W0/2 - w), (_xi_1, 2)), _xi_1, -W0/2 + w)/4 + W0*w1(x1, x2, x3)*Derivative(delta_W(x1, x2, x3, t), x1)*Subs(Derivative(O(-W0/2 + w, _xi_2), (_xi_2, 2)), _xi_2, -W0/2 - w)/4 + W0*w1(x1, x2, x3)*Derivative(delta_W(x1, x2, x3, t), x1)*Subs(Derivative(O(_xi_1, _xi_2), _xi_1, _xi_2), (_xi_2, _xi_1), (-W0/2 - w, -W0/2 + w))/2 + W0*w1(x1, x2, x3)*Derivative(zeta_c(x1, x2, x3, t), x1)*Subs(Derivative(O(_xi_1, -W0/2 - w), (_xi_1, 2)), _xi_1, -W0/2 + w)/2 - W0*w1(x1, x2, x3)*Derivative(zeta_c(x1, x2, x3, t), x1)*Subs(Derivative(O(-W0/2 + w, _xi_2), (_xi_2, 2)), _xi_2, -W0/2 - w)/2 + W0*zeta_c(x1, x2, x3, t)*Derivative(w1(x1, x2, x3), x1)*Subs(Derivative(O(_xi_1, -W0/2 - w), (_xi_1, 2)), _xi_1, -W0/2 + w)/2 - W0*zeta_c(x1, x2, x3, t)*Derivative(w1(x1, x2, x3), x1)*Subs(Derivative(O(-W0/2 + w, _xi_2), (_xi_2, 2)), _xi_2, -W0/2 - w)/2

