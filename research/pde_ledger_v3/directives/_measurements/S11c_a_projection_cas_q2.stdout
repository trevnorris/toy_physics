=== Q2 STAGE 3: analytic η-expansion of ∂εΩ|_ε0 (exposes O_ij × profile) ===
dG+/deta|_0 = -W0*w1(x1, x2, x3)/2
dG-/deta|_0 = -W0*w1(x1, x2, x3)/2
dG+/deps|_0 = -delta_W(x1, x2, x3, t)/2 - zeta_c(x1, x2, x3, t)
dG-/deps|_0 = -delta_W(x1, x2, x3, t)/2 + zeta_c(x1, x2, x3, t)

series_eta(dOmega/deps|_eps0) to O(eta) =
W0*eta*delta_W(x1, x2, x3, t)*w1(x1, x2, x3)*Subs(Derivative(O(_xi_1, _xi_2), _xi_1, _xi_2), _xi_2, -W0/2 - w)/4 + W0*eta*delta_W(x1, x2, x3, t)*w1(x1, x2, x3)*Subs(Derivative(O(_xi_1, _xi_2), _xi_1, _xi_2), _xi_1, -W0/2 + w)/4 + W0*eta*w1(x1, x2, x3)*zeta_c(x1, x2, x3, t)*Subs(Derivative(O(_xi_1, _xi_2), _xi_1, _xi_2), _xi_2, -W0/2 - w)/2 - W0*eta*w1(x1, x2, x3)*zeta_c(x1, x2, x3, t)*Subs(Derivative(O(_xi_1, _xi_2), _xi_1, _xi_2), _xi_1, -W0/2 + w)/2 - delta_W(x1, x2, x3, t)*Derivative(O(_xi_1, -W0/2 - w), _xi_1)/2 - delta_W(x1, x2, x3, t)*Derivative(O(-W0/2 + w, _xi_2), _xi_2)/2 - zeta_c(x1, x2, x3, t)*Derivative(O(_xi_1, -W0/2 - w), _xi_1) + zeta_c(x1, x2, x3, t)*Derivative(O(-W0/2 + w, _xi_2), _xi_2)

analytic_chain_Taylor_O(eta) =
W0*eta*delta_W(x1, x2, x3, t)*w1(x1, x2, x3)*Subs(Derivative(O(_xi_1, _xi_2), (_xi_1, 2)), (_xi_1, _xi_2), (-W0/2 + w, -W0/2 - w))/4 + W0*eta*delta_W(x1, x2, x3, t)*w1(x1, x2, x3)*Subs(Derivative(O(_xi_1, _xi_2), (_xi_2, 2)), (_xi_1, _xi_2), (-W0/2 + w, -W0/2 - w))/4 + W0*eta*delta_W(x1, x2, x3, t)*w1(x1, x2, x3)*Subs(Derivative(O(_xi_1, _xi_2), _xi_1, _xi_2), (_xi_1, _xi_2), (-W0/2 + w, -W0/2 - w))/2 + W0*eta*w1(x1, x2, x3)*zeta_c(x1, x2, x3, t)*Subs(Derivative(O(_xi_1, _xi_2), (_xi_1, 2)), (_xi_1, _xi_2), (-W0/2 + w, -W0/2 - w))/2 - W0*eta*w1(x1, x2, x3)*zeta_c(x1, x2, x3, t)*Subs(Derivative(O(_xi_1, _xi_2), (_xi_2, 2)), (_xi_1, _xi_2), (-W0/2 + w, -W0/2 - w))/2 - delta_W(x1, x2, x3, t)*Subs(Derivative(O(_xi_1, _xi_2), _xi_1), (_xi_1, _xi_2), (-W0/2 + w, -W0/2 - w))/2 - delta_W(x1, x2, x3, t)*Subs(Derivative(O(_xi_1, _xi_2), _xi_2), (_xi_1, _xi_2), (-W0/2 + w, -W0/2 - w))/2 - zeta_c(x1, x2, x3, t)*Subs(Derivative(O(_xi_1, _xi_2), _xi_1), (_xi_1, _xi_2), (-W0/2 + w, -W0/2 - w)) + zeta_c(x1, x2, x3, t)*Subs(Derivative(O(_xi_1, _xi_2), _xi_2), (_xi_1, _xi_2), (-W0/2 + w, -W0/2 - w))

concrete_O=exp(-(G+)^2-(G-)^2): series - analytic_Taylor = 0
