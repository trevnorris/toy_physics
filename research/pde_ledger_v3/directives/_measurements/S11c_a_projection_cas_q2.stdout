=== Q2 STAGE 0: chain rule vs raw ∂ε of Omega (integrands) ===
dOmega/deps (raw) =
-delta_W(x1, x2, x3, t)*Subs(Derivative(O(_xi_1, -W0*eta*w1(x1, x2, x3)/2 - W0/2 - epsilon*delta_W(x1, x2, x3, t)/2 + epsilon*zeta_c(x1, x2, x3, t) - w), _xi_1), _xi_1, -W0*eta*w1(x1, x2, x3)/2 - W0/2 - epsilon*delta_W(x1, x2, x3, t)/2 - epsilon*zeta_c(x1, x2, x3, t) + w)/2 - delta_W(x1, x2, x3, t)*Subs(Derivative(O(-W0*eta*w1(x1, x2, x3)/2 - W0/2 - epsilon*delta_W(x1, x2, x3, t)/2 - epsilon*zeta_c(x1, x2, x3, t) + w, _xi_2), _xi_2), _xi_2, -W0*eta*w1(x1, x2, x3)/2 - W0/2 - epsilon*delta_W(x1, x2, x3, t)/2 + epsilon*zeta_c(x1, x2, x3, t) - w)/2 - zeta_c(x1, x2, x3, t)*Subs(Derivative(O(_xi_1, -W0*eta*w1(x1, x2, x3)/2 - W0/2 - epsilon*delta_W(x1, x2, x3, t)/2 + epsilon*zeta_c(x1, x2, x3, t) - w), _xi_1), _xi_1, -W0*eta*w1(x1, x2, x3)/2 - W0/2 - epsilon*delta_W(x1, x2, x3, t)/2 - epsilon*zeta_c(x1, x2, x3, t) + w) + zeta_c(x1, x2, x3, t)*Subs(Derivative(O(-W0*eta*w1(x1, x2, x3)/2 - W0/2 - epsilon*delta_W(x1, x2, x3, t)/2 - epsilon*zeta_c(x1, x2, x3, t) + w, _xi_2), _xi_2), _xi_2, -W0*eta*w1(x1, x2, x3)/2 - W0/2 - epsilon*delta_W(x1, x2, x3, t)/2 + epsilon*zeta_c(x1, x2, x3, t) - w)

dOmega/deps (chain rule through G+,G-) =
-delta_W(x1, x2, x3, t)*Subs(Derivative(O(_xi_1, -W0*eta*w1(x1, x2, x3)/2 - W0/2 - epsilon*delta_W(x1, x2, x3, t)/2 + epsilon*zeta_c(x1, x2, x3, t) - w), _xi_1), _xi_1, -W0*eta*w1(x1, x2, x3)/2 - W0/2 - epsilon*delta_W(x1, x2, x3, t)/2 - epsilon*zeta_c(x1, x2, x3, t) + w)/2 - delta_W(x1, x2, x3, t)*Subs(Derivative(O(-W0*eta*w1(x1, x2, x3)/2 - W0/2 - epsilon*delta_W(x1, x2, x3, t)/2 - epsilon*zeta_c(x1, x2, x3, t) + w, _xi_2), _xi_2), _xi_2, -W0*eta*w1(x1, x2, x3)/2 - W0/2 - epsilon*delta_W(x1, x2, x3, t)/2 + epsilon*zeta_c(x1, x2, x3, t) - w)/2 - zeta_c(x1, x2, x3, t)*Subs(Derivative(O(_xi_1, -W0*eta*w1(x1, x2, x3)/2 - W0/2 - epsilon*delta_W(x1, x2, x3, t)/2 + epsilon*zeta_c(x1, x2, x3, t) - w), _xi_1), _xi_1, -W0*eta*w1(x1, x2, x3)/2 - W0/2 - epsilon*delta_W(x1, x2, x3, t)/2 - epsilon*zeta_c(x1, x2, x3, t) + w) + zeta_c(x1, x2, x3, t)*Subs(Derivative(O(-W0*eta*w1(x1, x2, x3)/2 - W0/2 - epsilon*delta_W(x1, x2, x3, t)/2 - epsilon*zeta_c(x1, x2, x3, t) + w, _xi_2), _xi_2), _xi_2, -W0*eta*w1(x1, x2, x3)/2 - W0/2 - epsilon*delta_W(x1, x2, x3, t)/2 + epsilon*zeta_c(x1, x2, x3, t) - w)

raw - chain = 0
integrands_identical: True
integrands_identical_at_eps0: True

=== Q2 STAGE 1: formal integrals (a) and (b) ===
form_(b)_diff_under_integral =
Integral((-delta_W(x1, x2, x3, t)/2 - zeta_c(x1, x2, x3, t))*Subs(Derivative(O(_xi_1, -W0*(eta*w1(x1, x2, x3) + 1)/2 + epsilon*(-delta_W(x1, x2, x3, t)/2 + zeta_c(x1, x2, x3, t)) - w), _xi_1), _xi_1, -W0*(eta*w1(x1, x2, x3) + 1)/2 - epsilon*(delta_W(x1, x2, x3, t)/2 + zeta_c(x1, x2, x3, t)) + w) + (-delta_W(x1, x2, x3, t)/2 + zeta_c(x1, x2, x3, t))*Subs(Derivative(O(-W0*(eta*w1(x1, x2, x3) + 1)/2 - epsilon*(delta_W(x1, x2, x3, t)/2 + zeta_c(x1, x2, x3, t)) + w, _xi_2), _xi_2), _xi_2, -W0*(eta*w1(x1, x2, x3) + 1)/2 + epsilon*(-delta_W(x1, x2, x3, t)/2 + zeta_c(x1, x2, x3, t)) - w), (w, -oo, oo))
form_(a)_chain_then_Integral =
Integral((-delta_W(x1, x2, x3, t)/2 - zeta_c(x1, x2, x3, t))*Subs(Derivative(O(_xi_1, -W0*(eta*w1(x1, x2, x3) + 1)/2 + epsilon*(-delta_W(x1, x2, x3, t)/2 + zeta_c(x1, x2, x3, t)) - w), _xi_1), _xi_1, -W0*(eta*w1(x1, x2, x3) + 1)/2 - epsilon*(delta_W(x1, x2, x3, t)/2 + zeta_c(x1, x2, x3, t)) + w) + (-delta_W(x1, x2, x3, t)/2 + zeta_c(x1, x2, x3, t))*Subs(Derivative(O(-W0*(eta*w1(x1, x2, x3) + 1)/2 - epsilon*(delta_W(x1, x2, x3, t)/2 + zeta_c(x1, x2, x3, t)) + w, _xi_2), _xi_2), _xi_2, -W0*(eta*w1(x1, x2, x3) + 1)/2 + epsilon*(-delta_W(x1, x2, x3, t)/2 + zeta_c(x1, x2, x3, t)) - w), (w, -oo, oo))
Integral(raw - chain) = Integral(0, (w, -oo, oo))
Integral_difference_identically_zero: True

=== Q2 STAGE 2: evaluate at eps=0 (first shape order) ===
integrand_(b)|_eps0 =
-delta_W(x1, x2, x3, t)*Subs(Derivative(O(_xi_1, -W0*eta*w1(x1, x2, x3)/2 - W0/2 - w), _xi_1), _xi_1, -W0*eta*w1(x1, x2, x3)/2 - W0/2 + w)/2 - delta_W(x1, x2, x3, t)*Subs(Derivative(O(-W0*eta*w1(x1, x2, x3)/2 - W0/2 + w, _xi_2), _xi_2), _xi_2, -W0*eta*w1(x1, x2, x3)/2 - W0/2 - w)/2 - zeta_c(x1, x2, x3, t)*Subs(Derivative(O(_xi_1, -W0*eta*w1(x1, x2, x3)/2 - W0/2 - w), _xi_1), _xi_1, -W0*eta*w1(x1, x2, x3)/2 - W0/2 + w) + zeta_c(x1, x2, x3, t)*Subs(Derivative(O(-W0*eta*w1(x1, x2, x3)/2 - W0/2 + w, _xi_2), _xi_2), _xi_2, -W0*eta*w1(x1, x2, x3)/2 - W0/2 - w)

integrand_(a)|_eps0 =
-delta_W(x1, x2, x3, t)*Subs(Derivative(O(_xi_1, -W0*eta*w1(x1, x2, x3)/2 - W0/2 - w), _xi_1), _xi_1, -W0*eta*w1(x1, x2, x3)/2 - W0/2 + w)/2 - delta_W(x1, x2, x3, t)*Subs(Derivative(O(-W0*eta*w1(x1, x2, x3)/2 - W0/2 + w, _xi_2), _xi_2), _xi_2, -W0*eta*w1(x1, x2, x3)/2 - W0/2 - w)/2 - zeta_c(x1, x2, x3, t)*Subs(Derivative(O(_xi_1, -W0*eta*w1(x1, x2, x3)/2 - W0/2 - w), _xi_1), _xi_1, -W0*eta*w1(x1, x2, x3)/2 - W0/2 + w) + zeta_c(x1, x2, x3, t)*Subs(Derivative(O(-W0*eta*w1(x1, x2, x3)/2 - W0/2 + w, _xi_2), _xi_2), _xi_2, -W0*eta*w1(x1, x2, x3)/2 - W0/2 - w)

form_(b)|_eps0 = Integral(-delta_W(x1, x2, x3, t)*Subs(Derivative(O(_xi_1, -W0*eta*w1(x1, x2, x3)/2 - W0/2 - w), _xi_1), _xi_1, -W0*eta*w1(x1, x2, x3)/2 - W0/2 + w)/2 - delta_W(x1, x2, x3, t)*Subs(Derivative(O(-W0*eta*w1(x1, x2, x3)/2 - W0/2 + w, _xi_2), _xi_2), _xi_2, -W0*eta*w1(x1, x2, x3)/2 - W0/2 - w)/2 - zeta_c(x1, x2, x3, t)*Subs(Derivative(O(_xi_1, -W0*eta*w1(x1, x2, x3)/2 - W0/2 - w), _xi_1), _xi_1, -W0*eta*w1(x1, x2, x3)/2 - W0/2 + w) + zeta_c(x1, x2, x3, t)*Subs(Derivative(O(-W0*eta*w1(x1, x2, x3)/2 - W0/2 + w, _xi_2), _xi_2), _xi_2, -W0*eta*w1(x1, x2, x3)/2 - W0/2 - w), (w, -oo, oo))
form_(a)|_eps0 = Integral(-delta_W(x1, x2, x3, t)*Subs(Derivative(O(_xi_1, -W0*eta*w1(x1, x2, x3)/2 - W0/2 - w), _xi_1), _xi_1, -W0*eta*w1(x1, x2, x3)/2 - W0/2 + w)/2 - delta_W(x1, x2, x3, t)*Subs(Derivative(O(-W0*eta*w1(x1, x2, x3)/2 - W0/2 + w, _xi_2), _xi_2), _xi_2, -W0*eta*w1(x1, x2, x3)/2 - W0/2 - w)/2 - zeta_c(x1, x2, x3, t)*Subs(Derivative(O(_xi_1, -W0*eta*w1(x1, x2, x3)/2 - W0/2 - w), _xi_1), _xi_1, -W0*eta*w1(x1, x2, x3)/2 - W0/2 + w) + zeta_c(x1, x2, x3, t)*Subs(Derivative(O(-W0*eta*w1(x1, x2, x3)/2 - W0/2 + w, _xi_2), _xi_2), _xi_2, -W0*eta*w1(x1, x2, x3)/2 - W0/2 - w), (w, -oo, oo))
