SECTION 1 homologous spreading flow
material_residual 0
family_S_gamma_B 0
family_S_order_residual 0
family_S_dt_n_Gamma_return -2*n0*s*w**2/(h0 + s*t)**3
family_S_dt_n_Gamma_return_at_w_h0_t0 -2*n0*s/h0
family_S_projected_material n0*(h0 + s*t)
family_S_dt_projected_material n0*s
family_S_dt_projected_order n0*s/2
family_S_face_speed_minus_interior_uw_lower 0
family_S_ur C0/r**2 - r*s/(3*(h0 + s*t))
family_S_uw s*w/(h0 + s*t)
SECTION 2 Eulerian-constant source densities
family_E_order_residual 0
family_E_dt_n_Gamma_return 0
family_E_dt_n_Gamma_drain 0
family_E_dt_chi b
family_E_dt_projected_material n0*s
family_E_dt_projected_order n0*(2*b*h0 + 4*b*s*t + s)/2
family_E_chi_at_0 1/2
family_E_chi_at_1 3/5
family_A_material_residual 0
family_A_order_residual 0
family_A_dt_n_Gamma_return 0
family_A_dt_projected_material 0
family_A_dt_projected_order 0
family_A_minus_family_S_dt_projected_material -n0*s
SECTION 3 product versus rate
dt_Gamma_when_product_changes 0
dt_n_Gamma_when_rate_constant 3
dt_n_Gamma_when_product_constant 0
dt_Gamma_when_product_constant -1/(t + 2)**2
SECTION 4 omega to 0 on the spreading profile
omega_limit_of_Gamma_return w**2/(h0 + s*t)**2
dt_of_that_limit -2*n0*s*w**2/(h0 + s*t)**3
dt_of_that_limit_at_w_h0_t0 -2*n0*s/h0
storage_before_limit A*omega*cos(omega*t) + sigma_rate
storage_omega_limit sigma_rate
storage_dropped_term A*omega*cos(omega*t)
SECTION 5 material balance contains neither rate
Gamma_return_in_material False
material_free_symbols ['r', 't', 'w']
material_expression_minus_itself 0
SECTION 6 order budget assemblies
C_minus -b1_minus + b2_minus + fna_minus
C_plus -b2_plus + b3_plus - fna_plus
after_minus_before_minus_C 0
before_minus_after b1_minus - b2_minus + b2_plus - b3_plus - fna_minus + fna_plus
concrete_C_minus 9
concrete_C_plus -7
concrete_before_minus_after -2
concrete_gap_after_before_C 0
orientation_residual_outer_minus_inner 0
orientation_residual_both_plus 2*a**2*H_r(a)
orientation_residual_both_plus_value 32
order_lost_minus_drain_plus_return_plus_faces 0
plain_totals_minus_order_lost_without_faces b1_minus - b2_minus + b2_plus - b3_plus - fna_minus + fna_plus
plain_totals_relation_residual_without_faces_concrete -2
order_lost_sign_totals_difference_from_plain 2*int_n_Gamma_drain - 2*int_n_Gamma_return
SECTION 7 order flux and far radius
radial_order_flux_minus_advective J_r(r, w, t)
d_face_channel_d_outer 4*pi*R**2*face_density(R, t)
d_face_channel_d_outer_at_sample 100*pi
shell_integral Integral(4*pi*r**2*face_density(r, t), (r, a, R))
shell_limits ((r, a, R),)
