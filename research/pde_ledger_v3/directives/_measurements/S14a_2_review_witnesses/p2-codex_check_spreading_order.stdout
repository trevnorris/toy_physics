domain: t>=0, r>=a=1; L=R^3-1>0; lower face 0, upper face h
n,u are the same in all three regions; chi is zero outside; J_chi=0 in all regions
n,chi_inside,J_chi,u_r,u_w = (1, 1/2, 0, -2/r**2, 0)
h = exp((1 - r**3)/(t + 1))/2 + 1
Gamma_return=Gamma_drain in the interior = 2*exp(1 - r**3)/(exp((1 - r**3)/(t + 1)) + 2)
material regular residual = 0
order regular residual = 0
material face jump coefficients = (0, 0)
order lower,upper face source coefficients = (0, -(1 - r**3)*exp((1 - r**3)/(t + 1))/(4*(t + 1)**2) + 3*exp((1 - r**3)/(t + 1))/(2*(t + 1)))
finite-shell excess material/(4*pi) = (-t + (t + 1)*exp(L/(t + 1)) - 1)*exp(-L/(t + 1))/6
finite-shell storage/(4*pi) = (-L - t + (t + 1)*exp(L/(t + 1)) - 1)*exp(-L/(t + 1))/(6*(t + 1))
face,core,J,outer flux/(4*pi) = (-L*(-t - 1)*exp(-L/(t + 1))/(6*(t + 1)**2) - 7/6 + 7*exp(-L/(t + 1))/6, 3, -L*(-t - 1)*exp(-L/(t + 1))/(6*(t + 1)**2) + 11/6 + 7*exp(-L/(t + 1))/6, -2 - exp(-L/(t + 1)))
material shell residual/(4*pi) = 0
order shell residual/(4*pi) = 0
regular return,drain shell totals/(4*pi) = (1/3 - exp(-L)/3, 1/3 - exp(-L)/3)
global regular return,drain totals/(4*pi) = (1/3, 1/3)
global storage/(4*pi) = 1/6
global net face source/(4*pi) = 7/12
global J/(4*pi) = 11/6
time derivatives of global storage,face source,J = (0, 0, 0)
DC finite-shell storage/(4*pi) = 0
DC then far storage/(4*pi) = 0
far then DC storage/(4*pi) = 1/6
mean-exp primitive derivative residual = 0
DC then far outer flux/(4*pi) = -3
far then DC outer flux/(4*pi) = -2
order-of-limits difference in outer flux/(4*pi) = -1
DC finite-shell face channel/(4*pi) = 0
DC finite-shell face source/(4*pi) = 0
far-first face channel/(4*pi) = -7/6
