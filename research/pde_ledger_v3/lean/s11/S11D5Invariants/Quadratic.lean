theorem quadratic_representation (Q : Quad) :
    ∃ c : Coefficients, ∀ G, Q G = polynomial c (coordinates G) := by
  let b := Q.associated
  refine ⟨bilinearCoefficients (fun i j => b (frame i) (frame j)), fun G => ?_⟩
