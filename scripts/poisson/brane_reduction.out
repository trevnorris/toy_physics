8b) Brane-observed velocity (definition): v_brane := J_brane / rho_brane
--------------------------------------------------------------------------------------------
[1] v_{x,{\rm brane}} = \frac{\int\limits_{- W_{\rm proj}}^{W_{\rm proj}} \left(- \frac{i \bar{\h} \left(\bar\psi{\left(t,x,y,z,w \right)} \frac{\partial}{\partial x} \psi{\left(t,x,y,z,w \right)} - \psi{\left(t,x,y,z,w \right)} \frac{\partial}{\partial x} \bar\psi{\left(t,x,y,z,w \right)}\right) W{\left(w \right)}}{2 m}\right)\, dw}{\int\limits_{- W_{\rm proj}}^{W_{\rm proj}} W{\left(w \right)} \bar\psi{\left(t,x,y,z,w \right)} \psi{\left(t,x,y,z,w \right)}\, dw}

[2] v_{y,{\rm brane}} = \frac{\int\limits_{- W_{\rm proj}}^{W_{\rm proj}} \left(- \frac{i \bar{\h} \left(\bar\psi{\left(t,x,y,z,w \right)} \frac{\partial}{\partial y} \psi{\left(t,x,y,z,w \right)} - \psi{\left(t,x,y,z,w \right)} \frac{\partial}{\partial y} \bar\psi{\left(t,x,y,z,w \right)}\right) W{\left(w \right)}}{2 m}\right)\, dw}{\int\limits_{- W_{\rm proj}}^{W_{\rm proj}} W{\left(w \right)} \bar\psi{\left(t,x,y,z,w \right)} \psi{\left(t,x,y,z,w \right)}\, dw}

[3] v_{z,{\rm brane}} = \frac{\int\limits_{- W_{\rm proj}}^{W_{\rm proj}} \left(- \frac{i \bar{\h} \left(\bar\psi{\left(t,x,y,z,w \right)} \frac{\partial}{\partial z} \psi{\left(t,x,y,z,w \right)} - \psi{\left(t,x,y,z,w \right)} \frac{\partial}{\partial z} \bar\psi{\left(t,x,y,z,w \right)}\right) W{\left(w \right)}}{2 m}\right)\, dw}{\int\limits_{- W_{\rm proj}}^{W_{\rm proj}} W{\left(w \right)} \bar\psi{\left(t,x,y,z,w \right)} \psi{\left(t,x,y,z,w \right)}\, dw}

============================================================================================


============================================================================================
