
============================================================================================
0) Frozen n=5 EOS anchor
--------------------------------------------------------------------------------------------
[1] P{\left(\rho \right)} = K \rho^{5}

[2] c^{2}_{s}{\left(\rho \right)} = 5 K \rho^{4}

[3] h{\left(\rho \right)} = \frac{5 K \rho^{4}}{4}

[4] U{\left(\rho \right)} = \frac{K \rho^{5}}{4}

[5] \rho\,h'(\rho) = 5 K \rho^{4}

============================================================================================


============================================================================================
1) Canonical 4D GNLS form (compact; PDE we intend to simulate)
--------------------------------------------------------------------------------------------
i \bar{\h} \frac{\partial}{\partial t} \psi{\left(t,x,y,z,w \right)} = \frac{- 2 \bar{\h}^{2} \left(\frac{\partial^{2}}{\partial w^{2}} \psi{\left(t,x,y,z,w \right)} + \frac{\partial^{2}}{\partial x^{2}} \psi{\left(t,x,y,z,w \right)} + \frac{\partial^{2}}{\partial y^{2}} \psi{\left(t,x,y,z,w \right)} + \frac{\partial^{2}}{\partial z^{2}} \psi{\left(t,x,y,z,w \right)}\right) + m \left(5 K \bar\psi^{4}{\left(t,x,y,z,w \right)} \psi^{4}{\left(t,x,y,z,w \right)} + 4 V_{\rm conf}{\left(x,y,z,w,a,L \right)}\right) \psi{\left(t,x,y,z,w \right)}}{4 m}
============================================================================================


============================================================================================
2) Canonical 4D current components (Jx,Jy,Jz,Jw)
--------------------------------------------------------------------------------------------
[1] \frac{i \bar{\h} \left(- \bar\psi{\left(t,x,y,z,w \right)} \frac{\partial}{\partial x} \psi{\left(t,x,y,z,w \right)} + \psi{\left(t,x,y,z,w \right)} \frac{\partial}{\partial x} \bar\psi{\left(t,x,y,z,w \right)}\right)}{2 m}

[2] \frac{i \bar{\h} \left(- \bar\psi{\left(t,x,y,z,w \right)} \frac{\partial}{\partial y} \psi{\left(t,x,y,z,w \right)} + \psi{\left(t,x,y,z,w \right)} \frac{\partial}{\partial y} \bar\psi{\left(t,x,y,z,w \right)}\right)}{2 m}

[3] \frac{i \bar{\h} \left(- \bar\psi{\left(t,x,y,z,w \right)} \frac{\partial}{\partial z} \psi{\left(t,x,y,z,w \right)} + \psi{\left(t,x,y,z,w \right)} \frac{\partial}{\partial z} \bar\psi{\left(t,x,y,z,w \right)}\right)}{2 m}

[4] \frac{i \bar{\h} \left(- \bar\psi{\left(t,x,y,z,w \right)} \frac{\partial}{\partial w} \psi{\left(t,x,y,z,w \right)} + \psi{\left(t,x,y,z,w \right)} \frac{\partial}{\partial w} \bar\psi{\left(t,x,y,z,w \right)}\right)}{2 m}

============================================================================================


============================================================================================
3) 4D continuity identity: rho_t + div_4 J = 0
--------------------------------------------------------------------------------------------
\frac{- i \bar{\h} \left(\bar\psi{\left(t,x,y,z,w \right)} \frac{\partial^{2}}{\partial w^{2}} \psi{\left(t,x,y,z,w \right)} - \psi{\left(t,x,y,z,w \right)} \frac{\partial^{2}}{\partial w^{2}} \bar\psi{\left(t,x,y,z,w \right)}\right) - i \bar{\h} \left(\bar\psi{\left(t,x,y,z,w \right)} \frac{\partial^{2}}{\partial x^{2}} \psi{\left(t,x,y,z,w \right)} - \psi{\left(t,x,y,z,w \right)} \frac{\partial^{2}}{\partial x^{2}} \bar\psi{\left(t,x,y,z,w \right)}\right) - i \bar{\h} \left(\bar\psi{\left(t,x,y,z,w \right)} \frac{\partial^{2}}{\partial y^{2}} \psi{\left(t,x,y,z,w \right)} - \psi{\left(t,x,y,z,w \right)} \frac{\partial^{2}}{\partial y^{2}} \bar\psi{\left(t,x,y,z,w \right)}\right) - i \bar{\h} \left(\bar\psi{\left(t,x,y,z,w \right)} \frac{\partial^{2}}{\partial z^{2}} \psi{\left(t,x,y,z,w \right)} - \psi{\left(t,x,y,z,w \right)} \frac{\partial^{2}}{\partial z^{2}} \bar\psi{\left(t,x,y,z,w \right)}\right) + 2 m \left(\bar\psi{\left(t,x,y,z,w \right)} \frac{\partial}{\partial t} \psi{\left(t,x,y,z,w \right)} + \psi{\left(t,x,y,z,w \right)} \frac{\partial}{\partial t} \bar\psi{\left(t,x,y,z,w \right)}\right)}{2 m} = 0
============================================================================================


============================================================================================
4) Brane projection weight: W(w)\ (unnormalized)
--------------------------------------------------------------------------------------------
W_{t} = W{\left(w \right)}
============================================================================================


============================================================================================
5) Brane-projected density rho_brane = ∫ Wt rho dw
--------------------------------------------------------------------------------------------
\int\limits_{- W_{\rm proj}}^{W_{\rm proj}} W{\left(w \right)} \bar\psi{\left(t,x,y,z,w \right)} \psi{\left(t,x,y,z,w \right)}\, dw
============================================================================================


============================================================================================
6) Brane-projected current components (integrated in w)
--------------------------------------------------------------------------------------------
[1] - \frac{i \bar{\h} \left(- \int\limits_{- W_{\rm proj}}^{W_{\rm proj}} \left(- W{\left(w \right)} \bar\psi{\left(t,x,y,z,w \right)} \frac{\partial}{\partial x} \psi{\left(t,x,y,z,w \right)}\right)\, dw - \int\limits_{- W_{\rm proj}}^{W_{\rm proj}} W{\left(w \right)} \psi{\left(t,x,y,z,w \right)} \frac{\partial}{\partial x} \bar\psi{\left(t,x,y,z,w \right)}\, dw\right)}{2 m}

[2] - \frac{i \bar{\h} \left(- \int\limits_{- W_{\rm proj}}^{W_{\rm proj}} \left(- W{\left(w \right)} \bar\psi{\left(t,x,y,z,w \right)} \frac{\partial}{\partial y} \psi{\left(t,x,y,z,w \right)}\right)\, dw - \int\limits_{- W_{\rm proj}}^{W_{\rm proj}} W{\left(w \right)} \psi{\left(t,x,y,z,w \right)} \frac{\partial}{\partial y} \bar\psi{\left(t,x,y,z,w \right)}\, dw\right)}{2 m}

[3] - \frac{i \bar{\h} \left(- \int\limits_{- W_{\rm proj}}^{W_{\rm proj}} \left(- W{\left(w \right)} \bar\psi{\left(t,x,y,z,w \right)} \frac{\partial}{\partial z} \psi{\left(t,x,y,z,w \right)}\right)\, dw - \int\limits_{- W_{\rm proj}}^{W_{\rm proj}} W{\left(w \right)} \psi{\left(t,x,y,z,w \right)} \frac{\partial}{\partial z} \bar\psi{\left(t,x,y,z,w \right)}\, dw\right)}{2 m}

============================================================================================


============================================================================================
7) Exact projected continuity: (rho_brane)_t + div_3(J_brane) = S_rho_brane
--------------------------------------------------------------------------------------------
\frac{i \bar{\h} \int\limits_{- W_{\rm proj}}^{W_{\rm proj}} \left(- \bar\psi{\left(t,x,y,z,w \right)} \frac{\partial^{2}}{\partial x^{2}} \psi{\left(t,x,y,z,w \right)} + \psi{\left(t,x,y,z,w \right)} \frac{\partial^{2}}{\partial x^{2}} \bar\psi{\left(t,x,y,z,w \right)}\right) W{\left(w \right)}\, dw}{2 m} + \frac{i \bar{\h} \int\limits_{- W_{\rm proj}}^{W_{\rm proj}} \left(- \bar\psi{\left(t,x,y,z,w \right)} \frac{\partial^{2}}{\partial y^{2}} \psi{\left(t,x,y,z,w \right)} + \psi{\left(t,x,y,z,w \right)} \frac{\partial^{2}}{\partial y^{2}} \bar\psi{\left(t,x,y,z,w \right)}\right) W{\left(w \right)}\, dw}{2 m} + \frac{i \bar{\h} \int\limits_{- W_{\rm proj}}^{W_{\rm proj}} \left(- \bar\psi{\left(t,x,y,z,w \right)} \frac{\partial^{2}}{\partial z^{2}} \psi{\left(t,x,y,z,w \right)} + \psi{\left(t,x,y,z,w \right)} \frac{\partial^{2}}{\partial z^{2}} \bar\psi{\left(t,x,y,z,w \right)}\right) W{\left(w \right)}\, dw}{2 m} + \int\limits_{- W_{\rm proj}}^{W_{\rm proj}} \left(\bar\psi{\left(t,x,y,z,w \right)} \frac{\partial}{\partial t} \psi{\left(t,x,y,z,w \right)} + \psi{\left(t,x,y,z,w \right)} \frac{\partial}{\partial t} \bar\psi{\left(t,x,y,z,w \right)}\right) W{\left(w \right)}\, dw = \frac{i \bar{\h} \left(- \left(\bar\psi{\left(t,x,y,z,- W_{\rm proj} \right)} \left. \frac{\partial}{\partial w} \psi{\left(t,x,y,z,w \right)} \right|_{\substack{ w=- W_{\rm proj} }} - \psi{\left(t,x,y,z,- W_{\rm proj} \right)} \left. \frac{\partial}{\partial w} \bar\psi{\left(t,x,y,z,w \right)} \right|_{\substack{ w=- W_{\rm proj} }}\right) W{\left(- W_{\rm proj} \right)} + \left(\bar\psi{\left(t,x,y,z,W_{\rm proj} \right)} \frac{\partial}{\partial W_{\rm proj}} \psi{\left(t,x,y,z,W_{\rm proj} \right)} - \psi{\left(t,x,y,z,W_{\rm proj} \right)} \frac{\partial}{\partial W_{\rm proj}} \bar\psi{\left(t,x,y,z,W_{\rm proj} \right)}\right) W{\left(W_{\rm proj} \right)} + \int\limits_{- W_{\rm proj}}^{W_{\rm proj}} \left(- \bar\psi{\left(t,x,y,z,w \right)} \frac{\partial}{\partial w} \psi{\left(t,x,y,z,w \right)} + \psi{\left(t,x,y,z,w \right)} \frac{\partial}{\partial w} \bar\psi{\left(t,x,y,z,w \right)}\right) \frac{d}{d w} W{\left(w \right)}\, dw\right)}{2 m}
============================================================================================


============================================================================================
8) Exact brane source term S_rho_brane (purely from J_w)
--------------------------------------------------------------------------------------------
\frac{i \bar{\h} \left(- \left(\bar\psi{\left(t,x,y,z,- W_{\rm proj} \right)} \left. \frac{\partial}{\partial w} \psi{\left(t,x,y,z,w \right)} \right|_{\substack{ w=- W_{\rm proj} }} - \psi{\left(t,x,y,z,- W_{\rm proj} \right)} \left. \frac{\partial}{\partial w} \bar\psi{\left(t,x,y,z,w \right)} \right|_{\substack{ w=- W_{\rm proj} }}\right) W{\left(- W_{\rm proj} \right)} + \left(\bar\psi{\left(t,x,y,z,W_{\rm proj} \right)} \frac{\partial}{\partial W_{\rm proj}} \psi{\left(t,x,y,z,W_{\rm proj} \right)} - \psi{\left(t,x,y,z,W_{\rm proj} \right)} \frac{\partial}{\partial W_{\rm proj}} \bar\psi{\left(t,x,y,z,W_{\rm proj} \right)}\right) W{\left(W_{\rm proj} \right)} + \int\limits_{- W_{\rm proj}}^{W_{\rm proj}} \left(- \bar\psi{\left(t,x,y,z,w \right)} \frac{\partial}{\partial w} \psi{\left(t,x,y,z,w \right)} + \psi{\left(t,x,y,z,w \right)} \frac{\partial}{\partial w} \bar\psi{\left(t,x,y,z,w \right)}\right) \frac{d}{d w} W{\left(w \right)}\, dw\right)}{2 m}
============================================================================================


============================================================================================
9) Linearized brane acoustic relations (assumptions stated; do not force Poisson)
--------------------------------------------------------------------------------------------
[1] h'(\rho_{0)} = 5 K \rho_{0}^{3}

[2] c_{s,0}^2 = 5 K \rho_{0}^{4}

[3] \rho_{0 h'(\rho 0)} = 5 K \rho_{0}^{4}

[4] \rho_{0} \left(\frac{\partial^{2}}{\partial x^{2}} \phi_{3}{\left(t,x,y,z \right)} + \frac{\partial^{2}}{\partial y^{2}} \phi_{3}{\left(t,x,y,z \right)} + \frac{\partial^{2}}{\partial z^{2}} \phi_{3}{\left(t,x,y,z \right)}\right) + \frac{\partial}{\partial t} \delta\rho_{\rm brane}{\left(t,x,y,z \right)} = S_{\rm brane}{\left(t,x,y,z \right)}

[5] u{\left(t,x,y,z \right)} = 5 K \rho_{0}^{3} \delta\rho_{\rm brane}{\left(t,x,y,z \right)}

[6] \frac{\partial}{\partial t} \phi_{3}{\left(t,x,y,z \right)} + \frac{u{\left(t,x,y,z \right)}}{m} = 0

============================================================================================


============================================================================================
10) Forced wave equation for brane velocity potential φ3
--------------------------------------------------------------------------------------------
\frac{- 5 K \rho_{0}^{4} \left(\frac{\partial^{2}}{\partial x^{2}} \phi_{3}{\left(t,x,y,z \right)} + \frac{\partial^{2}}{\partial y^{2}} \phi_{3}{\left(t,x,y,z \right)} + \frac{\partial^{2}}{\partial z^{2}} \phi_{3}{\left(t,x,y,z \right)}\right) + m \frac{\partial^{2}}{\partial t^{2}} \phi_{3}{\left(t,x,y,z \right)}}{m} = - \frac{5 K \rho_{0}^{3} S_{\rm brane}{\left(t,x,y,z \right)}}{m}
============================================================================================


============================================================================================
11) Static-limit candidate (if φ_tt is negligible): ρ0 ∇^2 φ3 = S_brane
--------------------------------------------------------------------------------------------
\rho_{0} \left(\frac{\partial^{2}}{\partial x^{2}} \phi_{3}{\left(t,x,y,z \right)} + \frac{\partial^{2}}{\partial y^{2}} \phi_{3}{\left(t,x,y,z \right)} + \frac{\partial^{2}}{\partial z^{2}} \phi_{3}{\left(t,x,y,z \right)}\right) = S_{\rm brane}{\left(t,x,y,z \right)}
============================================================================================


============================================================================================
12) Madelung dictionary (definition-level)
--------------------------------------------------------------------------------------------
[1] \psi = \sqrt{\rho{\left(t,x,y,z,w \right)}} e^{i \theta{\left(t,x,y,z,w \right)}}

[2] \rho = \rho{\left(t,x,y,z,w \right)}

[3] \theta = \theta{\left(t,x,y,z,w \right)}

[4] v_{x} = \frac{\bar{\h} \frac{\partial}{\partial x} \theta{\left(t,x,y,z,w \right)}}{m}

[5] v_{w} = \frac{\bar{\h} \frac{\partial}{\partial w} \theta{\left(t,x,y,z,w \right)}}{m}

============================================================================================


============================================================================================
13) Madelung current identity (representative): J_x = ρ v_x
--------------------------------------------------------------------------------------------
[1] J_{x} = - \frac{i \bar{\h} \left(- \sqrt{\rho{\left(t,x,y,z,w \right)}} e^{i \theta{\left(t,x,y,z,w \right)}} \frac{\partial}{\partial x} \sqrt{\rho{\left(t,x,y,z,w \right)}} e^{- i \theta{\left(t,x,y,z,w \right)}} + \sqrt{\rho{\left(t,x,y,z,w \right)}} e^{- i \theta{\left(t,x,y,z,w \right)}} \frac{\partial}{\partial x} \sqrt{\rho{\left(t,x,y,z,w \right)}} e^{i \theta{\left(t,x,y,z,w \right)}}\right)}{2 m}

[2] \rho v_{x} = \frac{\bar{\h} \rho{\left(t,x,y,z,w \right)} \frac{\partial}{\partial x} \theta{\left(t,x,y,z,w \right)}}{m}

[3] residual = - \frac{i \bar{\h} \left(- \sqrt{\rho{\left(t,x,y,z,w \right)}} e^{i \theta{\left(t,x,y,z,w \right)}} \frac{\partial}{\partial x} \sqrt{\rho{\left(t,x,y,z,w \right)}} e^{- i \theta{\left(t,x,y,z,w \right)}} + \sqrt{\rho{\left(t,x,y,z,w \right)}} e^{- i \theta{\left(t,x,y,z,w \right)}} \frac{\partial}{\partial x} \sqrt{\rho{\left(t,x,y,z,w \right)}} e^{i \theta{\left(t,x,y,z,w \right)}}\right)}{2 m} - \frac{\bar{\h} \rho{\left(t,x,y,z,w \right)} \frac{\partial}{\partial x} \theta{\left(t,x,y,z,w \right)}}{m}

============================================================================================


============================================================================================
14) Madelung PDEs from the 4D GNLS (imag + real parts)
--------------------------------------------------------------------------------------------
[1] \text{(imag)} = \frac{\bar{\h} \rho{\left(t,x,y,z,w \right)} \frac{\partial^{2}}{\partial w^{2}} \theta{\left(t,x,y,z,w \right)} + \bar{\h} \rho{\left(t,x,y,z,w \right)} \frac{\partial^{2}}{\partial x^{2}} \theta{\left(t,x,y,z,w \right)} + \bar{\h} \rho{\left(t,x,y,z,w \right)} \frac{\partial^{2}}{\partial y^{2}} \theta{\left(t,x,y,z,w \right)} + \bar{\h} \rho{\left(t,x,y,z,w \right)} \frac{\partial^{2}}{\partial z^{2}} \theta{\left(t,x,y,z,w \right)} + \bar{\h} \frac{\partial}{\partial w} \rho{\left(t,x,y,z,w \right)} \frac{\partial}{\partial w} \theta{\left(t,x,y,z,w \right)} + \bar{\h} \frac{\partial}{\partial x} \rho{\left(t,x,y,z,w \right)} \frac{\partial}{\partial x} \theta{\left(t,x,y,z,w \right)} + \bar{\h} \frac{\partial}{\partial y} \rho{\left(t,x,y,z,w \right)} \frac{\partial}{\partial y} \theta{\left(t,x,y,z,w \right)} + \bar{\h} \frac{\partial}{\partial z} \rho{\left(t,x,y,z,w \right)} \frac{\partial}{\partial z} \theta{\left(t,x,y,z,w \right)} + m \frac{\partial}{\partial t} \rho{\left(t,x,y,z,w \right)}}{m}

[2] \frac{\bar{\h} \rho{\left(t,x,y,z,w \right)} \frac{\partial^{2}}{\partial w^{2}} \theta{\left(t,x,y,z,w \right)} + \bar{\h} \rho{\left(t,x,y,z,w \right)} \frac{\partial^{2}}{\partial x^{2}} \theta{\left(t,x,y,z,w \right)} + \bar{\h} \rho{\left(t,x,y,z,w \right)} \frac{\partial^{2}}{\partial y^{2}} \theta{\left(t,x,y,z,w \right)} + \bar{\h} \rho{\left(t,x,y,z,w \right)} \frac{\partial^{2}}{\partial z^{2}} \theta{\left(t,x,y,z,w \right)} + \bar{\h} \frac{\partial}{\partial w} \rho{\left(t,x,y,z,w \right)} \frac{\partial}{\partial w} \theta{\left(t,x,y,z,w \right)} + \bar{\h} \frac{\partial}{\partial x} \rho{\left(t,x,y,z,w \right)} \frac{\partial}{\partial x} \theta{\left(t,x,y,z,w \right)} + \bar{\h} \frac{\partial}{\partial y} \rho{\left(t,x,y,z,w \right)} \frac{\partial}{\partial y} \theta{\left(t,x,y,z,w \right)} + \bar{\h} \frac{\partial}{\partial z} \rho{\left(t,x,y,z,w \right)} \frac{\partial}{\partial z} \theta{\left(t,x,y,z,w \right)} + m \frac{\partial}{\partial t} \rho{\left(t,x,y,z,w \right)}}{m} = 0

[3] \text{(real)} = \frac{4 \bar{\h}^{2} \left(\left(\frac{\partial}{\partial w} \theta{\left(t,x,y,z,w \right)}\right)^{2} + \left(\frac{\partial}{\partial x} \theta{\left(t,x,y,z,w \right)}\right)^{2} + \left(\frac{\partial}{\partial y} \theta{\left(t,x,y,z,w \right)}\right)^{2} + \left(\frac{\partial}{\partial z} \theta{\left(t,x,y,z,w \right)}\right)^{2}\right) \rho^{2}{\left(t,x,y,z,w \right)} - \bar{\h}^{2} \left(2 \rho{\left(t,x,y,z,w \right)} \frac{\partial^{2}}{\partial w^{2}} \rho{\left(t,x,y,z,w \right)} + 2 \rho{\left(t,x,y,z,w \right)} \frac{\partial^{2}}{\partial x^{2}} \rho{\left(t,x,y,z,w \right)} + 2 \rho{\left(t,x,y,z,w \right)} \frac{\partial^{2}}{\partial y^{2}} \rho{\left(t,x,y,z,w \right)} + 2 \rho{\left(t,x,y,z,w \right)} \frac{\partial^{2}}{\partial z^{2}} \rho{\left(t,x,y,z,w \right)} - \left(\frac{\partial}{\partial w} \rho{\left(t,x,y,z,w \right)}\right)^{2} - \left(\frac{\partial}{\partial x} \rho{\left(t,x,y,z,w \right)}\right)^{2} - \left(\frac{\partial}{\partial y} \rho{\left(t,x,y,z,w \right)}\right)^{2} - \left(\frac{\partial}{\partial z} \rho{\left(t,x,y,z,w \right)}\right)^{2}\right) + 2 m \left(5 K \rho^{4}{\left(t,x,y,z,w \right)} + 4 \bar{\h} \frac{\partial}{\partial t} \theta{\left(t,x,y,z,w \right)} + 4 V_{\rm conf}{\left(x,y,z,w,a,L \right)}\right) \rho^{2}{\left(t,x,y,z,w \right)}}{8 m \rho^{2}{\left(t,x,y,z,w \right)}}

[4] \frac{4 \bar{\h}^{2} \left(\left(\frac{\partial}{\partial w} \theta{\left(t,x,y,z,w \right)}\right)^{2} + \left(\frac{\partial}{\partial x} \theta{\left(t,x,y,z,w \right)}\right)^{2} + \left(\frac{\partial}{\partial y} \theta{\left(t,x,y,z,w \right)}\right)^{2} + \left(\frac{\partial}{\partial z} \theta{\left(t,x,y,z,w \right)}\right)^{2}\right) \rho^{2}{\left(t,x,y,z,w \right)} - \bar{\h}^{2} \left(2 \rho{\left(t,x,y,z,w \right)} \frac{\partial^{2}}{\partial w^{2}} \rho{\left(t,x,y,z,w \right)} + 2 \rho{\left(t,x,y,z,w \right)} \frac{\partial^{2}}{\partial x^{2}} \rho{\left(t,x,y,z,w \right)} + 2 \rho{\left(t,x,y,z,w \right)} \frac{\partial^{2}}{\partial y^{2}} \rho{\left(t,x,y,z,w \right)} + 2 \rho{\left(t,x,y,z,w \right)} \frac{\partial^{2}}{\partial z^{2}} \rho{\left(t,x,y,z,w \right)} - \left(\frac{\partial}{\partial w} \rho{\left(t,x,y,z,w \right)}\right)^{2} - \left(\frac{\partial}{\partial x} \rho{\left(t,x,y,z,w \right)}\right)^{2} - \left(\frac{\partial}{\partial y} \rho{\left(t,x,y,z,w \right)}\right)^{2} - \left(\frac{\partial}{\partial z} \rho{\left(t,x,y,z,w \right)}\right)^{2}\right) + 2 m \left(5 K \rho^{4}{\left(t,x,y,z,w \right)} + 4 \bar{\h} \frac{\partial}{\partial t} \theta{\left(t,x,y,z,w \right)} + 4 V_{\rm conf}{\left(x,y,z,w,a,L \right)}\right) \rho^{2}{\left(t,x,y,z,w \right)}}{8 m \rho^{2}{\left(t,x,y,z,w \right)}} = 0

[5] Q = \frac{\bar{\h}^{2} \left(- 2 \rho{\left(t,x,y,z,w \right)} \frac{\partial^{2}}{\partial w^{2}} \rho{\left(t,x,y,z,w \right)} - 2 \rho{\left(t,x,y,z,w \right)} \frac{\partial^{2}}{\partial x^{2}} \rho{\left(t,x,y,z,w \right)} - 2 \rho{\left(t,x,y,z,w \right)} \frac{\partial^{2}}{\partial y^{2}} \rho{\left(t,x,y,z,w \right)} - 2 \rho{\left(t,x,y,z,w \right)} \frac{\partial^{2}}{\partial z^{2}} \rho{\left(t,x,y,z,w \right)} + \left(\frac{\partial}{\partial w} \rho{\left(t,x,y,z,w \right)}\right)^{2} + \left(\frac{\partial}{\partial x} \rho{\left(t,x,y,z,w \right)}\right)^{2} + \left(\frac{\partial}{\partial y} \rho{\left(t,x,y,z,w \right)}\right)^{2} + \left(\frac{\partial}{\partial z} \rho{\left(t,x,y,z,w \right)}\right)^{2}\right)}{8 m \rho^{2}{\left(t,x,y,z,w \right)}}

============================================================================================


