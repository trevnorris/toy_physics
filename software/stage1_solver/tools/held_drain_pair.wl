(* Independent exterior quadrature of pressure and advective momentum from
   gradients of the two sink potentials. x is directed toward the companion.
   The graph-face calculation uses a Cartesian surface-area cofactor. *)
ClearAll["Global`*"];
$HistoryLength = 0;
point = {x, y, z};
phi = q1/(4 Pi Sqrt[point.point]) +
      q2/(4 Pi Sqrt[(x - d)^2 + y^2 + z^2]);
v = Grad[phi, point];
current = Outer[Times, v, v] - IdentityMatrix[3]*(v.v)/2;
normal = {Cos[th], Sin[th], 0};
(* Return 4 Pi times inward axial flux for unit density. Absolute speeds
   are generated by the two potentials; no imposed flow at infinity. *)
sample[sep_, rad_, own_, other_] := Module[{integrand},
  integrand = First[current.normal] /. {x -> rad Cos[th], y -> rad Sin[th], z -> 0,
                                          d -> sep, q1 -> own, q2 -> other};
  -8 Pi^2 rad^2 NIntegrate[integrand Sin[th], {th, 0, Pi},
      WorkingPrecision -> 40, AccuracyGoal -> 28]
];
Do[
  single = sample[sep, rad, 1, 0];
  otherOnly = sample[sep, rad, 0, 1];
  both = sample[sep, rad, 1, 1];
  Print[StringJoin["d=", ToString[sep], " b=", ToString[rad],
    " 4pi/rho [single,other_only,pair,pair-single] = ",
    ToString[NumberForm[{single, otherOnly, both, both-single}, {18,15}], OutputForm]]],
  {sep, {10, 20}}, {rad, {1, 3}}];

(* Form the oriented area element of the graph (x,y,z,h); its axial
   component is a signed minor of the tangent matrix. Then integrate the
   first variation of the physical force over the two-sphere angles. *)
radial = Sqrt[point.point];
height = h0[radial] + eps*x/radial*h1[radial];
amp = p0[radial] + eps*x/radial*p1[radial];
embedding = Append[point, height];
tangents = Table[D[embedding, xi], {xi, point}];
upperX = -Det[tangents[[All, {2, 3, 4}]]];
integrand = FullSimplify[(D[amp*upperX, eps] /. eps -> 0) /.
  {x -> r*u, y -> r*Sqrt[1-u^2], z -> 0}, r > 0 && -1 < u < 1];
firstFace = Factor[2 Pi r^2 Integrate[integrand, {u, -1, 1}]];
Print["upper face first variation per dr = ", ToString[firstFace, InputForm]];
Exit[0];
