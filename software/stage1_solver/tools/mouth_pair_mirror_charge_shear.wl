(* The same registered 3D orientation, outward sphere and readout sign serve
   the two preparations. The only surviving compact group is generated by
   (1,-1). In a reflection-invariant state test two physical mirror lifts:
   face exchange, or face exchange followed by conjugation on both faces.
   Gauge additions d(chi) on regular charts drop out of the local curvature. *)
ClearAll["Global`*"];
emit[label_, value_] := Print[label <> " = " <> ToString[value, InputForm]];
xyz = {x, y, z};
curlGauge = Simplify[Curl[Grad[chi[x, y, z], xyz], xyz]];
integerAutomorphisms = Reduce[p h == 1, {p, h}, Integers];
primitive = {1, -1};
readout = primitive/(primitive.primitive);
swap = {{0, 1}, {1, 0}};
emit["curl of smooth gauge shift; integral winding p with integral inverse h",
  {curlGauge, integerAutomorphisms}];
(* Multiplying by the calibrated scalar 2 Pi leaves the character unchanged.
   A local, finite-k signed curl probe measures this same character. This
   does not identify a wave's local curl with a closed sphere's net flux. *)
rows = Table[Module[{mirror, after, signed, character, ward},
    mirror = eps swap;
    after = Expand[mirror.(s primitive)];
    signed = Expand[readout.after];
    character = readout.mirror.primitive;
    (* Common tangential drive has character +1. Symmetry gives X=r X
       for its linear susceptibility to the signed curl at fixed (k,w). *)
    ward = Reduce[transfer == character transfer, transfer, Complexes];
    {eps, after, signed, character, ward, character == -1,
     Reduce[transfer != 0 && transfer == character transfer, transfer, Complexes]}],
    {eps, {1, -1}}];
emit["{epsilon,mirrored face windings,signed reading in turns,character,allowed transfer,flips nonzero mouth,nonzero transfer allowed when}",
  rows];
both = Reduce[r^2 == 1 && r s == -s && s != 0 && transfer == r transfer &&
    transfer != 0, {r, s, transfer}, Complexes];
emit["single-generator sign reversal and nonzero even-drive transfer simultaneously", both];
If[!TrueQ[curlGauge == {0, 0, 0} && rows[[All, 4]] == {-1, 1} && both === False],
  Exit[1]];
